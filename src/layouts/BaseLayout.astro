---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { client as stegaClient, visualEditingEnabled } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'
import { VisualEditing } from '@sanity/astro/visual-editing'

const builder = imageUrlBuilder(stegaClient)
const urlFor = (source: any) => { const b = builder.image(source); const hs = source?.hotspot; return (hs?.x != null && hs?.y != null) ? b.focalPoint(hs.x, hs.y) : b }

// ── Un seul fetch pour tout le site (SEO global + données Footer) ──────────
const params = await stegaClient.fetch(`*[_id == "siteParametres"][0]{
  siteTitle, siteDescription, ogImage,
  telephone, email, adresse, footerTexte, mentionsLegales,
  facebook, instagram, youtube, vimeo, certifications, siret
}`)

// Menu de navigation Sanity — le footer FR reflète automatiquement le menu
// (entrées + sous-menus aplatis) : une page ajoutée au menu apparaît au footer.
const navDoc = await stegaClient.fetch(`*[_type == "navigation" && _id == "navigation"][0]{ items }`)

interface Props {
  title?: string
  description?: string
  image?: string   // URL directe — prioritaire sur ogImage Sanity
  lang?: 'fr' | 'en'
  hreflangFr?: string  // chemin relatif vers la version FR (ex: /stage-spey-cast)
  hreflangEn?: string  // chemin relatif vers la version EN (ex: /en/stage-spey-cast)
  jsonLd?: object[]    // blocs JSON-LD additionnels fournis par la page (Service, Article, Breadcrumb…)
}

const {
  title       = stegaClean(params?.siteTitle)       || 'Jean-Baptiste Vidal — Guide de pêche à la mouche en Bretagne',
  description = stegaClean(params?.siteDescription) || 'Moniteur-Guide diplômé, Jean-Baptiste Vidal vous accompagne pour la pêche à la mouche sur les plus belles rivières de Bretagne.',
  image       = params?.ogImage
    ? urlFor(params.ogImage).width(1200).height(630).fit('crop').crop('focalpoint').url()
    : '/og-default.jpg',
  lang        = 'fr',
  hreflangFr,
  hreflangEn,
  jsonLd      = [],
} = Astro.props

const siteBase = Astro.site?.toString().replace(/\/$/, '') || ''
const hasLangSwitch = !!(hreflangFr && hreflangEn)

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url

// Nettoyage stega pour les balises meta (title/description viennent parfois de pages enfants)
const metaTitle = stegaClean(title) || title
const metaDesc  = stegaClean(description) || description

// ── Données passées au Footer (évite un second fetch) ─────────────────────
const footerProps = {
  telephone: stegaClean(params?.telephone) || '06 87 30 34 56',
  email:     stegaClean(params?.email)     || 'enjoy.fishing@hotmail.fr',
  adresse:   params?.adresse   || null,
  footerBio: params?.footerTexte || null,
  instagram: stegaClean(params?.instagram) || null,
  facebook:  stegaClean(params?.facebook)  || null,
  youtube:   stegaClean(params?.youtube)   || null,
  vimeo:     stegaClean(params?.vimeo)     || null,
  navItems:  navDoc?.items || null,
  certifications: params?.certifications || null,
  siret: stegaClean(params?.siret) || null,
  lang,
}

// ── JSON-LD global : l'activité de guidage (toutes les pages) ─────────────
// Données tirées de Sanity (téléphone, e-mail, réseaux) — invisibles pour les
// visiteurs, lues par Google (pack local Maps, fiche entreprise).
const businessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  '@id': `${siteBase}/#business`,
  name: 'Jean-Baptiste Vidal — Guide de pêche à la mouche',
  description: metaDesc,
  url: siteBase || 'https://jeanbaptistevidalguidepeche.com',
  telephone: footerProps.telephone,
  email: footerProps.email,
  image: image?.startsWith('http') ? image : `${siteBase}${image}`,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Bretagne',
    addressCountry: 'FR',
  },
  areaServed: {
    '@type': 'Place',
    name: 'Bretagne-Sud, entre Quimper et Quimperlé, France',
  },
  founder: {
    '@type': 'Person',
    '@id': `${siteBase}/#jbv`,
    name: 'Jean-Baptiste Vidal',
    jobTitle: lang === 'en' ? 'Fly fishing guide and instructor' : 'Moniteur-Guide de pêche à la mouche',
    url: `${siteBase}/jean-baptiste-vidal-moniteur-guide-de-peche`,
  },
  sameAs: [footerProps.instagram, footerProps.facebook, footerProps.youtube, footerProps.vimeo].filter(Boolean),
}

const allJsonLd = [businessJsonLd, ...jsonLd]
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDesc} />
    <!-- Noindex — site en développement, non destiné à l'indexation -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <link rel="canonical" href={canonicalURL} />
    {hreflangFr && <link rel="alternate" hreflang="fr" href={`${siteBase}${hreflangFr}`} />}
    {hreflangEn && <link rel="alternate" hreflang="en" href={`${siteBase}${hreflangEn}`} />}
    {hasLangSwitch && <link rel="alternate" hreflang="x-default" href={`${siteBase}${hreflangFr}`} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <title>{metaTitle}</title>

    {/* Visiteur arrivant depuis un lien de la newsletter Mailchimp (?mc_cid / ?mc_eid)
        → déjà abonné : le popup newsletter ne lui sera plus jamais proposé. */}
    <script is:inline>
      try {
        var p = new URLSearchParams(location.search)
        if (p.has('mc_cid') || p.has('mc_eid')) {
          localStorage.setItem('nl_subscribed', '1')
          localStorage.removeItem('nl_popup_dismissed')
          localStorage.removeItem('nl_popup_closed')
        }
      } catch (e) {}
    </script>

    {/* Données structurées — cartes d'identité lues par Google */}
    {allJsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>

  <body>
    <Header lang={lang} hasLangSwitch={hasLangSwitch} />
    <main>
      <slot />
    </main>
    <Footer {...footerProps} />
    {/* Overlays Visual Editing — montés uniquement dans le worker d'aperçu */}
    <VisualEditing enabled={visualEditingEnabled} />
  </body>
</html>

<style is:global>
  /* ── Design tokens ── */
  :root {
    --color-ocean:       #0d2b3e;
    --color-ocean-main:  #1B5E8A;
    --color-ocean-mid:   #5BA3C9;
    --color-ocean-light: #7EC8E3;
    --color-mist:        #f0eff0;
    --color-sand:        #f8f7f4;
    --color-footer:      #07181f;
    --color-text:        #1a1a1f;
    --color-text-muted:  #5a6478;

    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans:  'DM Sans', system-ui, sans-serif;

    --max-width: 1400px;
    --header-height: 72px;
  }

  /* ── Cadrage d'image piloté par le hotspot Sanity ──────────────────────────
     À poser sur tout conteneur affichant une image Sanity dont le cadre change
     de ratio selon l'écran. Les variables viennent de hotspotVars()
     (src/lib/image.js) en style inline :
        <div class="img-hotspot" style={hotspotVars(url, image)}></div>

     Pourquoi un ::before + transform plutôt que background-size sur l'élément :
     le fond reste en `cover` (donc il couvre TOUJOURS le cadre) et le zoom est
     appliqué par-dessus, centré sur le hotspot. Une hauteur en pourcentage
     laisserait des bandes dès qu'une image serait plus étroite que le cadre.

     Sans hotspot, --img-zoom vaut 1 → strictement équivalent à `cover`.

     ⚠️ À poser sur un calque d'image DÉDIÉ et SANS enfant (le ::before, étant
     absolu, passerait au-dessus d'un contenu non positionné). L'hôte doit être
     positionné : .guide-photo est en `relative`, .hp-mat-card__bg en `absolute`.
     On ne force donc pas `position` ici, pour ne pas écraser ce dernier.

     ⚠️ `overflow: hidden` n'est PAS cosmétique : sans lui, le ::before agrandi
     par scale() déborde du cadre et recouvre le contenu voisin. */
  .img-hotspot {
    overflow: hidden;
  }
  .img-hotspot::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--img);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: var(--img-pos, center);
    /* Même origine que la position : le hotspot reste au même endroit du cadre
       pendant que le reste s'agrandit autour de lui. Se compose proprement avec
       un scale de survol posé sur l'hôte (ex. .hp-mat-card:hover). */
    transform-origin: var(--img-pos, center);
    transform: scale(var(--img-zoom, 1));
  }

  /* ── Reset ── */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text);
    background: #fff;
  }

  /* ── Typography ── */
  h1, h2, h3, h4 {
    font-family: var(--font-serif);
    line-height: 1.2;
    font-weight: 500;
  }

  h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); }
  h3 { font-size: clamp(1.1rem, 2.5vw, 1.5rem); }

  a {
    color: inherit;
    text-decoration: none;
  }

  img, video {
    display: block;
    max-width: 100%;
  }

  /* ── Utilities ── */
  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 3rem 0;
  }

  .section--white {
    background: #fff;
    color: var(--color-text);
  }

  .section--ocean {
    background: var(--color-ocean-main);
    color: white;
  }

  .section--mist {
    background: var(--color-mist);
  }

  .section--sand {
    background: var(--color-sand);
  }

  .section--dark {
    background: var(--color-ocean);
    color: white;
  }

  /* Offset for fixed header */
  main > *:first-child {
    padding-top: var(--header-height);
  }
</style>
