---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { client as stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(stegaClient)
const urlFor = (source: any) => { const b = builder.image(source); const hs = source?.hotspot; return (hs?.x != null && hs?.y != null) ? b.focalPoint(hs.x, hs.y) : b }

// ── Un seul fetch pour tout le site (SEO global + données Footer) ──────────
const params = await stegaClient.fetch(`*[_id == "siteParametres"][0]{
  siteTitle, siteDescription, ogImage,
  telephone, email, adresse, footerTexte, mentionsLegales,
  facebook, instagram, youtube, vimeo
}`)

interface Props {
  title?: string
  description?: string
  image?: string   // URL directe — prioritaire sur ogImage Sanity
  lang?: 'fr' | 'en'
  hreflangFr?: string  // chemin relatif vers la version FR (ex: /stage-spey-cast)
  hreflangEn?: string  // chemin relatif vers la version EN (ex: /en/stage-spey-cast)
}

const {
  title       = stegaClean(params?.siteTitle)       || 'Jean-Baptiste Vidal — Guide de pêche à la mouche en Bretagne',
  description = stegaClean(params?.siteDescription) || 'Moniteur-Guide diplômé, Jean-Baptiste Vidal vous accompagne pour la pêche à la mouche sur les plus belles rivières de Bretagne.',
  image       = params?.ogImage
    ? urlFor(params.ogImage).width(1200).height(630).fit('crop').crop('focalpoint').url()
    : '/og-default.jpg',
  lang        = 'fr',
  hreflangFr,
  hreflangEn,
} = Astro.props

const siteBase = Astro.site?.toString().replace(/\/$/, '') || ''
const hasLangSwitch = !!(hreflangFr && hreflangEn)

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url

// Nettoyage stega pour les balises meta (title/description viennent parfois de pages enfants)
const metaTitle = stegaClean(title) || title
const metaDesc  = stegaClean(description) || description

// ── Données passées au Footer (évite un second fetch) ─────────────────────
const footerProps = {
  telephone: stegaClean(params?.telephone) || '06 87 30 34 56',
  email:     stegaClean(params?.email)     || 'enjoy.fishing@hotmail.fr',
  adresse:   params?.adresse   || null,
  footerBio: params?.footerTexte || "Moniteur-Guide diplômé d'État.\nPêche à la mouche en rivières de Bretagne.",
  instagram: stegaClean(params?.instagram) || null,
  facebook:  stegaClean(params?.facebook)  || null,
  youtube:   stegaClean(params?.youtube)   || null,
  vimeo:     stegaClean(params?.vimeo)     || null,
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDesc} />
    <!-- Noindex — site en développement, non destiné à l'indexation -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <link rel="canonical" href={canonicalURL} />
    {hreflangFr && <link rel="alternate" hreflang="fr" href={`${siteBase}${hreflangFr}`} />}
    {hreflangEn && <link rel="alternate" hreflang="en" href={`${siteBase}${hreflangEn}`} />}
    {hasLangSwitch && <link rel="alternate" hreflang="x-default" href={`${siteBase}${hreflangFr}`} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <title>{metaTitle}</title>
  </head>

  <body>
    <Header lang={lang} hasLangSwitch={hasLangSwitch} />
    <main>
      <slot />
    </main>
    <Footer {...footerProps} />
  </body>
</html>

<style is:global>
  /* ── Design tokens ── */
  :root {
    --color-ocean:       #0d2b3e;
    --color-ocean-main:  #1B5E8A;
    --color-ocean-mid:   #5BA3C9;
    --color-ocean-light: #7EC8E3;
    --color-mist:        #f0eff0;
    --color-sand:        #f8f7f4;
    --color-footer:      #07181f;
    --color-text:        #1a1a1f;
    --color-text-muted:  #5a6478;

    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans:  'DM Sans', system-ui, sans-serif;

    --max-width: 1400px;
    --header-height: 72px;
  }

  /* ── Reset ── */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text);
    background: #fff;
  }

  /* ── Typography ── */
  h1, h2, h3, h4 {
    font-family: var(--font-serif);
    line-height: 1.2;
    font-weight: 500;
  }

  h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); }
  h3 { font-size: clamp(1.1rem, 2.5vw, 1.5rem); }

  a {
    color: inherit;
    text-decoration: none;
  }

  img, video {
    display: block;
    max-width: 100%;
  }

  /* ── Utilities ── */
  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 3rem 0;
  }

  .section--white {
    background: #fff;
    color: var(--color-text);
  }

  .section--ocean {
    background: var(--color-ocean-main);
    color: white;
  }

  .section--mist {
    background: var(--color-mist);
  }

  .section--sand {
    background: var(--color-sand);
  }

  .section--dark {
    background: var(--color-ocean);
    color: white;
  }

  /* Offset for fixed header */
  main > *:first-child {
    padding-top: var(--header-height);
  }
</style>
