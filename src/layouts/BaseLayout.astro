---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import VisualEditingPreview from '../components/VisualEditingPreview.tsx'
import { client } from '../lib/sanity.js'

// SEO globaux depuis Sanity — fallbacks si le document n'existe pas encore
const siteParams = await client.fetch(
  `*[_id == "siteParametres"][0]{ siteTitle, siteDescription }`
)

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = siteParams?.siteTitle || 'Jean-Baptiste Vidal — Guide de pêche à la mouche en Bretagne',
  description = siteParams?.siteDescription || 'Moniteur-Guide diplômé, Jean-Baptiste Vidal vous accompagne pour la pêche à la mouche sur les plus belles rivières de Bretagne.',
  image = '/og-default.jpg',
} = Astro.props

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Noindex — site en développement, non destiné à l'indexation -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Visual Editing — s'active UNIQUEMENT dans l'iframe Studio ou avec ?sanity-preview-perspective -->
    <!-- Les visiteurs normaux ne voient jamais les encadrés bleus -->
    <VisualEditingPreview client:only="react" />
  </body>
</html>

<style is:global>
  /* ── Design tokens ── */
  :root {
    --color-ocean:       #0d2b3e;
    --color-ocean-main:  #1B5E8A;
    --color-ocean-mid:   #5BA3C9;
    --color-ocean-light: #7EC8E3;
    --color-mist:        #f0eff0;
    --color-sand:        #f8f7f4;
    --color-footer:      #07181f;
    --color-text:        #1a1a1f;
    --color-text-muted:  #5a6478;

    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans:  'DM Sans', system-ui, sans-serif;

    --max-width: 1200px;
    --header-height: 72px;
  }

  /* ── Reset ── */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text);
    background: #fff;
  }

  /* ── Typography ── */
  h1, h2, h3, h4 {
    font-family: var(--font-serif);
    line-height: 1.2;
    font-weight: 500;
  }

  h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); }
  h3 { font-size: clamp(1.1rem, 2.5vw, 1.5rem); }

  a {
    color: inherit;
    text-decoration: none;
  }

  img, video {
    display: block;
    max-width: 100%;
  }

  /* ── Utilities ── */
  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section--mist {
    background: var(--color-mist);
  }

  .section--sand {
    background: var(--color-sand);
  }

  .section--dark {
    background: var(--color-ocean);
    color: white;
  }

  /* Offset for fixed header */
  main > *:first-child {
    padding-top: var(--header-height);
  }
</style>
