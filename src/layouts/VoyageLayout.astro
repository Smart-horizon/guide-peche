---
/**
 * VoyageLayout.astro
 * Layout dynamique partagé pour toutes les pages voyage.
 * Itère sur toutes les sections du pagebuilder dans l'ordre Sanity.
 * Utilise le CSS voy-* pour préserver le design voyage original.
 */
import BaseLayout from './BaseLayout.astro'
import { stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

interface Props {
  doc: any
}

const { doc } = Astro.props
const pb = (doc?.pagebuilder || []) as any[]

const builder = imageUrlBuilder(stegaClient)
const urlFor  = (source: any) => builder.image(source)

// ── SEO ───────────────────────────────────────────────────────────────────────
const heroSection = pb.find((s: any) => s._type === 'sectionHero')
const pageTitle   = doc?.seoTitle || heroSection?.titre || doc?.title || 'Voyage de pêche'
const pageDesc    = doc?.seoDescription || ''

// ── Helpers ───────────────────────────────────────────────────────────────────
const bgClass: Record<string,string> = { white:'section--white', sand:'section--sand', dark:'section--dark' }
const bg = (fond: string) => bgClass[stegaClean(fond) ?? ''] ?? 'section--white'

function blocks(content: any[]): string {
  if (!content?.length) return ''
  return content.map((b: any) => {
    if (b._type !== 'block') return ''
    const text = (b.children || []).map((s: any) => {
      let t = (s.text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      if (s.marks?.includes('strong')) t = `<strong>${t}</strong>`
      if (s.marks?.includes('em'))     t = `<em>${t}</em>`
      return t
    }).join('')
    const tags: Record<string,string> = { h2:'h2', h3:'h3', blockquote:'blockquote', normal:'p' }
    const el = tags[b.style] || 'p'
    return `<${el}>${text}</${el}>`
  }).join('')
}

// Détermine le variant de sectionProgrammeCartes
// Priority: champ styleMisePage explicite → fallback auto pour rétrocompat
function cartesVariant(s: any): 'photo-gauche' | 'photo-haut' | 'materiel' | 'generic' {
  const style = stegaClean(s.styleMisePage)
  const cols  = stegaClean(s.colonnes) || '3'
  const hasImg = !!s.image?.asset
  // Champ style explicite (fonctionne avec ou sans image)
  if (style === 'photo-gauche') return 'photo-gauche'
  if (style === 'photo-haut')   return 'photo-haut'
  // Fallback auto pour données existantes sans styleMisePage
  if (hasImg && cols === '2') return 'photo-gauche'
  if (hasImg && cols === '3') return 'photo-haut'
  if (cols === '4') return 'materiel'
  return 'generic'
}

// Carousel ID unique par galerie
let carouselCount = 0
---

<BaseLayout title={`${pageTitle} — Jean-Baptiste Vidal`} description={pageDesc}>

{pb.map((s: any) => (
<>

{/* ═══════════════ HERO ═══════════════ */}
{s._type === 'sectionHero' && (() => {
  const heroBg = s.image?.asset
    ? `background-image:url('${urlFor(s.image).width(1600).height(900).url()}')`
    : `background-color:var(--color-ocean)`
  return (
    <section class="voy-hero">
      <div class="voy-hero__bg" style={heroBg}></div>
      <div class="voy-hero__overlay"></div>
      <div class="voy-hero__content container">
        {s.eyebrow && <p class="voy-eyebrow">{s.eyebrow}</p>}
        <h1>{s.titre}<br/><span class="voy-hero__sub">{s.sousTitre}</span></h1>
        <div class="voy-hero__cta">
          <a href={s.btnReserverLien || '/contact'} class="btn-prim">{s.btnReserverTexte || 'Réserver'}</a>
          <a href="tel:0687303456" class="btn-ghost">{s.btnTelTexte || '06 87 30 34 56'}</a>
        </div>
      </div>
      <div class="voy-hero__scroll"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22"><path d="M12 5v14M5 12l7 7 7-7"/></svg></div>
    </section>
  )
})()}

{/* ═══════════════ STATS ═══════════════ */}
{s._type === 'sectionStats' && (
  <div class={`voy-stats ${bg(s.fond)}`}>
    {s.stats?.map((st: any) => (
      <div class="voy-stats__item">
        <span class="voy-stats__num">{st.nombre}</span>
        <span class="voy-stats__label">{st.label}</span>
      </div>
    ))}
  </div>
)}

{/* ═══════════════ INTRO + INFO CARD ═══════════════ */}
{s._type === 'sectionIntro' && (
  <section class={`section ${bg(s.fond) || 'section--white'}`}>
    <div class="container voy-intro">
      <div class="voy-intro__text" set:html={blocks(s.texte)} />
      <aside class="voy-intro__card">
        {s.saison  && <><p class="card-label">Saison</p><p class="card-val">{s.saison}</p></>}
        {s.tarif   && <><p class="card-label">Tarifs</p><p class="card-val">{s.tarif}</p></>}
        {s.duree   && <><p class="card-label">Format</p><p class="card-val">{s.duree}</p></>}
        {s.lignesSupp?.map((l: any) => l.label && (
          <><p class="card-label">{l.label}</p><p class="card-val">{l.valeur}</p></>
        ))}
        {s.boutons?.map((btn: any) => (
          <a href={btn.lien} class="card-cta">{btn.texte}</a>
        ))}
      </aside>
    </div>
  </section>
)}

{/* ═══════════════ TEXTE + IMAGE ═══════════════ */}
{s._type === 'sectionTexteImage' && (() => {
  const imgUrl = s.image?.asset ? urlFor(s.image).width(700).height(520).fit('crop').url() : null
  const pos    = stegaClean(s.imagePosition) || 'right'
  return (
    <section class={`section ${bg(s.fond) || 'section--white'}`}>
      <div class={`container voy-lodge-solo${pos === 'left' ? ' voy-lodge-solo--rev' : ''}`}>
        {imgUrl && (
          <div class="voy-lodge-solo__img">
            <img src={imgUrl} alt={s.image?.alt || s.titre || ''} loading="lazy" />
          </div>
        )}
        <div class="voy-lodge-solo__text">
          {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
          {s.titre   && <h2>{s.titre}</h2>}
          <div set:html={blocks(s.texte)} />
        </div>
      </div>
    </section>
  )
})()}

{/* ═══════════════ GRILLE DE CARTES ═══════════════ */}
{s._type === 'sectionProgrammeCartes' && (() => {
  const variant = cartesVariant(s)
  const imgUrl  = s.image?.asset ? urlFor(s.image).width(600).height(520).fit('crop').url() : null

  // ── Variante SAISONS (dark + image + 2 cols) ──────────────────────────
  if (variant === 'photo-gauche') return (
    <section class={`section ${bg(s.fond) || 'section--dark'}`}>
      <div class={`container${imgUrl ? ' voy-saison-grid' : ''}`}>
        {imgUrl && (
          <div class="voy-saison-img">
            <img src={imgUrl} alt={s.image?.alt || ''} loading="lazy" />
          </div>
        )}
        <div class="voy-saison-text">
          {s.eyebrow && <p class={imgUrl ? 'eyebrow-light' : 'eyebrow'}>{s.eyebrow}</p>}
          <h2 class={imgUrl ? 'light' : ''}>{s.titre}</h2>
          {s.intro && <p>{s.intro}</p>}
          <div class={`voy-saison-cards voy-saison-cards--${stegaClean(s.colonnes)||'2'}`}>
            {s.items?.map((item: any) => (
              <div class="voy-saison-card">
                <h3>{item.titre}</h3>
                {item.sousTitre && <p class="voy-saison-card__sub">{item.sousTitre}</p>}
                {item.description && <p>{item.description}</p>}
              </div>
            ))}
          </div>
          {s.note && <p class="voy-saison-note">{s.note}</p>}
        </div>
      </div>
    </section>
  )

  // ── Variante ESPÈCES (dark + image + 3 cols) ──────────────────────────
  if (variant === 'photo-haut') return (
    <section class={`section ${bg(s.fond) || 'section--dark'}`}>
      <div class="container">
        {s.eyebrow && <p class={bg(s.fond) === 'section--dark' ? 'eyebrow-light' : 'eyebrow'}>{s.eyebrow}</p>}
        <h2 class={bg(s.fond) === 'section--dark' ? 'light' : ''}>{s.titre}</h2>
        {(imgUrl || s.intro) && (
          <div class={imgUrl ? 'voy-fish-intro' : 'voy-fish-intro voy-fish-intro--no-img'}>
            {imgUrl && <img src={imgUrl} alt={s.image?.alt || ''} loading="lazy" class="voy-fish-hero-img" />}
            {s.intro && <p>{s.intro}</p>}
          </div>
        )}
        <div class={`voy-fish-trio voy-fish-trio--${stegaClean(s.colonnes)||'3'}`}>
          {s.items?.map((item: any) => (
            <div class="voy-fish-species">
              <h3>{item.titre}</h3>
              {item.sousTitre && <p class="voy-fish-tag">{item.sousTitre}</p>}
              {item.description && <p>{item.description}</p>}
            </div>
          ))}
        </div>
        {s.note && <p class="voy-saison-note" style="margin-top:2rem">{s.note}</p>}
      </div>
    </section>
  )

  // ── Variante MATÉRIEL (4 cols) ────────────────────────────────────────
  if (variant === 'materiel') return (
    <section class={`section ${bg(s.fond) || 'section--white'}`}>
      <div class="container">
        {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
        {s.titre   && <h2>{s.titre}</h2>}
        {s.intro   && <p class="section-intro">{s.intro}</p>}
        <div class="voy-materiel-grid">
          {s.items?.map((item: any) => (
            <div class="voy-materiel-card">
              <div class="voy-materiel-num">{item.titre}</div>
              {item.sousTitre  && <h3>{item.sousTitre}</h3>}
              {item.description && <p>{item.description}</p>}
            </div>
          ))}
        </div>
        {stegaClean(s.btnTexte) && (s.btnFichier?.asset?.url || stegaClean(s.btnLien)) && (
          <div class="voy-materiel-download">
            <a href={s.btnFichier?.asset?.url || stegaClean(s.btnLien)} class="btn-download" download={!!s.btnFichier?.asset?.url}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {stegaClean(s.btnTexte)}
            </a>
          </div>
        )}
        {s.note && <p class="voy-saison-note" style="margin-top:2rem">{s.note}</p>}
      </div>
    </section>
  )

  // ── Variante GÉNÉRIQUE ────────────────────────────────────────────────
  return (
    <section class={`section ${bg(s.fond) || 'section--sand'}`}>
      <div class="container">
        {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
        {s.titre   && <h2>{s.titre}</h2>}
        {s.intro   && <p class="section-intro">{s.intro}</p>}
        <div class={`voy-generic-cards voy-generic-cards--${stegaClean(s.colonnes)||'3'}`}>
          {s.items?.map((item: any) => (
            <div class="voy-generic-card">
              {item.sousTitre && <p class="voy-generic-card__sub">{item.sousTitre}</p>}
              <h3>{item.titre}</h3>
              {item.description && <p>{item.description}</p>}
            </div>
          ))}
        </div>
        {s.note && <p class="voy-saison-note" style="margin-top:2rem">{s.note}</p>}
        {s.btnTexte && (s.btnFichier?.asset?.url || s.btnLien) && (
          <div style="margin-top:2rem">
            <a href={s.btnFichier?.asset?.url || s.btnLien} class="btn-download">{s.btnTexte}</a>
          </div>
        )}
      </div>
    </section>
  )
})()}

{/* ═══════════════ PROGRAMME ═══════════════ */}
{s._type === 'sectionProgramme' && (
  <section class={`section ${bg(s.fond) || 'section--sand'}`}>
    <div class="container">
      {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
      {s.titre   && <h2>{s.titre}</h2>}
      <div class="voy-programme">
        {s.etapes?.map((etape: any) => (
          <div class="voy-prog-item">
            <span class="voy-prog-day">{etape.tag || ''}</span>
            <div><strong>{etape.titre}</strong>{etape.texte?.[0]?.children?.[0]?.text ? ` : ${etape.texte[0].children[0].text}` : ''}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{/* ═══════════════ GALERIE ═══════════════ */}
{s._type === 'sectionGalerie' && (() => {
  const cid = `carousel-${++carouselCount}`
  return (
    <section class="gallery-section">
      <div class="voy-carousel" id={cid} data-carousel>
        <div class="voy-carousel__track">
          {s.photos?.map((p: any, i: number) => (
            <div class="voy-carousel__slide">
              <img src={urlFor(p).width(900).height(600).fit('crop').url()} alt={p.alt || `Photo ${i+1}`} loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
        </div>
        <button class="voy-carousel__btn voy-carousel__btn--prev" aria-label="Précédent"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><polyline points="15 18 9 12 15 6"/></svg></button>
        <button class="voy-carousel__btn voy-carousel__btn--next" aria-label="Suivant"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><polyline points="9 18 15 12 9 6"/></svg></button>
        <div class="voy-carousel__counter">1 / {s.photos?.length || 0}</div>
      </div>
    </section>
  )
})()}

{/* ═══════════════ DATES ═══════════════ */}
{s._type === 'sectionDates' && (
  <section class={`section ${bg(s.fond) || 'section--white'}`}>
    <div class="container voy-dates">
      {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
      {s.titre   && <h2>{s.titre}</h2>}
      {s.intro   && <p class="section-intro">{s.intro}</p>}
      <div class="voy-dates-grid">
        {s.sejours?.map((sej: any, i: number) => (
          <div class="voy-date-card">
            <span class="voy-date-badge">Semaine {i + 1}</span>
            <h3>{sej.dates}</h3>
            {sej.description && <p>{sej.description}</p>}
            {sej.prix         && <p class="voy-date-prix">{sej.prix}</p>}
            <a href="/contact" class="btn-prim btn-sm">Se renseigner</a>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{/* ═══════════════ INCLUS / NON INCLUS ═══════════════ */}
{s._type === 'sectionProgrammeTexte' && (
  <section class={`section ${bg(s.fond) || 'section--dark'}`}>
    <div class="container voy-inclus-grid">
      {s.colonnes?.map((col: any, ci: number) => (
        <div>
          <p class={ci === 0 ? 'eyebrow-light' : 'eyebrow-light-muted'}>{col.label}</p>
          <h2 class="light">{ci === 0 ? 'Ce qui est inclus' : 'Non inclus'}</h2>
          <ul class={ci === 0 ? 'voy-check-list' : 'voy-cross-list'}>
            {col.items?.map((item: any) => (
              <li>
                {ci === 0
                  ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
                  : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                }
                {item.texte}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

{/* ═══════════════ TEXTE SIMPLE (pratique, etc.) ═══════════════ */}
{s._type === 'sectionTexte' && (
  <section class={`section ${bg(s.fond) || 'section--sand'}`}>
    <div class="container voy-pratique">
      <div class="voy-pratique__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="prose" set:html={blocks(s.texte)} />
    </div>
  </section>
)}

{/* ═══════════════ CTA ═══════════════ */}
{s._type === 'sectionCta' && (
  <section class="section section--dark voy-cta-final">
    <div class="container voy-cta-final__inner">
      <div>
        <h2>{s.titre}</h2>
        {s.texte && <p>{s.texte}</p>}
      </div>
      <div class="voy-cta-final__btns">
        <a href={s.btn1Lien || '/contact'} class="btn-prim">{s.btn1Texte || 'Me contacter'}</a>
        {s.btn2Texte && <a href={s.btn2Lien || 'tel:0687303456'} class="btn-ghost-light">{s.btn2Texte}</a>}
      </div>
    </div>
  </section>
)}

</>
))}

</BaseLayout>

<script>
document.querySelectorAll('[data-carousel]').forEach(carousel => {
  const track   = carousel.querySelector('.voy-carousel__track') as HTMLElement
  const counter = carousel.querySelector('.voy-carousel__counter')
  if (!track) return
  const slides = track.querySelectorAll('.voy-carousel__slide')
  const total  = slides.length
  let current  = 0
  let timer: ReturnType<typeof setInterval> | null = null

  const startAutoplay = () => { if (timer) return; timer = setInterval(() => go(current + 1), 4500) }
  const stopAutoplay  = () => { if (timer) { clearInterval(timer); timer = null } }
  const restartAutoplay = () => { stopAutoplay(); setTimeout(startAutoplay, 6000) }

  const slideW   = () => (slides[0] as HTMLElement).offsetWidth
  const visibleN = () => window.innerWidth <= 640 ? 1 : window.innerWidth <= 900 ? 2 : 3
  const calcOffset = (idx: number) => {
    const w = slideW(), g = 3, n = visibleN()
    const raw = n < 3 ? idx * (w + g) : (idx - 1) * (w + g)
    return Math.max(0, Math.min(Math.max(0, (total - n) * (w + g)), raw))
  }
  const go = (idx: number) => {
    current = (idx + total) % total
    track.style.transform = `translateX(-${calcOffset(current)}px)`
    if (counter) counter.textContent = `${current + 1} / ${total}`
  }

  window.addEventListener('resize', () => {
    track.style.transition = 'none'
    track.style.transform  = `translateX(-${calcOffset(current)}px)`
    requestAnimationFrame(() => { track.style.transition = '' })
  })

  carousel.querySelector('.voy-carousel__btn--prev')?.addEventListener('click', () => { go(current - 1); restartAutoplay() })
  carousel.querySelector('.voy-carousel__btn--next')?.addEventListener('click', () => { go(current + 1); restartAutoplay() })

  let startX = 0
  carousel.addEventListener('touchstart', (e: TouchEvent) => { startX = e.changedTouches[0].clientX }, { passive: true })
  carousel.addEventListener('touchend',   (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - startX
    if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
  }, { passive: true })

  carousel.addEventListener('mouseenter', stopAutoplay)
  carousel.addEventListener('mouseleave', startAutoplay)
  startAutoplay()
})
</script>

<style>
/* ── Hero ── */
.voy-hero { position:relative;min-height:100vh;display:flex;align-items:flex-end;padding-bottom:5rem;color:white;overflow:hidden; }
.voy-hero__bg { position:absolute;inset:0;background-size:cover;background-position:center;transition:transform 8s ease; }
.voy-hero:hover .voy-hero__bg { transform:scale(1.03); }
.voy-hero__overlay { position:absolute;inset:0;background:linear-gradient(to top,rgba(5,18,26,.92) 0%,rgba(5,18,26,.55) 50%,rgba(5,18,26,.2) 100%); }
.voy-hero__content { position:relative;z-index:1;max-width:700px;margin-left:clamp(2rem,8vw,120px);margin-right:auto; }
.voy-eyebrow { font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--color-ocean-light);font-weight:500;margin-bottom:1rem; }
.voy-hero h1 { font-size:clamp(3rem,8vw,6rem);color:white;margin:0 0 1.5rem;line-height:1; }
.voy-hero__sub { font-size:clamp(1.2rem,3vw,2rem);font-weight:300;opacity:.7;display:block; }
.voy-hero__cta { display:flex;gap:1rem;flex-wrap:wrap; }
.voy-hero__scroll { position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.4);animation:bounce 2s infinite; }
@keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(6px)} }

/* ── Stats ── */
.voy-stats { display:grid;grid-template-columns:repeat(4,1fr);background:var(--color-ocean); }
.voy-stats__item { padding:2rem 1.5rem;text-align:center;border-right:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;gap:.4rem; }
.voy-stats__item:last-child { border-right:none; }
.voy-stats__num { font-family:var(--font-serif);font-size:clamp(1.4rem,3vw,2rem);color:var(--color-ocean-light);font-weight:600;line-height:1; }
.voy-stats__label { font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.5); }

/* ── Sections communes ── */
.section { padding:5rem 0; }
.section--white { background:white; }
.section--sand  { background:var(--color-sand); }
.section--dark  { background:#07181f; }
.eyebrow { font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--color-ocean-main);font-weight:500;margin-bottom:.5rem; }
.eyebrow-light { font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--color-ocean-light);font-weight:500;margin-bottom:.5rem; }
.eyebrow-light-muted { font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.4);font-weight:500;margin-bottom:.5rem; }
h2.light { color:white;margin:.4rem 0 1.5rem; }
.section-intro { color:var(--color-text-muted,#555);font-size:.95rem;line-height:1.75;max-width:760px;margin-bottom:3rem; }

