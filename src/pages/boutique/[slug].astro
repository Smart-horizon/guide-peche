---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Panier from '../../components/boutique/Panier.astro'
import { client, PRODUIT_PROJECTION } from '../../lib/sanity.js'
import imageUrlBuilder from '@sanity/image-url'

export async function getStaticPaths() {
  const produits = await client.fetch(`*[_type == "produit" && disponible == true]${PRODUIT_PROJECTION}`)
  return produits
    .filter(p => p.slug?.current)
    .map(p => ({ params: { slug: p.slug.current }, props: { produit: p } }))
}

// Site public : produit fourni par getStaticPaths (pages figées au build).
// Aperçu Sanity : worker en SSR intégral → getStaticPaths ignoré, on
// récupère le produit (brouillon compris) au moment de la requête.
let { produit } = Astro.props
if (!produit) {
  produit = await client.fetch(
    `*[_type == "produit" && slug.current == $slug][0]${PRODUIT_PROJECTION}`,
    { slug: Astro.params.slug }
  )
  if (!produit) return Astro.redirect('/boutique')
}

// Bandeau : photo configurable par JBV (Studio → Boutique → ⚙️ Réglages)
const reglages = await client.fetch(`*[_id == "parametresBoutique"][0]{ heroImage }`)
const heroImg = reglages?.heroImage?.asset ? reglages.heroImage : null
const heroPos = heroImg?.hotspot
  ? `${Math.round(heroImg.hotspot.x * 100)}% ${Math.round(heroImg.hotspot.y * 100)}%`
  : 'center'
const heroStyle = heroImg
  ? `background-image: linear-gradient(to top, rgba(7,24,31,0.85) 0%, rgba(13,43,62,0.55) 100%), url(${builderHero(heroImg)}); background-size: cover; background-position: ${heroPos}; background-repeat: no-repeat;`
  : ''
function builderHero(img) {
  return imageUrlBuilder(client).image(img).width(1600).auto('format').url()
}

const prestationsAssociees = (produit.prestations || []).filter(p => p?.slug)
const articlesAssocies    = (produit.articles || []).filter(a => a?.slug)

const builder = imageUrlBuilder(client)
const urlFor = (source) => builder.image(source)

const categorieLabel = {
  mouche: 'Mouche', coffret: 'Coffret de mouches', goodies: 'Goodies',
  materiel: 'Matériel', autre: 'Boutique',
}
const badgeLabel = { nouveaute: 'Nouveauté', vente: 'Meilleure vente', 'coup-coeur': 'Coup de cœur' }
const fmtPrix = (n) => n != null ? `${n.toFixed(2).replace('.', ',')} €` : ''

// Quantité minimum de commande (ex : mouches vendues par 3)
const quantiteMin = Math.max(1, Math.floor(produit.quantiteMin ?? 1))

// ── Galerie : URLs des photos principales + par variante ──────────────────
const photosDefaut = (produit.images || [])
  .filter(img => img?.asset)
  .map(img => ({
    grande: urlFor(img).width(900).height(900).fit('crop').crop('focalpoint').url(),
    mini:   urlFor(img).width(160).height(160).fit('crop').crop('focalpoint').url(),
  }))

const variantes = (produit.variantes || []).map(v => ({
  nom:   v.nom,
  prix:  v.prix ?? produit.prix,
  stock: v.stock ?? null,
  photos: (v.photos || [])
    .filter(img => img?.asset)
    .map(img => ({
      grande: urlFor(img).width(900).height(900).fit('crop').crop('focalpoint').url(),
      mini:   urlFor(img).width(160).height(160).fit('crop').crop('focalpoint').url(),
    })),
}))

const epuiseGlobal = variantes.length
  ? variantes.every(v => v.stock === 0)
  : produit.stock === 0

// ── Vidéo YouTube : extraction de l'identifiant ───────────────────────────
function youtubeId(url) {
  if (!url) return null
  const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/)
  return m ? m[1] : null
}
const videoId = youtubeId(produit.videoYoutube)

// ── Données produit passées au script panier ──────────────────────────────
const produitMeta = {
  id:          produit._id,
  slug:        produit.slug.current,
  titre:       produit.title,
  prix:        produit.prix,
  stock:       produit.stock ?? null,
  poids:       produit.poids ?? null,
  quantiteMin,
  imageMini:   photosDefaut[0]?.mini || null,
}

const metaTitle = produit.seoTitle || `${produit.title} — Boutique Jean-Baptiste Vidal`
const metaDesc  = produit.seoDescription || `${produit.title} — mouches et goodies de Jean-Baptiste Vidal, guide de pêche à la mouche en Bretagne.`
---

<BaseLayout title={metaTitle} description={metaDesc} lang="fr">

  <!-- Bandeau — même recette que les autres pages du site, photo éditable -->
  <section class="page-hero">
    <div class="page-hero-bg" style={heroStyle}></div>
    <div class="container page-hero-content">
      <nav class="fil-ariane">
        <a href="/boutique">← Retour à la boutique</a>
      </nav>
      <p class="eyebrow">
        {categorieLabel[produit.categorie] ?? 'Boutique'}
        {(produit.badges ?? []).map(b => badgeLabel[b] && <span class="hero-badge">{badgeLabel[b]}</span>)}
      </p>
      <h1>{produit.title}</h1>
    </div>
  </section>

  <div class="produit-page container">

    <div class="produit-haut">

      <!-- Galerie -->
      <div class="galerie">
        <div class="galerie-grande" id="galerie-grande">
          {photosDefaut.length > 0 ? (
            <img src={photosDefaut[0].grande} alt={produit.title} id="galerie-img" />
          ) : (
            <div class="galerie-placeholder" id="galerie-placeholder">
              <img src="/images/logo.svg" alt="" />
              <span>Photo à venir</span>
            </div>
          )}
        </div>
        <div class="galerie-minis" id="galerie-minis">
          {photosDefaut.map((ph, i) => (
            <button class:list={['galerie-mini', { 'galerie-mini--active': i === 0 }]} data-grande={ph.grande}>
              <img src={ph.mini} alt="" loading="lazy" />
            </button>
          ))}
        </div>
      </div>

      <!-- Infos -->
      <div class="infos">
        <p class="prix" id="prix">{fmtPrix(variantes.length ? variantes[0].prix : produit.prix)}</p>

        {variantes.length > 0 && (
          <div class="champ-variante">
            <label for="select-variante">Choisissez une option</label>
            <select id="select-variante">
              {variantes.map((v, i) => (
                <option value={i} disabled={v.stock === 0}>
                  {v.nom}{v.stock === 0 ? ' — épuisé' : ''}
                </option>
              ))}
            </select>
          </div>
        )}

        {quantiteMin > 1 && (
          <p class="qte-min-note">Vendu par {quantiteMin} minimum</p>
        )}

        <p class="stock-note" id="stock-note"></p>

        <div class="achat">
          {epuiseGlobal ? (
            <button class="btn-achat" disabled>Épuisé</button>
          ) : (
            <>
              <div class="qte">
                <button type="button" id="qte-moins" aria-label="Réduire la quantité">−</button>
                <span id="qte-valeur">{quantiteMin}</span>
                <button type="button" id="qte-plus" aria-label="Augmenter la quantité">+</button>
              </div>
              <button class="btn-achat" id="btn-ajouter">Ajouter au panier</button>
            </>
          )}
          <a href="/contact" class="btn-contact">Commander par message</a>
        </div>

        {(prestationsAssociees.length > 0 || articlesAssocies.length > 0) && (
          <div class="aller-plus-loin">
            {prestationsAssociees.length > 0 && (
              <div class="apl-groupe">
                <p class="apl-titre">🎣 Pêchez-la avec Jean-Baptiste</p>
                {prestationsAssociees.map(pr => (
                  <a href={`/${pr.slug}`} class="apl-lien">{pr.title} →</a>
                ))}
              </div>
            )}
            {articlesAssocies.length > 0 && (
              <div class="apl-groupe">
                <p class="apl-titre">📖 À lire sur le blog</p>
                {articlesAssocies.map(a => (
                  <a href={`/blog/${a.slug}`} class="apl-lien">{a.title} →</a>
                ))}
              </div>
            )}
          </div>
        )}

        <!-- Description — sous les boutons, à droite de la photo -->
        {produit.description?.length > 0 && (
          <div class="description">
        {(() => {
          // Regroupe les blocs consécutifs en liste à puces dans un même <ul>
          const rendus = []
          let puces = []
          const videListe = () => {
            if (puces.length) { rendus.push({ type: 'ul', items: puces }); puces = [] }
          }
          for (const block of produit.description) {
            if (block._type !== 'block') continue
            const texte = (block.children || []).map(c => c.text || '').join('')
            if (!texte.trim()) continue
            if (block.listItem === 'bullet') { puces.push(texte); continue }
            videListe()
            rendus.push({ type: block.style || 'normal', texte })
          }
          videListe()
          return rendus.map(r => {
            if (r.type === 'ul') return <ul>{r.items.map(item => <li>{item}</li>)}</ul>
            if (r.type === 'h2') return <h2>{r.texte}</h2>
            if (r.type === 'h3') return <h3>{r.texte}</h3>
            if (r.type === 'blockquote') return <blockquote>{r.texte}</blockquote>
            return <p>{r.texte}</p>
          })
            })()}
          </div>
        )}
      </div>
    </div>

    <!-- Vidéo -->
    {videoId && (
      <div class="produit-video">
        <h2>La vidéo de montage</h2>
        <div class="video-cadre">
          <iframe
            src={`https://www.youtube.com/embed/${videoId}`}
            title={`Vidéo — ${produit.title}`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        </div>
      </div>
    )}

  </div>

  <Panier />
</BaseLayout>

<script is:inline define:vars={{ variantes, photosDefaut, produitMeta }}>
  const selectEl   = document.getElementById('select-variante')
  const prixEl     = document.getElementById('prix')
  const stockEl    = document.getElementById('stock-note')
  const minisEl    = document.getElementById('galerie-minis')
  const grandeEl   = document.getElementById('galerie-grande')

  const fmt = (n) => n != null ? n.toFixed(2).replace('.', ',') + ' €' : ''

  function majGalerie(photos) {
    const liste = photos.length ? photos : photosDefaut
    if (!liste.length) return
    grandeEl.innerHTML = '<img src="' + liste[0].grande + '" alt="" id="galerie-img" />'
    minisEl.innerHTML = liste.map((ph, i) =>
      '<button class="galerie-mini' + (i === 0 ? ' galerie-mini--active' : '') + '" data-grande="' + ph.grande + '">' +
      '<img src="' + ph.mini + '" alt="" loading="lazy" /></button>'
    ).join('')
    brancherMinis()
  }

  function brancherMinis() {
    document.querySelectorAll('.galerie-mini').forEach(btn => {
      btn.addEventListener('click', () => {
        const img = document.getElementById('galerie-img')
        if (img) img.src = btn.dataset.grande
        document.querySelectorAll('.galerie-mini').forEach(b => b.classList.toggle('galerie-mini--active', b === btn))
      })
    })
  }
  brancherMinis()

  function majVariante() {
    if (!selectEl) return
    const v = variantes[Number(selectEl.value)]
    if (!v) return
    if (prixEl) prixEl.textContent = fmt(v.prix)
    if (stockEl) {
      stockEl.textContent =
        v.stock === 0 ? 'Épuisé dans cette option' :
        v.stock != null && v.stock <= 5 ? 'Plus que ' + v.stock + ' en stock' : ''
    }
    majGalerie(v.photos || [])
  }

  if (selectEl) {
    // Présélectionne la première option disponible
    const dispo = variantes.findIndex(v => v.stock !== 0)
    if (dispo > 0) selectEl.value = String(dispo)
    selectEl.addEventListener('change', majVariante)
    majVariante()
  }

  // ── Quantité + ajout au panier ────────────────────────────────────────────
  const btnAjouter = document.getElementById('btn-ajouter')
  const qteValeur  = document.getElementById('qte-valeur')
  const qteMin     = produitMeta.quantiteMin || 1
  let qte = qteMin

  function varianteCourante() {
    if (!selectEl) return null
    return variantes[Number(selectEl.value)] || null
  }
  function stockMax() {
    const v = varianteCourante()
    const s = v ? v.stock : produitMeta.stock
    return s == null ? 99 : s
  }
  function majQte(delta) {
    // Le pas suit la quantité minimum : par 3 si vendu par 3
    qte = Math.min(Math.max(qteMin, qte + delta * qteMin), Math.max(qteMin, stockMax()))
    if (qteValeur) qteValeur.textContent = String(qte)
  }

  document.getElementById('qte-moins')?.addEventListener('click', () => majQte(-1))
  document.getElementById('qte-plus')?.addEventListener('click', () => majQte(1))
  selectEl?.addEventListener('change', () => { qte = qteMin; majQte(0); majBtnAjouter() })

  function majBtnAjouter() {
    if (!btnAjouter) return
    const v = varianteCourante()
    const epuise = (v ? v.stock : produitMeta.stock) === 0
    btnAjouter.disabled = epuise
    btnAjouter.textContent = epuise ? 'Épuisé' : 'Ajouter au panier'
  }
  majBtnAjouter()

  btnAjouter?.addEventListener('click', () => {
    const v = varianteCourante()
    if ((v ? v.stock : produitMeta.stock) === 0) return
    window.panierAjouter({
      produitId: produitMeta.id,
      slug:      produitMeta.slug,
      titre:     produitMeta.titre,
      variante:  v ? v.nom : null,
      prix:      v ? v.prix : produitMeta.prix,
      poids:     produitMeta.poids,
      image:     (v && v.photos && v.photos[0] && v.photos[0].mini) || produitMeta.imageMini,
      stockMax:  (v ? v.stock : produitMeta.stock) ?? null,
      qtyMin:    qteMin,
      qty:       qte,
    })
    qte = qteMin
    majQte(0)
  })
</script>

<style>
  /* Bandeau — même recette que le blog et la boutique */
  .page-hero {
    position: relative;
    min-height: 32vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 2.5rem;
    color: white;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(7,24,31,0.85) 0%, rgba(13,43,62,0.55) 100%),
      url('/images/hero.jpg') center / cover no-repeat;
    background-color: var(--color-ocean);
  }
  .page-hero-content {
    position: relative;
    z-index: 1;
    padding-top: var(--header-height);
  }
  .page-hero h1 {
    color: white;
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    margin: 0.4rem 0 0;
  }

  .fil-ariane {
    margin-bottom: 1rem;
  }
  .fil-ariane a {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    font-weight: 500;
    transition: color 0.2s;
  }
  .fil-ariane a:hover { color: white; }

  .produit-page {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .produit-haut {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
    margin-bottom: 3.5rem;
  }

  /* Galerie */
  .galerie-grande {
    aspect-ratio: 1;
    border-radius: 3px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-ocean) 0%, var(--color-ocean-main) 100%);
  }
  .galerie-grande img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .galerie-placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .galerie-placeholder img {
    width: 50%;
    height: auto;
    opacity: 0.85;
  }
  .galerie-placeholder span {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
  }
  .galerie-minis {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }
  :global(.galerie-mini) {
    width: 68px;
    height: 68px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 3px;
    overflow: hidden;
    cursor: pointer;
    background: none;
    opacity: 0.75;
    transition: opacity 0.15s, border-color 0.15s;
  }
  :global(.galerie-mini img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.galerie-mini--active), :global(.galerie-mini:hover) {
    opacity: 1;
    border-color: var(--color-ocean-main);
  }

  .eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    font-weight: 500;
  }

  /* Infos */
  .prix {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-ocean-main);
    margin-bottom: 1.5rem;
  }

  .champ-variante {
    margin-bottom: 1rem;
  }
  .champ-variante label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
    font-weight: 500;
  }
  .champ-variante select {
    width: 100%;
    max-width: 340px;
    padding: 0.65rem 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    border: 1.5px solid #d5d9e0;
    border-radius: 3px;
    background: white;
    color: var(--color-text);
    cursor: pointer;
  }
  .champ-variante select:focus {
    outline: none;
    border-color: var(--color-ocean-main);
  }

  .qte-min-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .stock-note {
    min-height: 1.3rem;
    font-size: 0.8rem;
    color: #b4552d;
    margin-bottom: 1rem;
  }
  .hero-badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.15rem 0.5rem;
    background: rgba(126,200,227,0.18);
    border: 1px solid var(--color-ocean-light);
    border-radius: 2px;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--color-ocean-light);
  }

  .achat {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: stretch;
    margin-bottom: 1.5rem;
  }
  .qte {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border: 1.5px solid #d5d9e0;
    border-radius: 3px;
    padding: 0 0.5rem;
  }
  .qte button {
    border: none;
    background: none;
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-text);
    padding: 0.4rem 0.35rem;
  }
  .qte button:hover { color: var(--color-ocean-main); }
  .qte span {
    min-width: 1.5rem;
    text-align: center;
    font-size: 0.95rem;
  }
  .btn-achat {
    padding: 0.85rem 1.75rem;
    background: var(--color-ocean-main);
    color: white;
    border: none;
    border-radius: 3px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-achat:hover:not(:disabled) { background: var(--color-ocean); }
  .btn-achat:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }
  .btn-contact {
    padding: 0.85rem 1.75rem;
    border: 1.5px solid var(--color-ocean-main);
    color: var(--color-ocean-main);
    border-radius: 3px;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.2s;
  }
  .btn-contact:hover {
    background: var(--color-ocean-main);
    color: white;
  }

  /* Pour aller plus loin — maillage prestations / blog */
  .aller-plus-loin {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem 1.15rem;
    background: var(--color-sand);
    border-radius: 3px;
  }
  .apl-titre {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 0.3rem;
  }
  .apl-lien {
    display: block;
    font-size: 0.9rem;
    color: var(--color-ocean-main);
    padding: 0.15rem 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .apl-lien:hover { color: var(--color-ocean); }

  /* Description — dans la colonne infos, sous les boutons */
  .description {
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid #e4e6ea;
  }
  .description p {
    margin-bottom: 1.1rem;
    color: var(--color-text);
    font-size: 0.95rem;
  }
  .description h2, .description h3 {
    margin: 1.75rem 0 0.9rem;
  }
  .description ul {
    margin: 0 0 1.1rem 1.25rem;
  }
  .description li {
    margin-bottom: 0.35rem;
  }

  /* Vidéo */
  .produit-video {
    max-width: 760px;
  }
  .produit-video h2 {
    margin-bottom: 1rem;
  }
  .video-cadre {
    position: relative;
    aspect-ratio: 16/9;
    border-radius: 3px;
    overflow: hidden;
    background: var(--color-ocean);
  }
  .video-cadre iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 860px) {
    .produit-haut {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
