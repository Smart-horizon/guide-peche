---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Panier from '../../components/boutique/Panier.astro'
import { client } from '../../lib/sanity.js'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(client)
const urlFor = (source) => builder.image(source)

// Bandeau + textes configurables par JBV (Studio → Boutique → ⚙️ Réglages)
const reglages = await client.fetch(`*[_id == "parametresBoutique"][0]{ heroImage, heroTitre, heroSousTitre }`)
const heroImg = reglages?.heroImage?.asset ? reglages.heroImage : null
const heroPos = heroImg?.hotspot
  ? `${Math.round(heroImg.hotspot.x * 100)}% ${Math.round(heroImg.hotspot.y * 100)}%`
  : 'center'
const heroStyle = heroImg
  ? `background-image: linear-gradient(to top, rgba(7,24,31,0.85) 0%, rgba(13,43,62,0.55) 100%), url(${urlFor(heroImg).width(1600).auto('format').url()}); background-size: cover; background-position: ${heroPos}; background-repeat: no-repeat;`
  : ''

const produits = await client.fetch(`
  *[_type == "produit" && disponible == true] | order(categorie asc, title asc) {
    title, slug, categorie, espece, prix, stock,
    "image": images[0],
    "variantes": variantes[]{ nom, prix, stock }
  }
`)

const categorieLabel = { mouche: 'Mouche', goodies: 'Goodies' }

// Prix affiché : le plus bas entre produit et variantes → "À partir de" si écarts
function prixInfo(p) {
  const prixVariantes = (p.variantes || []).map(v => v.prix).filter(x => x != null)
  if (!prixVariantes.length) return { prix: p.prix, aPartirDe: false }
  const tous = [...prixVariantes, ...(p.variantes.length > prixVariantes.length ? [p.prix] : [])]
  const min = Math.min(...tous)
  return { prix: min, aPartirDe: new Set(tous).size > 1 }
}

// Épuisé : stock produit à 0 sans variantes, ou toutes les variantes à 0
function estEpuise(p) {
  if (p.variantes?.length) return p.variantes.every(v => v.stock === 0)
  return p.stock === 0
}

const fmtPrix = (n) => n != null ? `${n.toFixed(2).replace('.', ',')} €` : ''

const hasMouches = produits.some(p => p.categorie === 'mouche')
const hasGoodies = produits.some(p => p.categorie === 'goodies')
---

<BaseLayout
  title="Boutique — Mouches et goodies de Jean-Baptiste Vidal"
  description="Mouches montées à la main par Jean-Baptiste Vidal, guide de pêche en Bretagne : streamers à bar, mouches truite, et goodies Enjoy Fishing."
  lang="fr"
>

  <section class="page-hero">
    <div class="page-hero-bg" style={heroStyle}></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Enjoy Fishing</p>
      <h1>{reglages?.heroTitre || 'La boutique'}</h1>
      <p class="hero-sub">{reglages?.heroSousTitre || 'Mouches montées à la main par Jean-Baptiste, et goodies Enjoy Fishing.'}</p>
    </div>
  </section>

  <section class="section boutique-section">
    <div class="container">

      {(hasMouches && hasGoodies) && (
        <nav class="filtres">
          <button class="filtre filtre--actif" data-cat="">Tous</button>
          <button class="filtre" data-cat="mouche">Mouches</button>
          <button class="filtre" data-cat="goodies">Goodies</button>
        </nav>
      )}

      {produits.length > 0 ? (
        <div class="produits-grid">
          {produits.map(p => {
            const { prix, aPartirDe } = prixInfo(p)
            const epuise = estEpuise(p)
            return (
              <a href={`/boutique/${p.slug?.current}`} class="produit-card" data-cat={p.categorie}>
                <div class="produit-img" style={p.image
                  ? `background-image: url(${urlFor(p.image).width(600).height(600).fit('crop').crop('focalpoint').url()})`
                  : ''}>
                  {!p.image && (
                    <div class="produit-img-placeholder">
                      <img src="/images/logo.svg" alt="" loading="lazy" />
                      <span>Photo à venir</span>
                    </div>
                  )}
                  {p.categorie && <span class="produit-badge">{categorieLabel[p.categorie] ?? p.categorie}</span>}
                  {epuise && <span class="produit-epuise">Épuisé</span>}
                </div>
                <div class="produit-body">
                  <h2 class="produit-title">{p.title}</h2>
                  <p class="produit-prix">
                    {aPartirDe && <span class="a-partir">À partir de </span>}{fmtPrix(prix)}
                  </p>
                  <span class="produit-voir">Voir le produit →</span>
                </div>
              </a>
            )
          })}
        </div>
      ) : (
        <div class="boutique-vide">
          <p>La boutique ouvre bientôt — les premières mouches arrivent.</p>
        </div>
      )}

    </div>
  </section>

  <Panier />
</BaseLayout>

<style>
  /* Hero — même recette que le blog */
  .page-hero {
    position: relative;
    min-height: 40vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 3rem;
    color: white;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(7,24,31,0.85) 0%, rgba(13,43,62,0.55) 100%),
      url('/images/hero.jpg') center / cover no-repeat;
    background-color: var(--color-ocean);
  }
  .page-hero-content {
    position: relative;
    z-index: 1;
    padding-top: var(--header-height);
  }
  .page-hero h1 { color: white; margin: 0.4rem 0 0.75rem; }
  .hero-sub { color: rgba(255,255,255,0.75); font-size: 1rem; }

  .eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    font-weight: 500;
  }

  /* Filtres */
  .filtres {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .filtre {
    padding: 0.4rem 1rem;
    border: 1.5px solid var(--color-ocean-main);
    border-radius: 2px;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ocean-main);
    background: none;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.2s;
  }
  .filtre:hover, .filtre--actif {
    background: var(--color-ocean-main);
    color: white;
  }

  /* Grille produits */
  .produits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .produit-card {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    border-radius: 3px;
    overflow: hidden;
    background: white;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .produit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }

  .produit-img {
    position: relative;
    aspect-ratio: 1;
    background: linear-gradient(160deg, var(--color-ocean) 0%, var(--color-ocean-main) 100%) center / cover no-repeat;
  }
  .produit-img-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }
  .produit-img-placeholder img {
    width: 55%;
    opacity: 0.85;
  }
  .produit-img-placeholder span {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
  }

  .produit-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--color-ocean-main);
    color: white;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.22rem 0.55rem;
    border-radius: 2px;
    font-weight: 500;
  }
  .produit-epuise {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(26,26,31,0.85);
    color: white;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.22rem 0.55rem;
    border-radius: 2px;
  }

  .produit-body {
    padding: 1.1rem 1.25rem 1.25rem;
  }
  .produit-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 0.35rem;
    color: var(--color-text);
  }
  .produit-prix {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ocean-main);
    margin-bottom: 0.75rem;
  }
  .a-partir {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .produit-voir {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-ocean-main);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .boutique-vide {
    text-align: center;
    padding: 5rem 0;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-style: italic;
  }

  @media (max-width: 1200px) { .produits-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px)  { .produits-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px)  { .produits-grid { grid-template-columns: 1fr; } }
</style>

<script>
  // Filtre par catégorie — côté client, sans rechargement
  document.querySelectorAll<HTMLElement>('.filtre').forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat || ''
      document.querySelectorAll('.filtre').forEach(f => f.classList.toggle('filtre--actif', f === btn))
      document.querySelectorAll<HTMLElement>('.produit-card').forEach(card => {
        card.style.display = !cat || card.dataset.cat === cat ? '' : 'none'
      })
    })
  })
</script>
