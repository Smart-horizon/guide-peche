/* ── CARROUSEL ── */
.pb-carr-outer { overflow:hidden; }
.carr3-wrap { position:relative;overflow:hidden;cursor:grab; }
.carr3-wrap:active { cursor:grabbing; }
.carr3-track { display:flex;align-items:stretch;gap:3px;transition:transform 0.55s cubic-bezier(0.4,0,0.2,1);will-change:transform; }
.carr3-slide { flex:0 0 calc((100% - 6px)/3);width:calc((100% - 6px)/3);overflow:hidden;position:relative; }
.carr3-slide img { width:100%;height:100%;object-fit:cover;object-position:center;display:block;user-select:none;-webkit-user-drag:none; }
.carr3-caption { position:absolute;bottom:0;left:0;right:0;padding:1.5rem 1rem 0.7rem;background:linear-gradient(to top,rgba(7,24,31,.75) 0%,transparent 100%);color:rgba(255,255,255,.85);font-size:0.68rem;letter-spacing:0.08em;text-transform:uppercase;pointer-events:none; }
.carr3-btn { position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;background:rgba(0,0,0,.45);border:1.5px solid rgba(255,255,255,.2);color:white;cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center;z-index:10;transition:background 0.2s,border-color 0.2s; }
.carr3-btn:hover { background:rgba(0,0,0,.7);border-color:rgba(255,255,255,.5); }
.carr3-btn--prev { left:1rem; }
.carr3-btn--next { right:1rem; }
.carr3-counter { position:absolute;bottom:0.85rem;right:1rem;font-size:0.7rem;letter-spacing:0.12em;color:rgba(255,255,255,.6);background:rgba(0,0,0,.35);padding:0.2rem 0.55rem;border-radius:2px;z-index:10; }

