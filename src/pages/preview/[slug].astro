  .pb-hero { min-height:60vh; }
  .sous-grid { grid-template-columns:1fr; }
  .wf-card--wide { grid-column:auto; }
  .carr3-slide { flex:0 0 100%;width:100%; }
  .pb-cta__inner { flex-direction:column;text-align:center; }
  .pb-cta__btns  { justify-content:center; }
}
</style>

<script>
document.querySelectorAll('[data-carr]').forEach(wrap => {
  const track   = wrap.querySelector('.carr3-track')
  const slides  = wrap.querySelectorAll('.carr3-slide')
  const counter = wrap.querySelector('.carr3-counter')
  if (!track || !slides.length) return
  const total = slides.length
  let current = 0, timer = null
  const DELAY = 4500
  function startAutoplay() { if (timer) return; timer = setInterval(() => go(current + 1), DELAY) }
  function stopAutoplay()  { if (timer) { clearInterval(timer); timer = null } }
  function restartAutoplay() { stopAutoplay(); setTimeout(startAutoplay, 6000) }
  function slideW() { return slides[0].offsetWidth }
  function visibleN() { return window.innerWidth <= 640 ? 1 : window.innerWidth <= 900 ? 2 : 3 }
  function calcOffset(idx) {
    const w = slideW(), g = 3, n = visibleN()
    const raw = n < 3 ? idx * (w + g) : (idx - 1) * (w + g)
    return Math.max(0, Math.min(Math.max(0, (total - n) * (w + g)), raw))
  }
  function go(idx) {
    current = (idx + total) % total
    track.style.transform = `translateX(-${calcOffset(current)}px)`
    if (counter) counter.textContent = `${current + 1} / ${total}`
  }
  window.addEventListener('resize', () => {
    track.style.transition = 'none'
    track.style.transform  = `translateX(-${calcOffset(current)}px)`
    requestAnimationFrame(() => { track.style.transition = '' })
  })
  wrap.querySelector('.carr3-btn--prev')?.addEventListener('click', () => { go(current - 1); restartAutoplay() })
  wrap.querySelector('.carr3-btn--next')?.addEventListener('click', () => { go(current + 1); restartAutoplay() })
  let startX = 0
  wrap.addEventListener('touchstart', e => { startX = e.changedTouches[0].clientX }, { passive: true })
  wrap.addEventListener('touchend',   e => {
    const dx = e.changedTouches[0].clientX - startX
    if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
  }, { passive: true })
  let dragX = 0, dragging = false
  wrap.addEventListener('mousedown',  e => { dragX = e.clientX; dragging = true })
  wrap.addEventListener('mouseup',    e => {
    if (!dragging) return; dragging = false
    const dx = e.clientX - dragX
    if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
  })
  wrap.addEventListener('mouseleave', () => { dragging = false })
  wrap.addEventListener('mouseenter', stopAutoplay)
  wrap.addEventListener('mouseleave', startAutoplay)
  startAutoplay()
})
</script>
