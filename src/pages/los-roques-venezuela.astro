---
import BaseLayout from '../layouts/BaseLayout.astro'
import { stegaClient } from '../lib/sanity.js'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(stegaClient)
const urlFor  = (source: any) => builder.image(source)

// ── Fetch du document ─────────────────────────────────────────────────────────
const doc = await stegaClient.fetch(`
  *[_type == "voyage" && slug.current == "los-roques-venezuela"][0]{
    _id, title, pays, especes, periode, prix,
    pagebuilder[]{
      ...,
      image{ asset->{ _id, url, metadata{ dimensions } } },
      btnFichier{ asset->{ _id, url } },
      photos[]{ asset->{ _id, url } },
      etapes[]{ ..., image{ asset->{ _id, url, metadata{ dimensions } } } },
      items[],
      colonnes[]{ ..., items[] },
      sejours[],
    },
    seoTitle, seoDescription, ogImage
  }
`)

// ── Helpers pour extraire les sections ────────────────────────────────────────
const pb = (doc?.pagebuilder || []) as any[]
const find  = (type: string) => pb.find((s: any) => s._type === type)
const finds = (type: string) => pb.filter((s: any) => s._type === type)
const findCartes = (eyebrowHint: string) =>
  pb.find((s: any) => s._type === 'sectionProgrammeCartes' && s.eyebrow?.includes(eyebrowHint))

const hero       = find('sectionHero')
const statsSec   = find('sectionStats')
const introSec   = find('sectionIntro')
const espSec     = findCartes('BONEFISH')
const saiSec     = findCartes('MÉTÉO')
const matSec     = findCartes('ÉQUIPEMENT')
const progSec    = find('sectionProgramme')
const galSec     = find('sectionGalerie')
const datesSec   = find('sectionDates')
const inclusSec  = find('sectionProgrammeTexte')
const ctaSec     = find('sectionCta')

// ── Images ────────────────────────────────────────────────────────────────────
const heroBg = hero?.image?.asset
  ? urlFor(hero.image).width(1600).height(900).url()
  : '/images/E16.avif'

const espImg = espSec?.image?.asset
  ? urlFor(espSec.image).width(680).height(520).fit('crop').url()
  : '/images/E6.avif'

const saiImg = saiSec?.image?.asset
  ? urlFor(saiSec.image).width(600).height(600).fit('crop').url()
  : '/images/E4.avif'

// ── Portable Text simple ──────────────────────────────────────────────────────
function blocks(content: any[]): string {
  if (!content?.length) return ''
  return content.map((b: any) => {
    if (b._type !== 'block') return ''
    const text = (b.children || []).map((s: any) => {
      let t = (s.text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      if (s.marks?.includes('strong')) t = `<strong>${t}</strong>`
      if (s.marks?.includes('em'))     t = `<em>${t}</em>`
      return t
    }).join('')
    return `<p>${text}</p>`
  }).join('')
}

// ── SEO ───────────────────────────────────────────────────────────────────────
const pageTitle = doc?.seoTitle || hero?.titre || "Voyage de pêche à Los Roques, Venezuela — Bonefish, Tarpon, Permit · Jean-Baptiste Vidal"
const pageDesc  = doc?.seoDescription || "Los Roques, Perle des Caraïbes — l'une des trois meilleures destinations mondiales pour la pêche du bonefish."
---

<BaseLayout title={`${pageTitle} — Jean-Baptiste Vidal`} description={pageDesc}>

  <!-- ═══ HERO ═══ -->
  <section class="voy-hero">
    <div class="voy-hero__bg" style={`background-image:url('${heroBg}')`}></div>
    <div class="voy-hero__overlay"></div>
    <div class="voy-hero__content container">
      <p class="voy-eyebrow">{hero?.eyebrow || 'Voyage · Venezuela · Los Roques'}</p>
      <h1>{hero?.titre || 'Los Roques'}<br/><span class="voy-hero__sub">{hero?.sousTitre || 'Perle des Caraïbes, Top 3 mondial bonefish'}</span></h1>
      <p class="voy-lead">{hero?.sousTitre || '221 000 hectares de Parc National, 360 îlots préservés, une dizaine d\'espèces au programme : je vous accompagne sur l\'archipel le plus sauvage des Caraïbes.'}</p>
      <div class="voy-hero__cta">
        <a href={hero?.btnReserverLien || '/contact'} class="btn-prim">{hero?.btnReserverTexte || 'Me contacter pour ce voyage'}</a>
        <a href="tel:0687303456" class="btn-ghost">06 87 30 34 56</a>
      </div>
    </div>
    <div class="voy-hero__scroll">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </section>

  <!-- ═══ CHIFFRES CLÉS ═══ -->
  <div class="voy-stats">
    {statsSec?.stats?.length ? statsSec.stats.map((st: any) => (
      <div class="voy-stats__item">
        <span class="voy-stats__num">{st.nombre}</span>
        <span class="voy-stats__label">{st.label}</span>
      </div>
    )) : (
      <>
        <div class="voy-stats__item"><span class="voy-stats__num">Top 3</span><span class="voy-stats__label">Mondial bonefish</span></div>
        <div class="voy-stats__item"><span class="voy-stats__num">12+</span><span class="voy-stats__label">Espèces à la mouche</span></div>
        <div class="voy-stats__item"><span class="voy-stats__num">9 jours</span><span class="voy-stats__label">6,5 jours de pêche guidée</span></div>
        <div class="voy-stats__item"><span class="voy-stats__num">360</span><span class="voy-stats__label">Îlots dans le Parc National</span></div>
      </>
    )}
  </div>

  <!-- ═══ INTRO ═══ -->
  <section class="section section--white">
    <div class="container voy-intro">
      <div class="voy-intro__text" set:html={introSec?.texte?.length
        ? blocks(introSec.texte)
        : `<p>Le Parc National de Los Roques est sans doute <strong>l'une des meilleures destinations multi-espèces pour la pêche à la mouche en mer exotique</strong>. Situé dans la mer des Caraïbes, à 170 km au nord des côtes du Venezuela, la diversité des coins de pêche (îlots, plages, flats et lagunes) permet de traquer toutes les espèces les plus intéressantes pour le moucheur en mer chaude.</p>
         <p>221 000 hectares interdisant toute pêche intensive et commerciale… 360 îlots de mangrove, bancs de sable blanc et flats cernés par une gigantesque barrière corallienne… Vous êtes à Los Roques, <strong>considérée comme une des trois meilleures destinations mondiales pour la traque du bonefish</strong>.</p>
         <p>En <strong>Janvier/Février 2026</strong>, j'organise deux séjours accompagnés sur l'archipel, en partenariat avec l'agence <a href="https://www.agence-dhdlaika.com/" target="_blank" rel="noopener noreferrer" class="voy-link-partner"><strong>DHD LAIKA</strong></a> et un guide local qui connaît tous les plus beaux coins de l'archipel.</p>`
      } />
      <aside class="voy-intro__card">
        {introSec ? (
          <>
            {introSec.saison && <><p class="card-label">Saison</p><p class="card-val">{introSec.saison}</p></>}
            {introSec.tarif  && <><p class="card-label">Tarifs</p><p class="card-val">{introSec.tarif}</p></>}
            {introSec.duree  && <><p class="card-label">Format</p><p class="card-val">{introSec.duree}</p></>}
            {introSec.lignesSupp?.map((l: any) => l.label && (
              <><p class="card-label">{l.label}</p><p class="card-val">{l.valeur}</p></>
            ))}
            {introSec.boutons?.map((btn: any) => (
              <a href={btn.lien} class="card-cta">{btn.texte}</a>
            ))}
          </>
        ) : (
          <>
            <p class="card-label">Espèces cibles</p>
            <p class="card-val">Bonefish · Tarpon · Permit · Carangues · Barracuda · Snook · +</p>
            <p class="card-label">Saison</p><p class="card-val">Toute l'année</p>
            <p class="card-label">Format</p><p class="card-val">9 jours / 6,5 jours de pêche</p>
            <p class="card-label">Hébergement</p><p class="card-val">Posadas de Gran Roque ★★★★</p>
            <p class="card-label">Encadrement</p><p class="card-val">JBV + guide local (1 guide/2 pêcheurs)</p>
            <p class="card-label">Partenaire</p><p class="card-val"><a href="https://www.agence-dhdlaika.com/" target="_blank" rel="noopener noreferrer" class="voy-link-partner">DHD LAIKA</a></p>
            <p class="card-label">Prochains départs</p><p class="card-val">Janv–Fév 2026</p>
            <p class="card-label">Tarifs</p><p class="card-val">Sur demande</p>
            <a href="/contact" class="card-cta">Demander un devis</a>
          </>
        )}
      </aside>
    </div>
  </section>

  <!-- ═══ HÉBERGEMENT ═══ -->
  <section class="section section--sand">
    <div class="container voy-lodge-solo">
      <div class="voy-lodge-solo__img">
        <img src="/images/E1.avif" alt="Posada de Gran Roque — Los Roques Venezuela" loading="lazy" />
      </div>
      <div class="voy-lodge-solo__text">
        <p class="eyebrow">Gran Roque</p>
        <h2>Les Posadas de Gran Roque</h2>
        <p>Loin du tourisme de masse, des hôtels de luxe et des plages bétonnées. Gran Roque est un charmant petit village de pêcheurs où règne une grande tranquillité. Nous travaillons avec <strong>plusieurs posadas de très bon standing</strong>, souvent tenues par des Italiens très accueillants.</p>
        <p>La restauration, à base de produits de la mer et de <em>pasta</em>, est vraiment excellente. Pension complète avec hébergement, petit-déjeuner, déjeuner et dîner inclus. La qualité et l'authenticité ont été privilégiées.</p>
        <p>Gran Roque accueille chaque année des visiteurs du monde entier pour ses belles plages, mais aussi pour le kite-surf, la plongée, et surtout la pêche.</p>
      </div>
    </div>
  </section>

  <!-- ═══ L'ARCHIPEL ═══ -->
  <section class="section section--white">
    <div class="container voy-beats-grid voy-beats-grid--reverse">
      <div class="voy-beats-imgs">
        <img src="/images/E2.avif" alt="Los Roques — plage de sable blanc" loading="lazy" class="voy-beats-img voy-beats-img--top" />
        <img src="/images/E3.avif" alt="Los Roques — îlot et lagon" loading="lazy" class="voy-beats-img voy-beats-img--bot" />
      </div>
      <div class="voy-beats-text">
        <p class="eyebrow">L'Archipel</p>
        <h2>Un décor de carte postale, des poissons partout</h2>
        <p>Imaginez un décor paradisiaque où les camaïeux de bleu et de vert se perdent à l'infini… Des bancs de sable blanc immaculés, des lagunes d'eau cristalline et des flats peu profonds à perte de vue.</p>
        <p>Chaque jour, nous partons en bateau vers un îlot différent de l'archipel. Selon les conditions, nous pêcherons <strong>à pied sur les flats</strong> en recherchant le bonefish en tailing, ou <strong>depuis le bateau</strong> pour traquer tarpon, permit et carangues en eau plus profonde.</p>
        <p>La particularité de Los Roques : les bonefish chassent souvent dans les bancs d'alevins. Nous les recherchons avec de petits clousers minnow ou gummy, et quand les conditions s'y prêtent, le Grand Slam est possible dans la même journée.</p>
      </div>
    </div>
  </section>

  <!-- ═══ LA SAISON ═══ -->
  <section class="section section--ocean">
    <div class="container voy-saison-grid">
      <div class="voy-saison-img">
        <img src={saiImg} alt="Los Roques — saison de pêche" loading="lazy" />
      </div>
      <div class="voy-saison-text">
        <p class="eyebrow-light">{saiSec?.eyebrow || 'Météo & Conditions'}</p>
        <h2 class="light">{saiSec?.titre || 'Pêchable toute l\'année'}</h2>
        <p>{saiSec?.intro || 'Il est possible de pêcher à Los Roques toute l\'année grâce à sa situation géographique, proche de l\'équateur. Les cyclones y sont rares, les alizés fréquents.'}</p>
        <div class="voy-saison-cards">
          {saiSec?.items?.length ? saiSec.items.map((item: any) => (
            <div class="voy-saison-card">
              <h3>{item.titre}</h3>
              <p>{item.description}</p>
            </div>
          )) : (
            <>
              <div class="voy-saison-card">
                <h3>Novembre → Avril</h3>
                <p>Marées hautes avec peu de marnage. Idéal pour les espèces pélagiques : <strong>tarpons, permits, carangues</strong>. Bonefish présents et actifs, moins souvent en tailing visible.</p>
              </div>
              <div class="voy-saison-card">
                <h3>Mai → Octobre</h3>
                <p>Marées basses, de nombreuses situations de pêche du <strong>bonefish en tailing</strong> dans très peu d'eau. Les autres espèces restent présentes et recherchables dans la même journée.</p>
              </div>
            </>
          )}
        </div>
        {saiSec?.note && <p class="voy-saison-note">{saiSec.note}</p>}
        {!saiSec?.note && <p class="voy-saison-note">Nos séjours accompagnés sont planifiés <strong>Janvier/Février 2026</strong>, conditions optimales pour une session multi-espèces avec de belles chances sur le tarpon.</p>}
      </div>
    </div>
  </section>

  <!-- ═══ LES GUIDES ═══ -->
  <section class="section section--sand">
    <div class="container voy-guide-layout">
      <div class="voy-guide-photo">
        <img src="/images/E5.avif" alt="Guide local Los Roques — expert bonefish" loading="lazy" />
      </div>
      <div class="voy-guide-text">
        <p class="eyebrow">Encadrement</p>
        <h2>Jean-Baptiste Vidal + guide local d'exception</h2>
        <p>Nous avons choisi de vous emmener sur les <strong>meilleurs spots de l'archipel</strong> en compagnie de l'un des meilleurs guides du secteur. Il parle bien l'anglais et se fait toujours une joie de vous faire prendre de nouvelles espèces.</p>
        <p>Je prendrai en charge la <strong>partie pêche des flats</strong>, déposés chaque jour sur une des îles avoisinantes pour rechercher surtout le bonefish, mais aussi carangues et d'autres espèces. Étant trilingue, je m'occupe également de toute la <strong>logistique et organisation sur place</strong>.</p>
        <p>Formule <strong>1 guide pour 2 pêcheurs</strong>, ou single skiff sur demande.</p>
      </div>
    </div>
  </section>

  <!-- ═══ LES POISSONS ═══ -->
  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow-light">{espSec?.eyebrow || 'Bonefish · Tarpon · Permit · Carangues · +'}</p>
      <h2 class="light">{espSec?.titre || 'Une destination multi-espèces unique'}</h2>
      <div class="voy-fish-intro">
        <img src={espImg} alt="Pêche à la mouche Los Roques — capture" loading="lazy" class="voy-fish-hero-img" />
        <p>{espSec?.intro || 'En plus de la bonne densité de gros bonefish, vous pourrez capturer à la mouche une douzaine d\'espèces de poissons, dont bien entendu le tarpon et le permit. Notre guide est également spécialisé dans la recherche des poissons perroquets et balistes (trigger fish).'}</p>
      </div>
      <div class="voy-fish-trio">
        {espSec?.items?.length ? espSec.items.map((item: any) => (
          <div class="voy-fish-species">
            <h3>{item.titre}</h3>
            {item.sousTitre && <p class="voy-fish-tag">{item.sousTitre}</p>}
            <p>{item.description}</p>
          </div>
        )) : (
          <>
            <div class="voy-fish-species">
              <h3>Le Bonefish</h3><p class="voy-fish-tag">Espèce star · Top 3 mondial</p>
              <p>Des bonefish actifs en tailing sur les flats peu profonds, la spécialité de Los Roques. De très bons gabarits, souvent chassant dans les bancs d'alevins. Petits clousers minnow et gummy sont les mouches de référence.</p>
            </div>
            <div class="voy-fish-species">
              <h3>Tarpon · Permit</h3><p class="voy-fish-tag">Grand Slam possible</p>
              <p>Les canaux plus profonds tiennent du tarpon toute l'année. Le permit est présent sur les flats et dans les passes. Le Grand Slam (bonefish, tarpon, permit dans la même journée) est un objectif réaliste à Los Roques.</p>
            </div>
            <div class="voy-fish-species">
              <h3>Les Bonus</h3><p class="voy-fish-tag">Carangues · Barracuda · Snook · +</p>
              <p>Carangues à œil de cheval, hippos, pompano, maquereaux espagnols, bonites, snook, barracuda, red snapper, poissons perroquets, balistes : Los Roques offre un tableau de pêche exceptionnel.</p>
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- ═══ LE MATÉRIEL ═══ -->
  <section class="section section--white">
    <div class="container">
      <p class="eyebrow">{matSec?.eyebrow || 'Équipement'}</p>
      <h2>{matSec?.titre || 'Le matériel recommandé'}</h2>
      <p class="section-intro">{matSec?.intro || 'L\'idéal est de prévoir trois cannes pour couvrir toutes les situations. Une fiche matériel détaillée est disponible en téléchargement.'}</p>
      <div class="voy-materiel-grid">
        {matSec?.items?.length ? matSec.items.map((item: any) => (
          <div class="voy-materiel-card">
            <div class="voy-materiel-num">{item.titre}</div>
            {item.sousTitre && <h3>{item.sousTitre}</h3>}
            {item.description && <p>{item.description}</p>}
          </div>
        )) : (
          <>
            <div class="voy-materiel-card"><div class="voy-materiel-num">#8</div><h3>Bonefish</h3><p>Soie de <strong>8</strong> (voire 9 si vent fort) pour la pêche à vue du bonefish sur les flats peu profonds.</p></div>
            <div class="voy-materiel-card"><div class="voy-materiel-num">#9/10</div><h3>Permit & Carangues</h3><p>Canne <strong>9/10</strong> pour le permit et les carangues. Équipez un ensemble avec un popper pour les gros barracudas.</p></div>
            <div class="voy-materiel-card"><div class="voy-materiel-num">#10/11</div><h3>Tarpon</h3><p>Canne <strong>10/11</strong> indispensable pour le tarpon. Moulinets robustes avec bon frein, 150m+ de backing 30 lb.</p></div>
            <div class="voy-materiel-card"><div class="voy-materiel-num">Bas de ligne</div><h3>Fluorocarbone</h3><p><strong>12-20</strong> pour bonefish · <strong>20-25</strong> pour permit · <strong>40-80+</strong> pour tarpon et autres espèces.</p></div>
          </>
        )}
      </div>
      {(matSec?.btnTexte && (matSec?.btnFichier?.asset?.url || matSec?.btnLien)) && (
        <div class="voy-materiel-download">
          <a href={matSec.btnFichier?.asset?.url || matSec.btnLien} class="btn-download" download={!!matSec.btnFichier?.asset?.url}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            {matSec.btnTexte}
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ LE DÉROULEMENT ═══ -->
  <section class="section section--sand">
    <div class="container">
      <p class="eyebrow">{progSec?.eyebrow || 'Programme'}</p>
      <h2>{progSec?.titre || '9 jours sur place, 6,5 jours de pêche'}</h2>
      <div class="voy-programme">
        {progSec?.etapes?.length ? progSec.etapes.map((etape: any, i: number) => (
          <div class="voy-prog-item">
            <span class="voy-prog-day">{etape.tag || `J${i+1}`}</span>
            <div><strong>{etape.titre}</strong>{etape.texte?.[0]?.children?.[0]?.text ? ` : ${etape.texte[0].children[0].text}` : ''}</div>
          </div>
        )) : (
          <>
            <div class="voy-prog-item"><span class="voy-prog-day">J1</span><div><strong>Départ de Paris</strong> : vol vers Caracas, arrivée en soirée. Transfert à l'hôtel près de l'aéroport.</div></div>
            <div class="voy-prog-item"><span class="voy-prog-day">J2</span><div><strong>Vol vers Los Roques</strong> : 40 minutes depuis Caracas. Accueil, installation à la posada. Journée libre avec possibilité de pêche à proximité. Révision du matériel et perfectionnement du lancer avec JBV.</div></div>
            <div class="voy-prog-item"><span class="voy-prog-day">J3–8</span><div><strong>6 jours de pêche guidée</strong> : à pied sur les flats ou en bateau selon les conditions et les espèces ciblées. Chaque jour sur un îlot ou une zone différente de l'archipel.</div></div>
            <div class="voy-prog-item"><span class="voy-prog-day">J9</span><div><strong>Transfert à l'aéroport</strong> : départ en fin d'après-midi. Arrivée en France le lendemain matin.</div></div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- ═══ GALERIE ═══ -->
  <section class="gallery-section">
    <div class="voy-carousel" id="main-carousel">
      <div class="voy-carousel__track" id="main-track">
        {galSec?.photos?.length ? galSec.photos.map((p: any, i: number) => (
          <div class="voy-carousel__slide">
            <img src={urlFor(p).width(900).height(600).fit('crop').url()} alt={p.alt || `Los Roques ${i+1}`} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
        )) : Array.from({length: 25}, (_, i) => i + 7).map((n, i) => (
          <div class="voy-carousel__slide">
            <img src={`/images/E${n}.avif`} alt={`Los Roques Venezuela — photo ${n}`} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
      <button class="voy-carousel__btn voy-carousel__btn--prev" id="main-prev" aria-label="Photo précédente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="voy-carousel__btn voy-carousel__btn--next" id="main-next" aria-label="Photo suivante">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <div class="voy-carousel__counter" id="main-counter">1 / {galSec?.photos?.length || 25}</div>
    </div>
  </section>

  <!-- ═══ DATES 2026 ═══ -->
  <section class="section section--white">
    <div class="container voy-dates">
      <p class="eyebrow">{datesSec?.eyebrow || 'Hosted Trip · 2026'}</p>
      <h2>{datesSec?.titre || 'Deux séjours disponibles'}</h2>
      <p class="section-intro">{datesSec?.intro || 'J\'organise deux semaines accompagnées pour début 2026, deux groupes de 4 pêcheurs maximum.'}</p>
      <div class="voy-dates-grid">
        {datesSec?.sejours?.length ? datesSec.sejours.map((sej: any, i: number) => (
          <div class="voy-date-card">
            <span class="voy-date-badge">Semaine {i + 1}</span>
            <h3>{sej.dates}</h3>
