---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Voyage de pêche à Los Roques, Venezuela — Bonefish, Tarpon, Permit · Jean-Baptiste Vidal"
  description="Los Roques, Perle des Caraïbes — l'une des trois meilleures destinations mondiales pour la pêche du bonefish. Jean-Baptiste Vidal vous accompagne sur ce Parc National exceptionnel."
>

  <!-- ═══ HERO ═══ -->
  <section class="voy-hero">
    <div class="voy-hero__bg" style="background-image: url('/images/E16.avif')"></div>
    <div class="voy-hero__overlay"></div>
    <div class="voy-hero__content container">
      <p class="voy-eyebrow">Voyage · Venezuela · Los Roques</p>
      <h1>Los Roques<br/><span class="voy-hero__sub">Perle des Caraïbes — Top 3 mondial bonefish</span></h1>
      <p class="voy-lead">221 000 hectares de Parc National, 360 îlots préservés, une dizaine d'espèces au programme — je vous accompagne sur l'archipel le plus sauvage des Caraïbes.</p>
      <div class="voy-hero__cta">
        <a href="/contact" class="btn-prim">Me contacter pour ce voyage</a>
        <a href="tel:0687303456" class="btn-ghost">06 87 30 34 56</a>
      </div>
    </div>
    <div class="voy-hero__scroll">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </section>

  <!-- ═══ CHIFFRES CLÉS ═══ -->
  <div class="voy-stats">
    <div class="voy-stats__item">
      <span class="voy-stats__num">Top 3</span>
      <span class="voy-stats__label">Mondial bonefish</span>
    </div>
    <div class="voy-stats__item">
      <span class="voy-stats__num">12+</span>
      <span class="voy-stats__label">Espèces à la mouche</span>
    </div>
    <div class="voy-stats__item">
      <span class="voy-stats__num">9 jours</span>
      <span class="voy-stats__label">6,5 jours de pêche guidée</span>
    </div>
    <div class="voy-stats__item">
      <span class="voy-stats__num">360</span>
      <span class="voy-stats__label">Îlots dans le Parc National</span>
    </div>
  </div>

  <!-- ═══ INTRO ═══ -->
  <section class="section section--white">
    <div class="container voy-intro">
      <div class="voy-intro__text">
        <p class="eyebrow">Los Roques · Parc National · Venezuela</p>
        <h2>L'archipel le plus sauvage des Caraïbes</h2>
        <p>Le Parc National de Los Roques est sans doute <strong>l'une des meilleures destinations multi-espèces pour la pêche à la mouche en mer exotique</strong>. Situé dans la mer des Caraïbes, à 170 km au nord des côtes du Venezuela, la diversité des coins de pêche — îlots, plages, flats et lagunes — permet de traquer toutes les espèces les plus intéressantes pour le moucheur en mer chaude.</p>
        <p>221 000 hectares interdisant toute pêche intensive et commerciale… 360 îlots de mangrove, bancs de sable blanc et flats cernés par une gigantesque barrière corallienne… Vous êtes à Los Roques — <strong>considérée comme une des trois meilleures destinations mondiales pour la traque du bonefish</strong>.</p>
        <p>En <strong>Janvier/Février 2026</strong>, j'organise deux séjours accompagnés sur l'archipel, en partenariat avec l'agence <a href="https://www.agence-dhdlaika.com/" target="_blank" rel="noopener noreferrer" class="voy-link-partner"><strong>DHD LAIKA</strong></a> et un guide local qui connaît tous les plus beaux coins de l'archipel.</p>
      </div>
      <aside class="voy-intro__card">
        <p class="card-label">Espèces cibles</p>
        <p class="card-val">Bonefish · Tarpon · Permit · Carangues · Barracuda · Snook · +</p>
        <p class="card-label">Saison</p>
        <p class="card-val">Toute l'année</p>
        <p class="card-label">Format</p>
        <p class="card-val">9 jours / 6,5 jours de pêche</p>
        <p class="card-label">Hébergement</p>
        <p class="card-val">Posadas de Gran Roque ★★★★</p>
        <p class="card-label">Encadrement</p>
        <p class="card-val">JBV + guide local (1 guide/2 pêcheurs)</p>
        <p class="card-label">Partenaire</p>
        <p class="card-val"><a href="https://www.agence-dhdlaika.com/" target="_blank" rel="noopener noreferrer" class="voy-link-partner">DHD LAIKA</a></p>
        <p class="card-label">Prochains départs</p>
        <p class="card-val">Janv–Fév 2026</p>
        <p class="card-label">Tarifs</p>
        <p class="card-val">Sur demande</p>
        <a href="/contact" class="card-cta">Demander un devis</a>
      </aside>
    </div>
  </section>

  <!-- ═══ HÉBERGEMENT ═══ -->
  <section class="section section--sand">
    <div class="container voy-lodge-solo">
      <div class="voy-lodge-solo__img">
        <img src="/images/E1.avif" alt="Posada de Gran Roque — Los Roques Venezuela" loading="lazy" />
      </div>
      <div class="voy-lodge-solo__text">
        <p class="eyebrow">Gran Roque</p>
        <h2>Les Posadas de Gran Roque</h2>
        <p>Loin du tourisme de masse, des hôtels de luxe et des plages bétonnées — Gran Roque est un charmant petit village de pêcheurs où règne une grande tranquillité. Nous travaillons avec <strong>plusieurs posadas de très bon standing</strong>, souvent tenues par des Italiens très accueillants.</p>
        <p>La restauration, à base de produits de la mer et de <em>pasta</em>, est vraiment excellente. Pension complète avec hébergement, petit-déjeuner, déjeuner et dîner inclus. La qualité et l'authenticité ont été privilégiées.</p>
        <p>Gran Roque accueille chaque année des visiteurs du monde entier pour ses belles plages, mais aussi pour le kite-surf, la plongée — et surtout la pêche.</p>
      </div>
    </div>
  </section>

  <!-- ═══ LA PLAGE / L'ARCHIPEL ═══ -->
  <section class="section section--white">
    <div class="container voy-beats-grid voy-beats-grid--reverse">
      <div class="voy-beats-imgs">
        <img src="/images/E2.avif" alt="Los Roques — plage de sable blanc" loading="lazy" class="voy-beats-img voy-beats-img--top" />
        <img src="/images/E3.avif" alt="Los Roques — îlot et lagon" loading="lazy" class="voy-beats-img voy-beats-img--bot" />
      </div>
      <div class="voy-beats-text">
        <p class="eyebrow">L'Archipel</p>
        <h2>Un décor de carte postale, des poissons partout</h2>
        <p>Imaginez un décor paradisiaque où les camaïeux de bleu et de vert se perdent à l'infini… Des bancs de sable blanc immaculés, des lagunes d'eau cristalline et des flats peu profonds à perte de vue.</p>
        <p>Chaque jour, nous partons en bateau vers un îlot différent de l'archipel. Selon les conditions, nous pêcherons <strong>à pied sur les flats</strong> en recherchant le bonefish en tailing, ou <strong>depuis le bateau</strong> pour traquer tarpon, permit et carangues en eau plus profonde.</p>
        <p>La particularité de Los Roques : les bonefish chassent souvent dans les bancs d'alevins. Nous les recherchons avec de petits clousers minnow ou gummy — et quand les conditions s'y prêtent, le Grand Slam est possible dans la même journée.</p>
      </div>
    </div>
  </section>

  <!-- ═══ LA SAISON ═══ -->
  <section class="section section--ocean">
    <div class="container voy-saison-grid">
      <div class="voy-saison-img">
        <img src="/images/E4.avif" alt="Los Roques — saison de pêche" loading="lazy" />
      </div>
      <div class="voy-saison-text">
        <p class="eyebrow-light">Météo & Conditions</p>
        <h2 class="light">Pêchable toute l'année</h2>
        <p>Il est possible de pêcher à Los Roques <strong>toute l'année</strong> grâce à sa situation géographique, proche de l'équateur. Les cyclones y sont rares, les alizés fréquents.</p>
        <div class="voy-saison-cards">
          <div class="voy-saison-card">
            <h3>Novembre → Avril</h3>
            <p>Marées hautes avec peu de marnage. Idéal pour les espèces pélagiques : <strong>tarpons, permits, carangues</strong>. Bonefish présents et actifs, moins souvent en tailing visible.</p>
          </div>
          <div class="voy-saison-card">
            <h3>Mai → Octobre</h3>
            <p>Marées basses — de nombreuses situations de pêche du <strong>bonefish en tailing</strong> dans très peu d'eau. Les autres espèces restent présentes et recherchables dans la même journée.</p>
          </div>
        </div>
        <p class="voy-saison-note">Nos séjours accompagnés sont planifiés <strong>Janvier/Février 2026</strong> — conditions optimales pour une session multi-espèces avec de belles chances sur le tarpon.</p>
      </div>
    </div>
  </section>

  <!-- ═══ LES GUIDES ═══ -->
  <section class="section section--sand">
    <div class="container voy-guide-layout">
      <div class="voy-guide-photo">
        <img src="/images/E5.avif" alt="Guide local Los Roques — expert bonefish" loading="lazy" />
      </div>
      <div class="voy-guide-text">
        <p class="eyebrow">Encadrement</p>
        <h2>Jean-Baptiste Vidal + guide local d'exception</h2>
        <p>Nous avons choisi de vous emmener sur les <strong>meilleurs spots de l'archipel</strong> en compagnie de l'un des meilleurs guides du secteur. Il parle bien l'anglais et se fait toujours une joie de vous faire prendre de nouvelles espèces.</p>
        <p>Je prendrai en charge la <strong>partie pêche des flats</strong> — déposés chaque jour sur une des îles avoisinantes pour rechercher surtout le bonefish, mais aussi carangues et d'autres espèces. Étant trilingue, je m'occupe également de toute la <strong>logistique et organisation sur place</strong>.</p>
        <p>Formule <strong>1 guide pour 2 pêcheurs</strong>, ou single skiff sur demande.</p>
      </div>
    </div>
  </section>

  <!-- ═══ LES POISSONS ═══ -->
  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow-light">Bonefish · Tarpon · Permit · Carangues · +</p>
      <h2 class="light">Une destination multi-espèces unique</h2>
      <div class="voy-fish-intro">
        <img src="/images/E6.avif" alt="Pêche à la mouche Los Roques — capture" loading="lazy" class="voy-fish-hero-img" />
        <p>En plus de la bonne densité de <strong>gros bonefish</strong>, vous pourrez capturer à la mouche une douzaine d'espèces de poissons — dont bien entendu le tarpon et le permit. Notre guide est également spécialisé dans la recherche des <strong>poissons perroquets et balistes</strong> (trigger fish).</p>
      </div>
      <div class="voy-fish-trio">
        <div class="voy-fish-species">
          <h3>Le Bonefish</h3>
          <p class="voy-fish-tag">Espèce star · Top 3 mondial</p>
          <p>Des bonefish actifs en tailing sur les flats peu profonds — la spécialité de Los Roques. De très bons gabarits, souvent chassant dans les bancs d'alevins. Petits clousers minnow et gummy sont les mouches de référence.</p>
        </div>
        <div class="voy-fish-species">
          <h3>Tarpon · Permit</h3>
          <p class="voy-fish-tag">Grand Slam possible</p>
          <p>Les canaux plus profonds tiennent du tarpon toute l'année. Le permit est présent sur les flats et dans les passes. Le Grand Slam — bonefish, tarpon, permit dans la même journée — est un objectif réaliste à Los Roques.</p>
        </div>
        <div class="voy-fish-species">
          <h3>Les Bonus</h3>
          <p class="voy-fish-tag">Carangues · Barracuda · Snook · +</p>
          <p>Carangues à œil de cheval, hippos, pompano, maquereaux espagnols, bonites, snook, barracuda, red snapper, poissons perroquets, balistes — Los Roques offre un tableau de pêche exceptionnel.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LE MATÉRIEL ═══ -->
  <section class="section section--white">
    <div class="container">
      <p class="eyebrow">Équipement</p>
      <h2>Le matériel recommandé</h2>
      <p class="section-intro">L'idéal est de prévoir trois cannes pour couvrir toutes les situations. Une fiche matériel détaillée est disponible en téléchargement.</p>
      <div class="voy-materiel-grid">
        <div class="voy-materiel-card">
          <div class="voy-materiel-num">#8</div>
          <h3>Bonefish</h3>
          <p>Soie de <strong>8</strong> (voire 9 si vent fort) pour la pêche à vue du bonefish sur les flats peu profonds.</p>
        </div>
        <div class="voy-materiel-card">
          <div class="voy-materiel-num">#9/10</div>
          <h3>Permit & Carangues</h3>
          <p>Canne <strong>9/10</strong> pour le permit et les carangues. Équipez un ensemble avec un popper pour les gros barracudas.</p>
        </div>
        <div class="voy-materiel-card">
          <div class="voy-materiel-num">#10/11</div>
          <h3>Tarpon</h3>
          <p>Canne <strong>10/11</strong> indispensable pour le tarpon. Moulinets robustes avec bon frein, 150m+ de backing 30 lb.</p>
        </div>
        <div class="voy-materiel-card">
          <div class="voy-materiel-num">Bas de ligne</div>
          <h3>Fluorocarbone</h3>
          <p><strong>12-20</strong> pour bonefish · <strong>20-25</strong> pour permit · <strong>40-80+</strong> pour tarpon et autres espèces.</p>
        </div>
      </div>
      <div class="voy-materiel-download">
        <a href="/fiche-materiel-los-roques.pdf" class="btn-download" download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Télécharger la fiche matériel complète (PDF)
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ LE DÉROULEMENT ═══ -->
  <section class="section section--sand">
    <div class="container">
      <p class="eyebrow">Programme</p>
      <h2>9 jours sur place, 6,5 jours de pêche</h2>
      <div class="voy-programme">
        <div class="voy-prog-item">
          <span class="voy-prog-day">J1</span>
          <div><strong>Départ de Paris</strong> — vol vers Caracas, arrivée en soirée. Transfert à l'hôtel près de l'aéroport.</div>
        </div>
        <div class="voy-prog-item">
          <span class="voy-prog-day">J2</span>
          <div><strong>Vol vers Los Roques</strong> — 40 minutes depuis Caracas. Accueil, installation à la posada. Journée libre avec possibilité de pêche à proximité. Révision du matériel et perfectionnement du lancer avec JBV.</div>
        </div>
        <div class="voy-prog-item">
          <span class="voy-prog-day">J3–8</span>
          <div><strong>6 jours de pêche guidée</strong> — à pied sur les flats ou en bateau selon les conditions et les espèces ciblées. Chaque jour sur un îlot ou une zone différente de l'archipel.</div>
        </div>
        <div class="voy-prog-item">
          <span class="voy-prog-day">J9</span>
          <div><strong>Transfert à l'aéroport</strong> — départ en fin d'après-midi. Arrivée en France le lendemain matin.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ GALERIE PRINCIPALE (E7–E31) ═══ -->
  <section class="gallery-section">
    <div class="voy-carousel" id="main-carousel">
      <div class="voy-carousel__track" id="main-track">
        {Array.from({length: 25}, (_, i) => i + 7).map((n, i) => (
          <div class="voy-carousel__slide">
            <img src={`/images/E${n}.avif`} alt={`Los Roques Venezuela — photo ${n}`} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
      <button class="voy-carousel__btn voy-carousel__btn--prev" id="main-prev" aria-label="Photo précédente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="voy-carousel__btn voy-carousel__btn--next" id="main-next" aria-label="Photo suivante">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <div class="voy-carousel__counter" id="main-counter">1 / 25</div>
    </div>
  </section>

  <!-- ═══ DATES 2026 ═══ -->
  <section class="section section--white">
    <div class="container voy-dates">
      <p class="eyebrow">Hosted Trip · 2026</p>
      <h2>Deux séjours disponibles</h2>
      <p class="section-intro">J'organise deux semaines accompagnées pour début 2026 — deux groupes de 4 pêcheurs maximum.</p>
      <div class="voy-dates-grid">
        <div class="voy-date-card">
          <span class="voy-date-badge">Semaine 1</span>
          <h3>23 → 31 Janvier 2026</h3>
          <p>Accompagnement par JBV pendant <strong>3 jours</strong> + 3 jours guidés par le guide local. Groupe de 4 pêcheurs maximum.</p>
          <a href="/contact" class="btn-prim btn-sm">Se renseigner</a>
        </div>
        <div class="voy-date-card">
          <span class="voy-date-badge">Semaine 2</span>
          <h3>31 Janvier → 7 Février 2026</h3>
          <p>Guidé par JBV <strong>3 jours</strong> + 3 jours guidés par le guide local. Groupe de 4 pêcheurs maximum.</p>
          <a href="/contact" class="btn-prim btn-sm">Se renseigner</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ INCLUS / NON INCLUS ═══ -->
  <section class="section section--ocean">
    <div class="container voy-inclus-grid">
      <div>
        <p class="eyebrow-light">Dans le séjour</p>
        <h2 class="light">Ce qui est inclus</h2>
        <ul class="voy-check-list">
          {[
            "Transferts et vols internes vers Los Roques",
            "7 nuits en posada en pension complète (sauf alcool)",
            "6,5 jours de pêche — 1 guide pour 2 pêcheurs",
            "Organisation, coordination et logistique par Jean-Baptiste Vidal",
            "Accompagnement et guidage JBV en plus du guide local",
            "Excédent de bagage pour le vol local (3$/kg au-dessus de 10 kg)",
            "Permis de pêche et taxe de séjour",
          ].map(item => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="eyebrow-light-muted">Hors séjour</p>
        <h2 class="light">Non inclus</h2>
        <ul class="voy-cross-list">
          {[
            "Les vols internationaux (Paris–Caracas)",
            "Le visa et les formalités d'entrée",
            "Les pourboires aux guides",
            "Les boissons (alcool, etc.)",
            "L'assurance voyage et rapatriement",
          ].map(item => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ PRATIQUE ═══ -->
  <section class="section section--sand">
    <div class="container voy-pratique">
      <div class="voy-pratique__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <h3>Réservation & organisation</h3>
        <p>Vous pouvez me contacter directement pour partir sur cette fabuleuse destination, ou passer par l'agence partenaire <a href="https://www.agence-dhdlaika.com/" target="_blank" rel="noopener noreferrer" class="voy-link-partner"><strong>DHD LAIKA</strong></a> spécialisée dans les voyages de pêche haut de gamme.</p>
        <p>Places limitées à <strong>4 pêcheurs par groupe</strong> — réservation recommandée au moins 6 mois à l'avance.</p>
        <p class="voy-pratique__partner">
          Séjour organisé en partenariat avec
          <a href="https://www.agence-dhdlaika.com/voyages-de-peche/" target="_blank" rel="noopener noreferrer" class="voy-link-partner">
            <strong>DHD LAIKA — Agence de voyages de pêche</strong>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" style="margin-left:4px;vertical-align:middle"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="section section--dark voy-cta-final">
    <div class="container voy-cta-final__inner">
      <div>
        <h2>Partir à Los Roques</h2>
        <p>Contactez-moi pour les disponibilités 2026, les dates de départ et un devis personnalisé.</p>
      </div>
      <div class="voy-cta-final__btns">
        <a href="/contact" class="btn-prim">Me contacter</a>
        <a href="tel:0687303456" class="btn-ghost-light">06 87 30 34 56</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
;(function() {
  var carousel = document.getElementById('main-carousel')
  var track    = document.getElementById('main-track')
  var prevBtn  = document.getElementById('main-prev')
  var nextBtn  = document.getElementById('main-next')
  var counter  = document.getElementById('main-counter')
  if (!track || !carousel) return

  var total   = track.querySelectorAll('.voy-carousel__slide').length
  var current = 0
  var DELAY   = 4500
  var timer   = null

  function startAutoplay() { if (timer) return; timer = setInterval(function() { go(current + 1) }, DELAY) }
  function stopAutoplay()  { if (timer) { clearInterval(timer); timer = null } }
  function restartAutoplay() { stopAutoplay(); setTimeout(startAutoplay, 6000) }

  function slideW() { return (carousel.offsetWidth - 6) / 3 }
  function calcOffset(idx) {
    var w = slideW()
    return Math.max(0, Math.min((total - 3) * (w + 3), (idx - 1) * (w + 3)))
  }
  function go(idx) {
    current = (idx + total) % total
    track.style.transform = 'translateX(-' + calcOffset(current) + 'px)'
    if (counter) counter.textContent = (current + 1) + ' / ' + total
  }

  window.addEventListener('resize', function() {
    track.style.transition = 'none'
    track.style.transform = 'translateX(-' + calcOffset(current) + 'px)'
    requestAnimationFrame(function() { track.style.transition = '' })
  })

  prevBtn && prevBtn.addEventListener('click', function() { go(current - 1); restartAutoplay() })
  nextBtn && nextBtn.addEventListener('click', function() { go(current + 1); restartAutoplay() })

  var startX = 0
  carousel.addEventListener('touchstart', function(e) { startX = e.changedTouches[0].clientX }, { passive: true })
  carousel.addEventListener('touchend', function(e) {
    var dx = e.changedTouches[0].clientX - startX
    if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
  }, { passive: true })

  var dragStartX = 0, dragging = false
  carousel.addEventListener('mousedown', function(e) { dragStartX = e.clientX; dragging = true })
  carousel.addEventListener('mouseup', function(e) {
    if (!dragging) return; dragging = false
    var dx = e.clientX - dragStartX
    if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
  })
  carousel.addEventListener('mouseleave', function() { dragging = false })
  carousel.addEventListener('mouseenter', stopAutoplay)
  carousel.addEventListener('mouseleave', startAutoplay)

  startAutoplay()
})()
