---
import BaseLayout from '../layouts/BaseLayout.astro'
import MatierielBtn from '../components/MatierielBtn.astro'
import BarSubNav from '../components/BarSubNav.astro'
---

<BaseLayout
  title="Perfectionnement à la pêche du bar à la mouche — Jean-Baptiste Vidal"
  description="Stage de perfectionnement à la pêche du bar à la mouche en Bretagne-Sud. Double traction, grands lancers, choix des mouches, stratégie de pêche et traque des gros bars à vue."
>

  <!-- ═══ HERO ═══ -->
  <section class="voy-hero">
    <div class="voy-hero__bg"></div>
    <div class="voy-hero__overlay"></div>
    <div class="voy-hero__content container">
      <p class="voy-eyebrow">Bar à la mouche · Perfectionnement · Bretagne-Sud</p>
      <h1>Perfectionnement<br /><span class="voy-hero__sub">Rechercher les gros poissons</span></h1>
      <p class="voy-lead">Double traction, grands lancers, lecture des postes, stratégie de pêche, pour les pêcheurs initiés qui veulent franchir le cap et traquer de vrais trophées.</p>
      <div class="voy-hero__cta">
        <a href="/contact" class="btn-prim">Réserver une sortie</a>
        <a href="tel:0687303456" class="btn-ghost">06 87 30 34 56</a>
        <MatierielBtn href="/materiel-mouche-bar" label="Matériel bar" />
      </div>
    </div>
    <div class="voy-hero__scroll">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </section>

  <!-- ═══ CHIFFRES CLÉS ═══ -->
  <div class="voy-stats">
    <div class="voy-stats__item">
      <span class="voy-stats__num">Mai – Nov</span>
      <span class="voy-stats__label">Saison de pêche du bar</span>
    </div>
    <div class="voy-stats__item">
      <span class="voy-stats__num">6–8 h</span>
      <span class="voy-stats__label">Journée de guidage</span>
    </div>
    <div class="voy-stats__item">
      <span class="voy-stats__num">2 max</span>
      <span class="voy-stats__label">Pêcheurs par sortie</span>
    </div>
    <div class="voy-stats__item">
      <span class="voy-stats__num">17 ans</span>
      <span class="voy-stats__label">d'expérience bar intensive</span>
    </div>
  </div>

  <!-- ═══ INTRO ═══ -->
  <section class="section section--white">
    <div class="container voy-intro">
      <div class="voy-intro__text">
        <p class="eyebrow">Perfectionnement · Bar à la mouche</p>
        <h2>Pour les pêcheurs initiés qui veulent aller plus loin</h2>
        <p>Vous êtes déjà pêcheur initié en eau douce et/ou en mer, et souhaitez améliorer votre technique de lancer, accroître vos connaissances de la pêche du bar et rechercher de plus gros poissons ? Ces stages de perfectionnement sont faits pour vous.</p>
        <p>Fort de plus de 17 années d'expérience intensive en France et à l'étranger, je vous transmets mon savoir-faire pour la double traction, les stratégies de pêche et la traque des poissons les plus imposants. L'objectif : être encore plus performant et vous concentrer uniquement sur la traque de Mr Labrax.</p>
        <p>Les bars quittent les côtes en automne pour leur reproduction et reviennent en mars. La saison s'étend de <strong>mai à fin novembre</strong>. Marées, coefficients, météo, direction du vent, luminosité et teinte de l'eau sont les paramètres clés à maîtriser pour maximiser vos chances sur les gros poissons.</p>
      </div>
      <aside class="voy-intro__card">
        <p class="card-label">Niveau</p>
        <p class="card-val">Pêcheurs initiés</p>
        <p class="card-label">Format</p>
        <p class="card-val">Journée · Week-end · Du bord ou en bateau</p>
        <p class="card-label">Durée</p>
        <p class="card-val">6 à 8 heures selon les marées</p>
        <p class="card-label">Groupe</p>
        <p class="card-val">Maximum 2 pêcheurs</p>
        <p class="card-label">Saison</p>
        <p class="card-val">Mai à novembre · Départ mi-avril</p>
        <p class="card-label">Tarifs</p>
        <p class="card-val">320 € · 1 pers. / 225 € · 2 pers.</p>
        <a href="/contact" class="card-cta">Réserver</a>
      </aside>
    </div>
  </section>

  <!-- ═══ PROGRAMME ═══ -->
  <section class="section section--sand">
    <div class="container">
      <p class="eyebrow">Programme</p>
      <h2>Ce que vous allez travailler</h2>
      <p class="section-intro">Chaque sortie est structurée autour de quatre axes pour faire progresser le pêcheur initié vers la maîtrise complète de la pêche du bar à la mouche.</p>

      <div class="prog-rows">

        <!-- 1 — Perfectionnement du lancer -->
        <div class="prog-row">
          <div class="prog-row__img">
            <img src="/images/BP2.avif" alt="Perfectionnement du lancer mouche — double traction" loading="lazy" />
          </div>
          <div class="prog-row__body">
            <div class="prog-row__num">01</div>
            <h3>Perfectionnement du lancer</h3>
            <p class="prog-row__tag">Double traction · Roulé · Back handed · Distance</p>
            <p>Maîtrise des techniques de lancer avancées : simple et double traction pour atteindre et dépasser les 15 mètres, lancer roulé, arrière-main (back handed), exploitation des vents de face et des vents arrière.</p>
            <p>La capacité à serrer la boucle face au vent est déterminante pour la pêche du bar en conditions bretonnes. On travaille la précision, la constance et l'économie du geste pour que chaque lancer soit efficace, quelle que soit la météo.</p>
          </div>
        </div>

        <!-- 2 — Matériel et mouches -->
        <div class="prog-row prog-row--reverse">
          <div class="prog-row__img">
            <img src="/images/BP3.avif" alt="Choix du matériel et des mouches pour la pêche du bar" loading="lazy" />
          </div>
          <div class="prog-row__body">
            <div class="prog-row__num">02</div>
            <h3>Matériel &amp; choix des mouches</h3>
            <p class="prog-row__tag">Cannes · Soies · Mouches · Animations</p>
            <p>Choix du matériel adapté selon les postes et les conditions du moment : type de soie, pointe, fluorocarbone. La sélection des mouches (taille, couleur, poids) et leur animation sont des paramètres souvent sous-estimés qui font pourtant toute la différence.</p>
            <p>On décrypte ensemble les erreurs courantes dans le choix du matériel et des mouches, et on optimise chaque réglage pour maximiser le nombre de touches et de captures.</p>
          </div>
        </div>

        <!-- 3 — Stratégies de pêche -->
        <div class="prog-row">
          <div class="prog-row__img">
            <img src="/images/BP4.avif" alt="Stratégies de pêche du bar — lecture des postes et courants" loading="lazy" />
          </div>
          <div class="prog-row__body">
            <div class="prog-row__num">03</div>
            <h3>Stratégies de pêche</h3>
            <p class="prog-row__tag">Préparation · Postes · Marées · Progression</p>
            <p>La pêche du bar se prépare. On travaille ensemble la structure d'une sortie efficace : choix du spot en fonction des marées et du vent, lecture des courants et des postes, timing d'intervention, gestion de l'approche.</p>
            <p>Accumulation progressive d'expérience et d'observation pour construire une véritable autonomie : comprendre pourquoi ça mord à tel endroit, à telle heure, dans telles conditions, et savoir reproduire le succès.</p>
          </div>
        </div>

        <!-- 4 — Traque du gros bar à vue -->
        <div class="prog-row prog-row--reverse">
          <div class="prog-row__img">
            <img src="/images/BP5.avif" alt="Traque du gros bar à vue en estuaire — Bretagne-Sud" loading="lazy" />
          </div>
          <div class="prog-row__body">
            <div class="prog-row__num">04</div>
            <h3>Traque du gros bar à vue</h3>
            <p class="prog-row__tag">Bar à vue · Imitations · Approche discrète · Places limitées</p>
            <p>Programme spécialisé pour pêcheurs confirmés en bonne condition physique. Traque des gros bars à vue en estuaire à l'aide d'imitations de crustacés et de streamers, la forme la plus exigeante et la plus gratifiante de la pêche du bar.</p>
            <p>Discrétion totale, lecture de l'eau, présentation millimétrique : un seul lancer imprécis et le bar disparaît. Un challenge technique et physique réservé aux pêcheurs qui maîtrisent déjà les bases, les places sont volontairement limitées.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- NAVIGATION CROISÉE BAR -->
  <BarSubNav current="perfectionnement" />

  <!-- CTA FINAL -->
  <section class="prest-cta-final section section--dark">
    <div class="container prest-cta-final__inner">
      <div>
        <h2>Réservez votre sortie</h2>
        <p>Disponibilités et tarifs sur demande, réponse sous 24h.</p>
      </div>
      <div class="prest-cta-final__btns">
        <a href="/contact" class="btn-prim">Me contacter</a>
        <a href="tel:0687303456" class="btn-ghost-light">06 87 30 34 56</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO ── */
  .voy-hero {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 5rem;
    color: white;
    overflow: hidden;
  }
  .voy-hero__bg {
    position: absolute; inset: 0;
    background: url('/images/BP1.avif') center / cover no-repeat;
    background-color: var(--color-ocean);
  }
  .voy-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(7,24,31,0.9) 0%, rgba(13,43,62,0.5) 55%, rgba(13,43,62,0.25) 100%);
  }
  .voy-hero__content { position: relative; z-index: 1; }
  .voy-eyebrow {
    font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-ocean-light); font-weight: 500; margin-bottom: 1rem;
  }
  .voy-hero__content h1 {
    font-family: var(--font-serif); font-weight: 400; color: white;
    margin-bottom: 1.5rem; max-width: 680px;
    font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1;
  }
  .voy-hero__sub {
    display: block; font-size: clamp(1.1rem, 3vw, 1.8rem);
    font-weight: 300; opacity: 0.75;
  }
  .voy-lead {
    font-size: 1rem; line-height: 1.7;
    color: rgba(255,255,255,0.75); max-width: 560px; margin-bottom: 2.5rem;
  }
  .voy-hero__cta { display: flex; gap: 1rem; flex-wrap: wrap; }
  .voy-hero__scroll {
    position: absolute; bottom: 2rem; right: 2rem;
    color: rgba(255,255,255,0.4); z-index: 1;
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }
  .btn-prim {
    background: var(--color-ocean-main); color: white;
    padding: 0.75rem 1.8rem; border-radius: 4px; font-weight: 500;
    font-size: 0.95rem; text-decoration: none; transition: background 0.2s;
  }
  .btn-prim:hover { background: #144b72; }
  .btn-ghost {
    border: 1.5px solid rgba(255,255,255,0.4); color: white;
    padding: 0.75rem 1.8rem; border-radius: 4px; font-weight: 500;
    font-size: 0.95rem; text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-ghost:hover { border-color: white; background: rgba(255,255,255,0.08); }

  /* ── STATS BAR ── */
  .voy-stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    background: var(--color-ocean);
  }
  .voy-stats__item {
    padding: 1.4rem 1rem; text-align: center;
    border-right: 1px solid rgba(255,255,255,0.1);
    display: flex; flex-direction: column; gap: 0.3rem;
  }
  .voy-stats__item:last-child { border-right: none; }
  .voy-stats__num {
    font-family: var(--font-serif); font-size: 1.5rem;
    color: white; font-weight: 500; line-height: 1;
  }
  .voy-stats__label {
    font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(255,255,255,0.55); font-weight: 400;
  }

  /* ── INTRO ── */
  .section--white { background: #fff; }
  .voy-intro {
    display: grid; grid-template-columns: 1fr 300px; gap: 4rem; align-items: start;
  }
  .eyebrow {
    font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-ocean-main); font-weight: 600; margin-bottom: 0.75rem;
  }
  .voy-intro__text h2 { margin-bottom: 1.25rem; }
  .voy-intro__text p { line-height: 1.8; color: var(--color-text); margin-bottom: 1rem; }
  .voy-intro__text p:last-child { margin-bottom: 0; }
  .voy-intro__card {
    background: var(--color-sand); border-radius: 6px; padding: 1.6rem;
    border-left: 3px solid var(--color-ocean-main);
    position: sticky; top: 90px;
  }
  .card-label {
    font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-ocean-main); font-weight: 600; margin-top: 1.1rem;
  }
  .card-label:first-child { margin-top: 0; }
  .card-val { font-size: 0.9rem; color: var(--color-text); line-height: 1.5; }
  .card-cta {
    display: block; margin-top: 1.4rem; text-align: center;
    background: var(--color-ocean-main); color: white;
    padding: 0.7rem 1rem; border-radius: 4px; font-weight: 500;
    font-size: 0.88rem; text-decoration: none; transition: background 0.2s;
  }
  .card-cta:hover { background: #144b72; }

  /* ── PROGRAMME ── */
  .section--sand { background: var(--color-sand); }
  .section-intro {
    font-size: 1rem; line-height: 1.7; color: var(--color-text);
    max-width: 640px; margin-bottom: 2.5rem;
  }

  .prog-rows { display: flex; flex-direction: column; gap: 2rem; }

  .prog-row {
    display: grid; grid-template-columns: 1fr 1fr;
    border-radius: 6px; overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,0.07);
  }
  .prog-row--reverse .prog-row__img { order: 2; }
  .prog-row--reverse .prog-row__body { order: 1; }

  .prog-row__img { overflow: hidden; min-height: 340px; }
  .prog-row__img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  .prog-row:hover .prog-row__img img { transform: scale(1.04); }

  .prog-row__body {
    padding: 2.5rem 3rem; background: white;
    display: flex; flex-direction: column; justify-content: center;
  }

  .prog-row__num {
    font-family: var(--font-serif); font-size: 2.5rem; font-weight: 300;
    color: rgba(27,94,138,0.15); line-height: 1; margin-bottom: 0.4rem;
  }
  .prog-row__body h3 { font-size: 1.3rem; margin-bottom: 0.3rem; }
  .prog-row__tag {
    font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--color-ocean-main); font-weight: 500; margin-bottom: 1.1rem; display: block;
  }
  .prog-row__body p { line-height: 1.75; color: var(--color-text-muted, #555); font-size: 0.9rem; margin-bottom: 0.8rem; }
  .prog-row__body p:last-child { margin-bottom: 0; }

  /* ── CTA FINAL ── */
  .prest-cta-final__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; flex-wrap: wrap;
  }
  .prest-cta-final__inner h2 { color: white; margin-bottom: 0.5rem; }
  .prest-cta-final__inner > div:first-child p { color: rgba(255,255,255,0.65); }
  .prest-cta-final__btns { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-ghost-light {
    border: 1.5px solid rgba(255,255,255,0.4); color: white;
    padding: 0.75rem 1.8rem; border-radius: 4px; font-weight: 500;
    font-size: 0.95rem; text-decoration: none; transition: border-color 0.2s;
  }
  .btn-ghost-light:hover { border-color: white; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .voy-stats { grid-template-columns: repeat(2, 1fr); }
    .voy-stats__item:nth-child(2) { border-right: none; }
    .voy-intro { grid-template-columns: 1fr; gap: 2rem; }
    .voy-intro__card { position: static; }
    .prog-row { grid-template-columns: 1fr; }
    .prog-row--reverse .prog-row__img,
    .prog-row--reverse .prog-row__body { order: unset; }
    .prog-row__img { min-height: 240px; }
    .prog-row__body { padding: 2rem 2rem; }
  }
  @media (max-width: 560px) {
    .voy-hero { min-height: 88vh; padding-bottom: 3.5rem; }
    .voy-stats { grid-template-columns: 1fr 1fr; }
    .prog-row__body { padding: 2rem 1.5rem; }
    .prest-cta-final__inner { flex-direction: column; align-items: flex-start; }
  }
</style>
