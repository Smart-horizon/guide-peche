---
import BaseLayout from '../layouts/BaseLayout.astro'

const seoTitle = "Tarifs stages et guidages 2026 — Jean-Baptiste Vidal, Guide de pêche Bretagne"
const seoDescription = "Tarifs 2026 des stages et guidages pêche à la mouche en Bretagne avec Jean-Baptiste Vidal : bar, truite, alose, brochet, réservoir, Spey Cast. À partir de 150 €/personne."

const inclus = [
  "L'enseignement et le guidage (7 à 8 h environ)",
  "Le prêt de matériel haut de gamme si nécessaire (canne, soie, moulinets, bas de ligne)",
  "Les mouches du guide",
  "Le matériel consommable",
  "Les boissons non alcoolisées",
  "Aide à l'acquisition du permis de pêche, matériel, hébergement et activités (sur demande)",
]

const nonInclus = [
  "Le permis de pêche",
  "Les waders ou bottes",
  "Les repas",
  "Le transport sur le lieu de pêche",
  "L'hébergement",
]

const supplements = [
  { label: "Assortiment migrateur saumon (obligatoire)", prix: "50 €",      note: "Fourni sur demande" },
  { label: "Permis journalier réservoir",                prix: "15 – 23 €", note: "Etang Neuf (22) · Parc Ar Bihan (56)" },
  { label: "Supplément carburant — 50 km A+R",           prix: "20 €",      note: "Guidage hors secteur géographique" },
  { label: "Supplément carburant — 100 km A+R",          prix: "30 €",      note: "" },
  { label: "Supplément carburant — 150 km A+R",          prix: "40 €",      note: "" },
]
---

<BaseLayout title={seoTitle} description={seoDescription}>

  <!-- ═══ HERO ═══ -->
  <section class="tarif-hero">
    <div class="container tarif-hero__inner">
      <p class="hero-eyebrow">Bretagne-Sud · 2026</p>
      <h1>Tarifs des stages<br/>&amp; guidages</h1>
      <p class="hero-sub">Enseignements et guidages pour pêcheurs débutants, confirmés et experts — eau douce, bar, migrateurs, technique.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn-prim">Demander un renseignement</a>
        <a href="tel:0687303456" class="btn-ghost">06 87 30 34 56</a>
      </div>
    </div>
  </section>

  <!-- ═══ INTRO ═══ -->
  <section class="section section--white">
    <div class="container intro-grid">
      <div class="intro-text">
        <p class="eyebrow">Tarifs 2026</p>
        <h2>Prix par personne</h2>
        <p>Sur cette page, vous trouverez le tarif de mes stages de pêche à la mouche et de mes prestations pour la pêche en Bretagne. N'hésitez pas à me contacter si vous souhaitez d'autres renseignements.</p>
        <div class="contact-inline">
          <a href="tel:0687303456" class="contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.72A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            06 87 30 34 56
          </a>
          <a href="mailto:enjoy.fishing@hotmail.fr" class="contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            enjoy.fishing@hotmail.fr
          </a>
        </div>
      </div>
      <div class="intro-card">
        <p class="intro-card__title">Durée</p>
        <p class="intro-card__val">7 à 8 heures environ</p>
        <p class="intro-card__title">Niveaux</p>
        <p class="intro-card__val">Débutants · Confirmés · Experts</p>
        <p class="intro-card__title">Zone</p>
        <p class="intro-card__val">Bretagne-Sud — Finistère · Morbihan</p>
        <p class="intro-card__title">Contact</p>
        <p class="intro-card__val">06 87 30 34 56</p>
      </div>
    </div>
  </section>

  <div class="tarifs-block">

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — BAR À LA MOUCHE
  ═══════════════════════════════════════════════════ -->
  <section class="ts-section">

    <div class="ts-panel ts-panel--bar">
      <p class="ts-eyebrow">Estuaires · Bretagne-Sud</p>
      <h2 class="ts-title">Bar à<br/>la mouche</h2>
      <div class="ts-divider"></div>
      <p class="ts-desc">Bar à vue, en bateau, en estuaire. Du débutant au pêcheur expert en quête des gros labrax.</p>
      <a href="/peche-du-bar-a-la-mouche" class="ts-more">Découvrir les prestations →</a>
    </div>

    <div class="ts-body ts-body--white">
      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/initiation-peche-du-bar-a-la-mouche" class="ts-row__name">Initiation bar à la mouche</a>
          <span class="ts-row__format">1 journée</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">280 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">180 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
        </div>
      </div>
      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/peche-du-bar-perfectionnement" class="ts-row__name">Perfectionnement bar</a>
          <span class="ts-row__format">1 journée</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">300 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">200 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
        </div>
      </div>
      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/peche-du-bar-a-vue-a-la-mouche" class="ts-row__name">Bar à vue en estuaire</a>
          <span class="ts-row__format">1 session</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price ts-price--accent">
            <span class="ts-price__val">320 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price ts-price--accent">
            <span class="ts-price__val">225 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
        </div>
      </div>
      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/peche-mouche-bar-bateau-bretagne" class="ts-row__name">Bar en bateau « spécial mouche »</a>
          <span class="ts-row__format">1 session · Carolina Skiff</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price ts-price--accent">
            <span class="ts-price__val">350 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price ts-price--accent">
            <span class="ts-price__val">250 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — EAU DOUCE & MIGRATEURS
  ═══════════════════════════════════════════════════ -->
  <section class="ts-section">

    <div class="ts-panel ts-panel--eau">
      <p class="ts-eyebrow">Rivières · Réservoirs</p>
      <h2 class="ts-title">Eau douce<br/>&amp; migrateurs</h2>
      <div class="ts-divider"></div>
      <p class="ts-desc">Truite, alose, brochet et saumon — les rivières bretonnes et leurs secrets.</p>
      <a href="/peche-a-la-mouche-en-bretagne" class="ts-more">Découvrir les prestations →</a>
    </div>

    <div class="ts-body ts-body--sand">

      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/peche-a-la-mouche-en-bretagne" class="ts-row__name">Initiation pêche à la mouche</a>
          <span class="ts-row__format">1 journée</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">280 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">180 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">150 €</span>
            <span class="ts-price__lbl">3 pers.</span>
          </div>
        </div>
      </div>

      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/peche-de-la-truite-a-la-mouche-en-bretagne" class="ts-row__name">Perfectionnement truite en rivière</a>
          <span class="ts-row__format">1 journée</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">300 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">200 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">160 €</span>
            <span class="ts-price__lbl">3 pers.</span>
          </div>
        </div>
      </div>

      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/peche-de-la-truite-en-reservoir" class="ts-row__name">Truite en réservoir</a>
          <span class="ts-row__format">1 journée · permis non inclus</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">320 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">200 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">150 €</span>
            <span class="ts-price__lbl">3 pers.</span>
          </div>
        </div>
      </div>

      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/peche-du-brochet-a-la-mouche" class="ts-row__name">Brochet — du bord</a>
          <span class="ts-row__format">1 journée</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">300 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">200 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
        </div>
      </div>

      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/peche-du-brochet-a-la-mouche" class="ts-row__name">Brochet — en bateau</a>
          <span class="ts-row__format">1 journée</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">320 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">200 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
        </div>
      </div>

      <div class="ts-row ts-row--closed">
        <div class="ts-row__info">
          <span class="ts-row__name">Pêche du saumon (salmo salar)</span>
          <span class="ts-row__format">
            <span class="tag-closed">Fermée en 2026</span>
          </span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">300 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">200 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">160 €</span>
            <span class="ts-price__lbl">3 pers.</span>
          </div>
        </div>
      </div>

      <!-- Alose — matrice 3 formats -->
      <div class="ts-matrix">
        <div class="ts-matrix__title">
          <a href="/peche-de-l-alose-a-la-mouche" class="ts-matrix__title-link">Grande alose (alosa alosa)</a>
          <span>— tarif selon le format de sortie</span>
        </div>
        <div class="ts-matrix__head ts-matrix--alose">
          <span></span>
          <span class="ts-mh__col">Coup du soir</span>
          <span class="ts-mh__col">1 j. Aulne</span>
          <span class="ts-mh__col">1 j. Blavet</span>
        </div>
        <div class="ts-matrix__row ts-matrix--alose">
          <span class="ts-mrow__label">1 personne</span>
          <span class="ts-mrow__val">200 €</span>
          <span class="ts-mrow__val">320 €</span>
          <span class="ts-mrow__val">350 €</span>
        </div>
        <div class="ts-matrix__row ts-matrix--alose">
          <span class="ts-mrow__label">2 personnes</span>
          <span class="ts-mrow__val">180 €</span>
          <span class="ts-mrow__val">200 €</span>
          <span class="ts-mrow__val">250 €</span>
        </div>
        <div class="ts-matrix__row ts-matrix--alose">
          <span class="ts-mrow__label">3 personnes</span>
          <span class="ts-mrow__val">150 €</span>
          <span class="ts-mrow__val">170 €</span>
          <span class="ts-mrow__val">180 €</span>
        </div>
      </div>

    </div><!-- ts-body -->

  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 3 — STAGES & TECHNIQUE
  ═══════════════════════════════════════════════════ -->
  <section class="ts-section">

    <div class="ts-panel ts-panel--stage">
      <p class="ts-eyebrow">Technique · Perfectionnement</p>
      <h2 class="ts-title">Stages<br/>&amp; technique</h2>
      <div class="ts-divider"></div>
      <p class="ts-desc">Cours de lancer, Spey Cast, Masterclass — progressez avec des exercices ciblés.</p>
      <a href="/stage-spey-cast-et-cours-de-lancer" class="ts-more">Découvrir les stages →</a>
    </div>

    <div class="ts-body ts-body--white">

      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/stage-spey-cast-et-cours-de-lancer" class="ts-row__name">Cours de lancer dont Spey Cast</a>
          <span class="ts-row__format">1 journée · canne une &amp; deux mains</span>
        </div>
        <div class="ts-prices">
          <div class="ts-price">
            <span class="ts-price__val">300 €</span>
            <span class="ts-price__lbl">1 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">200 €</span>
            <span class="ts-price__lbl">2 pers.</span>
          </div>
          <div class="ts-price">
            <span class="ts-price__val">160 €</span>
            <span class="ts-price__lbl">3 pers.</span>
          </div>
        </div>
      </div>

      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/master-class-peche-en-reservoir" class="ts-row__name">Masterclass réservoir</a>
          <span class="ts-row__format">Format sur mesure</span>
        </div>
        <div class="ts-prices ts-prices--contact">
          <span class="ts-contact-price">Nous contacter</span>
        </div>
      </div>

      <div class="ts-row">
        <div class="ts-row__info">
          <a href="/master-class-nymphe-au-fil" class="ts-row__name">Masterclass nymphe au fil</a>
          <span class="ts-row__format">Format sur mesure</span>
        </div>
        <div class="ts-prices ts-prices--contact">
          <span class="ts-contact-price">Nous contacter</span>
        </div>
      </div>

      <!-- Père / enfant — matrice ½j / 1j -->
      <div class="ts-matrix">
        <div class="ts-matrix__title">
          <a href="/contact" class="ts-matrix__title-link">Stage Père / enfant (– de 16 ans)</a>
        </div>
        <div class="ts-matrix__head ts-matrix--pere">
          <span></span>
          <span class="ts-mh__col">½ journée</span>
          <span class="ts-mh__col">1 journée</span>
        </div>
        <div class="ts-matrix__row ts-matrix--pere">
          <span class="ts-mrow__label">Père et 1 enfant</span>
          <span class="ts-mrow__val">230 €</span>
          <span class="ts-mrow__val">350 €</span>
        </div>
        <div class="ts-matrix__row ts-matrix--pere">
          <span class="ts-mrow__label">Père et 2 enfants</span>
          <span class="ts-mrow__val">250 €</span>
          <span class="ts-mrow__val">400 €</span>
        </div>
      </div>

    </div><!-- ts-body -->

  </section>

  </div><!-- /tarifs-block -->

  <!-- ═══ CE QUI EST INCLUS ═══ -->
  <section class="section section--ocean">
    <div class="container inclus-grid">
      <div>
        <p class="eyebrow-light">Dans le tarif</p>
        <h2 class="h2-light">Ce qui est inclus</h2>
        <ul class="inclus-list">
          {inclus.map(item => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="eyebrow-light-muted">Hors tarif</p>
        <h2 class="h2-light">Non inclus</h2>
        <ul class="noninclus-list">
          {nonInclus.map(item => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ SUPPLÉMENTS ═══ -->
  <section class="section section--sand">
    <div class="container">
      <p class="eyebrow">Informations pratiques</p>
      <h2>Suppléments & frais annexes</h2>
      <div class="suppl-list">
        {supplements.map(s => (
          <div class="suppl-row">
            <span class="suppl-label">{s.label}</span>
            {s.note && <span class="suppl-note">{s.note}</span>}
            <span class="suppl-prix">{s.prix}</span>
          </div>
        ))}
      </div>
      <p class="suppl-footer">
        Un supplément carburant peut être appliqué pour tout guidage se déroulant sur un site éloigné du secteur habituel (ex. : saumon de l'Elorn, saumon du Léguer, hors Finistère-Sud).
      </p>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="section section--ocean prest-cta">
    <div class="container prest-cta__inner">
      <div>
        <h2 class="h2-light">Réservez votre stage</h2>
        <p>Disponibilités et informations complémentaires sur demande — réponse sous 24h.</p>
      </div>
      <div class="prest-cta__btns">
        <a href="/contact" class="btn-prim">Me contacter</a>
        <a href="tel:0687303456" class="btn-ghost-light">06 87 30 34 56</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Bloc conteneur des tableaux ───────────────────────────────────────── */
.tarifs-block {
  background: #eceae5;
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

/* ── Hero ──────────────────────────────────────────────────────────────── */
.tarif-hero {
  min-height: 56vh;
  display: flex; align-items: flex-end; padding-bottom: 4.5rem;
  background:
    linear-gradient(to top, rgba(7,24,31,0.96) 0%, rgba(13,43,62,0.55) 55%, rgba(13,43,62,0.3) 100%),
    url('/images/bar-perf-9.jpg') center / cover no-repeat;
  background-color: var(--color-ocean);
  color: white;
}
.tarif-hero__inner { position: relative; z-index: 1; }
.hero-eyebrow {
  font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--color-ocean-light); font-weight: 500; margin-bottom: 0.75rem;
}
.tarif-hero h1 {
  color: white; margin: 0 0 1.1rem;
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  line-height: 1.1;
}
.hero-sub { color: rgba(255,255,255,0.68); max-width: 520px; line-height: 1.7; margin-bottom: 2.2rem; }
.hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

/* ── Boutons ───────────────────────────────────────────────────────────── */
.btn-prim {
  display: inline-block; background: var(--color-ocean-main); color: white;
  padding: 0.78rem 1.8rem; border-radius: 4px; font-weight: 500; font-size: 0.93rem;
  text-decoration: none; transition: background 0.2s;
}
.btn-prim:hover { background: #144b72; }
.btn-ghost {
  display: inline-block; border: 1.5px solid rgba(255,255,255,0.4); color: white;
  padding: 0.78rem 1.8rem; border-radius: 4px; font-weight: 500; font-size: 0.93rem;
  text-decoration: none; transition: border-color 0.2s, background 0.2s;
}
.btn-ghost:hover { border-color: white; background: rgba(255,255,255,0.06); }
.btn-ghost-light {
  display: inline-block; border: 1.5px solid rgba(255,255,255,0.4); color: white;
  padding: 0.78rem 1.8rem; border-radius: 4px; font-weight: 500; font-size: 0.93rem;
  text-decoration: none; transition: border-color 0.2s;
}
.btn-ghost-light:hover { border-color: white; }

/* ── Sections utilitaires ──────────────────────────────────────────────── */
.section { padding: 4.5rem 0; }
.section--white { background: white; }
.section--sand  { background: var(--color-sand, #f8f7f4); }
.section--ocean { background: var(--color-ocean, #0d2b3e); }

.eyebrow {
  font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
