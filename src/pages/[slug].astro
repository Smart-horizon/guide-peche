</style>

<script>
// ── CARROUSEL 3 IMAGES ────────────────────────────────────────────────────────
document.querySelectorAll('.carr3-track-wrap').forEach(wrap => {
  const track  = wrap.querySelector('.carr3-track')
  const slides = wrap.querySelectorAll('.carr3-slide')
  const total  = slides.length
  if (total <= 3) return

  let pos = 0 // index du premier slide visible

  function show(start) {
    pos = ((start % total) + total) % total
    slides.forEach((sl, i) => {
      const visible = i >= pos && i < pos + 3
      sl.style.display = visible ? '' : 'none'
    })
  }

  show(0)

  wrap.querySelector('.carr3-btn--prev')?.addEventListener('click', () => show(pos - 3))
  wrap.querySelector('.carr3-btn--next')?.addEventListener('click', () => show(pos + 3))
})
</script>
