---
import BaseLayout from '../layouts/BaseLayout.astro'
import { client } from '../lib/sanity.js'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(client)
const urlFor  = (source: any) => builder.image(source)

// ── Routes statiques ────────────────────────────────────────────────────────
export async function getStaticPaths() {
  const [pages, prestations, voyages] = await Promise.all([
    client.fetch(`*[_type == "page"       && defined(slug.current)]{ "slug": slug.current }`),
    client.fetch(`*[_type == "prestation" && defined(slug.current)]{ "slug": slug.current }`),
    client.fetch(`*[_type == "voyage"     && defined(slug.current)]{ "slug": slug.current }`),
  ])
  return [...pages, ...prestations, ...voyages]
    .filter(doc => doc.slug && doc.slug !== '/')
    .map(doc => ({ params: { slug: doc.slug } }))
}

const { slug } = Astro.params

// ── Fetch du document (prestation en priorité) ───────────────────────────────
const doc = await client.fetch(
  `coalesce(
    *[_type == "prestation" && slug.current == $slug][0]{
      _type, title, categorie,
      image, heroEyebrow, heroSubtitle, heroMaterielLien,
      description,
      sousPrestations[]{ titre, sousTitre, lien, image },
      niveau, format, saison, tarif, duree,
      gallery[]{ ..., "url": asset->url },
      videoUrl,
      seoTitle, seoDescription
    },
    *[_type == "voyage" && slug.current == $slug][0]{
      _type, title, pays, description, image,
      periode, prix, especes,
      seoTitle, seoDescription
    },
    *[_type == "page" && slug.current == $slug][0]{
      _type, title, contenu, image, seoTitle, seoDescription
    }
  )`,
  { slug }
)

if (!doc) return Astro.redirect('/404')

// ── SEO ───────────────────────────────────────────────────────────────────────
const pageTitle = doc.seoTitle || doc.title
const pageDesc  = doc.seoDescription || ''
const ogImg     = doc.image ? urlFor(doc.image).width(1200).height(630).url() : undefined

// ── Hero ──────────────────────────────────────────────────────────────────────
const heroImg   = doc.image ? urlFor(doc.image).width(1600).height(900).url() : null
const isPrestation = doc._type === 'prestation'
const isVoyage     = doc._type === 'voyage'

// ── Info card ──────────────────────────────────────────────────────────────────
const infoCard = isPrestation ? [
  doc.niveau  && { label: 'Niveau',   value: doc.niveau },
  doc.format  && { label: 'Format',   value: doc.format },
  doc.saison  && { label: 'Saison',   value: doc.saison },
  doc.tarif   && { label: 'Tarif',    value: doc.tarif },
  doc.duree   && { label: 'Durée',    value: doc.duree },
].filter(Boolean) : isVoyage ? [
  doc.periode && { label: 'Période',  value: doc.periode },
  doc.prix    && { label: 'À partir de', value: doc.prix },
  doc.especes && { label: 'Espèces',  value: doc.especes },
].filter(Boolean) : []

// ── Rendu Portable Text ────────────────────────────────────────────────────────
function renderBlocks(blocks: any[]): string {
  if (!blocks?.length) return ''
  return blocks.map(block => {
    if (block._type !== 'block') {
      if (block._type === 'image' && block.asset) {
        const imgUrl = urlFor(block).width(900).url()
        return `<figure><img src="${imgUrl}" alt="${block.alt || ''}" loading="lazy" /></figure>`
      }
      return ''
    }
    const text = (block.children || []).map((span: any) => {
      let t = span.text || ''
      if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`
      if (span.marks?.includes('em'))     t = `<em>${t}</em>`
      const linkMark = (span.marks || []).find((m: string) => m?.length > 5)
      if (linkMark) {
        const href = block.markDefs?.find((d: any) => d._key === linkMark)?.href
        if (href) t = `<a href="${href}">${t}</a>`
      }
      return t
    }).join('')
    const styles: Record<string, string> = { h2: 'h2', h3: 'h3', normal: 'p', blockquote: 'blockquote' }
    const tag = styles[block.style] || 'p'
    return `<${tag}>${text}</${tag}>`
  }).join('')
}

const descHtml = renderBlocks(doc.description || doc.contenu || [])

// ── YouTube embed ──────────────────────────────────────────────────────────────
function getYoutubeId(url: string): string | null {
  const m = url.match(/(?:v=|youtu\.be\/|embed\/)([a-zA-Z0-9_-]{11})/)
  return m ? m[1] : null
}
const youtubeId = doc.videoUrl ? getYoutubeId(doc.videoUrl) : null

// ── Sous-prestations ──────────────────────────────────────────────────────────
const sousPrestations: any[] = doc.sousPrestations || []
const hasSous = sousPrestations.length > 0
---

<BaseLayout title={`${pageTitle} — Jean-Baptiste Vidal`} description={pageDesc} image={ogImg}>

  <!-- ══════════════════════════ HERO ══════════════════════════ -->
  <section class="ph">
    <div
      class="ph__bg"
      style={heroImg
        ? `background-image: linear-gradient(to top, rgba(7,24,31,.9) 0%, rgba(13,43,62,.45) 70%, rgba(13,43,62,.3) 100%), url(${heroImg})`
        : `background: var(--color-ocean)`}
    ></div>
    <div class="ph__content container">
      {doc.heroEyebrow && <p class="ph__eyebrow">{doc.heroEyebrow}</p>}
      {isVoyage && doc.pays  && <p class="ph__eyebrow">{doc.pays}</p>}
      <h1 class="ph__h1">{doc.title}</h1>
      {doc.heroSubtitle && <p class="ph__sub">{doc.heroSubtitle}</p>}
      {isVoyage && doc.periode && <p class="ph__sub">{doc.periode}{doc.especes ? ` · ${doc.especes}` : ''}</p>}
      <div class="ph__cta">
        <a href="/contact"       class="btn-prim">Réserver une sortie</a>
        <a href="tel:0687303456" class="btn-ghost">06 87 30 34 56</a>
        {doc.heroMaterielLien && (
          <a href={doc.heroMaterielLien} class="btn-mat">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            Matériel
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ INTRO + INFO CARD ══════════════ -->
  {(descHtml || infoCard.length > 0) && (
    <section class="section pi">
      <div class="container pi__grid">

        {/* Texte principal */}
        {descHtml && (
          <div class="pi__body prose" set:html={descHtml} />
        )}

        {/* Info card */}
        {infoCard.length > 0 && (
          <aside class="pi__aside">
            <div class="info-card">
              {infoCard.map((row: any) => (
                <>
                  <p class="info-card__label">{row.label}</p>
                  <p class="info-card__val">{row.value}</p>
                </>
              ))}
              <p class="info-card__label">Contact</p>
              <p class="info-card__val">
                06 87 30 34 56<br />
                enjoy.fishing@hotmail.fr
              </p>
            </div>
          </aside>
        )}

      </div>
    </section>
  )}

  <!-- ══════════════════════════ SOUS-PRESTATIONS ════════════════ -->
  {hasSous && (
    <section class="sous-section">
      <div class="sous-grid" data-count={sousPrestations.length}>
        {sousPrestations.map((sp: any, i: number) => {
          const bg = sp.image
            ? urlFor(sp.image).width(800).height(600).url()
            : null
          const isLast = i === sousPrestations.length - 1
          const isOdd  = sousPrestations.length % 2 === 1
          return (
            <a
              href={sp.lien || '#'}
              class:list={['wf-card', isOdd && isLast && 'wf-card--wide']}
            >
              {bg && <div class="wf-card-bg" style={`background-image:url(${bg})`}></div>}
              {!bg && <div class="wf-card-bg"></div>}
              <div class="wf-overlay"></div>
              <div class="wf-body">
                {sp.sousTitre && <span class="wf-sub">{sp.sousTitre}</span>}
                <strong class="wf-label">{sp.titre}</strong>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  )}

  <!-- ══════════════════════════ GALERIE ═════════════════════════ -->
  {doc.gallery?.length > 0 && (
    <section class="section section--mist gallery-section">
      <div class="container">
        <div class="gallery-grid">
          {doc.gallery.map((img: any) => (
            <img
              src={urlFor(img).width(600).height(450).url()}
              alt={img.alt || doc.title}
              loading="lazy"
              class="gallery-img"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════ VIDÉO ══════════════════════════ -->
  {youtubeId && (
    <section class="section section--sand video-section">
      <div class="container" style="max-width:860px">
        <div class="video-wrap">
          <iframe
            src={`https://www.youtube.com/embed/${youtubeId}`}
            title={doc.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════ CTA FINAL ══════════════════════ -->
  <section class="section section--dark pf-cta">
    <div class="container pf-cta__inner">
      <div>
        <h2>Réservez votre sortie</h2>
        <p>Disponibilités et tarifs sur demande — réponse sous 24h.</p>
      </div>
      <div class="pf-cta__btns">
        <a href="/contact"       class="btn-prim">Me contacter</a>
        <a href="tel:0687303456" class="btn-ghost-light">06 87 30 34 56</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO ── */
  .ph {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 4rem;
    color: white;
  }
  .ph__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-color: var(--color-ocean);
  }
  .ph__content {
    position: relative;
    z-index: 1;
    padding-top: var(--header-height);
  }
  .ph__eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    margin-bottom: 0.8rem;
    font-weight: 500;
  }
  .ph__h1 {
    color: white;
    margin-bottom: 1rem;
    max-width: 720px;
  }
  .ph__sub {
    color: rgba(255,255,255,0.75);
    max-width: 560px;
    line-height: 1.65;
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }
  .ph__cta { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* boutons hero */
  .btn-prim {
    background: var(--color-ocean-main);
    color: white;
    padding: 0.75rem 1.8rem;
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s;
  }
  .btn-prim:hover { background: #144b72; }
  .btn-ghost {
    border: 1.5px solid rgba(255,255,255,0.4);
    color: white;
    padding: 0.75rem 1.8rem;
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: border-color 0.2s;
  }
  .btn-ghost:hover { border-color: white; }
  .btn-mat {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1.5px solid rgba(126,200,227,0.5);
    color: var(--color-ocean-light);
    padding: 0.75rem 1.4rem;
    border-radius: 4px;
    font-size: 0.88rem;
    font-weight: 500;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-mat:hover { border-color: var(--color-ocean-light); color: white; }

  /* ── INTRO + INFO CARD ── */
  .pi__grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }

  .prose :global(p) {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 1.25rem;
    font-size: 1.025rem;
  }
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    color: var(--color-text);
    margin: 2rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--color-text);
    margin: 1.5rem 0 0.5rem;
  }
  .prose :global(a) {
    color: var(--color-ocean-main);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(figure) { margin: 1.5rem 0; }
  .prose :global(figure img) { border-radius: 6px; width: 100%; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-ocean-light);
    padding-left: 1.2rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .info-card {
    background: var(--color-sand);
    border: 1px solid #e0dfd9;
    border-radius: 8px;
    padding: 1.5rem;
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }
  .info-card__label {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ocean-main);
    font-weight: 600;
    margin-bottom: 0.2rem;
    margin-top: 1rem;
  }
  .info-card__label:first-child { margin-top: 0; }
  .info-card__val {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  /* ── SOUS-PRESTATIONS ── */
  .sous-section { background: var(--color-ocean); }
  .sous-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    min-height: 520px;
  }
  .wf-card {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 260px;
    overflow: hidden;
    text-decoration: none;
    color: white;
  }
  .wf-card--wide { grid-column: 1 / -1; }
  .wf-card-bg {
    position: absolute;
    inset: 0;
    background: var(--color-ocean) center / cover no-repeat;
    transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);
  }
  .wf-card:hover .wf-card-bg { transform: scale(1.04); }
  .wf-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7,24,31,.85) 0%, transparent 65%);
    transition: opacity 0.3s;
  }
  .wf-card:hover .wf-overlay { opacity: 0.7; }
  .wf-body {
    position: relative;
    z-index: 1;
    padding: 1.5rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .wf-sub {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    font-weight: 500;
  }
  .wf-label {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.25;
  }

  /* ── GALERIE ── */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .gallery-img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 4px;
  }

  /* ── VIDÉO ── */
  .video-wrap {
    position: relative;
    padding-bottom: 56.25%;
    border-radius: 6px;
    overflow: hidden;
  }
  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* ── CTA FINAL ── */
  .pf-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .pf-cta h2 { color: white; margin-bottom: 0.4rem; }
  .pf-cta p  { color: rgba(255,255,255,0.7); }
  .pf-cta__btns { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-ghost-light {
    border: 1.5px solid rgba(255,255,255,0.35);
    color: white;
    padding: 0.75rem 1.8rem;
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: border-color 0.2s;
  }
  .btn-ghost-light:hover { border-color: white; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .pi__grid { grid-template-columns: 1fr; }
    .info-card { position: static; order: -1; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .ph { min-height: 60vh; }
    .sous-grid { grid-template-columns: 1fr; }
    .wf-card--wide { grid-column: auto; }
    .gallery-grid { grid-template-columns: 1fr; }
    .pf-cta__inner { flex-direction: column; text-align: center; }
    .pf-cta__btns { justify-content: center; }
  }
</style>
