---
import BaseLayout from '../layouts/BaseLayout.astro'
import MatierielBtn from '../components/MatierielBtn.astro'
import { client, stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(stegaClient)
const urlFor  = (source: any) => builder.image(source)

// ── Routes statiques (client non-stega — juste des slugs) ────────────────────
export async function getStaticPaths() {
  const [pages, prestations, voyages] = await Promise.all([
    client.fetch(`*[_type == "page"       && defined(slug.current)]{ "slug": slug.current }`),
    client.fetch(`*[_type == "prestation" && defined(slug.current)]{ "slug": slug.current }`),
    client.fetch(`*[_type == "voyage"     && defined(slug.current)]{ "slug": slug.current }`),
  ])
  return [...pages, ...prestations, ...voyages]
    .filter(d => d.slug && d.slug !== '/')
    .map(d => ({ params: { slug: d.slug } }))
}

const { slug } = Astro.params

// ── Fetch du document (stegaClient — active les overlays Visual Editing) ─────
const doc = await stegaClient.fetch(
  `coalesce(
    *[_type == "prestation" && slug.current == $slug][0]{
      _type, title, categorie,
      pagebuilder[]{
        ...,
        image{ asset->{ _id, url, metadata{ dimensions } } },
        photos[]{ asset->{ _id, url } },
        images[]{ asset->{ _id, url } },
        cards[]{ ..., image{ asset->{ _id, url, metadata{ dimensions } } } },
      },
      seoTitle, seoDescription, ogImage
    },
    *[_type == "voyage" && slug.current == $slug][0]{
      _type, title, pays, description, image,
      periode, prix, especes,
      seoTitle, seoDescription
    },
    *[_type == "page" && slug.current == $slug][0]{
      _type, title, contenu, image, seoTitle, seoDescription
    }
  )`,
  { slug }
)

if (!doc) return Astro.redirect('/404')

// ── SEO ───────────────────────────────────────────────────────────────────────
const heroSection  = doc.pagebuilder?.find((s: any) => s._type === 'sectionHero')
const pageTitle    = doc.seoTitle || heroSection?.titre || doc.title
const pageDesc     = doc.seoDescription || ''
const ogImg        = doc.ogImage
  ? urlFor(doc.ogImage).width(1200).height(630).url()
  : heroSection?.image
    ? urlFor(heroSection.image).width(1200).height(630).url()
    : undefined

// ── Rendu Portable Text ───────────────────────────────────────────────────────
function blocks(content: any[]): string {
  if (!content?.length) return ''
  return content.map((b: any) => {
    if (b._type !== 'block') {
      if (b._type === 'image' && b.asset) {
        const u = urlFor(b).width(900).url()
        return `<figure><img src="${u}" alt="${b.alt || ''}" loading="lazy"/></figure>`
      }
      return ''
    }
    const html = (b.children || []).map((span: any) => {
      let t = (span.text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`
      if (span.marks?.includes('em'))     t = `<em>${t}</em>`
      const linkKey = (span.marks || []).find((m: any) => m?.length > 5)
      if (linkKey) {
        const href = b.markDefs?.find((d: any) => d._key === linkKey)?.href
        if (href) t = `<a href="${href}">${t}</a>`
      }
      return t
    }).join('')
    const tag: Record<string,string> = { h2:'h2', h3:'h3', blockquote:'blockquote', normal:'p' }
    const el = tag[b.style] || 'p'
    return `<${el} class="pb-${el}">${html}</${el}>`
  }).join('')
}

// ── Fond de section ───────────────────────────────────────────────────────────
const bgClass: Record<string,string> = {
  white: '',
  sand:  'section--sand',
  mist:  'section--mist',
  dark:  'section--dark',
}
// stegaClean sur un fond (champ enum)
const bg = (fond: string) => bgClass[stegaClean(fond) ?? ''] ?? ''

// ── YouTube ID ────────────────────────────────────────────────────────────────
const ytId = (url: string) => url?.match(/(?:v=|youtu\.be\/|embed\/)([a-zA-Z0-9_-]{11})/)?.[1] ?? null

// ── Helpers hero (évite les TypeScript génériques dans le JSX) ──────────────
const heroHeight = (h: string) => {
  const v = stegaClean(h)
  return v === 'medium' ? '52vh' : v === 'compact' ? '36vh' : '72vh'
}

const heroBg = (image: any) => {
  if (!image?.asset) return 'background:var(--color-ocean)'
  const url = urlFor(image).width(1600).height(900).url()
  return `background:linear-gradient(to top,rgba(7,24,31,.88) 0%,rgba(13,43,62,.45) 60%,rgba(13,43,62,.3) 100%),url(${url}) center/cover no-repeat`
}
---

<BaseLayout title={`${pageTitle} — Jean-Baptiste Vidal`} description={pageDesc} image={ogImg}>

  {/* ── PAGE BUILDER ── */}
  {doc.pagebuilder?.map((s: any) => (

    <>
    {/* ════════════ HERO ════════════ */}
    {s._type === 'sectionHero' && (
      <section class="pb-hero" style={`min-height:${heroHeight(s.hauteur)}`}>
        <div class="pb-hero__bg" style={heroBg(s.image)}></div>
        <div class="pb-hero__content container">
          {s.eyebrow && <p class="pb-eyebrow">{s.eyebrow}</p>}
          <h1 class="pb-hero__h1">{s.titre}</h1>
          {s.sousTitre && <p class="pb-hero__sub">{s.sousTitre}</p>}
          <div class="pb-hero__cta">
            <a href={s.btnReserverLien || '/contact'} class="btn-prim">{s.btnReserverTexte || 'Réserver une sortie'}</a>
            <a href={`tel:${(s.btnTelTexte || '06 87 30 34 56').replace(/\s/g,'')}`} class="btn-ghost">{s.btnTelTexte || '06 87 30 34 56'}</a>
            {s.btnMaterielLien && (
              <MatierielBtn href={s.btnMaterielLien} label={s.btnMaterielLabel || 'Matériel'} />
            )}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ INTRO + INFO CARD ════════════ */}
    {s._type === 'sectionIntro' && (
      <section class={`section pb-intro ${bg(s.fond)||''}`}>
        <div class="container pb-intro__grid">
          <div class="prose" set:html={blocks(s.texte)} />
          {s.showInfoCard !== false && (
            <aside>
              <div class="info-card">
                {s.niveau && <><p class="info-lbl">Niveau</p><p class="info-val">{s.niveau}</p></>}
                {s.format && <><p class="info-lbl">Format</p><p class="info-val">{s.format}</p></>}
                {s.saison && <><p class="info-lbl">Saison</p><p class="info-val">{s.saison}</p></>}
                {s.tarif  && <><p class="info-lbl">Tarif</p> <p class="info-val">{s.tarif}</p></>}
                {s.duree  && <><p class="info-lbl">Durée</p> <p class="info-val">{s.duree}</p></>}
                <p class="info-lbl">Contact</p>
                <p class="info-val">06 87 30 34 56<br/>enjoy.fishing@hotmail.fr</p>
              </div>
            </aside>
          )}
        </div>
      </section>
    )}

    {/* ════════════ CARDS ════════════ */}
    {s._type === 'sectionCards' && (
      <section class="pb-cards">
        {s.titre && <div class="container" style="padding-top:3rem"><h2 class="pb-section-titre">{s.titre}</h2></div>}
        <div class="sous-grid" data-count={s.cards?.length}>
          {s.cards?.map((c: any, i: number) => {
            const isLast   = i === s.cards.length - 1
            const isOdd    = s.cards.length % 2 === 1
            const cardImgUrl = c.image?.asset
              ? urlFor(c.image).width(800).height(600).fit('crop').url()
              : null
            return (
              <a href={c.lien||'#'} class:list={['wf-card', isOdd&&isLast&&'wf-card--wide']}>
                <div class="wf-card-bg" style={cardImgUrl ? `background-image:url(${cardImgUrl});background-position:${stegaClean(c.positionPhoto)||'center center'}` : ''}></div>
                <div class="wf-overlay"></div>
                <div class="wf-body">
                  {c.sousTitre && <span class="wf-sub">{c.sousTitre}</span>}
                  <strong class="wf-label">{c.titre}</strong>
                </div>
              </a>
            )
          })}
        </div>
      </section>
    )}

    {/* ════════════ TEXTE ════════════ */}
    {s._type === 'sectionTexte' && (
      <section class={`section pb-texte ${bg(s.fond)||''}`}>
        <div class="container" style={`max-width:${s.largeur==='wide'?'960px':s.largeur==='full'?'var(--max-width)':'760px'}`}>
          <div class="prose" set:html={blocks(s.texte)} />
        </div>
      </section>
    )}

    {/* ════════════ TEXTE + IMAGE ════════════ */}
    {s._type === 'sectionTexteImage' && (
      <section class={`section pb-ti ${bg(s.fond)||''}`}>
        <div class="container pb-ti__grid" data-pos={stegaClean(s.imagePosition)||'right'}>
          <div class="prose" set:html={blocks(s.texte)} />
          {s.texteImageUrl && (
            <figure class="pb-ti__fig">
              <img src={`${s.texteImageUrl}?w=680&fit=crop`} alt={s.image?.alt || ''} loading="lazy" />
            </figure>
          )}
        </div>
      </section>
    )}

    {/* ════════════ GALERIE ════════════ */}
    {s._type === 'sectionGalerie' && (
      <section class={`section pb-galerie ${bg(s.fond)||'section--mist'}`}>
        <div class="container">
          {s.titre && <h2 class="pb-section-titre">{s.titre}</h2>}
          <div class="galerie-grid" style={`grid-template-columns:repeat(${stegaClean(s.colonnes)||3},1fr)`}>
            {s.photos?.map((p: any) => (
              <img src={urlFor(p).width(600).height(450).fit('crop').url()} alt={p.alt||''} loading="lazy" class="galerie-img"/>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ VIDÉO ════════════ */}
    {s._type === 'sectionVideo' && ytId(s.url) && (
      <section class={`section pb-video ${bg(s.fond)||'section--sand'}`}>
        <div class="container" style="max-width:860px">
          {s.titre && <h2 class="pb-section-titre">{s.titre}</h2>}
          <div class="video-wrap">
            <iframe
              src={`https://www.youtube.com/embed/${ytId(s.url)}`}
              title={s.titre || pageTitle}
              allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>
    )}

    {/* ════════════ STATS ════════════ */}
    {s._type === 'sectionStats' && (
      <section class={`section pb-stats ${bg(s.fond)||'section--dark'}`}>
        <div class="container pb-stats__grid">
          {s.stats?.map((st: any) => (
            <div class="pb-stat">
              <strong class="pb-stat__num">{st.nombre}</strong>
              <span  class="pb-stat__lbl">{st.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* ════════════ CTA FINAL ════════════ */}
    {s._type === 'sectionCta' && (
      <section class={`section pb-cta ${bg(s.style)||'section--dark'}`}>
        <div class="container pb-cta__inner">
          <div>
            <h2 class="pb-cta__h2" style={stegaClean(s.style)==='dark'||!s.style?'color:white':''}>{s.titre}</h2>
            {s.texte && <p class="pb-cta__sub">{s.texte}</p>}
          </div>
          <div class="pb-cta__btns">
            <a href={s.btn1Lien||'/contact'} class="btn-prim">{s.btn1Texte||'Me contacter'}</a>
            {s.btn2Texte && <a href={s.btn2Lien||'tel:0687303456'} class="btn-ghost-light">{s.btn2Texte}</a>}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ BANNIÈRE ════════════ */}
    {s._type === 'sectionBanniere' && (
      <div class={`pb-banniere pb-banniere--${stegaClean(s.style)||'ocean'}`}>
        {s.lien
          ? <a href={s.lien} class="pb-banniere__inner container">{s.texte}</a>
          : <p class="pb-banniere__inner container">{s.texte}</p>
        }
      </div>
    )}

    {/* ════════════ CARROUSEL 3 IMAGES ════════════ */}
    {s._type === 'sectionCarrousel3Images' && (
      <section class={`section pb-carr ${bg(s.fond)||''}`}>
        <div class="container">
          {s.titre && <h2 class="pb-section-titre">{s.titre}</h2>}
          <div class="carr3-track-wrap">
            <div class="carr3-track" data-ratio={s.ratio||'4/3'}>
              {s.images?.map((img: any) => (
                <div class="carr3-slide">
                  <img
                    src={urlFor(img).width(600).url()}
                    alt={img.alt||''}
                    loading="lazy"
                    style={`aspect-ratio:${stegaClean(s.ratio)||'4/3'};object-fit:cover;width:100%;border-radius:4px`}
                  />
                  {img.legende && <p class="carr3-legende">{img.legende}</p>}
                </div>
              ))}
            </div>
            {s.images?.length > 3 && (
              <div class="carr3-nav">
                <button class="carr3-btn carr3-btn--prev" aria-label="Précédent">‹</button>
                <button class="carr3-btn carr3-btn--next" aria-label="Suivant">›</button>
              </div>
            )}
          </div>
        </div>
      </section>
    )}
    </>

  ))}

  {/* ── Fallback pages génériques (type page / voyage sans pagebuilder) ── */}
  {!doc.pagebuilder && (
    <>
      <section class="pb-hero" style="min-height:52vh">
        <div class="pb-hero__bg" style={doc.image
          ? `background:linear-gradient(to top,rgba(7,24,31,.9),rgba(13,43,62,.4)),url(${urlFor(doc.image).width(1600).url()});background-size:cover;background-position:center`
          : 'background:var(--color-ocean)'}></div>
        <div class="pb-hero__content container">
          {doc.pays && <p class="pb-eyebrow">{doc.pays}</p>}
          <h1 class="pb-hero__h1">{doc.title}</h1>
          {doc.periode && <p class="pb-hero__sub">{doc.periode}{doc.especes ? ` · ${doc.especes}` : ''}</p>}
        </div>
      </section>

      <section class="section">
        <div class="container" style="max-width:760px">
          <div class="prose" set:html={blocks(doc.description || doc.contenu || [])} />
          {doc.prix && <p style="margin-top:1.5rem;color:var(--color-ocean-main);font-weight:600">À partir de {doc.prix}</p>}
        </div>
      </section>

      <section class="section section--dark pb-cta">
        <div class="container pb-cta__inner">
          <div>
            <h2 style="color:white">Réservez votre sortie</h2>
            <p class="pb-cta__sub">Disponibilités sur demande — réponse sous 24h.</p>
          </div>
          <div class="pb-cta__btns">
            <a href="/contact"        class="btn-prim">Me contacter</a>
            <a href="tel:0687303456"  class="btn-ghost-light">06 87 30 34 56</a>
          </div>
        </div>
      </section>
    </>
  )}

</BaseLayout>

<style>
/* ── HERO ── */
.pb-hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  padding-bottom: 4rem;
  color: white;
}
.pb-hero__bg {
  position: absolute;
  inset: 0;
  background-color: var(--color-ocean);
}
.pb-hero__content {
  position: relative;
  z-index: 1;
  padding-top: var(--header-height);
}
.pb-eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-ocean-light);
  margin-bottom: 0.8rem;
  font-weight: 500;
}
.pb-hero__h1 {
  color: white;
  margin-bottom: 1rem;
  max-width: 720px;
}
.pb-hero__sub {
  color: rgba(255,255,255,0.75);
  max-width: 580px;
  line-height: 1.65;
  margin-bottom: 2rem;
  font-size: 1.05rem;
}
.pb-hero__cta { display: flex; gap: 1rem; flex-wrap: wrap; }

/* ── Boutons ── */
.btn-prim {
  background: var(--color-ocean-main);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: background 0.2s;
}
.btn-prim:hover { background: #144b72; }
.btn-ghost {
  border: 1.5px solid rgba(255,255,255,0.4);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: border-color 0.2s;
}
.btn-ghost:hover { border-color: white; }
.btn-ghost-light {
  border: 1.5px solid rgba(255,255,255,0.35);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: border-color 0.2s;
}
.btn-ghost-light:hover { border-color: white; }
.btn-mat {
  display: flex; align-items: center; gap: 0.4rem;
  border: 1.5px solid rgba(126,200,227,0.5);
  color: var(--color-ocean-light);
  padding: 0.75rem 1.4rem;
  border-radius: 4px;
  font-size: 0.88rem;
  font-weight: 500;
  transition: border-color 0.2s, color 0.2s;
}
.btn-mat:hover { border-color: var(--color-ocean-light); color: white; }

/* ── INTRO + INFO CARD ── */
.pb-intro__grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 4rem;
  align-items: start;
}
.info-card {
  background: var(--color-sand);
  border-radius: 6px;
  padding: 1.6rem;
  border-left: 3px solid var(--color-ocean-main);
  position: sticky;
  top: calc(var(--header-height) + 2rem);
}
.info-lbl {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-top: 1.2rem;
}
.info-lbl:first-child { margin-top: 0; }
.info-val {
  font-size: 0.92rem;
  color: var(--color-text);
  line-height: 1.55;
}

/* ── PROSE (Portable Text) ── */
.prose :global(.pb-p) {
  color: var(--color-text);
  line-height: 1.8;
  margin-bottom: 1.2rem;
  font-size: 1rem;
}
.prose :global(.pb-h2) {
  font-family: var(--font-serif);
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  color: var(--color-text);
  margin: 2rem 0 0.75rem;
}
.prose :global(.pb-h3) {
  font-family: var(--font-serif);
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  color: var(--color-text);
  margin: 1.5rem 0 0.5rem;
}
.prose :global(.pb-blockquote) {
  border-left: 3px solid var(--color-ocean-light);
  padding-left: 1.2rem;
  margin: 1.5rem 0;
  font-style: italic;
  color: var(--color-text-muted);
}
.prose :global(a) { color: var(--color-ocean-main); text-decoration: underline; text-underline-offset: 2px; }
.prose :global(figure) { margin: 1.5rem 0; }
.prose :global(figure img) { border-radius: 6px; width: 100%; }

/* ── CARDS (sous-prestations) ── */
/* Pas de background sur la section = gap blanc entre les cartes (comme l'original) */
.pb-cards { overflow: hidden; }
.pb-section-titre {
  margin-bottom: 2rem;
  color: var(--color-text);
}
.section--dark .pb-section-titre { color: white; }
.sous-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
}
/* Hauteurs : les cartes normales = 380px, la wide (dernière) = 500px */
.wf-card {
  position: relative;
  display: block;
  height: 380px;
  overflow: hidden;
  text-decoration: none;
  color: white;
  background: var(--color-ocean);
}
.wf-card--wide {
  grid-column: 1 / -1;
  height: 500px;
}
.wf-card-bg {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  transition: transform 0.6s ease;
}
.wf-card:hover .wf-card-bg { transform: scale(1.06); }
.wf-card::after {
  content: '';
  position: absolute; inset: 0;
  background: rgba(7,24,31,0.25);
  transition: background 0.35s ease;
}
.wf-card:hover::after { background: rgba(7,24,31,0.1); }
.wf-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(7,24,31,.75) 0%, transparent 55%);
  z-index: 1;
}
.wf-body {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 1.5rem 1.75rem 1.75rem;
  z-index: 2;
  display: flex; flex-direction: column; gap: 0.2rem;
}
.wf-sub {
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-ocean-light);
  font-weight: 500;
}
.wf-label {
  font-family: var(--font-serif);
  font-size: 1.45rem;
  font-weight: 500;
  line-height: 1.2;
  color: white;
}

/* ── TEXTE + IMAGE ── */
.pb-ti__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}
.pb-ti__grid[data-pos="left"] .pb-ti__fig { order: -1; }
.pb-ti__fig img { border-radius: 6px; width: 100%; }

/* ── GALERIE ── */
.galerie-grid {
  display: grid;
  gap: 1rem;
}
.galerie-img {
  width: 100%; aspect-ratio: 4/3;
  object-fit: cover; border-radius: 4px;
}

/* ── VIDÉO ── */
.video-wrap {
  position: relative;
  padding-bottom: 56.25%;
  border-radius: 6px; overflow: hidden;
  margin-top: 1.5rem;
}
.video-wrap iframe {
  position: absolute; inset: 0;
  width: 100%; height: 100%; border: none;
}

/* ── STATS ── */
