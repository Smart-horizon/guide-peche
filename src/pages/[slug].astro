---
import BaseLayout from '../layouts/BaseLayout.astro'
import RelatedArticles from '../components/RelatedArticles.astro'
import { articlesPourPage } from '../lib/maillage.js'
import { fullTitle } from '../lib/seo.js'
import PageBuilderSections from '../components/PageBuilderSections.astro'
import { client } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(client)
const urlFor = (source: any) => { const b = builder.image(source); const hs = source?.hotspot; return (hs?.x != null && hs?.y != null) ? b.focalPoint(hs.x, hs.y) : b }

// ── Routes statiques générées au build depuis Sanity ─────────────────────────
export async function getStaticPaths() {
  const docs = await client.fetch(`
    *[_type in ["page", "prestation", "voyage"] && defined(slug.current)]{ "slug": slug.current }
  `)
  return docs
    .filter((d: any) => d.slug && d.slug !== '/')
    .map((d: any) => ({ params: { slug: d.slug } }))
}

const { slug } = Astro.params

// ── Requête universelle avec tous les champs nécessaires ──────────────────────
const doc = await client.fetch(`
  *[slug.current == $slug && _type in ["page", "prestation", "voyage"]][0]{
    _id, _type, title, categorie, pays, especes, periode, prix, contenu, description,
    pagebuilder[]{
      ...,
      image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      btnFichier{ asset->{ _id, url } },
      photos[]{ _type, hotspot, crop, asset->{ _id, url }, alt },
      images[]{ _type, hotspot, crop, asset->{ _id, url }, alt, legende },
      cards[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      etapes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      'options': options[]{
        ...,
        image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      },
      'galerie': galerie[]{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      items[]{..., photos[]{ _type, hotspot, crop, asset->{_id, url}, alt, caption}},
      cartes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url } } },
      boutons[]{ ..., fichier{ asset->{ _id, url } } },
      specs[],
      liens[],
      sejours[],
      stats[],
      lignesInfo[],
    },
    image, seoTitle, seoDescription, ogImage
  }
`, { slug })

if (!doc) return Astro.redirect('/404')

// ── SEO ───────────────────────────────────────────────────────────────────────
const heroSection  = doc.pagebuilder?.find((s: any) => s._type === 'sectionHero')
const pageTitle    = doc.seoTitle || heroSection?.titre || doc.title
const pageDesc     = doc.seoDescription || ''
const ogImg        = doc.ogImage
  ? urlFor(doc.ogImage).width(1200).height(630).fit('crop').crop('focalpoint').url()
  : heroSection?.image
    ? urlFor(heroSection.image).width(1200).height(630).fit('crop').crop('focalpoint').url()
    : undefined

// ── JSON-LD : fil d'Ariane + Service (prestations/voyages) ────────────────────
const siteBase = Astro.site?.toString().replace(/\/$/, '') || ''
const jsonLd: object[] = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: doc.title, item: `${siteBase}/${slug}` },
  ],
}]

if (doc._type === 'prestation' || doc._type === 'voyage') {
  // Prix : uniquement si un montant chiffré existe (voyages)
  const prixNum = typeof doc.prix === 'string' ? doc.prix.replace(/[^\d]/g, '') : null
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: doc.title,
    serviceType: doc._type === 'voyage' ? 'Voyage de pêche à la mouche' : 'Guidage et stage de pêche à la mouche',
    provider: { '@id': `${siteBase}/#business` },
    areaServed: doc._type === 'voyage' && doc.pays ? doc.pays : 'Bretagne-Sud, France',
    url: `${siteBase}/${slug}`,
    ...(pageDesc ? { description: pageDesc } : {}),
    ...(prixNum && prixNum.length >= 2 ? {
      offers: { '@type': 'Offer', price: prixNum, priceCurrency: 'EUR' },
    } : {}),
  })
}

// ── Maillage interne : les récits qui CIBLENT cette page (puis même espèce) ───
// Actif sur TOUTES les pages : prestations/voyages (repli espèce) mais aussi
// les pages hub (matériel, mouches, vidéos, presse…) dès qu'un article les
// cible — automatiquement ou via le champ "Prestation liée" rempli par JBV.
const tousArticles = await client.fetch(`
  *[_type == "article"] | order(date desc) {
    title, "slug": slug.current, date, image, espece, tags,
    prestationLiee->{ title, "slug": slug.current },
    pageLiee->{ title, "slug": slug.current }
  }
`)
const articlesLies = articlesPourPage(slug, doc, tousArticles)
// stegaClean : en aperçu, doc.categorie porte des marqueurs invisibles et
// l'égalité stricte échouerait → titre générique alors que le site publié
// affiche le bon. Toute comparaison de chaîne Sanity doit être nettoyée.
const relTitre = stegaClean(doc.categorie) === 'bar' ? 'Derniers récits de pêche au bar'
  : doc._type === 'voyage' ? 'Derniers récits de voyage'
  : doc._type === 'page' ? 'À lire sur le blog'
  : 'Derniers récits de pêche'

// Si JBV a placé lui-même une section "📰 Blog" dans le Page Builder,
// elle remplace la section automatique de bas de page.
const pageHasBlogSection = doc.pagebuilder?.some((s: any) => s._type === 'sectionBlog') ?? false

// Coordonnées (⚙️ Paramètres) pour le CTA du layout de secours
const paramsContact = await client.fetch(`*[_id == "siteParametres"][0]{ telephone }`)
const fallbackTel = paramsContact?.telephone || '06 87 30 34 56'

// ── Utilitaires pour le fallback (pages sans pagebuilder) ─────────────────────
function spanHtml(b: any): string {
  return (b.children || []).map((span: any) => {
    let t = (span.text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`
    if (span.marks?.includes('em'))     t = `<em>${t}</em>`
    const linkKey = (span.marks || []).find((m: any) => m?.length > 5)
    if (linkKey) {
      const href = b.markDefs?.find((d: any) => d._key === linkKey)?.href
      if (href) t = `<a href="${href}">${t}</a>`
    }
    return t
  }).join('')
}

function blocks(content: any[]): string {
  if (!content?.length) return ''
  let out = '', i = 0
  while (i < content.length) {
    const b = content[i]
    if (b._type !== 'block') {
      if (b._type === 'image' && b.asset) {
        const u = urlFor(b).width(900).url()
        out += `<figure><img src="${u}" alt="${b.alt || ''}" loading="lazy"/></figure>`
      }
      i++; continue
    }
    if (b.listItem) {
      const tag = b.listItem === 'number' ? 'ol' : 'ul'
      out += `<${tag} class="pb-list pb-list--${b.listItem}">`
      while (i < content.length && content[i]._type === 'block' && content[i].listItem === b.listItem) {
        out += `<li>${spanHtml(content[i])}</li>`
        i++
      }
      out += `</${tag}>`
      continue
    }
    const tag: Record<string,string> = { h2:'h2', h3:'h3', blockquote:'blockquote', normal:'p' }
    const el = tag[b.style] || 'p'
    out += `<${el} class="pb-${el}">${spanHtml(b)}</${el}>`
    i++
  }
  return out
}
---

<BaseLayout
  title={fullTitle(pageTitle)}
  description={pageDesc}
  image={ogImg}
  lang="fr"
  hreflangFr={`/${slug}`}
  hreflangEn={`/en/${slug}`}
  jsonLd={jsonLd}
>

  {/* ── PAGE BUILDER ── */}
  <PageBuilderSections sections={doc.pagebuilder} pageTitle={pageTitle} articlesLies={articlesLies} />

  {/* ── Fallback pages génériques (type page / voyage sans pagebuilder) ── */}
  {!doc.pagebuilder && (
    <>
      <section class="pb-hero" style="min-height:52vh">
        <div class="pb-hero__bg" style={doc.image
          ? `background:linear-gradient(to top,rgba(7,24,31,.9),rgba(13,43,62,.4)),url(${urlFor(doc.image).width(1600).url()});background-size:cover;background-position:center`
          : 'background:var(--color-ocean)'}></div>
        <div class="pb-hero__content container">
          {doc.pays && <p class="pb-eyebrow">{doc.pays}</p>}
          <h1 class="pb-hero__h1">{doc.title}</h1>
          {doc.periode && <p class="pb-hero__sub">{doc.periode}{doc.especes ? ` · ${doc.especes}` : ''}</p>}
        </div>
      </section>

      <section class="section">
        <div class="container" style="max-width:760px">
          <div class="prose" set:html={blocks(doc.description || doc.contenu || [])} />
          {doc.prix && <p style="margin-top:1.5rem;color:var(--color-ocean-main);font-weight:600">À partir de {doc.prix}</p>}
        </div>
      </section>

      <section class="section section--dark pb-cta">
        <div class="container pb-cta__inner">
          <div>
            <h2 style="color:white">Réservez votre sortie</h2>
            <p class="pb-cta__sub">Disponibilités sur demande — réponse sous 24h.</p>
          </div>
          <div class="pb-cta__btns">
            <a href="/contact"        class="btn-prim">Me contacter</a>
            <a href={`tel:${fallbackTel.replace(/\s/g, '')}`} class="btn-ghost-light">{fallbackTel}</a>
          </div>
        </div>
      </section>
    </>
  )}

  {/* ── Maillage interne : derniers récits du même thème (masqué si une
       section 📰 Blog est déjà placée dans le Page Builder) ── */}
  {!pageHasBlogSection && <RelatedArticles articles={articlesLies} titre={relTitre} lang="fr" />}

</BaseLayout>
