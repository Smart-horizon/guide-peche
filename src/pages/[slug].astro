---
import BaseLayout from '../layouts/BaseLayout.astro'
import MatierielBtn from '../components/MatierielBtn.astro'
import { client, stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(stegaClient)
const urlFor  = (source: any) => builder.image(source)

// ── Routes statiques (client non-stega — juste des slugs) ────────────────────
export async function getStaticPaths() {
  const [pages, prestations, voyages] = await Promise.all([
    client.fetch(`*[_type == "page"       && defined(slug.current)]{ "slug": slug.current }`),
    client.fetch(`*[_type == "prestation" && defined(slug.current)]{ "slug": slug.current }`),
    client.fetch(`*[_type == "voyage"     && defined(slug.current)]{ "slug": slug.current }`),
  ])
  return [
    ...pages      .filter(d => d.slug && d.slug !== '/').map(d => ({ params: { slug: d.slug }, props: { docType: 'page'        } })),
    ...prestations.filter(d => d.slug && d.slug !== '/').map(d => ({ params: { slug: d.slug }, props: { docType: 'prestation'  } })),
    ...voyages    .filter(d => d.slug && d.slug !== '/').map(d => ({ params: { slug: d.slug }, props: { docType: 'voyage'      } })),
  ]
}

const { slug } = Astro.params
const { docType } = Astro.props

// ── Fetch du document (stegaClient — active les overlays Visual Editing) ─────
// Une requête directe par type (sans coalesce) : stega obtient un chemin propre,
// ce qui garantit que Visual Editing navigue vers le bon champ dans Studio.
const QUERIES: Record<string, string> = {
  prestation: `*[_type == "prestation" && slug.current == $slug][0]{
    _id, _type, title, categorie,
    pagebuilder[]{
      ...,
      image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      btnFichier{ asset->{ _id, url } },
      photos[]{ asset->{ _id, url } },
      images[]{ asset->{ _id, url } },
      cards[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      etapes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
    },
    seoTitle, seoDescription, ogImage
  }`,
  voyage: `*[_type == "voyage" && slug.current == $slug][0]{
    _id, _type, title, pays, especes, periode, prix,
    pagebuilder[]{
      ...,
      image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      btnFichier{ asset->{ _id, url } },
      photos[]{ asset->{ _id, url } },
      images[]{ asset->{ _id, url } },
      cards[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      etapes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      'options': options[]{
        ...,
        image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      },
      'galerie': galerie[]{
        asset->{ _id, url, metadata{ dimensions } }
      },
      items[],
      sejours[],
      stats[],
      lignesInfo[],
    },
    seoTitle, seoDescription, ogImage
  }`,
  page: `*[_type == "page" && slug.current == $slug][0]{
    _id, _type, title, contenu, image, seoTitle, seoDescription,
    pagebuilder[]{
      ...,
      image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      btnFichier{ asset->{ _id, url } },
      photos[]{ asset->{ _id, url } },
      images[]{ asset->{ _id, url } },
      cards[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      etapes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      items[]{..., photos[]{asset->{_id, url}, alt, caption}},
    }
  }`,
}

const doc = await stegaClient.fetch(QUERIES[docType], { slug })

if (!doc) return Astro.redirect('/404')

// ── SEO ───────────────────────────────────────────────────────────────────────
const heroSection  = doc.pagebuilder?.find((s: any) => s._type === 'sectionHero')
const pageTitle    = doc.seoTitle || heroSection?.titre || doc.title
const pageDesc     = doc.seoDescription || ''
const ogImg        = doc.ogImage
  ? urlFor(doc.ogImage).width(1200).height(630).url()
  : heroSection?.image
    ? urlFor(heroSection.image).width(1200).height(630).url()
    : undefined

// ── Rendu Portable Text ───────────────────────────────────────────────────────
function spanHtml(b: any): string {
  return (b.children || []).map((span: any) => {
    let t = (span.text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`
    if (span.marks?.includes('em'))     t = `<em>${t}</em>`
    const linkKey = (span.marks || []).find((m: any) => m?.length > 5)
    if (linkKey) {
      const href = b.markDefs?.find((d: any) => d._key === linkKey)?.href
      if (href) t = `<a href="${href}">${t}</a>`
    }
    return t
  }).join('')
}

function blocks(content: any[]): string {
  if (!content?.length) return ''
  let out = '', i = 0
  while (i < content.length) {
    const b = content[i]
    // Non-block (image, etc.)
    if (b._type !== 'block') {
      if (b._type === 'image' && b.asset) {
        const u = urlFor(b).width(900).url()
        out += `<figure><img src="${u}" alt="${b.alt || ''}" loading="lazy"/></figure>`
      }
      i++; continue
    }
    // Listes (puces ou numérotées) — regroupe les items consécutifs du même type
    if (b.listItem) {
      const tag = b.listItem === 'number' ? 'ol' : 'ul'
      out += `<${tag} class="pb-list pb-list--${b.listItem}">`
      while (i < content.length && content[i]._type === 'block' && content[i].listItem === b.listItem) {
        out += `<li>${spanHtml(content[i])}</li>`
        i++
      }
      out += `</${tag}>`
      continue
    }
    // Bloc normal
    const tag: Record<string,string> = { h2:'h2', h3:'h3', blockquote:'blockquote', normal:'p' }
    const el = tag[b.style] || 'p'
    out += `<${el} class="pb-${el}">${spanHtml(b)}</${el}>`
    i++
  }
  return out
}

// ── Fond de section ───────────────────────────────────────────────────────────
const bgClass: Record<string,string> = {
  white: 'section--white',
  sand:  'section--sand',
  mist:  'section--mist',
  dark:  'section--dark',
  ocean: 'section--ocean', // CTA style "Bleu océan"
}
// stegaClean sur un fond (champ enum)
const bg = (fond: string) => bgClass[stegaClean(fond) ?? ''] ?? ''

// ── YouTube ID ────────────────────────────────────────────────────────────────
const ytId = (url: string) => url?.match(/(?:v=|youtu\.be\/|embed\/)([a-zA-Z0-9_-]{11})/)?.[1] ?? null

// ── Helpers hero (évite les TypeScript génériques dans le JSX) ──────────────
const heroHeight = (h: string) => {
  const v = stegaClean(h)
  return v === 'medium' ? '52vh' : v === 'compact' ? '36vh' : '72vh'
}

const heroBg = (image: any) => {
  if (!image?.asset) return 'background:var(--color-ocean)'
  const url = urlFor(image).width(1600).height(900).url()
  return `background:linear-gradient(to top,rgba(7,24,31,.88) 0%,rgba(13,43,62,.45) 60%,rgba(13,43,62,.3) 100%),url(${url}) center/cover no-repeat`
}
---

<BaseLayout title={`${pageTitle} — Jean-Baptiste Vidal`} description={pageDesc} image={ogImg}>

  {/* ── PAGE BUILDER ── */}
  {doc.pagebuilder?.map((s: any) => (

    <>
    {/* ════════════ HERO ════════════ */}
    {s._type === 'sectionHero' && (
      <section class="pb-hero" style={`min-height:${heroHeight(s.hauteur)}`}>
        {ytId(stegaClean(s.videoYoutubeUrl) || '') ? (
          <>
            <div class="pb-hero__yt-wrapper">
              {(() => {
                const vid   = ytId(stegaClean(s.videoYoutubeUrl) || '')!
                const debut = s.videoYoutubeDebut ?? 0
                const fin   = s.videoYoutubeFin
                const params = new URLSearchParams({
                  autoplay: '1', mute: '1', loop: '1', playlist: vid,
                  controls: '0', rel: '0', iv_load_policy: '3',
                  modestbranding: '1', playsinline: '1', disablekb: '1',
                  start: String(debut),
                  ...(fin != null ? { end: String(fin) } : {}),
                })
                return (
                  <iframe
                    class="pb-hero__yt-iframe"
                    src={`https://www.youtube-nocookie.com/embed/${vid}?${params}`}
                    allow="autoplay; encrypted-media"
                    title="hero video"
                  />
                )
              })()}
            </div>
            <div class="pb-hero__overlay"></div>
          </>
        ) : stegaClean(s.videoUrl) ? (
          <>
            <video
              class="pb-hero__video"
              autoplay loop muted playsinline
              poster={s.image?.asset ? urlFor(s.image).width(1600).height(900).url() : undefined}
            >
              {stegaClean(s.videoWebmUrl) && <source src={stegaClean(s.videoWebmUrl)} type="video/webm" />}
              <source src={stegaClean(s.videoUrl)} type="video/mp4" />
            </video>
            <div class="pb-hero__overlay"></div>
          </>
        ) : (
          <div class="pb-hero__bg" style={heroBg(s.image)}></div>
        )}
        <div class="pb-hero__content container">
          {s.eyebrow && <p class="pb-eyebrow">{s.eyebrow}</p>}
          <h1 class="pb-hero__h1">{s.titre}</h1>
          {s.sousTitre && <p class="pb-hero__sub">{s.sousTitre}</p>}
          <div class="pb-hero__cta">
            {stegaClean(s.btnReserverTexte) && (
              <a href={s.btnReserverLien || '/contact'} class="btn-prim">{s.btnReserverTexte}</a>
            )}
            {stegaClean(s.btnTelTexte) && (
              <a href={`tel:${stegaClean(s.btnTelTexte).replace(/\s/g,'')}`} class="btn-ghost">{s.btnTelTexte}</a>
            )}
            {s.btnMaterielLien && (
              <MatierielBtn href={s.btnMaterielLien} label={s.btnMaterielLabel || 'Matériel'} />
            )}
            {stegaClean(s.btnYoutubeLien) && (
              <a href={stegaClean(s.btnYoutubeLien)} class="btn-youtube" target="_blank" rel="noopener noreferrer">
                <svg class="btn-youtube__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="currentColor"/>
                </svg>
                {s.btnYoutubeTexte || "S'abonner à ma chaîne"}
              </a>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ INTRO + INFO CARD ════════════ */}
    {s._type === 'sectionIntro' && (
      <section class={`section pb-intro ${bg(s.fond)||''}`}>
        <div class="container pb-intro__grid">
          <div class="pb-intro__left">
            <div class="pb-intro__body">
              {stegaClean(s.eyebrow) && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
              {stegaClean(s.titre)   && <h2 class="pb-intro__h2">{s.titre}</h2>}
              <div class="prose" set:html={blocks(s.texte)} />
            </div>
            {s.intervenant?.nom && (
              <div class="expert-card">
                {s.intervenant.avatar && (
                  <div class="expert-card__avatar">{s.intervenant.avatar}</div>
                )}
                <div>
                  <strong class="expert-card__name">{s.intervenant.nom}</strong>
                  {s.intervenant.titre && (
                    <span class="expert-card__title">{s.intervenant.titre}</span>
                  )}
                  {s.intervenant.bio && (
                    <p class="expert-card__bio">{s.intervenant.bio}</p>
                  )}
                </div>
              </div>
            )}
          </div>
          {s.showInfoCard !== false && (
            <aside>
              <div class="info-card">
                {s.niveau && <><p class="info-lbl">Niveau</p><p class="info-val">{s.niveau}</p></>}
                {s.format && <><p class="info-lbl">Format</p><p class="info-val">{s.format}</p></>}
                {s.saison && <><p class="info-lbl">Saison</p><p class="info-val">{s.saison}</p></>}
                {s.tarif  && <><p class="info-lbl">Tarif</p> <p class="info-val">{s.tarif}</p></>}
                {s.duree  && <><p class="info-lbl">Durée</p> <p class="info-val">{s.duree}</p></>}
                {s.lignesSupp?.map((l: any) => l.label && (
                  <><p class="info-lbl">{l.label}</p><p class="info-val">{l.valeur}</p></>
                ))}
                <p class="info-lbl">Contact</p>
                <p class="info-val">06 87 30 34 56<br/>enjoy.fishing@hotmail.fr</p>
                {s.boutons?.map((btn: any) => (
                  <a href={btn.lien} class="info-card-btn">{btn.texte}</a>
                ))}
              </div>
            </aside>
          )}
        </div>
      </section>
    )}

    {/* ════════════ CARDS ════════════ */}
    {s._type === 'sectionCards' && (
      <section class="pb-cards">
        {s.titre && <div class="container" style="padding-top:3rem"><h2 class="pb-section-titre">{s.titre}</h2></div>}
        <div class="sous-grid" data-count={s.cards?.length}>
          {s.cards?.map((c: any, i: number) => {
            const isLast   = i === s.cards.length - 1
            const isOdd    = s.cards.length % 2 === 1
            const cardImgUrl = c.image?.asset
              ? urlFor(c.image).width(800).height(600).fit('crop').crop('focalpoint').url()
              : null
            return (
              <a href={c.lien||'#'} class:list={['wf-card', isOdd&&isLast&&'wf-card--wide']}>
                <div class="wf-card-bg" style={cardImgUrl ? `background-image:url(${cardImgUrl});background-position:${stegaClean(c.positionPhoto)||'center center'}` : ''}></div>
                <div class="wf-overlay"></div>
                <div class="wf-body">
                  {c.sousTitre && <span class="wf-sub">{c.sousTitre}</span>}
                  <strong class="wf-label">{c.titre}</strong>
                </div>
              </a>
            )
          })}
        </div>
      </section>
    )}

    {/* ════════════ CARDS STYLE 2 ════════════ */}
    {s._type === 'sectionCards2' && (
      <section class={`pb-cards2 ${bg(s.fond)||''}`}>
        {(s.eyebrow || s.titre) && (
          <div class="container pb-cards2__header">
            {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
            {s.titre   && <h2 class="pb-section-titre">{s.titre}</h2>}
          </div>
        )}
        <div class="pb-cards2__grid" style={`grid-template-columns:repeat(${stegaClean(s.colonnes)||4},1fr)`}>
          {s.cards?.map((c: any) => {
            const cardImgUrl = c.image?.asset
              ? urlFor(c.image).width(800).height(600).fit('crop').crop('focalpoint').url()
              : null
            return (
              <a href={c.lien||'#'} class="wf-card">
                <div class="wf-card-bg" style={cardImgUrl ? `background-image:url(${cardImgUrl});background-position:${stegaClean(c.positionPhoto)||'center center'}` : ''}></div>
                <div class="wf-overlay"></div>
                <div class="wf-body">
                  {c.sousTitre && <span class="wf-sub">{c.sousTitre}</span>}
                  <strong class="wf-label">{c.titre}</strong>
                </div>
              </a>
            )
          })}
        </div>
      </section>
    )}

    {/* ════════════ TEXTE ════════════ */}
    {s._type === 'sectionTexte' && (
      <section class={`section pb-texte ${bg(s.fond)||''}`}>
        <div class="container" style={`max-width:${s.largeur==='wide'?'960px':s.largeur==='full'?'var(--max-width)':'760px'}`}>
          <div class="prose" set:html={blocks(s.texte)} />
        </div>
      </section>
    )}

    {/* ════════════ TEXTE + IMAGE ════════════ */}
    {s._type === 'sectionTexteImage' && (
      <section class={`section pb-ti ${bg(s.fond)||''}`}>
        <div class="container pb-ti__grid" data-pos={stegaClean(s.imagePosition)||'right'}>
          <div class="pb-ti__text">
            {stegaClean(s.eyebrow) && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
            {stegaClean(s.titre) && <h2 class="pb-ti__h2">{s.titre}</h2>}
            <div class="prose" set:html={blocks(s.texte)} />
            {s.distances?.length > 0 && (
              <div class="pb-ti__chips">
                {s.distances.map((d: string) => (
                  <span class="pb-ti__chip">{d}</span>
                ))}
              </div>
            )}
          </div>
          {(s.image?.asset || s.texteImageUrl) && (
            <figure class="pb-ti__fig">
              {s.image?.asset
                ? <img src={urlFor(s.image).width(680).height(520).fit('crop').crop('focalpoint').url()} alt={s.image?.alt || ''} loading="lazy" />
                : <img src={`${s.texteImageUrl}?w=680&fit=crop`} alt={s.image?.alt || ''} loading="lazy" />
              }
            </figure>
          )}
        </div>
      </section>
    )}

    {/* ════════════ GALERIE ════════════ */}
    {s._type === 'sectionGalerie' && (
      <section class={`section pb-galerie ${bg(s.fond)||'section--mist'}`}>
        <div class="container">
          {s.titre && <h2 class="pb-section-titre">{s.titre}</h2>}
          <div class="galerie-grid" style={`grid-template-columns:repeat(${stegaClean(s.colonnes)||3},1fr)`}>
            {s.photos?.map((p: any) => (
              <img src={urlFor(p).width(600).height(450).fit('crop').crop('focalpoint').url()} alt={p.alt||''} loading="lazy" class="galerie-img"/>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ VIDÉO ════════════ */}
    {s._type === 'sectionVideo' && ytId(s.url) && (
      <section class={`section pb-video2 ${bg(s.fond)||''}`}>
        <div class={`container pb-video2__grid${stegaClean(s.videoPosition)==='right' ? ' pb-video2__grid--rev' : ''}`}>
          <div class="pb-video2__player">
            <div class="video-wrap">
              <iframe
                src={`https://www.youtube.com/embed/${ytId(s.url)}`}
                title={s.titre || pageTitle}
                allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
          <div class="pb-video2__text">
            {s.eyebrow && <p class="pb-video2__eyebrow">{s.eyebrow}</p>}
            {s.titre   && <h2 class="pb-video2__titre">{s.titre}</h2>}
            {s.description && <p class="pb-video2__desc">{s.description}</p>}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ INFOS CLÉS BANDEAU ════════════ */}
    {s._type === 'sectionStats' && (
      <div class={`pb-bandeau ${bg(s.fond)||'section--dark'}`}>
        <div class="pb-bandeau__grid">
          {s.stats?.map((st: any) => (
            <div class="pb-bandeau__item">
              <strong class="pb-bandeau__titre">{st.nombre}</strong>
              <span   class="pb-bandeau__sub">{st.label}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* ════════════ PROGRAMME / ÉTAPES ════════════ */}
    {s._type === 'sectionProgramme' && (
      <section class={`section pb-prog ${bg(s.fond)||'section--sand'}`}>
        <div class="container">
          {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
          {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
          {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
          <div class="pb-prog__rows">
            {s.etapes?.map((etape: any, i: number) => {
              const imgUrl = etape.image?.asset
                ? urlFor(etape.image).width(1200).url()
                : null
              const hp = etape.image?.hotspot
              const objPos = hp
                ? `${Math.round(stegaClean(hp.x) * 100)}% ${Math.round(stegaClean(hp.y) * 100)}%`
                : 'center center'
              return (
                <div class:list={['pb-prog__row', i % 2 === 1 && 'pb-prog__row--rev']}>
                  <div class="pb-prog__img">
                    {imgUrl && <img src={imgUrl} alt={etape.image?.alt || etape.titre || ''} loading="lazy" style={`object-position:${objPos}`} />}
                  </div>
                  <div class="pb-prog__body">
                    <div class="pb-prog__num">{String(i + 1).padStart(2, '0')}</div>
                    <h3>{etape.titre}</h3>
                    {etape.tag && <span class="pb-prog__tag">{etape.tag}</span>}
                    <div class="pb-prog__text prose" set:html={blocks(etape.texte)} />
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ PROGRAMME SANS IMAGE ════════════ */}
    {s._type === 'sectionProgrammeTexte' && (
      <section class={`section pb-prog-txt ${bg(s.fond)||'section--sand'}`}>
        <div class="container">
          {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
          {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
          {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
          <div class="pb-prog-txt__grid">
            {s.colonnes?.map((col: any) => {
              const isCheck = stegaClean(col.style) === 'check'
              return (
                <div class="pb-prog-txt__card">
                  {col.label && <div class="pb-prog-txt__label">{col.label}</div>}
                  <ul class:list={['pb-prog-txt__list', isCheck && 'pb-prog-txt__list--check']}>
                    {col.items?.map((item: any) => (
                      <li class:list={[isCheck && (item.inclus !== false ? 'ok' : 'no')]}>
                        {item.texte}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            })}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ MISE EN PAGE D'INFO ════════════ */}
    {s._type === 'sectionProgrammeCartes' && (() => {
      const imgUrl = s.image?.asset ? urlFor(s.image).width(560).height(460).fit('crop').crop('focalpoint').url() : null
      return (
        <section class={`section pb-prog-cart ${bg(s.fond)||'section--sand'}`}>
          <div class="container">
            {/* Header : image optionnelle + titre/intro côte à côte */}
            {imgUrl ? (
              <div class="pb-prog-cart__header" data-pos={stegaClean(s.imagePosition)||'left'}>
                <figure class="pb-prog-cart__header-img">
                  <img src={imgUrl} alt={s.image?.alt || s.titre || ''} loading="lazy" />
                </figure>
                <div class="pb-prog-cart__header-text">
                  {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
                  {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
                  {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
                </div>
              </div>
            ) : (
              <>
                {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
                {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
                {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
              </>
            )}
            {/* Grille de cartes */}
            <div class="pb-prog-cart__grid" style={`grid-template-columns:repeat(${stegaClean(s.colonnes)||3},1fr)`}>
              {s.items?.map((item: any, i: number) => (
                <div class="pb-prog-cart__card">
                  <span class="pb-prog-cart__num">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="pb-prog-cart__h3">{item.titre}</h3>
                  {item.sousTitre && <p class="pb-prog-cart__sub">{item.sousTitre}</p>}
                  {item.description && <p class="pb-prog-cart__desc">{item.description}</p>}
                </div>
              ))}
            </div>
            {/* Note de bas de section */}
            {s.note && <p class="pb-prog-cart__note">{s.note}</p>}
            {/* Bouton optionnel — fichier PDF Sanity ou URL externe */}
            {s.btnTexte && (s.btnFichier?.asset?.url || s.btnLien) && (
              <div class="pb-prog-cart__btn-wrap">
                <a href={s.btnFichier?.asset?.url || s.btnLien} class="btn-download" download={!!s.btnFichier?.asset?.url}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  {s.btnTexte}
                </a>
              </div>
            )}
          </div>
        </section>
      )
    })()}

    {/* ════════════ SÉLECTION ════════════ */}
    {s._type === 'sectionSelection' && (
      <section class={`section pb-sel ${bg(s.fond)||'section--white'}`}>
        <div class="container">
          {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
          {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
          {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
          <div class="pb-sel__list">
            {s.items?.map((item: any, i: number) => {
              const imgUrl = item.image?.asset
                ? urlFor(item.image).width(900).height(700).fit('crop').crop('focalpoint').url()
                : null
              const isReverse = i % 2 === 1
              const bodySand  = stegaClean(s.styleCorps) !== 'white'
              return (
                <div class:list={['pb-sel__block', isReverse && 'pb-sel__block--rev']}>
                  <div class="pb-sel__img">
                    {imgUrl && <img src={imgUrl} alt={item.image?.alt || item.titre || ''} loading="lazy" />}
                  </div>
                  <div class:list={['pb-sel__body', bodySand && 'pb-sel__body--sand']}>
                    {item.tag && <p class="pb-sel__tag">{item.tag}</p>}
                    <h3 class="pb-sel__h3">{item.titre}</h3>
                    <div class="pb-sel__text prose" set:html={blocks(item.texte)} />
                    {item.pills?.length > 0 && (
                      <ul class="pb-sel__pills">
                        {item.pills.map((p: string) => <li>{p}</li>)}
                      </ul>
                    )}
                    {item.infos?.length > 0 && (
                      <div class="pb-sel__infos">
                        {item.infos.map((inf: any) => (
                          <div class="pb-sel__info-item">
                            <span class="pb-sel__info-lbl">{inf.label}</span>
                            <span class="pb-sel__info-val">{inf.valeur}</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ BILAN DE SÉJOUR ════════════ */}
    {s._type === 'sectionBilan' && (() => {
      const imgUrl = s.image?.asset ? urlFor(s.image).width(680).height(520).fit('crop').crop('focalpoint').url() : null
      return (
        <section class={`section pb-bilan ${bg(s.fond)||'section--sand'}`}>
          <div class="container pb-bilan__inner">
            <div class="pb-bilan__text">
              {s.eyebrow  && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
              {s.titre    && <h2 class="pb-prog__h2">{s.titre}</h2>}
              {s.contexte && <p class="pb-bilan__contexte">{s.contexte}</p>}
              <div class="prose" set:html={blocks(s.texte)} />
              {s.resultats?.length > 0 && (
                <div class="pb-bilan__resultats">
                  {s.resultats.map((r: any) => (
                    <div class="pb-bilan__resultat">
                      <span class="pb-bilan__res-val">{r.valeur}</span>
                      <span class="pb-bilan__res-lbl">{r.label}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
            {imgUrl && (
              <figure class="pb-bilan__img">
                <img src={imgUrl} alt={s.image?.alt || s.titre || ''} loading="lazy" />
              </figure>
            )}
          </div>
        </section>
      )
    })()}

    {/* ════════════ DATES DES SÉJOURS ════════════ */}
    {s._type === 'sectionDates' && (
      <section class={`section pb-dates ${bg(s.fond)||'section--dark'}`}>
        <div class="container">
          {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
          {s.titre   && <h2 class="pb-prog__h2" style="color:white">{s.titre}</h2>}
          {s.intro   && <p class="pb-dates__intro">{s.intro}</p>}
          <div class="pb-dates__grid">
            {s.sejours?.map((sej: any) => {
              const statut = stegaClean(sej.statut) || 'disponible'
              const icons = { disponible: '🟢', 'peu-de-places': '🟡', complet: '🔴', 'liste-attente': '⏳' } as const
              const labels = { disponible: 'Disponible', 'peu-de-places': 'Quelques places', complet: 'Complet', 'liste-attente': "Liste d'attente" } as const
              return (
                <div class="pb-dates__card">
                  <div class="pb-dates__card-header">
                    <span class="pb-dates__statut">{icons[statut]} {labels[statut]}</span>
                    {sej.placesDispo != null && statut !== 'complet' && (
                      <span class="pb-dates__places">{sej.placesDispo} place(s)</span>
                    )}
                  </div>
                  <h3 class="pb-dates__h3">{sej.dates}</h3>
                  {sej.destination  && <p class="pb-dates__dest">{sej.destination}</p>}
                  {sej.description  && <p class="pb-dates__desc">{sej.description}</p>}
                  {sej.prix         && <p class="pb-dates__prix">{sej.prix}</p>}
                </div>
              )
            })}
          </div>
          {s.btnTexte && s.btnLien && (
            <div class="pb-dates__cta">
              <a href={s.btnLien} class="btn-prim">{s.btnTexte}</a>
            </div>
          )}
        </div>
      </section>
    )}

    {/* ════════════ CTA FINAL ════════════ */}
    {s._type === 'sectionCta' && (
      <section class={`section pb-cta ${bg(s.style)||'section--dark'}`}>
        <div class="container pb-cta__inner">
          <div>
            <h2 class="pb-cta__h2" style={stegaClean(s.style)==='dark'||!s.style?'color:white':''}>{s.titre}</h2>
            {s.texte && <p class="pb-cta__sub">{s.texte}</p>}
          </div>
          <div class="pb-cta__btns">
            <a href={s.btn1Lien||'/contact'} class="btn-prim">{s.btn1Texte||'Me contacter'}</a>
            {s.btn2Texte && <a href={s.btn2Lien||'tel:0687303456'} class="btn-ghost-light">{s.btn2Texte}</a>}
          </div>
        </div>
      </section>
    )}

    {/* ════════════ TITRE DE SECTION ════════════ */}
    {s._type === 'sectionTitre' && (
      <section class={`pb-st ${bg(s.fond)||''}`}>
        <div class={`container pb-st__inner${stegaClean(s.alignement)==='left' ? ' pb-st__inner--left' : ''}`}>
          {s.eyebrow && <p class="pb-st__eyebrow">{s.eyebrow}</p>}
          <h2 class="pb-st__h2">{s.titre}</h2>
          {s.sousTitre && <p class="pb-st__sub">{s.sousTitre}</p>}
        </div>
      </section>
    )}

    {/* ════════════ BANNIÈRE ════════════ */}
    {s._type === 'sectionBanniere' && (
      <div class={`pb-banniere pb-banniere--${stegaClean(s.style)||'ocean'}`}>
        {s.lien
          ? <a href={s.lien} class="pb-banniere__inner container">{s.texte}</a>
          : <p class="pb-banniere__inner container">{s.texte}</p>
        }
      </div>
    )}

    {/* ════════════ CARROUSEL 3 IMAGES ════════════ */}
    {s._type === 'sectionCarrousel3Images' && (
      <section class={`pb-carr-outer ${bg(s.fond)||'section--dark'}`}>
        {s.titre && (
          <div class="container" style="padding-top:2.5rem;padding-bottom:1.5rem">
            <h2 class="pb-section-titre">{s.titre}</h2>
          </div>
        )}
        <div class="carr3-wrap" data-carr>
          <div class="carr3-track">
            {s.images?.map((img: any, i: number) => (
              <div class="carr3-slide" style={`aspect-ratio:${stegaClean(s.ratio)||'3/2'}`}>
                <img
                  src={urlFor(img).width(1400).url()}
                  alt={img.alt||''}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                {img.legende && <span class="carr3-caption">{img.legende}</span>}
              </div>
            ))}
          </div>
          <button class="carr3-btn carr3-btn--prev" aria-label="Précédent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="carr3-btn carr3-btn--next" aria-label="Suivant">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
          </button>
          <div class="carr3-counter">1 / {s.images?.length || 0}</div>
        </div>
      </section>
    )}
    {/* ════════════ LIEN BLOG ════════════ */}
    {s._type === 'sectionLienBlog' && stegaClean(s.urlArticle) && (
      <section class={`section ${bg(s.fond)||'section--white'}`}>
        <div class="container pb-blog-section">
          <div class="pb-blog-card">
            <div class="pb-blog-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/></svg>
            </div>
            <div class="pb-blog-card__body">
              {stegaClean(s.eyebrow) && (
                <p class={`eyebrow${stegaClean(s.fond)==='dark' ? ' eyebrow--light' : ''}`}>{s.eyebrow}</p>
              )}
              <h3>{s.titre}</h3>
              {stegaClean(s.description) && <p>{s.description}</p>}
              <a href={stegaClean(s.urlArticle)} class="pb-blog-card__btn" target="_blank" rel="noopener noreferrer">
                {stegaClean(s.labelBouton) || 'Lire l\'article →'}
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    {/* ════════════ FRISE CHRONOLOGIQUE ════════════ */}
    {s._type === 'sectionFriseChronologique' && s.items?.length > 0 && (
      <section class={`section ${bg(s.fond)||'section--sand'}`}>
        <div class="container">
          {(stegaClean(s.eyebrow) || stegaClean(s.titre)) && (
            <div class="frise-header">
              {stegaClean(s.eyebrow) && <p class="pb-eyebrow frise-eyebrow">{s.eyebrow}</p>}
              {stegaClean(s.titre) && <h2 class="frise-h2">{s.titre}</h2>}
              {stegaClean(s.sousTitre) && <p class="frise-sub">{s.sousTitre}</p>}
            </div>
          )}
          {(s.statsBar?.length > 0 || stegaClean(s.citation)) && (
            <div class="tl-stats-bar">
              {s.statsBar?.map((stat: any, si: number) => (
                <>
                  {si > 0 && <div class="tl-stat-sep" />}
                  <div class="tl-stat-item">
                    <span class="tl-stat-num">{stat.nombre}</span>
                    <span class="tl-stat-lbl">{stat.label}</span>
                  </div>
                </>
              ))}
              {s.statsBar?.length > 0 && stegaClean(s.citation) && (
                <div class="tl-stat-sep tl-stat-sep--hide-sm" />
              )}
              {stegaClean(s.citation) && (
                <blockquote class="tl-stat-quote">{s.citation}</blockquote>
              )}
            </div>
          )}
          <div class="timeline" id="timeline-list">
            {s.items?.map((item: any, i: number) => {
              const hasPhotos = (item.photos?.length ?? 0) > 0
              return (
                <div class={`timeline-item${hasPhotos ? ' has-photo' : ''}`} data-idx={String(i)}>
                  <div class="timeline-periode">{item.periode}</div>
                  <div class="timeline-dot">
                    {hasPhotos && (
                      <svg class="dot-camera" viewBox="0 0 24 24" fill="currentColor" width="8" height="8" aria-hidden="true">
                        <path d="M20 5h-3.17L15 3H9L7.17 5H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-8 13c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                      </svg>
                    )}
                  </div>
                  <div class="timeline-content">
                    <h3>{item.lieu}</h3>
                    {stegaClean(item.detail) && <p>{item.detail}</p>}
                  </div>
                  {hasPhotos && (
                    <div class="tl-expand">
                      <div class="tl-expand-inner">
                        <div class="tl-expand-body">
                          <div class="tl-carousel" data-total={String(item.photos.length)}>
                            <div class="tl-car-track">
                              {item.photos.map((ph: any) => (
                                <div class="tl-car-slide">
                                  <div class="tl-expand-photo">
                                    <img
                                      src={ph.asset?.url}
                                      alt={stegaClean(ph.alt) || stegaClean(item.lieu) || ''}
                                      loading="lazy"
                                      width="560"
                                      height="373"
                                    />
                                    {stegaClean(ph.caption) && (
                                      <span class="tl-expand-caption">{ph.caption}</span>
                                    )}
                                  </div>
                                </div>
                              ))}
                            </div>
                            {item.photos.length > 1 && (
                              <>
                                <button class="tl-car-btn tl-car-prev" aria-label="Photo précédente" type="button">
                                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                                </button>
                                <button class="tl-car-btn tl-car-next" aria-label="Photo suivante" type="button">
                                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                                </button>
                                <div class="tl-car-counter">1 / {item.photos.length}</div>
                              </>
                            )}
                          </div>
                          {stegaClean(item.lien) && (
                            <a href={stegaClean(item.lien)} class="tl-expand-link">
                              {stegaClean(item.lienLabel) || 'Voir →'}
                            </a>
                          )}
                          {stegaClean(item.lien2) && (
                            <a href={stegaClean(item.lien2)} class="tl-expand-link tl-expand-link--temo">
                              {stegaClean(item.lienLabel2) || 'Témoignage →'}
                            </a>
                          )}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              )
            })}
          </div>
        </div>
      </section>
    )}

    </>

  ))}

  {/* ── Fallback pages génériques (type page / voyage sans pagebuilder) ── */}
  {!doc.pagebuilder && (
    <>
      <section class="pb-hero" style="min-height:52vh">
        <div class="pb-hero__bg" style={doc.image
          ? `background:linear-gradient(to top,rgba(7,24,31,.9),rgba(13,43,62,.4)),url(${urlFor(doc.image).width(1600).url()});background-size:cover;background-position:center`
          : 'background:var(--color-ocean)'}></div>
        <div class="pb-hero__content container">
          {doc.pays && <p class="pb-eyebrow">{doc.pays}</p>}
          <h1 class="pb-hero__h1">{doc.title}</h1>
          {doc.periode && <p class="pb-hero__sub">{doc.periode}{doc.especes ? ` · ${doc.especes}` : ''}</p>}
        </div>
      </section>

      <section class="section">
        <div class="container" style="max-width:760px">
          <div class="prose" set:html={blocks(doc.description || doc.contenu || [])} />
          {doc.prix && <p style="margin-top:1.5rem;color:var(--color-ocean-main);font-weight:600">À partir de {doc.prix}</p>}
        </div>
      </section>

      <section class="section section--dark pb-cta">
        <div class="container pb-cta__inner">
          <div>
            <h2 style="color:white">Réservez votre sortie</h2>
            <p class="pb-cta__sub">Disponibilités sur demande — réponse sous 24h.</p>
          </div>
          <div class="pb-cta__btns">
            <a href="/contact"        class="btn-prim">Me contacter</a>
            <a href="tel:0687303456"  class="btn-ghost-light">06 87 30 34 56</a>
          </div>
        </div>
      </section>
    </>
  )}

</BaseLayout>

<style>
/* ── HERO ── */
.pb-hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  padding-bottom: 4rem;
  color: white;
}
.pb-hero__bg {
  position: absolute;
  inset: 0;
  background-color: var(--color-ocean);
}
.pb-hero__yt-wrapper {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}
.pb-hero__yt-iframe {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100vw;
  height: 56.25vw;
  min-width: 177.78vh;
  min-height: 100vh;
  transform: translate(-50%, -50%);
  border: none;
}
.pb-hero__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.pb-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(7,24,31,.88) 0%, rgba(13,43,62,.5) 55%, rgba(13,43,62,.25) 100%);
}
.pb-hero__content {
  position: relative;
  z-index: 1;
  padding-top: var(--header-height);
}
.pb-eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-ocean-light);
  margin-bottom: 0.8rem;
  font-weight: 500;
}
.pb-hero__h1 {
  color: white;
  margin-bottom: 1rem;
  max-width: 720px;
}
.pb-hero__sub {
  color: rgba(255,255,255,0.75);
  max-width: 580px;
  line-height: 1.65;
  margin-bottom: 2rem;
  font-size: 1.05rem;
}
.pb-hero__cta { display: flex; gap: 1rem; flex-wrap: wrap; }

/* ── Boutons ── */
.btn-prim {
  background: var(--color-ocean-main);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: background 0.2s;
}
.btn-prim:hover { background: #144b72; }
.btn-ghost {
  border: 1.5px solid rgba(255,255,255,0.4);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: border-color 0.2s;
}
.btn-ghost:hover { border-color: white; }
.btn-youtube {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  border: 1.5px solid rgba(255,255,255,0.4);
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: border-color 0.2s, background 0.2s;
}
.btn-youtube:hover {
  border-color: #FF0000;
  background: rgba(255,0,0,0.12);
}
.btn-youtube__icon {
  width: 20px;
  height: 20px;
  color: #FF0000;
  flex-shrink: 0;
}
.btn-ghost-light {
  border: 1.5px solid rgba(255,255,255,0.35);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: border-color 0.2s;
}
.btn-ghost-light:hover { border-color: white; }
.btn-mat {
  display: flex; align-items: center; gap: 0.4rem;
  border: 1.5px solid rgba(126,200,227,0.5);
  color: var(--color-ocean-light);
  padding: 0.75rem 1.4rem;
  border-radius: 4px;
  font-size: 0.88rem;
  font-weight: 500;
  transition: border-color 0.2s, color 0.2s;
}
.btn-mat:hover { border-color: var(--color-ocean-light); color: white; }

/* ── TITRE DE SECTION ── */
.pb-st {
  padding: 3.5rem 0 1.5rem;
}
.pb-st__inner {
  text-align: center;
  max-width: 760px;
  margin: 0 auto;
}
.pb-st__inner--left {
  text-align: left;
  max-width: var(--max-width);
}
.pb-st__eyebrow {
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-ocean-main);
  font-weight: 500;
  margin-bottom: 0.6rem;
}
.section--dark .pb-st__eyebrow { color: var(--color-ocean-light); }
.pb-st__h2 {
  color: var(--color-text);
  margin-bottom: 0;
}
.section--dark .pb-st__h2 { color: white; }
.pb-st__sub {
  color: var(--color-text-muted);
  max-width: 600px;
  margin: 0.9rem auto 0;
  line-height: 1.7;
  font-size: 1rem;
}
.pb-st__inner--left .pb-st__sub { margin-left: 0; }
.section--dark .pb-st__sub { color: rgba(255,255,255,0.7); }

/* ── INTRO + INFO CARD ── */
.pb-intro__grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 4rem;
  align-items: start;
}
.pb-intro__h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  color: var(--color-text);
  margin: 0.3rem 0 1.4rem;
  line-height: 1.2;
}
.section--dark .pb-intro__h2,
.section--ocean .pb-intro__h2 { color: white; }
.info-card {
  background: var(--color-sand);
  border-radius: 6px;
  padding: 1.6rem;
  border-left: 3px solid var(--color-ocean-main);
  position: sticky;
  top: calc(var(--header-height) + 2rem);
}
.info-lbl {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-top: 1.2rem;
}
.info-lbl:first-child { margin-top: 0; }
.info-val {
  font-size: 0.92rem;
  color: var(--color-text);
  line-height: 1.55;
}
.info-card-btn {
  display: block;
  margin-top: 1.2rem;
  text-align: center;
  background: var(--color-ocean-main);
  color: white;
  padding: 0.7rem 1rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.88rem;
  text-decoration: none;
  transition: background 0.2s;
}
.info-card-btn:hover { background: #144b72; }

/* ── PROSE (Portable Text) ── */
.prose :global(.pb-p) {
  color: var(--color-text);
  line-height: 1.8;
  margin-bottom: 1.2rem;
  font-size: 1rem;
}
.prose :global(.pb-h2) {
  font-family: var(--font-serif);
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  color: var(--color-text);
  margin: 2rem 0 0.75rem;
}
.prose :global(.pb-h3) {
  font-family: var(--font-serif);
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  color: var(--color-text);
  margin: 1.5rem 0 0.5rem;
}
.prose :global(.pb-blockquote) {
  border-left: 3px solid var(--color-ocean-light);
  padding-left: 1.2rem;
  margin: 1.5rem 0;
  font-style: italic;
  color: var(--color-text-muted);
}
.prose :global(a) { color: var(--color-ocean-main); text-decoration: underline; text-underline-offset: 2px; }
.prose :global(figure) { margin: 1.5rem 0; }
.prose :global(figure img) { border-radius: 6px; width: 100%; }
.prose :global(.pb-list) {
  padding-left: 1.4rem; margin-bottom: 1rem;
}
.prose :global(.pb-list li) {
  line-height: 1.75; margin-bottom: 0.35rem;
  color: var(--color-text);
}
.prose :global(.pb-list--bullet) { list-style-type: disc; }
.prose :global(.pb-list--number) { list-style-type: decimal; }
.section--dark .prose :global(.pb-list li) { color: rgba(255,255,255,0.82); }

/* ── EXPERT CARD (intervenant) ── */
.expert-card {
  display: flex; gap: 1rem; align-items: flex-start;
  background: var(--color-sand); border-radius: 4px;
  padding: 1.2rem; margin-top: 1.5rem;
}
.expert-card__avatar {
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--color-ocean); color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; font-weight: 700; flex-shrink: 0;
}
.expert-card__name { font-size: 1rem; font-weight: 600; color: var(--color-text); display: block; }
.expert-card__title { font-size: 0.75rem; color: var(--color-ocean-main); display: block; margin: 0.2rem 0 0.5rem; line-height: 1.5; }
.expert-card__bio { font-size: 0.85rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }

/* ── CARDS STYLE 2 ── */
.pb-cards2 { overflow: hidden; }
.pb-cards2__header { padding-top: 3rem; padding-bottom: 1.5rem; }
.section--dark .pb-cards2__header .pb-eyebrow-sm,
.section--ocean .pb-cards2__header .pb-eyebrow-sm { color: var(--color-ocean-light); }
.section--dark .pb-cards2__header .pb-section-titre,
.section--ocean .pb-cards2__header .pb-section-titre { color: white; }
.pb-cards2__grid {
  display: grid;
  grid-template-rows: 320px;
  gap: 4px;
}
.pb-cards2__grid .wf-card { height: 320px; }
@media (max-width: 900px) {
  .pb-cards2__grid { grid-template-columns: 1fr 1fr !important; grid-template-rows: 240px 240px; }
}
@media (max-width: 480px) {
  .pb-cards2__grid { grid-template-columns: 1fr !important; grid-template-rows: none; }
  .pb-cards2__grid .wf-card { height: 220px; }
}

/* ── CARDS (sous-prestations) ── */
/* Pas de background sur la section = gap blanc entre les cartes (comme l'original) */
.pb-cards { overflow: hidden; }
.pb-section-titre {
  margin-bottom: 2rem;
  color: var(--color-text);
}
.section--dark .pb-section-titre,
.section--ocean .pb-section-titre { color: white; }
.sous-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
}
/* Hauteurs : les cartes normales = 380px, la wide (dernière) = 500px */
.wf-card {
  position: relative;
  display: block;
  height: 380px;
  overflow: hidden;
  text-decoration: none;
  color: white;
  background: var(--color-ocean);
}
.wf-card--wide {
  grid-column: 1 / -1;
  height: 500px;
}
.wf-card-bg {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  transition: transform 0.6s ease;
}
.wf-card:hover .wf-card-bg { transform: scale(1.06); }
.wf-card::after {
  content: '';
  position: absolute; inset: 0;
  background: rgba(7,24,31,0.25);
  transition: background 0.35s ease;
}
.wf-card:hover::after { background: rgba(7,24,31,0.1); }
.wf-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(7,24,31,.75) 0%, transparent 55%);
  z-index: 1;
}
.wf-body {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 1.5rem 1.75rem 1.75rem;
  z-index: 2;
  display: flex; flex-direction: column; gap: 0.2rem;
}
.wf-sub {
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-ocean-light);
  font-weight: 500;
}
.wf-label {
  font-family: var(--font-serif);
  font-size: 1.45rem;
  font-weight: 500;
  line-height: 1.2;
  color: white;
}

/* ── TEXTE + IMAGE ── */
.pb-ti__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}
.pb-ti__grid[data-pos="left"] .pb-ti__fig { order: -1; }
.pb-ti__fig img { border-radius: 6px; width: 100%; }
.pb-ti__h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  color: var(--color-text);
  margin: 0.3rem 0 1.2rem;
  line-height: 1.2;
}
.section--dark .pb-ti__h2,
.section--ocean .pb-ti__h2 { color: white; }
.pb-ti__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1.6rem;
}
.pb-ti__chip {
  display: inline-block;
  padding: 0.3rem 0.85rem;
  border: 1px solid #d0d5dc;
  border-radius: 999px;
  font-size: 0.82rem;
  color: var(--color-text-muted);
  background: transparent;
  white-space: nowrap;
}
.section--dark .pb-ti__chip,
.section--ocean .pb-ti__chip {
  border-color: rgba(255,255,255,0.3);
  color: rgba(255,255,255,0.75);
}

/* ── GALERIE ── */
.galerie-grid {
  display: grid;
  gap: 1rem;
}
.galerie-img {
  width: 100%; aspect-ratio: 4/3;
  object-fit: cover; border-radius: 4px;
}

/* ── VIDÉO (layout texte + vidéo) ── */
.pb-video2__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
.pb-video2__grid--rev .pb-video2__player { order: 2; }
.pb-video2__grid--rev .pb-video2__text   { order: 1; }
.video-wrap {
  position: relative;
  padding-bottom: 56.25%;
  border-radius: 8px; overflow: hidden;
}
.video-wrap iframe {
  position: absolute; inset: 0;
  width: 100%; height: 100%; border: none;
}
.pb-video2__eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-bottom: 0.75rem;
}
.pb-video2__titre {
  color: var(--color-text);
  margin-bottom: 1rem;
  line-height: 1.2;
}
.section--dark .pb-video2__titre { color: white; }
.section--dark .pb-video2__eyebrow { color: var(--color-ocean-light); }
.pb-video2__desc {
  color: var(--color-text-muted);
  line-height: 1.75;
  font-size: 1rem;
}
.section--dark .pb-video2__desc { color: rgba(255,255,255,0.7); }
@media (max-width: 860px) {
  .pb-video2__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .pb-video2__grid--rev .pb-video2__player { order: 1; }
  .pb-video2__grid--rev .pb-video2__text   { order: 2; }
}

/* ── INFOS CLÉS BANDEAU ── */
.pb-bandeau {
  width: 100%;
}
.pb-bandeau__grid {
  display: flex;
  flex-wrap: nowrap;
}
.pb-bandeau__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1.6rem 1.5rem;
  border-right: 1px solid rgba(255,255,255,0.1);
}
.pb-bandeau__item:last-child { border-right: none; }
/* Couleurs par fond */
.section--dark  .pb-bandeau__item,
.section--ocean .pb-bandeau__item { border-color: rgba(255,255,255,0.1); }
.section--white .pb-bandeau__item,
.section--sand  .pb-bandeau__item { border-color: rgba(0,0,0,0.08); }
.pb-bandeau__titre {
  font-family: var(--font-serif);
  font-size: clamp(0.95rem, 2vw, 1.2rem);
  font-weight: 500;
  line-height: 1.2;
  color: white;
}
.section--white .pb-bandeau__titre,
.section--sand  .pb-bandeau__titre { color: var(--color-text); }
.pb-bandeau__sub {
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  margin-top: 0.4rem;
  font-weight: 400;
}
.section--white .pb-bandeau__sub,
.section--sand  .pb-bandeau__sub { color: var(--color-text-muted); }
@media (max-width: 700px) {
  .pb-bandeau__grid { flex-wrap: wrap; }
  .pb-bandeau__item {
    flex: 0 0 50%;
    border-right: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .pb-bandeau__item:nth-child(even) { border-right: none; }
  .section--white .pb-bandeau__item,
  .section--sand  .pb-bandeau__item { border-color: rgba(0,0,0,0.08); }
}

/* ── PROGRAMME / ÉTAPES ── */
.pb-eyebrow-sm {
  font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--color-ocean-main); font-weight: 600; margin-bottom: 0.5rem;
}
.section--dark .pb-eyebrow-sm,
.section--ocean .pb-eyebrow-sm { color: var(--color-ocean-light); }
.pb-prog__h2  { margin-bottom: 0.5rem; }
.section--dark .pb-prog__h2,
.section--ocean .pb-prog__h2 { color: white; }
.pb-prog__intro {
  font-size: 1rem; line-height: 1.7; color: var(--color-text-muted);
  max-width: 640px; margin-bottom: 2.5rem;
}
.section--dark .pb-prog__intro,
.section--ocean .pb-prog__intro { color: rgba(255,255,255,0.72); }
.pb-prog__rows { display: flex; flex-direction: column; gap: 2rem; }
.pb-prog__row {
  display: grid; grid-template-columns: 1fr 1fr;
  border-radius: 6px; overflow: hidden;
  box-shadow: 0 2px 16px rgba(0,0,0,0.07);
}
.pb-prog__row--rev .pb-prog__img  { order: 2; }
.pb-prog__row--rev .pb-prog__body { order: 1; }
.pb-prog__img { overflow: hidden; min-height: 340px; }
.pb-prog__img img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.pb-prog__row:hover .pb-prog__img img { transform: scale(1.04); }
.pb-prog__body {
  padding: 2.5rem 3rem; background: white;
  display: flex; flex-direction: column; justify-content: center;
}
.pb-prog__num {
  font-family: var(--font-serif); font-size: 2.5rem; font-weight: 300;
  color: rgba(27,94,138,0.15); line-height: 1; margin-bottom: 0.4rem;
}
.pb-prog__body h3 { font-size: 1.3rem; margin-bottom: 0.3rem; color: var(--color-text); }
.pb-prog__tag {
  font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--color-ocean-main); font-weight: 500;
  margin-bottom: 1.1rem; display: block;
}
.pb-prog__text :global(p) {
  line-height: 1.75; color: var(--color-text-muted);
  font-size: 0.92rem; margin-bottom: 0.8rem;
}
.pb-prog__text :global(p:last-child) { margin-bottom: 0; }
@media (max-width: 900px) {
  .pb-prog__row { grid-template-columns: 1fr; }
  .pb-prog__row--rev .pb-prog__img,
  .pb-prog__row--rev .pb-prog__body { order: unset; }
  .pb-prog__img { min-height: 240px; }
  .pb-prog__body { padding: 2rem; }
}
@media (max-width: 560px) {
  .pb-prog__body { padding: 1.75rem 1.5rem; }
}

/* ── SÉLECTION ── */
.pb-sel__list { display: flex; flex-direction: column; gap: 3rem; margin-top: 2rem; }
.pb-sel__block {
  display: grid; grid-template-columns: 1fr 1fr;
  border-radius: 8px; overflow: hidden;
  box-shadow: 0 2px 20px rgba(0,0,0,0.08);
}
.pb-sel__block--rev .pb-sel__img  { order: 2; }
.pb-sel__block--rev .pb-sel__body { order: 1; }
.pb-sel__img { overflow: hidden; min-height: 400px; }
.pb-sel__img img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.pb-sel__block:hover .pb-sel__img img { transform: scale(1.04); }
.pb-sel__body {
  padding: 2.5rem 3rem; background: white;
  display: flex; flex-direction: column;
}
.pb-sel__body--sand { background: white; }
.pb-sel__tag {
  font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--color-ocean-main); font-weight: 600; margin-bottom: 0.4rem;
}
.pb-sel__h3 {
  font-size: 1.35rem; margin-bottom: 1rem; color: var(--color-ocean); line-height: 1.25;
}
.pb-sel__text :global(p) {
  font-size: 0.88rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: 0.8rem;
}
.pb-sel__text :global(p:last-child) { margin-bottom: 0; }
/* Pills (tags techniques) */
.pb-sel__pills {
  display: flex; gap: 0.5rem; flex-wrap: wrap;
  list-style: none; padding: 0; margin-top: 1.25rem;
}
.pb-sel__pills li {
  font-size: 0.72rem; background: rgba(27,94,138,0.08); color: var(--color-ocean);
  padding: 0.3rem 0.75rem; border-radius: 2px; font-weight: 500; letter-spacing: 0.05em;
}
/* Infos clés grid */
.pb-sel__infos {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem;
  margin-top: 1.5rem; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 1.5rem;
}
.pb-sel__info-item { display: flex; flex-direction: column; gap: 0.15rem; }
.pb-sel__info-lbl {
  font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--color-ocean-main); font-weight: 700;
}
.pb-sel__info-val { font-size: 0.84rem; color: var(--color-text); font-weight: 500; line-height: 1.4; }
/* ── Fond bleu nuit ── */
.section--dark .pb-sel__block {
  box-shadow: 0 2px 24px rgba(0,0,0,0.4);
}
.section--dark .pb-sel__body,
.section--dark .pb-sel__body--sand {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
}
.section--dark .pb-sel__tag   { color: var(--color-ocean-light); }
.section--dark .pb-sel__h3    { color: white; }
.section--dark .pb-sel__text :global(p) { color: rgba(255,255,255,0.72); }
.section--dark .pb-sel__pills li {
  background: rgba(255,255,255,0.1);
  color: white;
}
.section--dark .pb-sel__infos {
  border-top-color: rgba(255,255,255,0.1);
}
.section--dark .pb-sel__info-lbl { color: var(--color-ocean-light); }
.section--dark .pb-sel__info-val { color: rgba(255,255,255,0.85); }

@media (max-width: 900px) {
  .pb-sel__block { grid-template-columns: 1fr; }
  .pb-sel__block--rev .pb-sel__img,
  .pb-sel__block--rev .pb-sel__body { order: unset; }
  .pb-sel__img { min-height: 260px; }
  .pb-sel__body { padding: 2rem; }
}
@media (max-width: 560px) {
  .pb-sel__infos { grid-template-columns: 1fr; }
  .pb-sel__body { padding: 1.5rem; }
}

/* ── PROGRAMME CARTES style 2 ── */
.pb-prog-cart__grid {
  display: grid;
  gap: 2rem;
}
.pb-prog-cart__card {
  background: white;
  border-radius: 6px;
  padding: 1.8rem;
  border-top: 3px solid var(--color-ocean-main);
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.pb-prog-cart__num {
  display: block;
  font-size: 2rem;
  font-family: var(--font-serif);
  color: var(--color-ocean-light);
  opacity: 0.5;
  margin-bottom: 0.5rem;
  line-height: 1;
}
.pb-prog-cart__h3 {
  font-size: 1rem;
  color: var(--color-ocean);
  margin-bottom: 0.7rem;
}
.pb-prog-cart__desc {
  font-size: 0.9rem;
  line-height: 1.7;
  color: var(--color-text-muted);
  margin: 0;
  white-space: pre-line;
}
@media (max-width: 768px) {
  .pb-prog-cart__grid { grid-template-columns: repeat(2,1fr) !important; gap: 1.2rem; }
}
@media (max-width: 480px) {
  .pb-prog-cart__grid { grid-template-columns: 1fr !important; }
}

/* ── PROGRAMME SANS IMAGE ── */
.pb-prog-txt__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.pb-prog-txt__card {
  background: white;
  border-radius: 6px;
  padding: 1.5rem;
  box-shadow: 0 2px 12px rgba(27,94,138,0.07);
}
.pb-prog-txt__label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-bottom: 1rem;
}
.pb-prog-txt__list {
  list-style: none;
  padding: 0; margin: 0;
}
.pb-prog-txt__list li {
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--color-text);
  padding: 0.35rem 0 0.35rem 1.3rem;
  border-bottom: 1px solid #f0eff0;
  position: relative;
  white-space: pre-line;
}
.pb-prog-txt__list li::before {
  content: '—';
