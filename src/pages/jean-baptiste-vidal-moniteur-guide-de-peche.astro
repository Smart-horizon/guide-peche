---

<BaseLayout title={seoTitle} description={seoDescription}>

  <!-- Données structurées Schema.org Person -->
  <script type="application/ld+json" is:raw>
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jean-Baptiste Vidal",
    "jobTitle": "Moniteur-Guide de pêche à la mouche",
    "description": "Moniteur-Guide de pêche à la mouche diplômé d'État, basé en Bretagne-Sud. Spécialiste bar, truite, migrateurs et Spey Cast. 21 ans d'expérience de guidage.",
    "url": "https://jeanbaptistevidalguidepeche.com/jean-baptiste-vidal-moniteur-guide-de-peche",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "Bretagne",
      "addressCountry": "FR"
    },
    "knowsAbout": ["Pêche à la mouche", "Pêche du bar", "Truite", "Migrateurs", "Spey Cast", "Pêche en saltwater"]
  }
  </script>

  <!-- Hero -->
  <section class="guide-hero">
    <div class="guide-hero-bg" style="background-image: url('/images/bar-perf-9.jpg')"></div>
    <div class="container guide-hero-content">
      <p class="eyebrow-light">Votre guide</p>
      <h1>Jean-Baptiste Vidal</h1>
      <p class="hero-subtitle">Moniteur-Guide diplômé d'État · Bretagne-Sud</p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">21</span>
          <span class="stat-label">ans de guidage</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-num">33</span>
          <span class="stat-label">ans de pratique</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <span class="stat-num">12+</span>
          <span class="stat-label">pays visités</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Bio -->
  <section class="section section--white">
    <div class="container bio-layout">
      <div class="bio-text">
        <p class="eyebrow">Le guide</p>
        <h2>Un professionnel à votre service</h2>
        <p>
          On ne choisit pas de faire le métier de guide de pêche sur un coup de tête.
          C'est une vocation, une passion que l'on souhaite partager, une envie de transmettre
          ses connaissances, son savoir-faire, sa technique, mais aussi sa sensibilité
          pour les milieux aquatiques et l'environnement.
        </p>
        <p>
          Après avoir beaucoup pêché en France depuis mon plus jeune âge, j'ai rapidement su
          qu'il fallait que je travaille de cette passion dévorante. J'ai commencé mon parcours
          professionnel au sein de la Fédération de Pêche du Finistère à Quimper pendant 5 ans,
          avant d'obtenir le BP JEPS « Pêche de Loisir » en 2004.
        </p>
        <p>
          Dès 2005, je pars guider en Islande, une première expérience internationale qui
          ouvre la porte à une longue carrière de guide et manager de lodge dans plusieurs pays :
          Argentine, Russie, Bolivie, Irlande…
        </p>
        <p>
          Depuis 2014, j'ai choisi de m'installer définitivement en Bretagne pour y proposer
          mes services et partager avec vous cette passion qui nous unit.
        </p>
        <div class="bio-certs">
          <img src="/images/jbv-portrait.jpg" alt="Jean-Baptiste Vidal, moniteur-guide de pêche à la mouche" class="cert-portrait" loading="lazy" />
          <p class="cert-caption">Fiche officielle, Fédération Française des Moniteurs-Guides de Pêche</p>
        </div>
      </div>
      <div class="bio-photo">
        <img
          src="/images/guide-argentine-3.jpg"
          alt="Jean-Baptiste Vidal et une belle truite de mer en Argentine — Terre de Feu"
          loading="lazy"
          width="620"
          height="465"
        />
      </div>
    </div>
  </section>

  <!-- Parcours international — Timeline Option B -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Expérience</p>
        <h2>Un parcours de guide international</h2>
        <p class="section-sub">
          De l'Islande à la Terre de Feu, de la Russie à la Bolivie : des années de guidage
          aux quatre coins du monde avant de poser les cannes en Bretagne.
        </p>
      </div>

      <!-- Barre de stats -->
      <div class="tl-stats-bar">
        <div class="tl-stat-item">
          <span class="tl-stat-num">10+</span>
          <span class="tl-stat-lbl">pays guidés</span>
        </div>
        <div class="tl-stat-sep"></div>
        <div class="tl-stat-item">
          <span class="tl-stat-num">8</span>
          <span class="tl-stat-lbl">lodges managés</span>
        </div>
        <div class="tl-stat-sep"></div>
        <div class="tl-stat-item">
          <span class="tl-stat-num">15</span>
          <span class="tl-stat-lbl">ans à l'international</span>
        </div>
        <div class="tl-stat-sep tl-stat-sep--hide-sm"></div>
        <blockquote class="tl-stat-quote">
          « Chaque destination m'a appris quelque chose d'unique, une lecture de l'eau, une technique. »
        </blockquote>
      </div>

      <!-- Frise chronologique -->
      <div class="timeline" id="timeline-list">
        {experiences.map((exp, i) => (
          <div
            class:list={['timeline-item', { 'has-photo': exp.photos.length > 0 }]}
            data-idx={String(i)}
          >
            <div class="timeline-periode">{exp.periode}</div>
            <div class="timeline-dot">
              {exp.photos.length > 0 && (
                <svg class="dot-camera" viewBox="0 0 24 24" fill="currentColor" width="8" height="8" aria-hidden="true">
                  <path d="M20 5h-3.17L15 3H9L7.17 5H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-8 13c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                </svg>
              )}
            </div>
            <div class="timeline-content">
              <h3>{exp.lieu}</h3>
              <p>{exp.detail}</p>
            </div>
            {exp.photos.length > 0 && (
              <div class="tl-expand">
                <div class="tl-expand-inner">
                  <div class="tl-expand-body">
                    <div class="tl-carousel" data-total={String(exp.photos.length)}>
                      <div class="tl-car-track">
                        {exp.photos.map((ph) => (
                          <div class="tl-car-slide">
                            <div class="tl-expand-photo">
                              <img src={ph.src} alt={ph.caption || exp.lieu} loading="lazy" width="560" height="373" />
                              {ph.caption && <span class="tl-expand-caption">{ph.caption}</span>}
                            </div>
                          </div>
                        ))}
                      </div>
                      {exp.photos.length > 1 && (
                        <>
                          <button class="tl-car-btn tl-car-prev" aria-label="Photo précédente" type="button">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                          </button>
                          <button class="tl-car-btn tl-car-next" aria-label="Photo suivante" type="button">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                          </button>
                          <div class="tl-car-counter">1 / {exp.photos.length}</div>
                        </>
                      )}
                    </div>
                    {exp.link && (
                      <a href={exp.link} class="tl-expand-link">{exp.linkLabel} →</a>
                    )}
                    {exp.link2 && (
                      <a href={exp.link2} class="tl-expand-link tl-expand-link--temo">{exp.linkLabel2} →</a>
                    )}
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Galerie photos -->
  <section class="gallery-section">
    <div class="carousel" id="guide-carousel">
      <div class="carousel-track" id="guide-track">
        {carouselImages.map((img, i) => (
          <div class="carousel-slide">
            <img
              src={img.src}
              alt={img.alt}
              class="carousel-img"
              loading={i === 0 ? 'eager' : 'lazy'}
              width="1400"
              height="933"
            />
          </div>
        ))}
      </div>
      <button class="carousel-btn carousel-prev" id="guide-prev" aria-label="Photo précédente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="carousel-btn carousel-next" id="guide-next" aria-label="Photo suivante">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
      </button>
      <div class="carousel-counter" id="guide-counter">1 / {carouselImages.length}</div>
    </div>
  </section>

  <!-- Qualifications -->
  <section class="section section--white">
    <div class="container qualif-layout">
      <div class="qualif-text">
        <p class="eyebrow">Diplômes</p>
        <h2>Qualifications & certifications</h2>
        <p>
          Titulaire du BP JEPS « Pêche de Loisir », Jean-Baptiste est habilité à enseigner
          la pêche à la mouche et à encadrer des sorties en milieu maritime.
          Il est également membre du Pro Guide Team Rio, SAGE et Simms.
        </p>
        <ul class="qualif-list">
          {diplomes.map((d) => (
            <li>
              <span class="qualif-annee">{d.annee}</span>
              <span class="qualif-label">{d.label}</span>
            </li>
          ))}
          <li>
            <span class="qualif-annee">2001–</span>
            <span class="qualif-label">Technicien à la Fédération de Pêche du Finistère</span>
          </li>
          <li>
            <span class="qualif-annee">Presse</span>
            <span class="qualif-label">Journaliste halieutique, magazine <em>Pêche Mouche</em> (depuis 2011)</span>
          </li>
