<script>
  (function () {
    const track   = document.getElementById('guide-track')
    const carousel = document.getElementById('guide-carousel')
    const btnPrev  = document.getElementById('guide-prev')
    const btnNext  = document.getElementById('guide-next')
    const counter  = document.getElementById('guide-counter')
    if (!track || !carousel) return

    const slides = track.querySelectorAll('.carousel-slide')
    const total  = slides.length
    let current  = 0
    const DELAY  = 4500

    let timer: ReturnType<typeof setInterval> | null = null
    function startAutoplay () { if (timer) return; timer = setInterval(() => go(current + 1), DELAY) }
    function stopAutoplay  () { if (timer) { clearInterval(timer); timer = null } }
    function restartAutoplay () { stopAutoplay(); setTimeout(startAutoplay, 6000) }

    function slideW () {
      // Mesure la vraie largeur rendue — gère tous les breakpoints (1 / 2 / 3 slides)
      return (slides[0] as HTMLElement).offsetWidth
    }
    function visibleN () {
      return window.innerWidth <= 640 ? 1 : window.innerWidth <= 900 ? 2 : 3
    }
    function calcOffset (idx: number) {
      const w = slideW()
      const g = 3          // gap CSS en px
      const n = visibleN()
      // n=1 ou n=2 : avancer d'un slide à la fois
      // n=3 : mode centré — affiche [idx-1, idx, idx+1]
      const raw = n < 3 ? idx * (w + g) : (idx - 1) * (w + g)
      const maxOff = Math.max(0, (total - n) * (w + g))
      return Math.max(0, Math.min(maxOff, raw))
    }

    function go (idx: number) {
      current = (idx + total) % total
      ;(track as HTMLElement).style.transform = `translateX(-${calcOffset(current)}px)`
      if (counter) counter.textContent = `${current + 1} / ${total}`
    }

    window.addEventListener('resize', () => {
      ;(track as HTMLElement).style.transition = 'none'
      ;(track as HTMLElement).style.transform = `translateX(-${calcOffset(current)}px)`
      requestAnimationFrame(() => { ;(track as HTMLElement).style.transition = '' })
    })

    btnPrev?.addEventListener('click', () => { go(current - 1); restartAutoplay() })
    btnNext?.addEventListener('click', () => { go(current + 1); restartAutoplay() })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft')  { go(current - 1); restartAutoplay() }
      if (e.key === 'ArrowRight') { go(current + 1); restartAutoplay() }
    })

    // Swipe
    let startX = 0
    carousel.addEventListener('touchstart', (e: TouchEvent) => { startX = e.changedTouches[0].clientX }, { passive: true })
    carousel.addEventListener('touchend',   (e: TouchEvent) => {
      const dx = e.changedTouches[0].clientX - startX
      if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
    }, { passive: true })

    // Mouse drag
    let dragStartX = 0, dragging = false
    carousel.addEventListener('mousedown', (e: MouseEvent) => { dragStartX = e.clientX; dragging = true })
    carousel.addEventListener('mouseup',   (e: MouseEvent) => {
      if (!dragging) return; dragging = false
      const dx = e.clientX - dragStartX
      if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
    })
    carousel.addEventListener('mouseleave', () => { dragging = false })

    // Pause on hover
    carousel.addEventListener('mouseenter', stopAutoplay)
    carousel.addEventListener('mouseleave', startAutoplay)

    startAutoplay()
  })()
</script>

<script>
  // ── Frise chronologique — mini-carrousels + hover avec délai ─────
  (function () {

    // ── 1. Mini-carrousels (avec autoplay) ─────────────────────────
    document.querySelectorAll<HTMLElement>('.tl-carousel').forEach(car => {
      const track   = car.querySelector<HTMLElement>('.tl-car-track')
      const counter = car.querySelector<HTMLElement>('.tl-car-counter')
      const total   = parseInt(car.dataset.total || '1', 10)
      let idx = 0
      let autoTimer: ReturnType<typeof setInterval> | null = null

      function carGo (n: number) {
        idx = (n + total) % total
        if (track) track.style.transform = `translateX(-${idx * 100}%)`
        if (counter) counter.textContent = `${idx + 1} / ${total}`
      }

      function startAuto () {
        if (total <= 1 || autoTimer) return
        autoTimer = setInterval(() => carGo(idx + 1), 2800)
      }

      function stopAuto () {
        if (autoTimer) { clearInterval(autoTimer); autoTimer = null }
      }

      car.querySelector('.tl-car-prev')?.addEventListener('click', (e) => {
        e.stopPropagation()
        stopAuto()
        carGo(idx - 1)
        setTimeout(startAuto, 5000)
      })
      car.querySelector('.tl-car-next')?.addEventListener('click', (e) => {
        e.stopPropagation()
        stopAuto()
        carGo(idx + 1)
        setTimeout(startAuto, 5000)
      })

      startAuto()
    })

    // ── 2. Accordéon de la frise ────────────────────────────────────
    const CLOSE_DELAY = 900  // ms avant fermeture sur mouseleave
    const items = document.querySelectorAll<HTMLElement>('#timeline-list .timeline-item.has-photo')
    const timers = new Map<HTMLElement, ReturnType<typeof setTimeout>>()

    function openItem (item: HTMLElement) {
      // Annuler un éventuel timer de fermeture sur cet item
      const t = timers.get(item)
      if (t !== undefined) { clearTimeout(t); timers.delete(item) }
      // Fermer immédiatement les autres
      items.forEach(i => { if (i !== item) i.classList.remove('is-active') })
      item.classList.add('is-active')
      // Forcer le chargement des images lazy (sinon les slides hors-écran restent vides)
      item.querySelectorAll<HTMLImageElement>('.tl-expand img[loading="lazy"]').forEach(img => {
        img.loading = 'eager'
      })
    }

    function scheduleClose (item: HTMLElement) {
      const t = setTimeout(() => {
        item.classList.remove('is-active')
        timers.delete(item)
      }, CLOSE_DELAY)
      timers.set(item, t)
    }

    if (window.innerWidth > 900) {
      // Desktop : hover géré en JS avec délai de fermeture
      items.forEach(item => {
        item.addEventListener('mouseenter', () => openItem(item))
        item.addEventListener('mouseleave', () => scheduleClose(item))
      })
    } else {
      // Mobile : clic toggle
      items.forEach(item => {
        item.addEventListener('click', () => {
          const wasActive = item.classList.contains('is-active')
          items.forEach(i => i.classList.remove('is-active'))
          if (!wasActive) {
            item.classList.add('is-active')
            item.querySelectorAll<HTMLImageElement>('.tl-expand img[loading="lazy"]').forEach(img => {
              img.loading = 'eager'
            })
          }
        })
      })
    }

  })()
</script>
