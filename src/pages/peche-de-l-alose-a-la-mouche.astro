  /* ── CARROUSEL GALERIE ── */
  .al-carr-outer { background: var(--color-ocean); overflow: hidden; }
  .carr3-wrap { position:relative; overflow:hidden; cursor:grab; }
  .carr3-wrap:active { cursor:grabbing; }
  .carr3-track {
    display:flex; align-items:stretch; gap:3px;
    transition:transform .55s cubic-bezier(.4,0,.2,1); will-change:transform;
  }
  .carr3-slide {
    flex:0 0 calc((100% - 6px)/3); width:calc((100% - 6px)/3);
    aspect-ratio:3/2; overflow:hidden;
  }
  .carr3-slide img { width:100%; height:100%; object-fit:cover; display:block; user-select:none; -webkit-user-drag:none; }
  .carr3-btn {
    position:absolute; top:50%; transform:translateY(-50%);
    width:46px; height:46px; border-radius:50%;
    background:rgba(0,0,0,.45); border:1.5px solid rgba(255,255,255,.2);
    color:white; cursor:pointer; padding:0;
