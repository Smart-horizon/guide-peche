    z-index:10; transition:background .2s, border-color .2s;
  }
  .carr3-btn:hover { background:rgba(0,0,0,.7); border-color:rgba(255,255,255,.5); }
  .carr3-btn--prev { left:1rem; }
  .carr3-btn--next { right:1rem; }
  .carr3-counter {
    position:absolute; bottom:.85rem; right:1rem;
    font-size:.7rem; letter-spacing:.12em;
    color:rgba(255,255,255,.6); background:rgba(0,0,0,.35);
    padding:.2rem .55rem; border-radius:2px; z-index:10;
  }
  @media (max-width:900px) {
    .carr3-slide { flex:0 0 calc((100% - 3px)/2); width:calc((100% - 3px)/2); }
  }
  @media (max-width:640px) {
    .carr3-slide { flex:0 0 100%; width:100%; }
  }

  /* ── BLOG ── */
  .blog-section { max-width: 800px; }
  .blog-card {
    display: flex; gap: 2rem; align-items: flex-start;
    background: var(--color-sand); border-radius: 8px; padding: 2rem 2.5rem;
