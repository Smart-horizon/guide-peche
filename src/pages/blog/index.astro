---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { createClient } from '@sanity/client'
import imageUrlBuilder from '@sanity/image-url'

const client = createClient({
  projectId: 'uievv97s',
  dataset: 'production',
  useCdn: true,
  apiVersion: '2024-01-01',
})

const builder = imageUrlBuilder(client)
const urlFor = (source) => builder.image(source)

const articles = await client.fetch(`
  *[_type == "article"] | order(date desc) {
    title, slug, date, image, extrait, espece, tags
  }
`)

const especeLabel = {
  bar: 'Bar', truite: 'Truite', saumon: 'Saumon',
  alose: 'Alose', brochet: 'Brochet', exotique: 'Exotique',
}

// Espèces présentes dans les articles pour le filtre
const especesPresentes = [...new Set(articles.map(a => a.espece).filter(Boolean))]
---

<BaseLayout
  title="Blog pêche à la mouche — Jean-Baptiste Vidal"
  description="Articles et récits de pêche à la mouche par Jean-Baptiste Vidal : bar, truite, alose, saumon et pêche exotique."
>

  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Enjoy Fishing</p>
      <h1>Le blog</h1>
      <p class="hero-sub">Récits, techniques et carnets de pêche à la mouche.</p>
    </div>
  </section>

  <section class="section blog-section">
    <div class="container">

      {especesPresentes.length > 0 && (
        <nav class="filtres">
          <a href="/blog" class="filtre filtre--actif">Tous</a>
          {especesPresentes.map(esp => (
            <a href={`/blog?espece=${esp}`} class="filtre">{especeLabel[esp] ?? esp}</a>
          ))}
        </nav>
      )}

      {articles.length > 0 ? (
        <div class="articles-grid">
          {articles.map(article => (
            <a href={`/blog/${article.slug?.current}`} class="article-card">
              <div class="article-img" style={article.image
                ? `background-image: url(${urlFor(article.image).width(600).height(380).fit('crop').crop('focalpoint').url()})`
                : ''}>
                {article.espece && (
                  <span class="article-espece">{especeLabel[article.espece] ?? article.espece}</span>
                )}
              </div>
              <div class="article-body">
                {article.date && (
                  <time class="article-date" datetime={article.date}>
                    {new Date(article.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                )}
                <h2 class="article-title">{article.title}</h2>
                {article.extrait && <p class="article-extrait">{article.extrait}</p>}
                <span class="article-lire">Lire l'article →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="blog-vide">
          <p>Les articles arrivent bientôt.</p>
        </div>
      )}

    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .page-hero {
    position: relative;
    min-height: 40vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 3rem;
    color: white;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(7,24,31,0.85) 0%, rgba(13,43,62,0.55) 100%),
      url('/images/hero.jpg') center / cover no-repeat;
    background-color: var(--color-ocean);
  }
  .page-hero-content {
    position: relative;
    z-index: 1;
    padding-top: var(--header-height);
  }
  .page-hero h1 { color: white; margin: 0.4rem 0 0.75rem; }
  .hero-sub { color: rgba(255,255,255,0.75); font-size: 1rem; }

  .eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    font-weight: 500;
  }

  /* Filtres */
  .filtres {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .filtre {
    padding: 0.4rem 1rem;
    border: 1.5px solid var(--color-ocean-main);
    border-radius: 2px;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ocean-main);
    transition: all 0.2s;
  }
  .filtre:hover, .filtre--actif {
    background: var(--color-ocean-main);
    color: white;
  }

  /* Grille articles */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .article-card {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    border-radius: 3px;
    overflow: hidden;
    background: white;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }

  .article-img {
    position: relative;
    aspect-ratio: 16/10;
    background: var(--color-ocean) center / cover no-repeat;
  }

  .article-espece {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--color-ocean-main);
    color: white;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    font-weight: 500;
  }

  .article-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .article-date {
    display: block;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 0.6rem;
    color: var(--color-text);
  }

  .article-extrait {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-lire {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ocean-main);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .blog-vide {
    text-align: center;
    padding: 5rem 0;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-style: italic;
  }

  @media (max-width: 1024px) { .articles-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px)  { .articles-grid { grid-template-columns: 1fr; } }
</style>
