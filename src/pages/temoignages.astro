---
import BaseLayout from '../layouts/BaseLayout.astro'
import { stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'

const seoTitle = "Témoignages & Avis — Jean-Baptiste Vidal, Guide de Pêche à la Mouche"
const seoDescription = "Témoignages et avis de stagiaires et clients de Jean-Baptiste Vidal, moniteur-guide de pêche à la mouche en Bretagne-Sud. Bar, saumon, alose, Spey Cast, truite et voyages."

// ── Textes éditables depuis Sanity (singleton pageTemoignages) ──────────────
const pt = await stegaClient.fetch(`*[_id == "pageTemoignages"][0]`) ?? {}

// Fallbacks vers les valeurs originales si le champ Sanity est vide
const hero = {
  eyebrow:  pt.heroEyebrow?.trim()  || '21 ans de guidage',
  titre:    pt.heroTitre?.trim()    || 'Témoignages & Avis',
  intro:    pt.heroIntro?.trim()    || "Sur cette page vous pourrez trouver certains témoignages de personnes qui m'ont fait confiance et qui ont participé à une journée de pêche en France ou été guidé par mes soins lors d'un voyage à l'étranger :",
}
const bar = {
  onglet:   pt.barOnglet?.trim()    || 'Bar à la mouche',
  titre:    pt.barTitre?.trim()     || 'Bar à la mouche',
  sousTitre:pt.barSousTitre?.trim() || 'Pêche du bar en Bretagne-Sud, bar à vue, en bateau, en estuaire',
  ctaTexte: pt.barCtaTexte?.trim()  || 'Découvrir la pêche du bar à la mouche →',
  ctaUrl:   pt.barCtaUrl?.trim()    || '/peche-du-bar-a-la-mouche',
}
const saumon = {
  onglet:   pt.saumonOnglet?.trim()    || 'Saumon & Spey Cast',
  titre:    pt.saumonTitre?.trim()     || 'Saumon, Alose & Spey Cast',
  sousTitre:pt.saumonSousTitre?.trim() || 'Guidage migrateurs sur les rivières bretonnes : Ellé, Scorff, Aulne, Aven, Elorn',
  ctaTexte: pt.saumonCtaTexte?.trim()  || 'Découvrir le Spey Cast →',
  ctaUrl:   pt.saumonCtaUrl?.trim()    || '/stage-spey-cast-et-cours-de-lancer',
}
const truite = {
  onglet:   pt.truiteOnglet?.trim()    || 'Truite & Initiation',
  titre:    pt.truiteTitre?.trim()     || 'Truite & Initiation',
  sousTitre:pt.truiteSousTitre?.trim() || 'Initiation, perfectionnement truite en rivière : Scorff, Ellé, Isole',
  ctaTexte: pt.truiteCtaTexte?.trim()  || 'Découvrir la pêche en eau douce →',
  ctaUrl:   pt.truiteCtaUrl?.trim()    || '/peche-a-la-mouche-en-bretagne',
}
const voyages = {
  onglet:   pt.voyagesOnglet?.trim()    || 'Voyages',
  titre:    pt.voyagesTitre?.trim()     || 'Voyages internationaux',
  sousTitre:pt.voyagesSousTitre?.trim() || 'Argentine · Bolivie · Cuba · Venezuela · Mexique',
  ctaTexte: pt.voyagesCtaTexte?.trim()  || 'Découvrir les voyages →',
  ctaUrl:   pt.voyagesCtaUrl?.trim()    || '/voyages-peche-mouche',
}
const cta = {
  titre:    pt.ctaTitre?.trim()     || 'Prêt à vivre votre expérience ?',
  texte:    pt.ctaTexte?.trim()     || 'Rejoignez les centaines de pêcheurs qui ont fait confiance à Jean-Baptiste depuis 2004.',
  btn1Texte:pt.ctaBtn1Texte?.trim() || 'Réserver une sortie',
  btn1Url:  pt.ctaBtn1Url?.trim()   || '/contact',
  btn2Texte:pt.ctaBtn2Texte?.trim() || 'Voir les prestations',
  btn2Url:  pt.ctaBtn2Url?.trim()   || '/stage-peche-mouche',
}

// ── Témoignages depuis Sanity, ordonnés par orderRank ──────────────────────
// On utilise stegaClient pour activer le Visual Editing (clic → Studio).
// Les comparaisons sur prestation utilisent stegaClean() pour retirer les
// caractères invisibles stega avant de comparer les chaînes.
const allTemos = await stegaClient.fetch(
  `*[_type == "temoignage"] | order(orderRank asc) { _id, nom, note, prestation, texte }`
)

// ── Photos associées (chemins locaux public/images/) ───────────────────────
// Les photos ne sont pas encore dans Sanity — elles sont servies depuis /public/images
const photoMap: Record<string, { src: string; alt: string; style?: string }[]> = {
  'temo-malcolm': [
    { src: '/images/temo-malcolm-1.jpg', alt: 'Malcolm avec un beau bar — pêche à vue en Bretagne-Sud' },
    { src: '/images/temo-malcolm-2.png', alt: 'Malcolm en action — lancer fly fishing bar à la mouche' },
    { src: '/images/temo-malcolm-3.png', alt: 'Malcolm avec un bar capturé en pêche à vue' },
  ],
  'temo-vincent': [
    { src: '/images/temo-vincent-1.png', alt: 'Vincent avec un bar capturé à la mouche en Bretagne' },
    { src: '/images/temo-vincent-2.png', alt: 'Vincent — bar à la mouche en bord de côte bretonne' },
  ],
  'temo-marc': [
    { src: '/images/temo-marc-1.jpg', alt: 'Marc avec un bar capturé en bateau — pêche mouche Bretagne' },
  ],
  'temo-diego': [
    { src: '/images/temo-diego-1.png', alt: 'Diego guidé par Jean-Baptiste — saumon à la mouche en Bretagne' },
    { src: '/images/temo-diego-2.png', alt: 'Rivière bretonne — session saumon et Spey Cast avec JBV' },
  ],
  'temo-patrice': [
    { src: '/images/temo-patrice-1.jpg', alt: 'Patrice et Jean-Baptiste avec un beau saumon — rivière bretonne' },
  ],
  'temo-patrice58': [
    { src: '/images/temo-patrice58-1.jpg', alt: 'Patrice en Spey Cast sur rivière bretonne' },
    { src: '/images/temo-patrice58-3.jpg', alt: 'Patrice — stage de pêche des migrateurs en Bretagne' },
  ],
  'temo-patrick-alain': [
    { src: '/images/temo-patrick-1.jpg', alt: 'Patrick — migrateurs à la mouche sur rivières bretonnes', style: 'object-fit:contain' },
  ],
  'temo-mathieu-philippe': [
    { src: '/images/temo-mathieu-1.png', alt: 'Philippe avec un saumon capturé — guidage JBV Bretagne' },
    { src: '/images/temo-mathieu-2.png', alt: 'Mathieu — saumon à la mouche en rivière bretonne' },
    { src: '/images/temo-mathieu-3.png', alt: 'Mathieu et Philippe — séjour saumon avec Jean-Baptiste Vidal' },
  ],
  'temo-antoine': [
    { src: '/images/temo-antoine-1.jpg', alt: "Antoine — guidage saumon sur l'Elorn avec Jean-Baptiste Vidal" },
  ],
  'temo-jerome-veyret': [
    { src: '/images/temo-jeromev-1.jpg', alt: "Jérôme Veyret — alose à la mouche avec JBV sur l'Aulne" },
    { src: '/images/temo-jeromev-2.jpg', alt: "Jérôme Veyret — Spey Cast et pêche de l'alose en Bretagne" },
  ],
  'temo-yann-leprevost': [
    { src: '/images/temo-yann-2.png', alt: 'Yann Le Prevost — Spey Cast sur les rivières bretonnes' },
    { src: '/images/temo-yann-1.jpg', alt: 'Yann Le Prevost — saumon et alose avec Jean-Baptiste Vidal' },
  ],
  'temo-guy-bonel': [
    { src: '/images/temo-guy-1.jpg', alt: 'Guy Bonel — saumon à la mouche sur les rivières du Finistère' },
    { src: '/images/temo-guy-2.jpg', alt: 'Guy Bonel guidé par Jean-Baptiste Vidal — rivières bretonnes' },
  ],
  'temo-michael-arraitz': [
    { src: '/images/temo-michael-1.jpg', alt: 'Michael Arraitz — Spey Cast et migrateurs avec JBV en Bretagne' },
    { src: '/images/temo-michael-2.jpg', alt: 'Michael Arraitz — session migrateurs sur rivière bretonne' },
  ],
  'temo-jean-daniel-pilotto': [
    { src: '/images/temo-jeandaniel-1.jpg', alt: 'Jean-Daniel Pilotto — saumon atlantique en Bretagne avec JBV' },
    { src: '/images/temo-jeandaniel-2.jpg', alt: "Jean-Daniel Pilotto — guidage saumon sur l'Ellé ou le Scorff" },
  ],
  'temo-woestelandt': [
    { src: '/images/temo-woestelandt-1.jpg', alt: 'Mr et Mme Woestelandt — Spey Cast et saumon sur rivières bretonnes' },
  ],
  'temo-yann-leprevost-2': [
    { src: '/images/temo-yann2-1.jpg', alt: "Yann Le Prevost — Spey Cast et saumon sur l'Ellé avec JBV" },
  ],
  'temo-pierre-sabourin': [
    { src: '/images/temo-pierre-1.jpg', alt: 'Pierre Sabourin — saumon à la mouche en Bretagne avec JBV' },
  ],
  'temo-cedric-goh': [
    { src: '/images/temo-cedric-1.jpg', alt: 'Cédric Goh — initiation saumon et Spey Cast avec Jean-Baptiste Vidal' },
  ],
  'temo-christophe': [
    { src: '/images/temo-christophe-1.png', alt: 'Christophe relâchant une truite sur le Scorff — guidage JBV' },
  ],
  'temo-christian': [
    { src: '/images/temo-christian-2.jpg', alt: 'Christian — beau fario capturé en rivière bretonne' },
    { src: '/images/temo-christian-1.jpg', alt: 'Christian — perfectionnement pêche à la mouche avec JBV' },
  ],
  'temo-jerome': [
    { src: '/images/temo-jerome-1.jpg', alt: "Jérome — initiation pêche à la mouche sur le Scorff et l'Ellé" },
    { src: '/images/temo-jerome-2.jpg', alt: 'Jérome en action — lancer mouche sous la guidance de JBV' },
  ],
  'temo-christian-chris-ferrier': [
    { src: '/images/temo-christianchris-1.jpg', alt: 'Christian et Chris Ferrier — initiation père-fils pêche à la mouche' },
  ],
  'temo-fiona-romain': [
    { src: '/images/temo-antoine-2.jpg', alt: 'Fiona et Romain — journée découverte pêche à la mouche en rivière bretonne' },
    { src: '/images/temo-fiona-1.jpg', alt: 'Fiona et Romain — découverte de la pêche à la mouche avec JBV' },
  ],
  'temo-mary-ann': [
    { src: '/images/temo-maryann-1.jpg', alt: 'Mary-Ann — dorado en Argentine avec Jean-Baptiste Vidal, Pira Lodge' },
  ],
  'temo-jean-pierre': [
    { src: '/images/temo-jeanpierre-1.jpg', alt: 'Jean-Pierre — pêche à la mouche en mer, grande distance' },
  ],
  'temo-cary-pugh': [
    { src: '/images/temo-cary-1.jpg', alt: 'Cary Pugh — dorado à la mouche en Bolivie avec JBV, Tsimane Lodge' },
  ],
}

// ── Regroupement par catégorie ──────────────────────────────────────────────
// stegaClean() retire les caractères stega invisibles avant toute comparaison
const temoBar     = allTemos.filter((t: any) => stegaClean(t.prestation) === 'Bar à la mouche')
const temoSaumon  = allTemos.filter((t: any) =>
  ['Saumon', 'Alose', 'Spey Cast'].includes(stegaClean(t.prestation))
)
const temoTruite  = allTemos.filter((t: any) =>
  ['Truite en rivière', 'Initiation pêche à la mouche', 'Brochet', 'Masterclass'].includes(stegaClean(t.prestation))
)
const temoVoyages = allTemos.filter((t: any) => stegaClean(t.prestation) === 'Voyage')

// Témoignages ajoutés dans Sanity sans catégorie connue (futur)
const temoAutres  = allTemos.filter((t: any) =>
  !['Bar à la mouche', 'Saumon', 'Alose', 'Spey Cast',
    'Truite en rivière', 'Initiation pêche à la mouche', 'Brochet', 'Masterclass', 'Voyage']
    .includes(stegaClean(t.prestation))
)

const sections = [
  { id: 'bar',     label: bar.onglet,     count: temoBar.length },
  { id: 'saumon',  label: saumon.onglet,  count: temoSaumon.length },
  { id: 'truite',  label: truite.onglet,  count: temoTruite.length },
  { id: 'voyages', label: voyages.onglet, count: temoVoyages.length },
]

// Seuil à partir duquel on affiche "Lire la suite" (~3 lignes = ~250 chars)
const EXTRAIT_MAX = 260
---

<BaseLayout title={seoTitle} description={seoDescription}>

  <!-- ══════════════════════════ HERO ══════════════════════════ -->
  <section class="temo-hero">
    <div class="container">
      <p class="temo-hero__eyebrow">{hero.eyebrow}</p>
      <h1>{hero.titre}</h1>
      <p class="temo-hero__intro">{hero.intro}</p>
    </div>
  </section>

  <!-- ══════════════════════════ NAV SECTIONS ══════════════════ -->
  <nav class="temo-nav" aria-label="Catégories de témoignages">
    <ul class="temo-nav__list">
      <span class="temo-nav__slider" aria-hidden="true"></span>
      {sections.map(s => (
        <li>
          <a href={`#${s.id}`} class="temo-nav__link">
            <span class="temo-nav__label">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- ══════════════════════════ BAR ══════════════════════════ -->
  <section class="temo-section section section--sand" id="bar">
    <div class="container">
      <div class="temo-section__header">
        <div>
          <h2>{bar.titre}</h2>
          <p class="temo-section__sub">{bar.sousTitre}</p>
        </div>
      </div>
      <div class="temo-grid">
        {temoBar.map((t: any) => {
          const photos = photoMap[t._id] ?? []
          const long = t.texte.length > EXTRAIT_MAX
          return (
            <article class="temo-card">
              {photos.length > 0 && (
                <div class="carousel" data-count={photos.length}>
                  <div class="carousel__track">
                    {photos.map(p => (
                      <img src={p.src} alt={p.alt} loading="lazy" style={p.style} />
                    ))}
                  </div>
                  <button class="carousel__btn carousel__btn--prev" aria-label="Photo précédente">‹</button>
                  <button class="carousel__btn carousel__btn--next" aria-label="Photo suivante">›</button>
                  <div class="carousel__dots">
                    {photos.map((_: any, i: number) => (
                      <span class={i === 0 ? 'dot dot--active' : 'dot'} />
                    ))}
                  </div>
                </div>
              )}
              <div class="temo-card__header">
                <div class="temo-card__avatar">{t.nom.charAt(0)}</div>
                <div>
                  <strong class="temo-card__name">{t.nom}</strong>
                  {t.prestation && <span class="temo-card__type">{t.prestation}</span>}
                </div>
              </div>
              <blockquote class:list={['temo-card__quote', { 'clamped': long }]}>
                {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
              </blockquote>
              {long && <button class="quote-toggle" type="button">Lire la suite</button>}
              <div class="temo-card__stars" aria-label="5 étoiles">★★★★★</div>
            </article>
          )
        })}
      </div>
      <div class="temo-section__cta">
        <a href={bar.ctaUrl} class="btn-link">{bar.ctaTexte}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ SAUMON ══════════════════════ -->
  <section class="temo-section section section--mist" id="saumon">
    <div class="container">
      <div class="temo-section__header">
        <div>
          <h2>{saumon.titre}</h2>
          <p class="temo-section__sub">{saumon.sousTitre}</p>
        </div>
      </div>
      <div class="temo-grid">
        {temoSaumon.map((t: any) => {
          const photos = photoMap[t._id] ?? []
          const long = t.texte.length > EXTRAIT_MAX
          return (
            <article class="temo-card">
              {photos.length > 0 && (
                <div class="carousel" data-count={photos.length}>
                  <div class="carousel__track">
                    {photos.map(p => (
                      <img src={p.src} alt={p.alt} loading="lazy" style={p.style} />
                    ))}
                  </div>
                  <button class="carousel__btn carousel__btn--prev" aria-label="Photo précédente">‹</button>
                  <button class="carousel__btn carousel__btn--next" aria-label="Photo suivante">›</button>
                  <div class="carousel__dots">
                    {photos.map((_: any, i: number) => (
                      <span class={i === 0 ? 'dot dot--active' : 'dot'} />
                    ))}
                  </div>
                </div>
              )}
              <div class="temo-card__header">
                <div class="temo-card__avatar">{t.nom.charAt(0)}</div>
                <div>
                  <strong class="temo-card__name">{t.nom}</strong>
                  {t.prestation && <span class="temo-card__type">{t.prestation}</span>}
                </div>
              </div>
              <blockquote class:list={['temo-card__quote', { 'clamped': long }]}>
                {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
              </blockquote>
              {long && <button class="quote-toggle" type="button">Lire la suite</button>}
              <div class="temo-card__stars" aria-label="5 étoiles">★★★★★</div>
            </article>
          )
        })}
      </div>
      <div class="temo-section__cta">
        <a href={saumon.ctaUrl} class="btn-link">{saumon.ctaTexte}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ TRUITE ══════════════════════ -->
  <section class="temo-section section section--sand" id="truite">
    <div class="container">
      <div class="temo-section__header">
        <div>
          <h2>{truite.titre}</h2>
          <p class="temo-section__sub">{truite.sousTitre}</p>
        </div>
      </div>
      <div class="temo-grid">
        {temoTruite.map((t: any) => {
          const photos = photoMap[t._id] ?? []
          const long = t.texte.length > EXTRAIT_MAX
          return (
            <article class="temo-card">
              {photos.length > 0 && (
                <div class="carousel" data-count={photos.length}>
                  <div class="carousel__track">
                    {photos.map(p => (
                      <img src={p.src} alt={p.alt} loading="lazy" style={p.style} />
                    ))}
                  </div>
                  <button class="carousel__btn carousel__btn--prev" aria-label="Photo précédente">‹</button>
                  <button class="carousel__btn carousel__btn--next" aria-label="Photo suivante">›</button>
                  <div class="carousel__dots">
                    {photos.map((_: any, i: number) => (
                      <span class={i === 0 ? 'dot dot--active' : 'dot'} />
                    ))}
                  </div>
                </div>
              )}
              <div class="temo-card__header">
                <div class="temo-card__avatar">{t.nom.charAt(0)}</div>
                <div>
                  <strong class="temo-card__name">{t.nom}</strong>
                  {t.prestation && <span class="temo-card__type">{t.prestation}</span>}
                </div>
              </div>
              <blockquote class:list={['temo-card__quote', { 'clamped': long }]}>
                {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
              </blockquote>
              {long && <button class="quote-toggle" type="button">Lire la suite</button>}
              <div class="temo-card__stars" aria-label="5 étoiles">★★★★★</div>
            </article>
          )
        })}
      </div>
      <div class="temo-section__cta">
        <a href={truite.ctaUrl} class="btn-link">{truite.ctaTexte}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ VOYAGES ══════════════════════ -->
  <section class="temo-section section section--dark" id="voyages">
    <div class="container">
      <div class="temo-section__header temo-section__header--light">
        <div>
          <h2>{voyages.titre}</h2>
          <p class="temo-section__sub temo-section__sub--light">{voyages.sousTitre}</p>
        </div>
      </div>
      <div class="temo-grid">
        {temoVoyages.map((t: any) => {
          const photos = photoMap[t._id] ?? []
          const long = t.texte.length > EXTRAIT_MAX
          return (
            <article class="temo-card temo-card--dark">
              {photos.length > 0 && (
                <div class="carousel" data-count={photos.length}>
                  <div class="carousel__track">
                    {photos.map(p => (
                      <img src={p.src} alt={p.alt} loading="lazy" style={p.style} />
                    ))}
                  </div>
                  <button class="carousel__btn carousel__btn--prev" aria-label="Photo précédente">‹</button>
                  <button class="carousel__btn carousel__btn--next" aria-label="Photo suivante">›</button>
                  <div class="carousel__dots">
                    {photos.map((_: any, i: number) => (
                      <span class={i === 0 ? 'dot dot--active' : 'dot'} />
                    ))}
                  </div>
                </div>
              )}
              <div class="temo-card__header">
                <div class="temo-card__avatar temo-card__avatar--light">{t.nom.charAt(0)}</div>
                <div>
                  <strong class="temo-card__name">{t.nom}</strong>
                  {t.prestation && <span class="temo-card__type temo-card__type--light">{t.prestation}</span>}
                </div>
              </div>
              <blockquote class:list={['temo-card__quote temo-card__quote--light', { 'clamped': long }]}>
                {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
              </blockquote>
              {long && <button class="quote-toggle quote-toggle--light" type="button">Lire la suite</button>}
              <div class="temo-card__stars" aria-label="5 étoiles">★★★★★</div>
            </article>
          )
        })}
      </div>
      <div class="temo-section__cta">
        <a href={voyages.ctaUrl} class="btn-link btn-link--light">{voyages.ctaTexte}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════ AUTRES (nouveaux témoignages sans catégorie) ══════════ -->
  {temoAutres.length > 0 && (
    <section class="temo-section section section--mist">
      <div class="container">
        <div class="temo-section__header">
          <div>
            <p class="temo-eyebrow">✦ Nouveaux témoignages</p>
            <h2>Récemment ajoutés</h2>
          </div>
        </div>
        <div class="temo-grid">
          {temoAutres.map((t: any) => {
            const long = t.texte.length > EXTRAIT_MAX
            return (
              <article class="temo-card">
                <div class="temo-card__header">
                  <div class="temo-card__avatar">{t.nom.charAt(0)}</div>
                  <div>
                    <strong class="temo-card__name">{t.nom}</strong>
                    {t.prestation && <span class="temo-card__type">{t.prestation}</span>}
                  </div>
                </div>
                <blockquote class:list={['temo-card__quote', { 'clamped': long }]}>
                  {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
                </blockquote>
                {long && <button class="quote-toggle" type="button">Lire la suite</button>}
                <div class="temo-card__stars" aria-label={`${t.note || 5} étoiles`}>
                  {'★'.repeat(t.note || 5)}{'☆'.repeat(5 - (t.note || 5))}
                </div>
              </article>
            )
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════ CTA RÉSERVATION ══════════════ -->
  <section class="temo-cta section">
    <div class="container">
      <h2>{cta.titre}</h2>
      <p>{cta.texte}</p>
      <div class="temo-cta__btns">
        <a href={cta.btn1Url} class="btn-primary">{cta.btn1Texte}</a>
        <a href={cta.btn2Url} class="btn-secondary">{cta.btn2Texte}</a>
      </div>
    </div>
  </section>

</BaseLayout>

