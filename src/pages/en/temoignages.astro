---
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import { stegaClient } from '../../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'

const seoTitle = "Testimonials & Reviews — Jean-Baptiste Vidal, Fly Fishing Guide"
const seoDescription = "Read testimonials and reviews from Jean-Baptiste Vidal's clients — sea bass fly fishing, Atlantic salmon, Spey casting, trout and international fly fishing expeditions in Brittany."

// ── EN strings (hardcoded — pageTemoignages singleton has no EN fields yet) ──
const hero = {
  eyebrow:  '21 years of guiding',
  titre:    'Testimonials & Reviews',
  intro:    "Here you'll find testimonials from clients who have trusted me for a guided day in France or on one of my international fly fishing expeditions:",
}
const bar = {
  onglet:   'Sea bass',
  titre:    'Sea Bass Fly Fishing',
  sousTitre:'Sea bass fly fishing in South Brittany — sight fishing, boat and estuary',
  ctaTexte: 'Discover sea bass fly fishing →',
  ctaUrl:   '/en/peche-du-bar-a-la-mouche',
}
const saumon = {
  onglet:   'Salmon & Spey',
  titre:    'Atlantic Salmon, Shad & Spey Cast',
  sousTitre:"Migratory fish guiding on Brittany's rivers: Ellé, Scorff, Aulne, Aven, Elorn",
  ctaTexte: 'Discover Spey casting →',
  ctaUrl:   '/en/stage-spey-cast-et-cours-de-lancer',
}
const truite = {
  onglet:   'Trout & Beginners',
  titre:    'Trout & Beginners',
  sousTitre:'Beginner courses and trout river guiding: Scorff, Ellé, Isole',
  ctaTexte: 'Discover freshwater fly fishing →',
  ctaUrl:   '/en/peche-a-la-mouche-en-bretagne',
}
const voyages = {
  onglet:   'Expeditions',
  titre:    'International Fly Fishing Expeditions',
  sousTitre:'Argentina · Bolivia · Cuba · Venezuela · Mexico',
  ctaTexte: 'Discover the expeditions →',
  ctaUrl:   '/en/voyages-peche-mouche',
}
const cta = {
  titre:    'Ready for your own experience?',
  texte:    'Join the hundreds of anglers who have trusted Jean-Baptiste since 2004.',
  btn1Texte:'Book a session',
  btn1Url:  '/en/contact',
  btn2Texte:'View programmes',
  btn2Url:  '/en/stage-peche-mouche',
}

// ── Testimonials from Sanity (shown in their original language) ──────────────
const allTemos = await stegaClient.fetch(
  `*[_type == "temoignage"] | order(orderRank asc) { _id, nom, note, prestation, texte }`
)

// ── Associated photos (local /public/images/) ─────────────────────────────────
const photoMap: Record<string, { src: string; alt: string; style?: string }[]> = {
  'temo-malcolm': [
    { src: '/images/temo-malcolm-1.jpg', alt: 'Malcolm with a fine sea bass — sight fishing in South Brittany' },
    { src: '/images/temo-malcolm-2.png', alt: 'Malcolm casting — sea bass fly fishing on the Breton coast' },
    { src: '/images/temo-malcolm-3.png', alt: 'Malcolm with a sea bass caught on a sight fishing session' },
  ],
  'temo-vincent': [
    { src: '/images/temo-vincent-1.png', alt: 'Vincent with a sea bass caught on the fly in Brittany' },
    { src: '/images/temo-vincent-2.png', alt: 'Vincent — sea bass fly fishing along the Breton coastline' },
  ],
  'temo-marc': [
    { src: '/images/temo-marc-1.jpg', alt: 'Marc with a sea bass from the boat — fly fishing in Brittany' },
  ],
  'temo-diego': [
    { src: '/images/temo-diego-1.png', alt: 'Diego guided by Jean-Baptiste — Atlantic salmon fly fishing in Brittany' },
    { src: '/images/temo-diego-2.png', alt: 'Breton river — salmon and Spey Cast session with JBV' },
  ],
  'temo-patrice': [
    { src: '/images/temo-patrice-1.jpg', alt: 'Patrice and Jean-Baptiste with a fine Atlantic salmon on a Breton river' },
  ],
  'temo-patrice58': [
    { src: '/images/temo-patrice58-1.jpg', alt: 'Patrice Spey casting on a Breton river' },
    { src: '/images/temo-patrice58-3.jpg', alt: 'Patrice — migratory fish guiding course in Brittany' },
  ],
  'temo-patrick-alain': [
    { src: '/images/temo-patrick-1.jpg', alt: 'Patrick — migratory fish fly fishing on Breton rivers', style: 'object-fit:contain' },
  ],
  'temo-mathieu-philippe': [
    { src: '/images/temo-mathieu-1.png', alt: 'Philippe with an Atlantic salmon — JBV guided trip in Brittany' },
    { src: '/images/temo-mathieu-2.png', alt: 'Mathieu — salmon fly fishing on a Breton river' },
    { src: '/images/temo-mathieu-3.png', alt: 'Mathieu and Philippe — salmon trip with Jean-Baptiste Vidal' },
  ],
  'temo-antoine': [
    { src: '/images/temo-antoine-1.jpg', alt: 'Antoine — salmon guiding on the Elorn river with Jean-Baptiste Vidal' },
  ],
  'temo-jerome-veyret': [
    { src: '/images/temo-jeromev-1.jpg', alt: 'Jérôme Veyret — shad on the fly with JBV on the Aulne river' },
    { src: '/images/temo-jeromev-2.jpg', alt: 'Jérôme Veyret — Spey Cast and shad fly fishing in Brittany' },
  ],
  'temo-yann-leprevost': [
    { src: '/images/temo-yann-2.png', alt: 'Yann Le Prevost — Spey casting on Breton rivers' },
    { src: '/images/temo-yann-1.jpg', alt: 'Yann Le Prevost — salmon and shad with Jean-Baptiste Vidal' },
  ],
  'temo-guy-bonel': [
    { src: '/images/temo-guy-1.jpg', alt: 'Guy Bonel — Atlantic salmon fly fishing on rivers of Finistère' },
    { src: '/images/temo-guy-2.jpg', alt: 'Guy Bonel guided by Jean-Baptiste Vidal on Breton rivers' },
  ],
  'temo-michael-arraitz': [
    { src: '/images/temo-michael-1.jpg', alt: 'Michael Arraitz — Spey Cast and migratory fish with JBV in Brittany' },
    { src: '/images/temo-michael-2.jpg', alt: 'Michael Arraitz — migratory fish session on a Breton river' },
  ],
  'temo-jean-daniel-pilotto': [
    { src: '/images/temo-jeandaniel-1.jpg', alt: 'Jean-Daniel Pilotto — Atlantic salmon in Brittany with JBV' },
    { src: '/images/temo-jeandaniel-2.jpg', alt: 'Jean-Daniel Pilotto — salmon guiding on the Ellé or Scorff' },
  ],
  'temo-woestelandt': [
    { src: '/images/temo-woestelandt-1.jpg', alt: 'Mr and Mrs Woestelandt — Spey Cast and salmon on Breton rivers' },
  ],
  'temo-yann-leprevost-2': [
    { src: '/images/temo-yann2-1.jpg', alt: 'Yann Le Prevost — Spey Cast and salmon on the Ellé with JBV' },
  ],
  'temo-pierre-sabourin': [
    { src: '/images/temo-pierre-1.jpg', alt: 'Pierre Sabourin — Atlantic salmon fly fishing in Brittany with JBV' },
  ],
  'temo-cedric-goh': [
    { src: '/images/temo-cedric-1.jpg', alt: 'Cédric Goh — salmon beginner course and Spey Cast with Jean-Baptiste Vidal' },
  ],
  'temo-christophe': [
    { src: '/images/temo-christophe-1.png', alt: 'Christophe releasing a trout on the Scorff — JBV guided session' },
  ],
  'temo-christian': [
    { src: '/images/temo-christian-2.jpg', alt: 'Christian — fine wild trout caught on a Breton river' },
    { src: '/images/temo-christian-1.jpg', alt: 'Christian — fly fishing improvement course with JBV' },
  ],
  'temo-jerome': [
    { src: '/images/temo-jerome-1.jpg', alt: 'Jérome — beginner fly fishing course on the Scorff and Ellé' },
    { src: '/images/temo-jerome-2.jpg', alt: 'Jérome casting — learning fly fishing under JBV coaching' },
  ],
  'temo-christian-chris-ferrier': [
    { src: '/images/temo-christianchris-1.jpg', alt: 'Christian and Chris Ferrier — father-and-son beginner fly fishing course' },
  ],
  'temo-fiona-romain': [
    { src: '/images/temo-antoine-2.jpg', alt: 'Fiona and Romain — introductory fly fishing day on a Breton river' },
    { src: '/images/temo-fiona-1.jpg', alt: 'Fiona and Romain — discovering fly fishing with JBV' },
  ],
  'temo-mary-ann': [
    { src: '/images/temo-maryann-1.jpg', alt: 'Mary-Ann — dorado in Argentina with Jean-Baptiste Vidal, Pira Lodge' },
  ],
  'temo-jean-pierre': [
    { src: '/images/temo-jeanpierre-1.jpg', alt: 'Jean-Pierre — saltwater fly fishing, long-distance casting' },
  ],
  'temo-cary-pugh': [
    { src: '/images/temo-cary-1.jpg', alt: 'Cary Pugh — dorado on the fly in Bolivia with JBV, Tsimane Lodge' },
  ],
}

// ── Group by category ─────────────────────────────────────────────────────────
const temoBar     = allTemos.filter((t: any) => stegaClean(t.prestation) === 'Bar à la mouche')
const temoSaumon  = allTemos.filter((t: any) =>
  ['Saumon', 'Alose', 'Spey Cast'].includes(stegaClean(t.prestation))
)
const temoTruite  = allTemos.filter((t: any) =>
  ['Truite en rivière', 'Initiation pêche à la mouche', 'Brochet', 'Masterclass'].includes(stegaClean(t.prestation))
)
const temoVoyages = allTemos.filter((t: any) => stegaClean(t.prestation) === 'Voyage')
const temoAutres  = allTemos.filter((t: any) =>
  !['Bar à la mouche', 'Saumon', 'Alose', 'Spey Cast',
    'Truite en rivière', 'Initiation pêche à la mouche', 'Brochet', 'Masterclass', 'Voyage']
    .includes(stegaClean(t.prestation))
)

const sections = [
  { id: 'bar',     label: bar.onglet,     count: temoBar.length },
  { id: 'saumon',  label: saumon.onglet,  count: temoSaumon.length },
  { id: 'truite',  label: truite.onglet,  count: temoTruite.length },
  { id: 'voyages', label: voyages.onglet, count: temoVoyages.length },
]

const EXTRAIT_MAX = 260
---

<BaseLayout title={seoTitle} description={seoDescription} lang="en" hreflangFr="/temoignages" hreflangEn="/en/temoignages">

  <!-- ══════════════════════════ HERO ══════════════════════════ -->
  <section class="temo-hero">
    <div class="container">
      <p class="temo-hero__eyebrow">{hero.eyebrow}</p>
      <h1>{hero.titre}</h1>
      <p class="temo-hero__intro">{hero.intro}</p>
    </div>
  </section>

  <!-- ══════════════════════════ NAV SECTIONS ══════════════════ -->
  <nav class="temo-nav" aria-label="Testimonial categories">
    <ul class="temo-nav__list">
      <span class="temo-nav__slider" aria-hidden="true"></span>
      {sections.map(s => (
        <li>
          <a href={`#${s.id}`} class="temo-nav__link">
            <span class="temo-nav__label">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- ══════════════════════════ BAR ══════════════════════════ -->
  <section class="temo-section section section--sand" id="bar">
    <div class="container">
      <div class="temo-section__header">
        <div>
          <h2>{bar.titre}</h2>
          <p class="temo-section__sub">{bar.sousTitre}</p>
        </div>
      </div>
      <div class="temo-grid">
        {temoBar.map((t: any) => {
          const photos = photoMap[t._id] ?? []
          const long = t.texte.length > EXTRAIT_MAX
          return (
            <article class="temo-card">
              {photos.length > 0 && (
                <div class="carousel" data-count={photos.length}>
                  <div class="carousel__track">
                    {photos.map(p => (
                      <img src={p.src} alt={p.alt} loading="lazy" style={p.style} />
                    ))}
                  </div>
                  <button class="carousel__btn carousel__btn--prev" aria-label="Previous photo">‹</button>
                  <button class="carousel__btn carousel__btn--next" aria-label="Next photo">›</button>
                  <div class="carousel__dots">
                    {photos.map((_: any, i: number) => (
                      <span class={i === 0 ? 'dot dot--active' : 'dot'} />
                    ))}
                  </div>
                </div>
              )}
              <div class="temo-card__header">
                <div class="temo-card__avatar">{t.nom.charAt(0)}</div>
                <div>
                  <strong class="temo-card__name">{t.nom}</strong>
                  {t.prestation && <span class="temo-card__type">{t.prestation}</span>}
                </div>
              </div>
              <blockquote class:list={['temo-card__quote', { 'clamped': long }]}>
                {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
              </blockquote>
              {long && <button class="quote-toggle" type="button">Read more</button>}
              <div class="temo-card__stars" aria-label="5 stars">★★★★★</div>
            </article>
          )
        })}
      </div>
      <div class="temo-section__cta">
        <a href={bar.ctaUrl} class="btn-link">{bar.ctaTexte}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ SAUMON ══════════════════════ -->
  <section class="temo-section section section--mist" id="saumon">
    <div class="container">
      <div class="temo-section__header">
        <div>
          <h2>{saumon.titre}</h2>
          <p class="temo-section__sub">{saumon.sousTitre}</p>
        </div>
      </div>
      <div class="temo-grid">
        {temoSaumon.map((t: any) => {
          const photos = photoMap[t._id] ?? []
          const long = t.texte.length > EXTRAIT_MAX
          return (
            <article class="temo-card">
              {photos.length > 0 && (
                <div class="carousel" data-count={photos.length}>
                  <div class="carousel__track">
                    {photos.map(p => (
                      <img src={p.src} alt={p.alt} loading="lazy" style={p.style} />
                    ))}
                  </div>
                  <button class="carousel__btn carousel__btn--prev" aria-label="Previous photo">‹</button>
                  <button class="carousel__btn carousel__btn--next" aria-label="Next photo">›</button>
                  <div class="carousel__dots">
                    {photos.map((_: any, i: number) => (
                      <span class={i === 0 ? 'dot dot--active' : 'dot'} />
                    ))}
                  </div>
                </div>
              )}
              <div class="temo-card__header">
                <div class="temo-card__avatar">{t.nom.charAt(0)}</div>
                <div>
                  <strong class="temo-card__name">{t.nom}</strong>
                  {t.prestation && <span class="temo-card__type">{t.prestation}</span>}
                </div>
              </div>
              <blockquote class:list={['temo-card__quote', { 'clamped': long }]}>
                {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
              </blockquote>
              {long && <button class="quote-toggle" type="button">Read more</button>}
              <div class="temo-card__stars" aria-label="5 stars">★★★★★</div>
            </article>
          )
        })}
      </div>
      <div class="temo-section__cta">
        <a href={saumon.ctaUrl} class="btn-link">{saumon.ctaTexte}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ TRUITE ══════════════════════ -->
  <section class="temo-section section section--sand" id="truite">
    <div class="container">
      <div class="temo-section__header">
        <div>
          <h2>{truite.titre}</h2>
          <p class="temo-section__sub">{truite.sousTitre}</p>
        </div>
      </div>
      <div class="temo-grid">
        {temoTruite.map((t: any) => {
          const photos = photoMap[t._id] ?? []
          const long = t.texte.length > EXTRAIT_MAX
          return (
            <article class="temo-card">
              {photos.length > 0 && (
                <div class="carousel" data-count={photos.length}>
                  <div class="carousel__track">
                    {photos.map(p => (
                      <img src={p.src} alt={p.alt} loading="lazy" style={p.style} />
                    ))}
                  </div>
                  <button class="carousel__btn carousel__btn--prev" aria-label="Previous photo">‹</button>
                  <button class="carousel__btn carousel__btn--next" aria-label="Next photo">›</button>
                  <div class="carousel__dots">
                    {photos.map((_: any, i: number) => (
                      <span class={i === 0 ? 'dot dot--active' : 'dot'} />
                    ))}
                  </div>
                </div>
              )}
              <div class="temo-card__header">
                <div class="temo-card__avatar">{t.nom.charAt(0)}</div>
                <div>
                  <strong class="temo-card__name">{t.nom}</strong>
                  {t.prestation && <span class="temo-card__type">{t.prestation}</span>}
                </div>
              </div>
              <blockquote class:list={['temo-card__quote', { 'clamped': long }]}>
                {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
              </blockquote>
              {long && <button class="quote-toggle" type="button">Read more</button>}
              <div class="temo-card__stars" aria-label="5 stars">★★★★★</div>
            </article>
          )
        })}
      </div>
      <div class="temo-section__cta">
        <a href={truite.ctaUrl} class="btn-link">{truite.ctaTexte}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ VOYAGES ══════════════════════ -->
  <section class="temo-section section section--dark" id="voyages">
    <div class="container">
      <div class="temo-section__header temo-section__header--light">
        <div>
          <h2>{voyages.titre}</h2>
          <p class="temo-section__sub temo-section__sub--light">{voyages.sousTitre}</p>
        </div>
      </div>
      <div class="temo-grid">
        {temoVoyages.map((t: any) => {
          const photos = photoMap[t._id] ?? []
          const long = t.texte.length > EXTRAIT_MAX
          return (
            <article class="temo-card temo-card--dark">
              {photos.length > 0 && (
                <div class="carousel" data-count={photos.length}>
                  <div class="carousel__track">
                    {photos.map(p => (
                      <img src={p.src} alt={p.alt} loading="lazy" style={p.style} />
                    ))}
                  </div>
                  <button class="carousel__btn carousel__btn--prev" aria-label="Previous photo">‹</button>
                  <button class="carousel__btn carousel__btn--next" aria-label="Next photo">›</button>
                  <div class="carousel__dots">
                    {photos.map((_: any, i: number) => (
                      <span class={i === 0 ? 'dot dot--active' : 'dot'} />
                    ))}
                  </div>
                </div>
              )}
              <div class="temo-card__header">
                <div class="temo-card__avatar temo-card__avatar--light">{t.nom.charAt(0)}</div>
                <div>
                  <strong class="temo-card__name">{t.nom}</strong>
                  {t.prestation && <span class="temo-card__type temo-card__type--light">{t.prestation}</span>}
                </div>
              </div>
              <blockquote class:list={['temo-card__quote temo-card__quote--light', { 'clamped': long }]}>
                {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
              </blockquote>
              {long && <button class="quote-toggle quote-toggle--light" type="button">Read more</button>}
              <div class="temo-card__stars" aria-label="5 stars">★★★★★</div>
            </article>
          )
        })}
      </div>
      <div class="temo-section__cta">
        <a href={voyages.ctaUrl} class="btn-link btn-link--light">{voyages.ctaTexte}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════ AUTRES (recent additions without category) ══════════════ -->
  {temoAutres.length > 0 && (
    <section class="temo-section section section--mist">
      <div class="container">
        <div class="temo-section__header">
          <div>
            <p class="temo-eyebrow">✦ Recent additions</p>
            <h2>Recently added</h2>
          </div>
        </div>
        <div class="temo-grid">
          {temoAutres.map((t: any) => {
            const long = t.texte.length > EXTRAIT_MAX
            return (
              <article class="temo-card">
                <div class="temo-card__header">
                  <div class="temo-card__avatar">{t.nom.charAt(0)}</div>
                  <div>
                    <strong class="temo-card__name">{t.nom}</strong>
                    {t.prestation && <span class="temo-card__type">{t.prestation}</span>}
                  </div>
                </div>
                <blockquote class:list={['temo-card__quote', { 'clamped': long }]}>
                  {t.texte.split('\n\n').map((p: string) => <p>{p}</p>)}
                </blockquote>
                {long && <button class="quote-toggle" type="button">Read more</button>}
                <div class="temo-card__stars" aria-label={`${t.note || 5} stars`}>
                  {'★'.repeat(t.note || 5)}{'☆'.repeat(5 - (t.note || 5))}
                </div>
              </article>
            )
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════ CTA ══════════════════════════ -->
  <section class="temo-cta section">
    <div class="container">
      <h2>{cta.titre}</h2>
      <p>{cta.texte}</p>
      <div class="temo-cta__btns">
        <a href={cta.btn1Url} class="btn-primary">{cta.btn1Texte}</a>
        <a href={cta.btn2Url} class="btn-secondary">{cta.btn2Texte}</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO ── */
  .temo-hero {
    background: var(--color-ocean);
    color: white;
    padding: 7rem 0 4rem;
    text-align: center;
  }
  .temo-hero__eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    margin-bottom: 0.8rem;
  }
  .temo-hero h1 {
    color: white;
    margin-bottom: 1.2rem;
  }
  .temo-hero__intro {
    max-width: 680px;
    margin: 0 auto;
    color: rgba(255,255,255,0.75);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* ── NAV ── */
  .temo-nav {
    background: var(--color-ocean);
    position: sticky;
    top: var(--header-height);
    z-index: 10;
  }
  .temo-nav__list {
    list-style: none;
    position: relative;
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .temo-nav__list::-webkit-scrollbar { display: none; }
  .temo-nav__list li {
    flex: 1;
    min-width: 120px;
    border-right: 1px solid rgba(255,255,255,0.08);
  }
  .temo-nav__list li:last-child { border-right: none; }

  .temo-nav__slider {
    position: absolute;
    top: 0;
    height: 100%;
    background: var(--color-ocean-main);
    pointer-events: none;
    z-index: 0;
  }

  .temo-nav__link {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1.1rem 1rem;
    color: rgba(255,255,255,0.55);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .temo-nav__link:hover {
    background: var(--color-ocean-main);
    color: white;
  }
  .temo-nav__link.temo-nav__link--active {
    color: white;
  }
  .temo-nav__label { letter-spacing: inherit; }

  /* ── EYEBROW nouveaux ── */
  .temo-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ocean-main);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  /* ── SECTION HEADERS ── */
  .temo-section__header {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    margin-bottom: 3rem;
  }
  .temo-section__header--light { color: white; }
  .temo-section__sub {
    color: var(--color-text-muted);
    margin-top: 0.3rem;
    font-size: 1rem;
  }
  .temo-section__sub--light { color: rgba(255,255,255,0.6); }
  .temo-section__header--light h2 { color: white; }

  /* ── GRID ── */
  .temo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  /* ── CARD ── */
  .temo-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(27,94,138,0.07);
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .temo-card--dark {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: none;
  }

  /* ── CAROUSEL ── */
  .carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: #07181f;
  }
  .carousel__track {
    display: flex;
    height: 100%;
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .carousel__track img {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    object-fit: cover;
    display: block;
  }
  .carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,0.38);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }
  .carousel__btn:hover {
    background: rgba(0,0,0,0.62);
    transform: translateY(-50%) scale(1.08);
  }
  .carousel__btn--prev { left: 10px; }
  .carousel__btn--next { right: 10px; }
  .carousel[data-count="1"] .carousel__btn { display: none; }
  .carousel__dots {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 2;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    transition: background 0.2s, transform 0.2s;
  }
  .dot--active {
    background: white;
    transform: scale(1.25);
  }
  .carousel[data-count="1"] .carousel__dots { display: none; }

  /* ── CARD BODY ── */
  .temo-card__header {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.2rem 1.4rem 0.8rem;
  }
  .temo-card__avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-ocean-main);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    flex-shrink: 0;
  }
  .temo-card__avatar--light {
    background: rgba(126,200,227,0.25);
    color: var(--color-ocean-light);
  }
  .temo-card__name {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .temo-card--dark .temo-card__name { color: white; }
  .temo-card__type {
    display: block;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 2px;
    line-height: 1.35;
  }
  .temo-card__type--light { color: rgba(255,255,255,0.5); }

  /* ── QUOTE + TRUNCATION ── */
  .temo-card__quote {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.72;
    border-left: 3px solid var(--color-ocean-light);
    padding: 0 1.2rem 0 1rem;
    margin: 0 0.2rem 0 1.2rem;
    font-style: italic;
  }
  .temo-card__quote--light {
    color: rgba(255,255,255,0.85);
    border-left-color: var(--color-ocean-light);
  }
  .temo-card__quote p + p { margin-top: 0.65em; }

  .temo-card__quote.clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  .quote-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-ocean-main);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.35rem 1.4rem 0 2.2rem;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-align: left;
    line-height: 1;
  }
  .quote-toggle:hover { color: var(--color-ocean); }
  .quote-toggle--light {
    color: var(--color-ocean-light);
  }
  .quote-toggle--light:hover { color: white; }

  .temo-card__stars {
    font-size: 0.88rem;
    color: #f59e0b;
    letter-spacing: 0.05em;
    padding: 0.8rem 1.4rem 1.2rem;
    margin-top: auto;
  }

  /* ── CTA SECTION ── */
  .temo-section__cta { text-align: center; }
  .btn-link {
    color: var(--color-ocean-main);
    font-weight: 500;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--color-ocean-light);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-link:hover { color: var(--color-ocean); border-color: var(--color-ocean); }
  .btn-link--light {
    color: var(--color-ocean-light);
    border-bottom-color: rgba(126,200,227,0.4);
  }
  .btn-link--light:hover { color: white; border-color: white; }

  /* ── FINAL CTA ── */
  .temo-cta {
    text-align: center;
    background: var(--color-sand);
  }
  .temo-cta h2 { margin-bottom: 0.8rem; }
  .temo-cta p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .temo-cta__btns {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--color-ocean-main);
    color: white;
    padding: 0.75rem 1.8rem;
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--color-ocean); }
  .btn-secondary {
    background: transparent;
    color: var(--color-ocean-main);
    padding: 0.75rem 1.8rem;
    border-radius: 4px;
    border: 1.5px solid var(--color-ocean-main);
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s, color 0.2s;
  }
  .btn-secondary:hover { background: var(--color-ocean-main); color: white; }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .temo-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .temo-hero { padding: 5rem 0 3rem; }
    .temo-section__header { flex-direction: column; gap: 0.5rem; }
    .carousel { aspect-ratio: 4/3; }
  }

  @media (max-width: 580px) {
    .temo-nav__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow-x: visible;
    }
    .temo-nav__list li {
      flex: unset;
      min-width: unset;
      border-right: 1px solid rgba(255,255,255,0.08);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .temo-nav__list li:nth-child(2n) { border-right: none; }
    .temo-nav__list li:nth-last-child(-n+2) { border-bottom: none; }
    .temo-nav__link {
      padding: 0.75rem 0.6rem;
      font-size: 0.68rem;
      letter-spacing: 0.07em;
      white-space: normal;
      text-align: center;
      line-height: 1.3;
    }
  }
</style>

<script>
  document.querySelectorAll('.carousel').forEach(carousel => {
    const track = carousel.querySelector('.carousel__track');
    const imgs  = carousel.querySelectorAll('img');
    const dots  = carousel.querySelectorAll('.dot');
    const count = imgs.length;
    if (count <= 1) return;

    let current = 0;

    function goto(n) {
      current = ((n % count) + count) % count;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('dot--active', i === current));
    }

    carousel.querySelector('.carousel__btn--prev')
      .addEventListener('click', e => { e.stopPropagation(); goto(current - 1); });
    carousel.querySelector('.carousel__btn--next')
      .addEventListener('click', e => { e.stopPropagation(); goto(current + 1); });

    let startX = 0;
    carousel.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) goto(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  });

  document.querySelectorAll('.quote-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const quote = btn.previousElementSibling;
      const isClamped = quote.classList.toggle('clamped');
      btn.textContent = isClamped ? 'Read more' : 'Read less';
    });
  });

  (() => {
    const sectionIds = ['bar', 'saumon', 'truite', 'voyages'];
    const navLinks   = {};
    const slider     = document.querySelector('.temo-nav__slider');
    const listEl     = document.querySelector('.temo-nav__list');

    document.querySelectorAll('.temo-nav__link').forEach(link => {
      const id = link.getAttribute('href')?.replace('#', '');
      if (id) navLinks[id] = link;
    });

    function moveSlider(link, instant) {
      if (!slider || !listEl || !link) return;
      if (instant) slider.style.transition = 'none';
      const listRect = listEl.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      slider.style.left  = (linkRect.left - listRect.left + listEl.scrollLeft) + 'px';
      slider.style.width = linkRect.width + 'px';
      if (instant) {
        requestAnimationFrame(() => {
          slider.style.transition = 'left 0.38s cubic-bezier(0.4,0,0.2,1), width 0.38s cubic-bezier(0.4,0,0.2,1)';
        });
      }
    }

    function setActive(id, instant) {
      Object.entries(navLinks).forEach(([key, link]) => {
        link.classList.toggle('temo-nav__link--active', key === id);
      });
      moveSlider(navLinks[id], instant);
      if (navLinks[id]) navLinks[id].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    }

    function update(instant = false) {
      const trigger = window.innerHeight * 0.35;
      let active = sectionIds[0];
      sectionIds.forEach(id => {
        const el = document.getElementById(id);
        if (el && el.getBoundingClientRect().top <= trigger) active = id;
      });
      setActive(active, instant);
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { update(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });

    window.addEventListener('resize', () => update(true), { passive: true });

    document.querySelectorAll('.temo-nav__link').forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault();
        const id     = link.getAttribute('href')?.replace('#', '');
        const target = id && document.getElementById(id);
        if (target) {
          const header = document.querySelector('header');
          const nav    = document.querySelector('.temo-nav');
          const offset = (header?.offsetHeight || 0) + (nav?.offsetHeight || 0) + 16;
          const top    = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });

    requestAnimationFrame(() => update(true));
  })();
</script>
