---
export const prerender = true

import BaseLayout from '../../../layouts/BaseLayout.astro'
import { createClient } from '@sanity/client'
import imageUrlBuilder from '@sanity/image-url'

const client = createClient({
  projectId: 'uievv97s',
  dataset: 'production',
  useCdn: false,
  apiVersion: '2024-01-01',
})

const builder = imageUrlBuilder(client)
const urlFor = (source) => builder.image(source)

const articles = await client.fetch(`
  *[_type == "article"] | order(date desc) {
    title, slug, date, image, extrait, espece, tags,
    titleEn, extraitEn
  }
`)

const especeLabel = {
  bar: 'Sea bass', truite: 'Trout', saumon: 'Salmon',
  alose: 'Shad', brochet: 'Pike', exotique: 'Saltwater',
}

const FILTER_TAGS_ORDER = ['Bar', 'Alose', 'Saumon', 'Truite', 'Brochet', 'Exotique', 'Voyage', 'Réservoir', 'Spey Cast', 'Masterclass']
const filtresPresents = FILTER_TAGS_ORDER.filter(tag => articles.some(a => (a.tags || []).includes(tag)))
---

<BaseLayout
  title="Fly Fishing Blog — Jean-Baptiste Vidal"
  description="Fishing stories, techniques and field notes from fly fishing guide Jean-Baptiste Vidal in Brittany, France."
  lang="en"
  hreflangFr="/blog"
  hreflangEn="/en/blog"
>

  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Enjoy Fishing</p>
      <h1>The blog</h1>
      <p class="hero-sub">Fishing stories, techniques and field notes.</p>
    </div>
  </section>

  <section class="section blog-section">
    <div class="container">

      {filtresPresents.length > 0 && (
        <nav class="filtres" id="filtres-nav">
          <a href="/en/blog" class="filtre filtre--tous">All</a>
          {filtresPresents.map(tag => (
            <a href={`/en/blog?tag=${encodeURIComponent(tag)}`} class="filtre" data-tag={tag}>{tag}</a>
          ))}
        </nav>
      )}

      {articles.length > 0 ? (
        <div class="articles-grid">
          {articles.map(article => {
            const shortTags = (article.tags || []).filter(t => t.length < 26).slice(0, 4)
            return (
            <a href={`/en/blog/${article.slug?.current}`} class="article-card"
               data-espece={article.espece || ''}
               data-tags={article.tags?.join(',') || ''}>
              <div class="article-img" style={article.image
                ? `background-image: url(${urlFor(article.image).width(600).height(380).fit('crop').crop('focalpoint').url()})`
                : ''}>
                {shortTags.length > 0 ? (
                  <div class="article-badges">
                    {shortTags.map(t => <span class="article-badge">{t}</span>)}
                  </div>
                ) : (
                  article.espece && <span class="article-badge">{especeLabel[article.espece] ?? article.espece}</span>
                )}
              </div>
              <div class="article-body">
                {article.date && (
                  <time class="article-date" datetime={article.date}>
                    {new Date(article.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                )}
                <h2 class="article-title">{article.titleEn || article.title}</h2>
                {(article.extraitEn || article.extrait) && (
                  <p class="article-extrait">{article.extraitEn || article.extrait}</p>
                )}
                <span class="article-lire">Read the article →</span>
              </div>
            </a>
            )
          })}
        </div>
      ) : (
        <div class="blog-vide">
          <p>Articles coming soon.</p>
        </div>
      )}
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    position: relative;
    min-height: 40vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 3rem;
    color: white;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(7,24,31,0.85) 0%, rgba(13,43,62,0.55) 100%),
      url('/images/hero.jpg') center / cover no-repeat;
    background-color: var(--color-ocean);
  }
  .page-hero-content {
    position: relative;
    z-index: 1;
    padding-top: var(--header-height);
  }
  .page-hero h1 { color: white; margin: 0.4rem 0 0.75rem; }
  .hero-sub { color: rgba(255,255,255,0.75); font-size: 1rem; }
  .eyebrow { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-ocean-light); font-weight: 500; }

  .filtres { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .filtre { padding: 0.4rem 1rem; border: 1.5px solid var(--color-ocean-main); border-radius: 2px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ocean-main); transition: all 0.2s; }
  .filtre:hover, .filtre--actif { background: var(--color-ocean-main); color: white; }
  .filtre--tag-actif { background: var(--color-ocean); color: white; border-color: var(--color-ocean); display: inline-flex; align-items: center; gap: 0.4rem; }
  .filtre--tag-actif .tag-close { color: rgba(255,255,255,0.7); font-weight: 700; line-height: 1; text-decoration: none; }
  .filtre--tag-actif .tag-close:hover { color: white; }

  .articles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .article-card { display: block; text-decoration: none; color: var(--color-text); border-radius: 3px; overflow: hidden; background: white; box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .article-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
  .article-img { position: relative; aspect-ratio: 16/10; background: var(--color-ocean) center / cover no-repeat; }
  .article-badges { position: absolute; top: 0.75rem; left: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .article-badge { background: var(--color-ocean-main); color: white; font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.22rem 0.55rem; border-radius: 2px; font-weight: 500; white-space: nowrap; }
  .article-espece { position: absolute; top: 0.75rem; left: 0.75rem; background: var(--color-ocean-main); color: white; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.25rem 0.6rem; border-radius: 2px; font-weight: 500; }
  .article-body { padding: 1.25rem 1.5rem 1.5rem; }
  .article-date { display: block; font-size: 0.72rem; color: var(--color-text-muted); letter-spacing: 0.05em; margin-bottom: 0.5rem; }
  .article-title { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 500; line-height: 1.3; margin-bottom: 0.6rem; color: var(--color-text); }
  .article-extrait { font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .article-lire { font-size: 0.75rem; font-weight: 500; color: var(--color-ocean-main); letter-spacing: 0.05em; text-transform: uppercase; }
  .blog-vide { text-align: center; padding: 5rem 0; color: var(--color-text-muted); font-family: var(--font-serif); font-size: 1.2rem; font-style: italic; }

  @media (max-width: 1024px) { .articles-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px)  { .articles-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const params  = new URLSearchParams(location.search)
  const activeT = params.get('tag')

  if (activeT) {
    document.querySelectorAll('.article-card').forEach(card => {
      const el = card as HTMLElement
      const cardTags = (el.dataset.tags || '').split(',').map(t => t.trim())
      el.style.display = cardTags.includes(decodeURIComponent(activeT)) ? '' : 'none'
    })
  }

  const tousEl = document.querySelector('.filtre--tous') as HTMLElement | null
  if (tousEl) tousEl.classList.toggle('filtre--actif', !activeT)

  document.querySelectorAll<HTMLElement>('.filtre[data-tag]').forEach(f => {
    f.classList.toggle('filtre--actif', f.dataset.tag === decodeURIComponent(activeT || ''))
  })

  if (activeT) {
    const nav = document.getElementById('filtres-nav')
    if (nav) {
      const pill = document.createElement('span')
      pill.className = 'filtre filtre--tag-actif'
      const label = decodeURIComponent(activeT)
      pill.innerHTML = `${label} <a href="/en/blog" class="tag-close" title="Remove filter">×</a>`
      nav.appendChild(pill)
    }
  }
</script>
