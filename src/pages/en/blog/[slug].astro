---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { createClient } from '@sanity/client'
import imageUrlBuilder from '@sanity/image-url'

export const prerender = true

export async function getStaticPaths() {
  const client = createClient({
    projectId: 'uievv97s',
    dataset: 'production',
    useCdn: false,
    apiVersion: '2024-01-01',
  })
  const articles = await client.fetch(
    `*[_type == "article" && defined(slug.current)]{ "slug": slug.current }`
  )
  return articles.map((a: any) => ({ params: { slug: a.slug } }))
}

const { slug } = Astro.params

const client = createClient({
  projectId: 'uievv97s',
  dataset: 'production',
  useCdn: false,
  apiVersion: '2024-01-01',
})

const builder = imageUrlBuilder(client)
const urlFor = (source: any) => { const b = builder.image(source); const hs = source?.hotspot; return (hs?.x != null && hs?.y != null) ? b.focalPoint(hs.x, hs.y) : b }

const article = await client.fetch(
  `*[_type == "article" && slug.current == $slug][0]{
    title, titleEn, slug, date, image, extrait, extraitEn,
    contenu, contenuEn, tags, espece, seoTitle, seoTitleEn, seoDescription, seoDescriptionEn
  }`,
  { slug }
)

if (!article) return Astro.redirect('/en/blog')

const especeLabel: Record<string, string> = {
  bar: 'Sea bass', truite: 'Trout', saumon: 'Salmon',
  alose: 'Shad', brochet: 'Pike', exotique: 'Saltwater',
}

const heroImg = article.image ? urlFor(article.image).width(1400).height(600).fit('crop').crop('focalpoint').url() : null
const dateFormatee = article.date
  ? new Date(article.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : null

const pageTitle  = article.seoTitleEn || article.titleEn || article.seoTitle || article.title
const pageDesc   = article.seoDescriptionEn || article.extraitEn || article.seoDescription || article.extrait || ''
const displayTitle  = article.titleEn  || article.title
const displayExtrait = article.extraitEn || article.extrait
// Merge: EN text blocks + FR images/videos at their original positions
function mergedContent(fr: any[], en: any[]) {
  if (!en?.length) return fr ?? []
  let textIdx = 0
  return (fr ?? []).map((block: any) => {
    if (block._type === 'block') {
      // Use EN text block at same position if available, else fall back to FR
      const enBlock = en.filter((b: any) => b._type === 'block')[textIdx]
      textIdx++
      return enBlock ?? block
    }
    // Images and videos always come from FR
    return block
  })
}
const content = mergedContent(article.contenu, article.contenuEn)
---

<BaseLayout
  title={`${pageTitle} — Jean-Baptiste Vidal`}
  description={pageDesc}
  lang="en"
  hreflangFr={`/blog/${slug}`}
  hreflangEn={`/en/blog/${slug}`}
>

  <section class="article-hero">
    <div class="article-hero-bg" style={heroImg
      ? `background-image: linear-gradient(to top, rgba(7,24,31,0.88) 0%, rgba(13,43,62,0.45) 100%), url(${heroImg}); background-size: cover; background-position: center; background-repeat: no-repeat;`
      : ''}></div>
    <div class="container article-hero-content">
      <div class="article-meta">
        {article.espece && <span class="badge">{especeLabel[article.espece] ?? article.espece}</span>}
        {dateFormatee && <time datetime={article.date}>{dateFormatee}</time>}
      </div>
      <h1>{displayTitle}</h1>
      {displayExtrait && <p class="article-extrait">{displayExtrait}</p>}
    </div>
  </section>

  <article class="section">
    <div class="container article-body">
      {content?.map((block: any) => {
        // ── Image ──
        if (block._type === 'image') {
          const imgUrl = block.asset ? urlFor(block).width(860).fit('max').url() : null
          if (!imgUrl) return null
          return (
            <figure class="article-image">
              <img src={imgUrl} alt={block.alt || ''} loading="lazy" />
            </figure>
          )
        }
        // ── YouTube ──
        if (block._type === 'youtube') {
          if (!block.videoId) return null
          return (
            <div class="article-video">
              <iframe
                src={`https://www.youtube.com/embed/${block.videoId}`}
                title="YouTube video"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              />
            </div>
          )
        }
        // ── Vimeo ──
        if (block._type === 'vimeo') {
          if (!block.videoId) return null
          return (
            <div class="article-video">
              <iframe
                src={`https://player.vimeo.com/video/${block.videoId}`}
                title="Vimeo video"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              />
            </div>
          )
        }
        // ── Bloc texte ──
        if (block._type !== 'block') return null
        const { children = [], markDefs = [], style = 'normal' } = block
        if (!children.some((c: any) => c.text?.trim())) return null
        const innerHtml = children.map((span: any) => {
          if (!span.text) return ''
          let txt = span.text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          const marks = span.marks ?? []
          const linkMark = marks.find((mk: string) => markDefs.some((md: any) => md._key === mk))
          const href = linkMark ? markDefs.find((md: any) => md._key === linkMark)?.href : null
          if (marks.includes('strong')) txt = `<strong>${txt}</strong>`
          if (marks.includes('em'))     txt = `<em>${txt}</em>`
          if (marks.includes('underline')) txt = `<u>${txt}</u>`
          if (href) txt = `<a href="${href}" target="_blank" rel="noopener">${txt}</a>`
          return txt
        }).join('')
        if (style === 'h2')         return <h2 set:html={innerHtml} />
        if (style === 'h3')         return <h3 set:html={innerHtml} />
        if (style === 'blockquote') return <blockquote set:html={innerHtml} />
        return <p set:html={innerHtml} />
      })}
      {article.tags?.length > 0 && (
        <div class="article-tags">
          {article.tags.map((tag: string) => (
            <a href={`/en/blog?tag=${encodeURIComponent(tag)}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </div>
  </article>

  <div class="article-nav container">
    <a href="/en/blog" class="retour">← Back to the blog</a>
  </div>

  <section class="section--sand article-cta">
    <div class="container" style="text-align:center">
      <h2>Want to experience this for real?</h2>
      <p>Contact Jean-Baptiste to book a guided day on his favourite rivers and coastlines.</p>
      <div style="display:flex;gap:1rem;justify-content:center;margin-top:1.5rem;flex-wrap:wrap">
        <a href="/contact" class="btn btn--ocean">Contact Jean-Baptiste</a>
        <a href="tel:+33687303456" class="btn btn--outline">+33 6 87 30 34 56</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .article-hero { position: relative; min-height: 55vh; display: flex; align-items: flex-end; padding-bottom: 3.5rem; color: white; }
  .article-hero-bg { position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,24,31,0.88) 0%, rgba(13,43,62,0.45) 100%), var(--color-ocean); }
  .article-hero-content { position: relative; z-index: 1; max-width: 820px; padding-top: var(--header-height); }
  .article-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .badge { background: var(--color-ocean-main); color: white; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.25rem 0.7rem; border-radius: 2px; font-weight: 500; }
  .article-meta time { font-size: 0.78rem; color: rgba(255,255,255,0.6); letter-spacing: 0.04em; }
  .article-hero h1 { color: white; margin-bottom: 1rem; }
  .article-extrait { font-size: 1.05rem; color: rgba(255,255,255,0.75); line-height: 1.65; max-width: 640px; }
  .article-body { max-width: 720px; }
  .article-body p { color: var(--color-text-muted); line-height: 1.85; margin-bottom: 1.4rem; font-size: 1.025rem; }
  .article-body h2 { margin: 2.5rem 0 1rem; color: var(--color-ocean); }
  .article-body h3 { margin: 2rem 0 0.75rem; color: var(--color-text); }
  .article-body blockquote { border-left: 3px solid var(--color-ocean-main); margin: 2rem 0; padding: 0.75rem 1.5rem; font-family: var(--font-serif); font-style: italic; font-size: 1.1rem; color: var(--color-ocean); background: var(--color-mist); border-radius: 0 3px 3px 0; }
  .article-image { margin: 2rem 0; }
  .article-image img { width: 100%; height: auto; border-radius: 3px; display: block; }
  .article-video { margin: 2rem 0; aspect-ratio: 16 / 9; border-radius: 3px; overflow: hidden; }
  .article-video iframe { width: 100%; height: 100%; border: none; display: block; }
  .article-body a { color: var(--color-ocean-main); text-decoration: underline; }
  .article-body a:hover { color: var(--color-ocean); }
  .article-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-mist); }
  .tag { display: inline-block; padding: 0.3rem 0.75rem; background: var(--color-mist); color: var(--color-ocean-main); font-size: 0.72rem; border-radius: 2px; letter-spacing: 0.06em; text-decoration: none; transition: background 0.15s; }
  .tag:hover { background: var(--color-ocean-main); color: white; }
  .article-nav { padding: 1.5rem 2rem; }
  .retour { font-size: 0.8rem; color: var(--color-ocean-main); font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; }
  .retour:hover { text-decoration: underline; }
  .article-cta { padding: 4rem 0; }
  .article-cta h2 { margin-bottom: 0.75rem; }
  .article-cta p { color: var(--color-text-muted); }
  .btn { display: inline-block; padding: 0.8rem 1.75rem; border-radius: 2px; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; transition: all 0.2s; }
  .btn--ocean { background: var(--color-ocean); color: white; }
  .btn--ocean:hover { background: var(--color-ocean-main); }
  .btn--outline { border: 1.5px solid var(--color-ocean-main); color: var(--color-ocean-main); }
  .btn--outline:hover { background: var(--color-ocean-main); color: white; }
</style>
