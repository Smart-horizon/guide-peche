---
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import PageBuilderSections from '../../components/PageBuilderSections.astro'
import { client, stegaClient } from '../../lib/sanity.js'
import { fullTitle } from '../../lib/seo.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(stegaClient)
const urlFor = (source: any) => {
  const b = builder.image(source)
  const hs = source?.hotspot
  return (hs?.x != null && hs?.y != null) ? b.focalPoint(hs.x, hs.y) : b
}

const hp = await stegaClient.fetch(`
  *[_type == "page" && slug.current == "/"][0]{
    _id, title, seoTitle, seoDescription, seoTitleEn, seoDescriptionEn,
    pagebuilder[]{
      ...,
      image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      photo{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      btnFichier{ asset->{ _id, url } },
      photos[]{ asset->{ _id, url } },
      images[]{ asset->{ _id, url } },
      cards[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      etapes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      items[]{..., photos[]{asset->{_id, url}, alt, caption}},
      featuredImage{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      cardsSecondaires[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      sousLiens[],
    },
    pagebuilderEn[]{
      ...,
      image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      photo{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      cards[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      etapes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      featuredImage{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      cardsSecondaires[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      sousLiens[],
    },
  }
`)

// ── SEO (EN first, fallback FR then hardcoded)
const heroSection = hp?.pagebuilder?.find((s: any) => s._type === 'sectionHero')
const pageTitle   = hp?.seoTitleEn || 'Jean-Baptiste Vidal — Fly Fishing Guide in Brittany, France'
const pageDesc    = hp?.seoDescriptionEn || hp?.seoDescription || 'Licensed fly fishing guide, 21 years of guiding. Guided fishing for sea bass, trout, shad and pike in South Brittany, France.'
const ogImg       = heroSection?.image
  ? urlFor(heroSection.image).width(1200).height(630).fit('crop').crop('focalpoint').url()
  : undefined

// ── Hero EN : always use FR sectionHero for visuals (video, image), override text in EN
const frHeroSection = hp?.pagebuilder?.find((s: any) => s._type === 'sectionHero')
const enHeroSection = frHeroSection ? {
  ...frHeroSection,
  eyebrow: 'Licensed Guide · South Brittany',
  titre: 'Fly Fishing in Brittany',
  sousTitre: 'Guided fishing for sea bass, trout, shad and pike. Courses and coaching from beginner to masterclass level.',
  btnReserverTexte: 'Book a session',
  btnReserverLien: '/contact',
  btnTelTexte: '06 87 30 34 56',
  // Badges EN depuis Sanity (badgesEn), sinon fallback hardcodé
  badges: frHeroSection.badgesEn?.length
    ? frHeroSection.badgesEn
    : [
        { _key: 'b1', texte: '21 years of guiding' },
        { _key: 'b2', texte: '🪶 Fly fishing only', style: 'mouche' },
      ],
} : null

// ── Other sections: use pagebuilderEn if filled, otherwise FR pagebuilder (skip sectionHero, handled above)
const hasEnContent = hp?.pagebuilderEn?.length > 0
const allSections  = (hasEnContent ? hp.pagebuilderEn : (hp?.pagebuilder ?? []))
  .filter((s: any) => s._type !== 'sectionHero')

// ── Testimonials
const allTemoStats = await client.fetch(`*[_type == "temoignage"] { note }`)
const temoCount    = allTemoStats.length
const temoAvgRaw   = temoCount > 0
  ? allTemoStats.reduce((sum: number, t: any) => sum + (t.note ?? 5), 0) / temoCount
  : 5
const temoAvgNote  = temoAvgRaw.toFixed(1)
const temoLabel    = temoCount > 0
  ? `${temoCount} review${temoCount > 1 ? 's' : ''}`
  : '26 reviews'

const temoHPSection = hp?.pagebuilder?.find((s: any) => s._type === 'sectionTemoignagesHP')
const temoEyebrow = 'What they say'
const temoPitch   = 'Anglers from across France and Europe have trusted Jean-Baptiste since 2004.'
const temoCtaTxt  = 'Read all reviews'
const temoCtaLien = '/en/temoignages-avis-jeanbaptiste-vidal'

const sanityTemoignages = await stegaClient.fetch(`
  *[_type == "temoignage" && afficherAccueil == true] | order(orderRank asc) [0...6] {
    _id, nom, note, texte, prestation
  }
`)
const fallbackTemoignages = [
  { _id: 'f1', nom: 'Diego', prestation: 'Salmon & Spey Cast stage', note: 5, texte: "I had to unlearn to relearn. 5 intensive days of salmon fly fishing in Brittany: the scenery is stunning and the rivers are brown and mysterious." },
  { _id: 'f2', nom: 'Marc', prestation: 'Sea bass sight fishing & boat', note: 5, texte: 'Jean-Baptiste knows the fish inside and out — their habits, the best spots. Great gear, great advice. Very pleasant and efficient. Hugely experienced guide.' },
  { _id: 'f3', nom: 'Fiona & Romain', prestation: 'Introduction to fly fishing', note: 5, texte: "It was a real pleasure learning with you. No stress, plenty of laughs, and above all an excellent teacher who doesn't just focus on casting mechanics but reveals the true art of fly fishing." },
  { _id: 'f4', nom: 'Vincent', prestation: 'Sight bass fishing & boat, South Brittany', note: 5, texte: "I recommend this to everyone — the adrenaline rush of watching enormous bass holding right in front of you is something you'll never forget. Jean-Baptiste knows every one of them." },
]
const temoignages = sanityTemoignages.length > 0 ? sanityTemoignages : fallbackTemoignages

// ── Gift voucher
const bonCadeauHP = hp?.pagebuilder?.find((s: any) => s._type === 'sectionBonCadeauHP')
const cadeauTitre  = 'Give an unforgettable experience'
const cadeauTexte  = "Give a loved one a day of fly fishing in Brittany. Introduction, advanced coaching, or guided fishing — the gift voucher is valid for all sessions, freshwater or sea bass."
const cadeauBtn1T  = 'Discover the gift voucher'
const cadeauBtn1L  = '/en/bon-cadeau'
const cadeauBtn2T  = 'Ask a question'
const cadeauBtn2L  = '/contact'

// ── Guide section (EN first, fallback FR)
const guideHP = hp?.pagebuilderEn?.find((s: any) => s._type === 'sectionGuideHP')
             || hp?.pagebuilder?.find((s: any) => s._type === 'sectionGuideHP')
const guidePhotoUrl  = guideHP?.photo?.asset
  ? urlFor(guideHP.photo).width(600).height(800).fit('crop').crop('focalpoint').url()
  : null
const guideEyebrow   = 'Your guide'
const guideNom       = stegaClean(guideHP?.nom) || 'Jean-Baptiste Vidal'
const guideAccroche  = '33 years of fly fishing and experience at your service, including 21 years of professional guiding in France and abroad.'
const guideBio       = 'After studies in environmental science and 5 years at the Finistère Fishing Federation, Jean-Baptiste guided 6 seasons on the Rio Grande (Argentina) for Nervous Waters, then in Ireland, Russia and Bolivia. Since 2014, he has offered his services as a licensed fly fishing guide in South Brittany, year-round.'
const guideBtnTxt    = 'Your guide'
const guideBtnLien   = '/en/jean-baptiste-vidal-moniteur-guide-de-peche'
const guideStats: { valeur: string; label: string }[] = (guideHP?.stats ?? []).length > 0
  ? guideHP.stats.map((s: any) => ({ valeur: stegaClean(s.valeur) || '', label: stegaClean(s.label) || '' }))
  : [
      { valeur: '33 years', label: 'of fly fishing' },
      { valeur: '21 years', label: 'of guiding' },
      { valeur: '8 years',  label: 'guiding abroad' },
      { valeur: 'Trips',    label: 'Fishing travel organisation' },
    ]

// ── Gear section (EN first, fallback FR)
const materielHP = hp?.pagebuilderEn?.find((s: any) => s._type === 'sectionMaterielHP')
                || hp?.pagebuilder?.find((s: any) => s._type === 'sectionMaterielHP')
const MATERIEL_CARDS_FALLBACK = [
  { eyebrow: 'Streamers · Nymphs · Dry flies', titre: 'My flies',  lien: '/en/mouches-de-peche-jeanbaptiste-vidal', imageUrl: '/images/A1.avif' },
  { eyebrow: 'Carolina Skiff · Flat-bottomed',  titre: 'The boat', lien: '/en/bateau-bar-a-la-mouche',            imageUrl: '/images/bateau-3.jpg' },
]
const materielSection = {
  eyebrow:         'Gear · Resources',
  titre:           'Tackle & universe',
  featuredEyebrow: 'Rods · Lines · Reels · Accessories',
  featuredTitre:   'My gear',
  featuredLien:    '/en/materiel-jeanbaptistevidal',
  featuredImage:   materielHP?.featuredImage?.asset
    ? urlFor(materielHP.featuredImage).width(900).height(700).fit('crop').crop('focalpoint').url()
    : '/images/materiel-hero.jpg',
  sousLiens: (materielHP?.sousLiens?.length > 0)
    ? materielHP.sousLiens.map((l: any) => ({ label: stegaClean(l.label) || '', href: '/en' + (stegaClean(l.href) || '#') }))
    : [
        { label: 'Migratory fly gear',  href: '/en/materiel-mouche-migrateur' },
        { label: 'Trout fly gear',      href: '/en/materiel-mouche-truite' },
        { label: 'Sea bass fly gear',   href: '/en/materiel-mouche-bar' },
        { label: 'Stillwater fly gear', href: '/en/materiel-mouche-reservoir' },
        { label: 'Pike fly gear',       href: '/en/materiel-mouche-brochet' },
        { label: 'Saltwater fly gear',  href: '/en/materiel-mouche-peche-exotique' },
      ],
  cardsSecondaires: (materielHP?.cardsSecondaires?.length > 0)
    ? materielHP.cardsSecondaires.map((c: any, i: number) => ({
        eyebrow:  stegaClean(c.eyebrow) || MATERIEL_CARDS_FALLBACK[i]?.eyebrow || '',
        titre:    stegaClean(c.titre)   || MATERIEL_CARDS_FALLBACK[i]?.titre   || '',
        lien:     '/en' + (stegaClean(c.lien) || MATERIEL_CARDS_FALLBACK[i]?.lien || '#'),
        imageUrl: c.image?.asset
          ? urlFor(c.image).width(600).height(500).fit('crop').crop('focalpoint').url()
          : MATERIEL_CARDS_FALLBACK[i]?.imageUrl || null,
      }))
    : MATERIEL_CARDS_FALLBACK,
}
---

<BaseLayout
  title={fullTitle(pageTitle)}
  description={pageDesc}
  image={ogImg}
  lang="en"
  hreflangFr="/"
  hreflangEn="/en/"
>

  {/* ── Hero EN : same video/visuals as FR, with EN text */}
  {enHeroSection
    ? <PageBuilderSections sections={[enHeroSection]} pageTitle={pageTitle} lang="en" />
    : (
      <section class="hp-hero-fallback">
        <div class="hp-hero-fallback__bg"></div>
        <div class="hp-hero-fallback__overlay"></div>
        <div class="hp-hero-fallback__content container">
          <div class="hp-hero-fallback__badges">
            <span class="hp-hero-fallback__badge">21 years of guiding</span>
            <span class="hp-hero-fallback__badge hp-hero-fallback__badge--mouche">🪶 Fly fishing only</span>
          </div>
          <p class="hp-hero-fallback__eyebrow">Licensed Guide · South Brittany, France</p>
          <h1 class="hp-hero-fallback__h1">Fly fishing<br/><em>in Brittany</em></h1>
          <p class="hp-hero-fallback__sub">Guided fishing for sea bass, trout, shad and pike. Courses and coaching from beginner to masterclass level.</p>
          <div class="hp-hero-fallback__cta">
            <a href="/en/contact" class="btn-prim">Book a session</a>
            <a href="tel:0033687303456" class="btn-ghost-hero">+33 6 87 30 34 56</a>
          </div>
        </div>
      </section>
    )
  }

  {/* ── Sections in Sanity order */}
  {allSections.map((s: any) => {

    if (s._type === 'sectionGuideHP') return (
      <section class="section section--sand guide-section">
        <div class="container guide-inner">
          <div class="guide-photo" style={guidePhotoUrl ? `background-image: url('${guidePhotoUrl}')` : undefined}></div>
          <div class="guide-text">
            <p class="eyebrow">{guideEyebrow}</p>
            <h2>{guideNom}</h2>
            <p class="guide-accroche">{guideAccroche}</p>
            <p>{guideBio}</p>
            <ul class="guide-stats">
              {guideStats.map((st) => (
                <li><strong>{st.valeur}</strong> {st.label}</li>
              ))}
            </ul>
            <a href={guideBtnLien} class="btn btn--ocean">{guideBtnTxt}</a>
          </div>
        </div>
      </section>
    )

    if (s._type === 'sectionMaterielHP') return (
      <section class="section hp-materiel">
        <div class="container hp-materiel__header">
          <p class="eyebrow">{materielSection.eyebrow}</p>
          <h2>{materielSection.titre}</h2>
        </div>
        <div class="hp-materiel__grid">
          <div class="hp-mat-card hp-mat-card--featured">
            <div class="hp-mat-card__bg" style={`background-image: url('${materielSection.featuredImage}')`}></div>
            <div class="hp-mat-card__body hp-mat-card__body--featured">
              <div class="hp-mat-card__left">
                <p class="hp-mat-card__eyebrow">{materielSection.featuredEyebrow}</p>
                <h3>{materielSection.featuredTitre}</h3>
                <a href={materielSection.featuredLien} class="hp-mat-card__all">See all →</a>
              </div>
              <nav class="hp-mat-subnav" aria-label="Gear sub-pages">
                {materielSection.sousLiens.map((l: any) => (
                  <a href={l.href} class="hp-mat-subnav__link">{l.label}</a>
                ))}
              </nav>
            </div>
          </div>
          {materielSection.cardsSecondaires.map((c: any) => (
            <a href={c.lien} class="hp-mat-card">
              <div class="hp-mat-card__bg" style={`background-image: url('${c.imageUrl}')`}></div>
              <div class="hp-mat-card__body">
                <p class="hp-mat-card__eyebrow">{c.eyebrow}</p>
                <h3>{c.titre}</h3>
                <span class="hp-mat-card__arrow">Discover →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )

    if (s._type === 'sectionBonCadeauHP') return (
      <section class="hp-cadeau">
        <div class="hp-cadeau__bg"></div>
        <div class="hp-cadeau__overlay"></div>
        <div class="container hp-cadeau__inner">
          <div class="hp-cadeau__content">
            <p class="hp-cadeau__eyebrow">🎁 Gift idea</p>
            <h2 class="hp-cadeau__titre">{cadeauTitre}</h2>
            <p class="hp-cadeau__texte">{cadeauTexte}</p>
            <div class="hp-cadeau__actions">
              <a href={cadeauBtn1L} class="hp-cadeau__btn hp-cadeau__btn--prim">{cadeauBtn1T}</a>
              <a href={cadeauBtn2L} class="hp-cadeau__btn hp-cadeau__btn--ghost">{cadeauBtn2T}</a>
            </div>
          </div>
          <div class="hp-cadeau__aside">
            <div class="hp-cadeau__card">
              <p class="hp-cadeau__card-label">Format</p>
              <p class="hp-cadeau__card-val">Full day · Half day</p>
              <p class="hp-cadeau__card-label">Valid for</p>
              <p class="hp-cadeau__card-val">All sessions · Freshwater &amp; Sea bass</p>
              <p class="hp-cadeau__card-label">Validity</p>
              <p class="hp-cadeau__card-val">1 year from date of purchase</p>
              <p class="hp-cadeau__card-label">Delivery</p>
              <p class="hp-cadeau__card-val">By e-mail or post · Personalised</p>
              <a href={cadeauBtn1L} class="hp-cadeau__card-cta">Order →</a>
            </div>
          </div>
        </div>
      </section>
    )

    if (s._type === 'sectionTemoignagesHP') return (
      <section class="hp-temo">
        <div class="container hp-temo__inner">
          <div class="hp-temo__left">
            <p class="hp-temo__eyebrow">{temoEyebrow}</p>
            <div class="hp-temo__mark">&ldquo;</div>
            <div class="hp-temo__rotator" id="temoRotator">
              {temoignages.map((t: any, i: number) => (
                <figure class={`hp-temo__quote${i === 0 ? ' hp-temo__quote--active' : ''}`}>
                  <blockquote>{t.texte}</blockquote>
                  <figcaption>
                    <strong class="hp-temo__name">{t.nom}</strong>
                    <span class="hp-temo__cat">{t.prestation}</span>
                    <span class="hp-temo__stars">{'★'.repeat(t.note ?? 5)}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
            <div class="hp-temo__dots" id="temoDots">
              {temoignages.map((_: any, i: number) => (
                <button
                  class={`hp-temo__dot${i === 0 ? ' hp-temo__dot--active' : ''}`}
                  aria-label={`Review ${i + 1}`}
                ></button>
              ))}
            </div>
          </div>
          <div class="hp-temo__right">
            <div class="hp-temo__score">
              <div class="hp-temo__score-num">{temoAvgNote}</div>
              <div class="hp-temo__score-stars">★★★★★</div>
              <div class="hp-temo__score-label">{temoLabel}</div>
            </div>
            <div class="hp-temo__divider"></div>
            <p class="hp-temo__pitch">{temoPitch}</p>
            <a href={temoCtaLien} class="hp-temo__cta">{temoCtaTxt}</a>
          </div>
        </div>
      </section>
    )

    return <PageBuilderSections sections={[s]} pageTitle={pageTitle} lang="en" />
  })}

</BaseLayout>

<style>
  .hp-hero-fallback {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 6rem;
    overflow: hidden;
  }
  .hp-hero-fallback__bg {
    position: absolute; inset: 0;
    background: url('/images/hero.jpg') center / cover no-repeat;
  }
  .hp-hero-fallback__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(7,24,31,0.92) 0%, rgba(13,43,62,0.55) 55%, rgba(13,43,62,0.3) 100%);
  }
  .hp-hero-fallback__content {
    position: relative; z-index: 1;
    max-width: 780px;
  }
  .hp-hero-fallback__badges {
    display: flex; gap: 0.75rem; flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .hp-hero-fallback__badge {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 2px;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    background: rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.85);
    border: 1px solid rgba(255,255,255,0.2);
  }
  .hp-hero-fallback__badge--mouche {
    background: rgba(126,200,227,0.15);
    border-color: rgba(126,200,227,0.35);
    color: var(--color-ocean-light);
  }
  .hp-hero-fallback__eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  .hp-hero-fallback__h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 1.1;
    color: white;
    margin-bottom: 1.5rem;
  }
  .hp-hero-fallback__h1 em { font-style: italic; color: var(--color-ocean-light); }
  .hp-hero-fallback__sub {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.65;
    max-width: 540px;
    margin-bottom: 2.5rem;
  }
  .hp-hero-fallback__cta {
    display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;
  }
  .btn-prim {
    display: inline-block;
    padding: 0.9rem 2rem;
    background: var(--color-ocean-light);
    color: #07181f;
    font-weight: 600;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .btn-prim:hover { background: white; transform: translateY(-2px); }
  .btn-ghost-hero {
    display: inline-block;
    padding: 0.9rem 1.8rem;
    border: 1.5px solid rgba(255,255,255,0.35);
    color: white;
    font-size: 0.88rem;
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-ghost-hero:hover { border-color: white; background: rgba(255,255,255,0.08); }

  .section--sand { background: var(--color-sand); }
  .guide-section { overflow: hidden; }
  .guide-inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 5rem;
    align-items: center;
  }
  .guide-photo {
    aspect-ratio: 3/4;
    background-color: var(--color-ocean-main);
    background-image: url('/images/votre-guide.avif');
    background-size: cover;
    background-position: center;
    border-radius: 3px;
  }
  .guide-accroche {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-ocean-main);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .guide-text p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .guide-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    list-style: none;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: white;
    border-radius: 3px;
    border-left: 3px solid var(--color-ocean-main);
  }
  .guide-stats li { font-size: 0.85rem; color: var(--color-text-muted); }
  .guide-stats strong {
    display: block;
    font-size: 1.5rem;
    font-family: var(--font-serif);
    color: var(--color-ocean);
    line-height: 1;
    margin-bottom: 0.2rem;
  }
  @media (max-width: 1024px) {
    .guide-inner { grid-template-columns: 1fr; gap: 2rem; }
    .guide-photo { aspect-ratio: 16/9; max-height: 320px; }
  }

  .hp-cadeau {
    position: relative;
    overflow: hidden;
    min-height: 520px;
    display: flex;
    align-items: center;
  }
  .hp-cadeau__bg {
    position: absolute; inset: 0;
    background: url('/images/prestation-cadeau.jpg') center / cover no-repeat;
  }
  .hp-cadeau__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(105deg, rgba(7,24,31,0.93) 0%, rgba(13,43,62,0.82) 50%, rgba(13,43,62,0.55) 100%);
  }
  .hp-cadeau__inner {
    position: relative; z-index: 1;
    display: grid;
