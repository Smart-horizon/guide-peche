---
import BaseLayout from '../layouts/BaseLayout.astro'
import { client, stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(stegaClient)
const urlFor = (source) => builder.image(source)

// ── Contenu de la page d'accueil (éditable depuis Sanity Studio)
const hp = await stegaClient.fetch(`*[_type == "accueil" && _id == "accueil"][0]`)

// ── Section Hero
const hero = {
  badge:        hp?.hero?.badge        ?? '21 ans de guidage',
  eyebrow:      hp?.hero?.eyebrow      ?? "Moniteur-Guide diplômé d'État · Bretagne-Sud",
  titre:        hp?.hero?.titre        ?? 'Pêche à la mouche',
  titreItalic:  hp?.hero?.titreItalic  ?? 'en Bretagne sauvage',
  texte:        hp?.hero?.texte        ?? "La pêche est possible toute l'année en eau douce ou en mer du fait de la complémentarité des milieux. Lacs, réservoirs, rivières, estuaires et côte : une multitude de possibilités en Bretagne-Sud.",
  imageUrl:     hp?.hero?.image        ? urlFor(hp.hero.image).width(1920).height(1080).url() : '/images/hero.jpg',
  btn1Texte:    hp?.hero?.bouton1Texte ?? 'Pêche du bar',
  btn1Lien:     hp?.hero?.bouton1Lien  ?? '/peche-du-bar-a-la-mouche',
  btn2Texte:    hp?.hero?.bouton2Texte ?? 'Réserver une sortie',
  btn2Lien:     hp?.hero?.bouton2Lien  ?? '/contact',
}

// ── Section Le Guide
const guide = {
  photoUrl:    hp?.guide?.photo ? urlFor(hp.guide.photo).width(600).height(800).url() : null,
  eyebrow:     hp?.guide?.eyebrow     ?? 'Votre guide',
  nom:         hp?.guide?.nom         ?? 'Jean-Baptiste Vidal',
  accroche:    hp?.guide?.accroche    ?? "33 ans de pêche à la mouche et d'expérience à votre service, dont 21 années de guidage en France et à l'étranger.",
  bio:         hp?.guide?.bio         ?? "Après des études dans l'environnement et 5 ans à la Fédération de Pêche du Finistère, Jean-Baptiste a guidé 6 saisons sur le Rio Grande (Argentine) pour Nervous Waters, puis en Irlande, Russie et Bolivie. Depuis 2014, il propose ses services de Moniteur-Guide en Bretagne-Sud, tout au long de l'année.",
  stats:       hp?.guide?.stats       ?? [
    { nombre: '33 ans',    label: 'de pêche à la mouche' },
    { nombre: '21 ans',    label: 'de guidage' },
    { nombre: '8 ans', label: "de guidage à l'étranger" },
    { nombre: 'Voyages', label: 'Organisation de voyages' },
  ],
  boutonTexte: hp?.guide?.boutonTexte ?? 'Votre guide',
  boutonLien:  hp?.guide?.boutonLien  ?? '/jean-baptiste-vidal-moniteur-guide-de-peche',
}

// ── Section Bar promo
const bar = {
  eyebrow:  hp?.bar?.eyebrow     ?? 'Page star du site',
  titre:    hp?.bar?.titre       ?? 'Pêche du bar à la mouche',
  texte:    hp?.bar?.texte       ?? 'Bar à vue dans les estuaires bretons ou streamer en bateau sur le Carolina Skiff. Poissons trophées de 2 à 5 kg+ dans des cadres sauvages et préservés.',
  imageUrl: hp?.bar?.image       ? urlFor(hp.bar.image).width(800).height(600).url() : '/images/bar-promo.jpg',
  btnTexte: hp?.bar?.boutonTexte ?? 'Découvrir les formules',
  btnLien:  hp?.bar?.boutonLien  ?? '/peche-du-bar-a-la-mouche',
}

// ── Section Matériel
const materielSection = {
  eyebrow:         hp?.materiel?.eyebrow         ?? 'Équipement · Ressources',
  titre:           hp?.materiel?.titre           ?? 'Matériel & univers',
  featuredImage:   hp?.materiel?.featuredImage   ? urlFor(hp.materiel.featuredImage).width(1400).height(500).url() : '/images/materiel-hero.jpg',
  featuredEyebrow: hp?.materiel?.featuredEyebrow ?? 'Cannes · Soies · Moulinets · Accessoires',
  featuredTitre:   hp?.materiel?.featuredTitre   ?? 'Mon matériel',
  featuredLien:    hp?.materiel?.featuredLien    ?? '/materiel-jeanbaptistevidal',
  sousLiens:       hp?.materiel?.sousLiens       ?? [
    { label: 'Matériel migrateurs', href: '/materiel-mouche-migrateur' },
    { label: 'Matériel truite',     href: '/materiel-mouche-truite' },
    { label: 'Matériel bar',        href: '/materiel-mouche-bar' },
    { label: 'Matériel réservoir',  href: '/materiel-mouche-reservoir' },
    { label: 'Matériel brochet',    href: '/materiel-mouche-brochet' },
    { label: 'Matériel exotique',   href: '/materiel-mouche-peche-exotique' },
  ],
  cardsSecondaires: (hp?.materiel?.cardsSecondaires ?? [
    { eyebrow: 'Streamers · Nymphes · Sèches', titre: 'Mes mouches', lien: '/mouches-de-peche-jeanbaptiste-vidal', image: null },
    { eyebrow: 'Carolina Skiff · Fond plat',   titre: 'Le bateau',   lien: '/bateau-bar-a-la-mouche',            image: null },
  ]).map((c: any) => ({
    ...c,
    imageUrl: c.image ? urlFor(c.image).width(700).height(530).url() : (c.titre === 'Le bateau' ? '/images/bateau-3.jpg' : '/images/A1.avif'),
  })),
}

// ── Section Témoignages (meta)
const temoSection = {
  eyebrow:  hp?.temo?.eyebrow  ?? "Ce qu'ils disent",
  score:    hp?.temo?.score    ?? '5.0',
  nombre:   hp?.temo?.nombre   ?? '26 témoignages',
  pitch:    hp?.temo?.pitch    ?? 'Des pêcheurs de toute la France font confiance à Jean-Baptiste depuis 2004.',
  ctaTexte: hp?.temo?.ctaTexte ?? 'Lire tous les témoignages',
  ctaLien:  hp?.temo?.ctaLien  ?? '/temoignages',
}

// ── Section CTA
const cta = {
  titre:     hp?.cta?.titre     ?? 'Prêt pour votre première sortie ?',
  texte:     hp?.cta?.texte     ?? 'Contactez Jean-Baptiste pour construire votre programme selon votre niveau, vos espèces cibles et vos disponibilités.',
  telephone: hp?.cta?.telephone ?? '06 87 30 34 56',
  email:     hp?.cta?.email     ?? 'enjoy.fishing@hotmail.fr',
  btn1Texte: hp?.cta?.btn1Texte ?? 'Me contacter',
  btn1Lien:  hp?.cta?.btn1Lien  ?? '/contact',
  btn2Texte: hp?.cta?.btn2Texte ?? 'Voir les disponibilités 2026',
  btn2Lien:  hp?.cta?.btn2Lien  ?? '/disponibilites-guidages',
}

// ── Sections personnalisées (documents sectionAccueil — même niveau que les autres)
const sectionsCustomRaw = await client.fetch(`
  *[_type == "sectionAccueil"] | order(position asc) {
    _id, sectionType, position, visible,
    eyebrow, titre, texte, image, disposition,
    boutonTexte, boutonLien, fond,
    cartes[] { label, sub, href, image }
  }
`)
const sectionsCustom = sectionsCustomRaw.map((section: any) => ({
  ...section,
  imageUrl: section.image ? urlFor(section.image).width(900).height(600).url() : null,
  cartes: section.cartes?.map((c: any) => ({
    ...c,
    imageUrl: c.image ? urlFor(c.image).width(600).height(400).url() : null,
  })),
  _cssOrder: section.position ?? 99,
  _visible:  section.visible !== false,
}))

// ── Ordre & visibilité des sections principales
const sectionData: Record<string, { position: number; visible: boolean }> = {
  prestations: { position: hp?.prestations?.position ?? 1, visible: hp?.prestations?.visible !== false },
  guide:       { position: hp?.guide?.position       ?? 2, visible: hp?.guide?.visible       !== false },
  bar:         { position: hp?.bar?.position         ?? 3, visible: hp?.bar?.visible         !== false },
  materiel:    { position: hp?.materiel?.position    ?? 5, visible: hp?.materiel?.visible    !== false },
  temo:        { position: hp?.temo?.position        ?? 7, visible: hp?.temo?.visible        !== false },
}

// Renvoie `order: N` (+ `display: none` si masquée)
const sStyle = (id: string): string | undefined => {
  const cfg = sectionData[id]
  if (!cfg) return undefined
  return `order: ${cfg.position}${cfg.visible ? '' : '; display: none'}`
}

// Style pour une section personnalisée individuelle
const slStyle = (section: any): string =>
  `order: ${section._cssOrder}${section._visible ? '' : '; display: none'}`

// ── Prestations (client régulier — categorie utilisé pour comparaison, pas rendu avec stega)
const prestations = await client.fetch(`
  *[_type == "prestation"] | order(_createdAt asc) {
    title, slug, categorie, tarif, duree, image,
    "description": description[0].children[0].text
  }
`)

// ── Témoignages (stegaClient — textes affichés directement)
// Seuls ceux cochés "Afficher sur l'accueil" dans Sanity Studio apparaissent ici.
// S'il n'y en a aucun de coché, on affiche les 6 premiers par orderRank (fallback).
const sanityTemoignages = await stegaClient.fetch(`
  *[_type == "temoignage" && afficherAccueil == true] | order(orderRank asc) [0...6] {
    _id, nom, note, texte, prestation
  }
`)
const temoignagesFallbackQuery = await stegaClient.fetch(`
  *[_type == "temoignage"] | order(orderRank asc) [0...6] {
    _id, nom, note, texte, prestation
  }
`)

// Témoignages de fallback si Sanity est vide
const fallbackTemoignages = [
  { _id: 'f1', nom: 'Diego', prestation: 'Stage saumon & Spey Cast', note: 5, texte: "Il m'a fallu désapprendre pour réapprendre. 5 jours de stage intensif au saumon à la mouche en Bretagne : le site est proprement magnifique et les rivières sont brunes et mystérieuses." },
  { _id: 'f2', nom: 'Marc', prestation: 'Découverte bar à vue & bateau', note: 5, texte: 'Jean-Baptiste connaît le poisson par cœur, ses habitudes, les sites qui vont bien. Super matos, super conseils. Très agréable et efficace. Grande expérience du guidage.' },
  { _id: 'f3', nom: 'Fiona et Romain', prestation: 'Découverte de la pêche à la mouche', note: 5, texte: "Ce fut un vrai plaisir d'apprendre avec toi. Pas de stress, de la rigolade et surtout un excellent prof qui ne se contente pas de l'apprentissage brut du lancer mais fait découvrir l'art qu'est véritablement la pêche à la mouche." },
  { _id: 'f4', nom: 'Vincent', prestation: 'Bar à vue & bateau, Bretagne-Sud', note: 5, texte: "Je conseille à tout le monde d'essayer de prendre ces gros bars que Jean-Baptiste connaît par cœur — ressentir ces montées d'adrénaline à la vue de bars énormes postés devant vous." },
]
const temoignages = sanityTemoignages.length > 0
  ? sanityTemoignages
  : (temoignagesFallbackQuery.length > 0 ? temoignagesFallbackQuery : fallbackTemoignages)

// ── Section prestations : cartes avec images Sanity
// La carte stocke directement son slug de categorie → plus de lookup par label
const imgFallback = {
  'eau-douce':  '/images/prestation-eaudouce.jpg',
  'bar':        '/images/prestation-bar.jpg',
  'masterclass':'/images/prestation-masterclass.jpg',
  'spey-cast':  '/images/prestation-speycast.jpg',
  'bon-cadeau': '/images/prestation-cadeau.jpg',
}
const rawCards = hp?.prestations?.cards ?? [
  { label: 'Eau douce',          sub: 'Truite · Alose · Brochet',         href: '/peche-a-la-mouche-en-bretagne',      categorie: 'eau-douce'   },
  { label: 'Pêche du bar',       sub: 'Pêche à vue · Bateau',             href: '/peche-du-bar-a-la-mouche',           categorie: 'bar'         },
  { label: 'Masterclass',        sub: 'Réservoir · Nymphe au fil',        href: '/masterclass',                        categorie: 'masterclass'  },
  { label: 'Spey Cast & Lancer', sub: 'Canne une main · Switch · Spey',   href: '/stage-spey-cast-et-cours-de-lancer', categorie: 'spey-cast'   },
  { label: 'Bon cadeau',         sub: 'Offrir une sortie',                href: '/bon-cadeau-peche-mouche',            categorie: 'bon-cadeau'  },
]
const prestationsSection = {
  eyebrow: hp?.prestations?.eyebrow ?? 'Ce que je propose',
  titre:   hp?.prestations?.titre   ?? 'Stages & guidages',
  cards: rawCards.map((card, i) => {
    // stegaClean retire les chars Unicode invisibles que stega encode dans les chaînes
    // categorie est un slug ('eau-douce', 'bar'…) — le client régulier renvoie déjà une valeur propre
    const slug = stegaClean(card.categorie ?? '')
    const sanityImg = prestations.find(p => p.categorie === slug)?.image
    const img = sanityImg
      ? urlFor(sanityImg).width(i === 0 ? 900 : 600).height(i === 0 ? 600 : 400).url()
      : (imgFallback[slug] ?? '/images/hero.jpg')
    return { ...card, img, isLarge: i === 0 }
  }),
}
---

<BaseLayout
  title="Jean-Baptiste Vidal — Guide de pêche à la mouche en Bretagne"
  description="Moniteur-Guide diplômé, 21 ans de guidage. Stages de pêche à la mouche, guidage bar, truite, alose et brochet en Bretagne-Sud."
>

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-bg" style={`background-image: linear-gradient(to top, rgba(7,24,31,0.9) 0%, rgba(13,43,62,0.55) 50%, rgba(13,43,62,0.4) 100%), url('${hero.imageUrl}')`}></div>
    <div class="hero-content">
      <div class="hero-badges">
        <div class="hero-badge">{hero.badge}</div>
        <div class="hero-badge hero-badge--mouche">🪶 Exclusivement Mouche</div>
      </div>
      <p class="hero-eyebrow">{hero.eyebrow}</p>
      <h1>{hero.titre}<br /><em>{hero.titreItalic}</em></h1>
      <p class="hero-sub">{hero.texte}</p>
      <div class="hero-cta">
        
        <a href={hero.btn2Lien} class="btn btn--ghost">{hero.btn2Texte}</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true"><span></span></div>
  </section>

  <!-- ═══ SECTIONS DYNAMIQUES (ordre & visibilité gérés depuis Sanity) ═══ -->
  <div class="sections-dynamic">

  <!-- ═══ PRESTATIONS ═══ -->
  <section class="prestations-section" style={sStyle('prestations')}>
    <div class="prestations-header container">
      <p class="eyebrow">{prestationsSection.eyebrow}</p>
      <h2>{prestationsSection.titre}</h2>
    </div>

    <div class="wildfly-grid">
      {prestationsSection.cards.map((card: any) => (
        <a href={card.href} class={`wf-card ${card.isLarge ? 'wf-card--large' : ''}`}>
          <div class="wf-card-bg" style={`background-image: url(${card.img})`}></div>
          <div class="wf-overlay"></div>
          <div class="wf-body">
            <span class="wf-sub">{card.sub}</span>
            <strong class="wf-label">{card.label}</strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ LE GUIDE ═══ -->
  <section class="section section--sand guide-section" style={sStyle('guide')}>
    <div class="container guide-inner">
      <div class="guide-photo" style={guide.photoUrl ? `background-image: url('${guide.photoUrl}')` : undefined}></div>
      <div class="guide-text">
        <p class="eyebrow">{guide.eyebrow}</p>
        <h2>{guide.nom}</h2>
        <p class="guide-accroche">{guide.accroche}</p>
        <p>{guide.bio}</p>
        <ul class="guide-stats">
          {guide.stats.map((s: any) => (
            <li><strong>{s.nombre}</strong> {s.label}</li>
          ))}
        </ul>
        <a href={guide.boutonLien} class="btn btn--ocean">{guide.boutonTexte}</a>
      </div>
    </div>
  </section>

  <!-- ═══ BAR PROMO ═══ -->
  <section class="section--dark bar-promo" style={sStyle('bar')}>
    <div class="container bar-promo-inner">
      <div class="bar-promo-text">
        <p class="eyebrow eyebrow--light">{bar.eyebrow}</p>
        <h2>{bar.titre}</h2>
        <p>{bar.texte}</p>
        <a href={bar.btnLien} class="btn btn--primary">{bar.btnTexte}</a>
      </div>
      <div class="bar-promo-img" style={`background-image: url('${bar.imageUrl}')`}></div>
    </div>
  </section>

  <!-- ═══ SECTIONS PERSONNALISÉES (documents sectionAccueil, positionnées librement) ═══ -->
  {sectionsCustom.map((section: any) => (
    <Fragment>

      {/* ── Texte + image ── */}
      {section.sectionType === 'texteImage' && (
        <section
          class={`section section--sand sl-texte-image${section.disposition === 'image-gauche' ? ' sl-texte-image--gauche' : ''}`}
          style={slStyle(section)}
        >
          <div class="container sl-ti-inner">
            <div class="sl-ti-text">
              {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
              <h2>{section.titre}</h2>
              {section.texte && <p class="sl-ti-body">{section.texte}</p>}
              {section.boutonTexte && section.boutonLien && (
                <a href={section.boutonLien} class="btn btn--ocean">{section.boutonTexte}</a>
              )}
            </div>
            <div
              class="sl-ti-img"
              style={section.imageUrl ? `background-image: url('${section.imageUrl}')` : undefined}
            ></div>
          </div>
        </section>
      )}

      {/* ── Mise en avant (fond sombre) ── */}
      {section.sectionType === 'promo' && (
        <section class="section--dark sl-promo" style={slStyle(section)}>
          <div class="container sl-promo-inner">
            <div class="sl-promo-text">
              {section.eyebrow && <p class="eyebrow eyebrow--light">{section.eyebrow}</p>}
              <h2>{section.titre}</h2>
              {section.texte && <p>{section.texte}</p>}
              {section.boutonTexte && section.boutonLien && (
                <a href={section.boutonLien} class="btn btn--primary">{section.boutonTexte}</a>
              )}
            </div>
            {section.imageUrl && (
              <div class="sl-promo-img" style={`background-image: url('${section.imageUrl}')`}></div>
            )}
          </div>
        </section>
      )}

      {/* ── Galerie de cartes ── */}
      {section.sectionType === 'cartes' && (
        <section class="section sl-cartes" style={slStyle(section)}>
          <div class="container sl-cartes-header">
            {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
            <h2>{section.titre}</h2>
          </div>
          <div class="sl-cartes-grid">
            {(section.cartes ?? []).map((carte: any) => (
              <a href={carte.href ?? '#'} class="sl-carte">
                <div
                  class="sl-carte-bg"
                  style={`background-image: url('${carte.imageUrl ?? '/images/hero.jpg'}')`}
                ></div>
                <div class="sl-carte-overlay"></div>
                <div class="sl-carte-body">
                  {carte.sub && <span class="wf-sub">{carte.sub}</span>}
                  <strong class="wf-label">{carte.label}</strong>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* ── Bannière (texte centré) ── */}
      {section.sectionType === 'banniere' && (
        <section class={`section sl-banniere sl-banniere--${section.fond ?? 'sable'}`} style={slStyle(section)}>
          <div class="container sl-banniere-inner">
            {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
            <h2>{section.titre}</h2>
            {section.texte && <p class="sl-banniere-body">{section.texte}</p>}
            {section.boutonTexte && section.boutonLien && (
              <a href={section.boutonLien} class="btn btn--ocean">{section.boutonTexte}</a>
            )}
          </div>
        </section>
      )}

    </Fragment>
  ))}

  <!-- ═══ MATÉRIEL & UNIVERS ═══ -->
  <section class="section hp-materiel" style={sStyle('materiel')}>
    <div class="container hp-materiel__header">
      <p class="eyebrow">{materielSection.eyebrow}</p>
      <h2>{materielSection.titre}</h2>
    </div>
    <div class="hp-materiel__grid">

      <!-- Carte featured : Mon matériel + sous-liens -->
      <div class="hp-mat-card hp-mat-card--featured">
        <div class="hp-mat-card__bg" style={`background-image: url('${materielSection.featuredImage}')`}></div>
        <div class="hp-mat-card__body hp-mat-card__body--featured">
          <div class="hp-mat-card__left">
            <p class="hp-mat-card__eyebrow">{materielSection.featuredEyebrow}</p>
            <h3>{materielSection.featuredTitre}</h3>
            <a href={materielSection.featuredLien} class="hp-mat-card__all">Voir tout →</a>
          </div>
          <nav class="hp-mat-subnav" aria-label="Sous-pages matériel">
            {materielSection.sousLiens.map((l: any) => (
              <a href={l.href} class="hp-mat-subnav__link">{l.label}</a>
            ))}
          </nav>
        </div>
      </div>

      {materielSection.cardsSecondaires.map((c: any) => (
        <a href={c.lien} class="hp-mat-card">
          <div class="hp-mat-card__bg" style={`background-image: url('${c.imageUrl}')`}></div>
          <div class="hp-mat-card__body">
            <p class="hp-mat-card__eyebrow">{c.eyebrow}</p>
            <h3>{c.titre}</h3>
            <span class="hp-mat-card__arrow">Découvrir →</span>
          </div>
        </a>
      ))}

    </div>
  </section>

  <!-- ═══ BON CADEAU ═══ -->
  <section class="hp-cadeau" style="order: 6">
    <div class="hp-cadeau__bg"></div>
    <div class="hp-cadeau__overlay"></div>
    <div class="container hp-cadeau__inner">
      <div class="hp-cadeau__content">
        <p class="hp-cadeau__eyebrow">🎁 Idée cadeau</p>
        <h2 class="hp-cadeau__titre">Offrez une expérience<br/><em>inoubliable</em></h2>
        <p class="hp-cadeau__texte">Offrez à un proche une journée de pêche à la mouche en Bretagne. Initiation, perfectionnement ou sortie guidée — le bon cadeau est valable sur toutes les prestations, eau douce ou bar en mer.</p>
        <div class="hp-cadeau__actions">
          <a href="/bon-cadeau-peche-mouche" class="hp-cadeau__btn hp-cadeau__btn--prim">Découvrir le bon cadeau</a>
          <a href="/contact" class="hp-cadeau__btn hp-cadeau__btn--ghost">Demander un renseignement</a>
        </div>
      </div>
      <div class="hp-cadeau__aside">
        <div class="hp-cadeau__card">
          <p class="hp-cadeau__card-label">Format</p>
          <p class="hp-cadeau__card-val">Journée · Demi-journée</p>
          <p class="hp-cadeau__card-label">Valable sur</p>
          <p class="hp-cadeau__card-val">Toutes les prestations · Eau douce &amp; Bar</p>
          <p class="hp-cadeau__card-label">Validité</p>
          <p class="hp-cadeau__card-val">1 an à compter de la date d'achat</p>
          <p class="hp-cadeau__card-label">Envoi</p>
