---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageBuilderSections from '../components/PageBuilderSections.astro'
import NewsletterSection from '../components/NewsletterSection.astro'
import NewsletterPopup from '../components/NewsletterPopup.astro'
import { client, stegaClient } from '../lib/sanity.js'
import { fullTitle } from '../lib/seo.js'
import { hotspotPosition } from '../lib/image.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(stegaClient)
const urlFor = (source: any) => {
  const b = builder.image(source)
  const hs = source?.hotspot
  return (hs?.x != null && hs?.y != null) ? b.focalPoint(hs.x, hs.y) : b
}

// ── Page d'accueil depuis Sanity (document "page" avec slug "/") ──────────────
const hp = await stegaClient.fetch(`
  *[_type == "page" && slug.current == "/"][0]{
    _id, title, seoTitle, seoDescription,
    pagebuilder[]{
      ...,
      image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      photo{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      btnFichier{ asset->{ _id, url } },
      photos[]{ asset->{ _id, url } },
      images[]{ asset->{ _id, url } },
      cards[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      etapes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      items[]{..., photos[]{asset->{_id, url}, alt, caption}},
      featuredImage{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      cardsSecondaires[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      sousLiens[],
    }
  }
`)

// ── SEO ───────────────────────────────────────────────────────────────────────
const heroSection = hp?.pagebuilder?.find((s: any) => s._type === 'sectionHero')
const pageTitle   = hp?.seoTitle || heroSection?.titre || hp?.title || 'Jean-Baptiste Vidal — Guide de pêche à la mouche en Bretagne'
const pageDesc    = hp?.seoDescription || 'Moniteur-Guide diplômé, 21 ans de guidage. Stages de pêche à la mouche, guidage bar, truite, alose et brochet en Bretagne-Sud.'
const ogImg       = heroSection?.image
  ? urlFor(heroSection.image).width(1200).height(630).fit('crop').crop('focalpoint').url()
  : undefined

// ── Stats témoignages ─────────────────────────────────────────────────────────
const allTemoStats = await client.fetch(`*[_type == "temoignage"] { note }`)
const temoCount    = allTemoStats.length
const temoAvgRaw   = temoCount > 0
  ? allTemoStats.reduce((sum: number, t: any) => sum + (t.note ?? 5), 0) / temoCount
  : 5
const temoAvgNote  = temoAvgRaw.toFixed(1)
const temoLabel    = temoCount > 0
  ? `${temoCount} témoignage${temoCount > 1 ? 's' : ''}`
  : '26 témoignages'

// ── Helper : fallback sans perdre le stega ────────────────────────────────────
// stegaClean() sert uniquement à tester si le champ est vide ; on rend la valeur
// ORIGINALE (marqueurs stega préservés → overlays cliquables dans l'aperçu Sanity).
// Les liens/URLs, eux, doivent rester nettoyés (stega dans un href = lien cassé).
const pick = (v: any, fallback: string) => (stegaClean(v) ? v : fallback)

// ── Témoignages section HP ────────────────────────────────────────────────────
const temoHPSection = hp?.pagebuilder?.find((s: any) => s._type === 'sectionTemoignagesHP')
const temoEyebrow = pick(temoHPSection?.eyebrow, "Ce qu'ils disent")
const temoPitch   = pick(temoHPSection?.pitch, 'Des pêcheurs de toute la France font confiance à Jean-Baptiste depuis 2004.')
const temoCtaTxt  = pick(temoHPSection?.ctaTexte, 'Lire tous les témoignages')
const temoCtaLien = stegaClean(temoHPSection?.ctaLien)  || '/temoignages'
// ── Témoignages (avec fallback) ───────────────────────────────────────────────
const sanityTemoignages = await stegaClient.fetch(`
  *[_type == "temoignage" && afficherAccueil == true] | order(orderRank asc) [0...6] {
    _id, nom, note, texte, prestation
  }
`)
const fallbackTemoignages = [
  { _id: 'f1', nom: 'Diego', prestation: 'Stage saumon & Spey Cast', note: 5, texte: "Il m'a fallu désapprendre pour réapprendre. 5 jours de stage intensif au saumon à la mouche en Bretagne : le site est proprement magnifique et les rivières sont brunes et mystérieuses." },
  { _id: 'f2', nom: 'Marc', prestation: 'Découverte bar à vue & bateau', note: 5, texte: 'Jean-Baptiste connaît le poisson par cœur, ses habitudes, les sites qui vont bien. Super matos, super conseils. Très agréable et efficace. Grande expérience du guidage.' },
  { _id: 'f3', nom: 'Fiona et Romain', prestation: 'Découverte de la pêche à la mouche', note: 5, texte: "Ce fut un vrai plaisir d'apprendre avec toi. Pas de stress, de la rigolade et surtout un excellent prof qui ne se contente pas de l'apprentissage brut du lancer mais fait découvrir l'art qu'est véritablement la pêche à la mouche." },
  { _id: 'f4', nom: 'Vincent', prestation: 'Bar à vue & bateau, Bretagne-Sud', note: 5, texte: "Je conseille à tout le monde d'essayer de prendre ces gros bars que Jean-Baptiste connaît par cœur — ressentir ces montées d'adrénaline à la vue de bars énormes postés devant vous." },
]
const temoignages = sanityTemoignages.length > 0 ? sanityTemoignages : fallbackTemoignages

// ── Bon cadeau HP ─────────────────────────────────────────────────────────────
const bonCadeauHP = hp?.pagebuilder?.find((s: any) => s._type === 'sectionBonCadeauHP')
const cadeauTitre  = pick(bonCadeauHP?.titre, 'Offrez une expérience inoubliable')
const cadeauTexte  = pick(bonCadeauHP?.texte, "Offrez à un proche une journée de pêche à la mouche en Bretagne. Initiation, perfectionnement ou sortie guidée — le bon cadeau est valable sur toutes les prestations, eau douce ou bar en mer.")
const cadeauBtn1T  = pick(bonCadeauHP?.btn1Texte, 'Découvrir le bon cadeau')
const cadeauBtn1L  = stegaClean(bonCadeauHP?.btn1Lien)  || '/bon-cadeau'
const cadeauBtn2T  = pick(bonCadeauHP?.btn2Texte, 'Demander un renseignement')
const cadeauBtn2L  = stegaClean(bonCadeauHP?.btn2Lien)  || '/contact'

// ── Guide HP ──────────────────────────────────────────────────────────────────
const guideHP    = hp?.pagebuilder?.find((s: any) => s._type === 'sectionGuideHP')
// Pas de recadrage CDN : .guide-photo passe de 3/4 à 16/9 sous 1024px, et un
// ratio figé s'y ferait redécouper au centre — hotspot perdu, visage coupé.
// On sert le ratio naturel et on positionne par le hotspot (cf. hotspotPosition).
const guidePhotoUrl  = guideHP?.photo?.asset
  ? urlFor(guideHP.photo).width(900).auto('format').url()
  : null
const guidePhotoPos  = hotspotPosition(guideHP?.photo)
const guideEyebrow   = pick(guideHP?.eyebrow, 'Votre guide')
const guideNom       = pick(guideHP?.nom, 'Jean-Baptiste Vidal')
const guideAccroche  = pick(guideHP?.accroche, "33 ans de pêche à la mouche et d'expérience à votre service, dont 21 années de guidage en France et à l'étranger.")
const guideBio       = pick(guideHP?.bio, "Après des études dans l'environnement et 5 ans à la Fédération de Pêche du Finistère, Jean-Baptiste a guidé 6 saisons sur le Rio Grande (Argentine) pour Nervous Waters, puis en Irlande, Russie et Bolivie. Depuis 2014, il propose ses services de Moniteur-Guide en Bretagne-Sud, tout au long de l'année.")
const guideBtnTxt    = pick(guideHP?.boutonTexte, 'Votre guide')
const guideBtnLien   = stegaClean(guideHP?.boutonLien)  || '/jean-baptiste-vidal-moniteur-guide-de-peche'
const guideStats: { valeur: string; label: string }[] = (guideHP?.stats ?? []).length > 0
  ? guideHP.stats.map((s: any) => ({ valeur: pick(s.valeur, ''), label: pick(s.label, '') }))
  : [
      { valeur: '33 ans',   label: 'de pêche à la mouche' },
      { valeur: '21 ans',   label: 'de guidage' },
      { valeur: '8 ans',    label: 'de guidage à l\'étranger' },
      { valeur: 'Voyages',  label: 'Organisation de voyages' },
    ]

// ── Section Matériel ──────────────────────────────────────────────────────────
const materielHP = hp?.pagebuilder?.find((s: any) => s._type === 'sectionMaterielHP')

const MATERIEL_CARDS_FALLBACK = [
  { eyebrow: 'Streamers · Nymphes · Sèches', titre: 'Mes mouches', lien: '/mouches-de-peche-jeanbaptiste-vidal', imageUrl: '/images/A1.avif' },
  { eyebrow: 'Carolina Skiff · Fond plat',   titre: 'Le bateau',   lien: '/bateau-bar-a-la-mouche',            imageUrl: '/images/bateau-3.jpg' },
]

const materielSection = {
  eyebrow:         pick(materielHP?.eyebrow, 'Équipement · Ressources'),
  titre:           pick(materielHP?.titre, 'Matériel & univers'),
  featuredEyebrow: pick(materielHP?.featuredEyebrow, 'Cannes · Soies · Moulinets · Accessoires'),
  featuredTitre:   pick(materielHP?.featuredTitre, 'Mon matériel'),
  featuredLien:    stegaClean(materielHP?.featuredLien)    || '/materiel-jeanbaptistevidal',
  featuredImage:   materielHP?.featuredImage?.asset
    ? urlFor(materielHP.featuredImage).width(900).height(700).fit('crop').crop('focalpoint').url()
    : '/images/materiel-hero.jpg',
  sousLiens: (materielHP?.sousLiens?.length > 0)
    ? materielHP.sousLiens.map((l: any) => ({ label: pick(l.label, ''), href: stegaClean(l.href) || '#' }))
    : [
        { label: 'Matériel migrateurs', href: '/materiel-mouche-migrateur' },
        { label: 'Matériel truite',     href: '/materiel-mouche-truite' },
        { label: 'Matériel bar',        href: '/materiel-mouche-bar' },
        { label: 'Matériel réservoir',  href: '/materiel-mouche-reservoir' },
        { label: 'Matériel brochet',    href: '/materiel-mouche-brochet' },
        { label: 'Matériel exotique',   href: '/materiel-mouche-peche-exotique' },
      ],
  cardsSecondaires: (materielHP?.cardsSecondaires?.length > 0)
    ? materielHP.cardsSecondaires.map((c: any, i: number) => ({
        eyebrow:  pick(c.eyebrow, MATERIEL_CARDS_FALLBACK[i]?.eyebrow || ''),
        titre:    pick(c.titre, MATERIEL_CARDS_FALLBACK[i]?.titre || ''),
        lien:     stegaClean(c.lien)    || MATERIEL_CARDS_FALLBACK[i]?.lien    || '#',
        imageUrl: c.image?.asset
          ? urlFor(c.image).width(600).height(500).fit('crop').crop('focalpoint').url()
          : MATERIEL_CARDS_FALLBACK[i]?.imageUrl || null,
      }))
    : MATERIEL_CARDS_FALLBACK,
}

// ── Toutes les sections dans l'ordre Sanity ───────────────────────────────────
const allSections = hp?.pagebuilder ?? []

// ── Coordonnées (⚙️ Paramètres) pour le hero de secours ──────────────────────
const paramsContact = await client.fetch(`*[_id == "siteParametres"][0]{ telephone }`)
const fallbackTel = paramsContact?.telephone || '06 87 30 34 56'

// ── Newsletter ────────────────────────────────────────────────────────────────
const nl = await client.fetch(`*[_type == "newsletter"][0]{
  sectionTitre, sectionSousTitre, sectionAvantages, sectionBoutonTexte, sectionPlaceholder,
  popupActif, popupDelai, popupScroll, popupCooldown1, popupCooldown2,
  popupTitre, popupTexte, popupBoutonTexte, popupIgnorerTexte, formAction,
  popupImage{ asset->{ _id, url } }
}`)

const nlSectionTitre   = pick(nl?.sectionTitre, 'Les carnets du guide, dans votre boîte mail')
const nlSectionSous    = pick(nl?.sectionSousTitre, "Conseils de pêche à la mouche, récits de sorties, annonces de stages et voyages. Pas de spam — seulement du contenu qui vaut le coup.")
const nlAvantages      = nl?.sectionAvantages?.map((a: any) => ({
  emoji: pick(a.emoji, ''), label: pick(a.label, '')
})) ?? [
  { emoji: '🎣', label: 'Conseils et techniques exclusifs' },
  { emoji: '🎬', label: 'Récits de sorties et vidéos' },
  { emoji: '🌍', label: 'Voyages et destinations pêche' },
]
const nlBoutonTexte    = pick(nl?.sectionBoutonTexte, "S'inscrire gratuitement")
const nlPlaceholder    = stegaClean(nl?.sectionPlaceholder)  || 'votre@email.fr'
const nlFormAction     = stegaClean(nl?.formAction)          || '/newsletter'
const nlPopupActif     = nl?.popupActif  ?? true
const nlPopupDelai     = nl?.popupDelai  ?? 15
const nlPopupScroll    = nl?.popupScroll ?? 35
const nlPopupCd1       = nl?.popupCooldown1 ?? 30
const nlPopupCd2       = nl?.popupCooldown2 ?? 180
const nlPopupTitre     = pick(nl?.popupTitre, "Une lettre du bord de l'eau")
const nlPopupTexte     = pick(nl?.popupTexte, "Rejoignez les pêcheurs qui reçoivent les conseils, récits et vidéos de Jean-Baptiste.")
const nlPopupBtn       = pick(nl?.popupBoutonTexte, "Je m'inscris")
const nlPopupIgnorer   = pick(nl?.popupIgnorerTexte, 'Non merci')
const nlPopupImageUrl  = nl?.popupImage?.asset?.url || '/images/bar-a-vue.jpg'
---

<BaseLayout
  title={fullTitle(pageTitle)}
  description={pageDesc}
  image={ogImg}
  lang="fr"
  hreflangFr="/"
  hreflangEn="/en/"
>

  {/* ── Hero fallback (si aucune sectionHero dans le pagebuilder) ── */}
  {!allSections.some((s: any) => s._type === 'sectionHero') && (
    <section class="hp-hero-fallback">
      <div class="hp-hero-fallback__bg"></div>
      <div class="hp-hero-fallback__overlay"></div>
      <div class="hp-hero-fallback__content container">
        <div class="hp-hero-fallback__badges">
          <span class="hp-hero-fallback__badge">21 ans de guidage</span>
          <span class="hp-hero-fallback__badge hp-hero-fallback__badge--mouche">🪶 Exclusivement Mouche</span>
        </div>
        <p class="hp-hero-fallback__eyebrow">Moniteur-Guide · Bretagne-Sud</p>
        <h1 class="hp-hero-fallback__h1">Pêche à la mouche<br/><em>en Bretagne</em></h1>
        <p class="hp-hero-fallback__sub">Guidage bar, truite, alose et brochet. Stages toutes techniques, de l'initiation à la masterclass.</p>
        <div class="hp-hero-fallback__cta">
          <a href="/contact" class="btn-prim">Réserver une sortie</a>
          <a href={`tel:${fallbackTel.replace(/\s/g, '')}`} class="btn-ghost-hero">{fallbackTel}</a>
        </div>
      </div>
    </section>
  )}

  {/* ── Toutes les sections dans l'ordre Sanity ── */}
  {allSections.map((s: any) => {

    if (s._type === 'sectionGuideHP') return (
      <section class="section section--sand guide-section">
        <div class="container guide-inner">
          <div class="guide-photo" style={guidePhotoUrl ? `background-image: url('${guidePhotoUrl}'); background-position: ${guidePhotoPos}` : undefined}></div>
          <div class="guide-text">
            <p class="eyebrow">{guideEyebrow}</p>
            <h2>{guideNom}</h2>
            <p class="guide-accroche">{guideAccroche}</p>
            <p>{guideBio}</p>
            <ul class="guide-stats">
              {guideStats.map((st) => (
                <li><strong>{st.valeur}</strong> {st.label}</li>
              ))}
            </ul>
            <a href={guideBtnLien} class="btn btn--ocean">{guideBtnTxt}</a>
          </div>
        </div>
      </section>
    )

    if (s._type === 'sectionMaterielHP') return (
      <section class="section hp-materiel">
        <div class="container hp-materiel__header">
          <p class="eyebrow">{materielSection.eyebrow}</p>
          <h2>{materielSection.titre}</h2>
        </div>
        <div class="hp-materiel__grid">
          <div class="hp-mat-card hp-mat-card--featured">
            <div class="hp-mat-card__bg" style={`background-image: url('${materielSection.featuredImage}')`}></div>
            <div class="hp-mat-card__body hp-mat-card__body--featured">
              <div class="hp-mat-card__left">
                <p class="hp-mat-card__eyebrow">{materielSection.featuredEyebrow}</p>
                <h3>{materielSection.featuredTitre}</h3>
                <a href={materielSection.featuredLien} class="hp-mat-card__all">Voir tout →</a>
              </div>
              <nav class="hp-mat-subnav" aria-label="Sous-pages matériel">
                {materielSection.sousLiens.map((l: any) => (
                  <a href={l.href} class="hp-mat-subnav__link">{l.label}</a>
                ))}
              </nav>
            </div>
          </div>
          {materielSection.cardsSecondaires.map((c: any) => (
            <a href={c.lien} class="hp-mat-card">
              <div class="hp-mat-card__bg" style={`background-image: url('${c.imageUrl}')`}></div>
              <div class="hp-mat-card__body">
                <p class="hp-mat-card__eyebrow">{c.eyebrow}</p>
                <h3>{c.titre}</h3>
                <span class="hp-mat-card__arrow">Découvrir →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )

    if (s._type === 'sectionBonCadeauHP') return (
      <section class="hp-cadeau">
        <div class="hp-cadeau__bg"></div>
        <div class="hp-cadeau__overlay"></div>
        <div class="container hp-cadeau__inner">
          <div class="hp-cadeau__content">
            <p class="hp-cadeau__eyebrow">🎁 Idée cadeau</p>
            <h2 class="hp-cadeau__titre">{cadeauTitre}</h2>
            <p class="hp-cadeau__texte">{cadeauTexte}</p>
            <div class="hp-cadeau__actions">
              <a href={cadeauBtn1L} class="hp-cadeau__btn hp-cadeau__btn--prim">{cadeauBtn1T}</a>
              <a href={cadeauBtn2L} class="hp-cadeau__btn hp-cadeau__btn--ghost">{cadeauBtn2T}</a>
            </div>
          </div>
          <div class="hp-cadeau__aside">
            <div class="hp-cadeau__card">
              <p class="hp-cadeau__card-label">Format</p>
              <p class="hp-cadeau__card-val">Journée · Demi-journée</p>
              <p class="hp-cadeau__card-label">Valable sur</p>
              <p class="hp-cadeau__card-val">Toutes les prestations · Eau douce &amp; Bar</p>
              <p class="hp-cadeau__card-label">Validité</p>
              <p class="hp-cadeau__card-val">1 an à compter de la date d'achat</p>
              <p class="hp-cadeau__card-label">Envoi</p>
              <p class="hp-cadeau__card-val">Par e-mail ou courrier · Personnalisable</p>
              <a href={cadeauBtn1L} class="hp-cadeau__card-cta">Commander →</a>
            </div>
          </div>
        </div>
      </section>
    )

    if (s._type === 'sectionTemoignagesHP') return (
      <section class="hp-temo">
        <div class="container hp-temo__inner">
          <div class="hp-temo__left">
            <p class="hp-temo__eyebrow">{temoEyebrow}</p>
            <div class="hp-temo__mark">&ldquo;</div>
            <div class="hp-temo__rotator" id="temoRotator">
              {temoignages.map((t: any, i: number) => (
                <figure class={`hp-temo__quote${i === 0 ? ' hp-temo__quote--active' : ''}`}>
                  <blockquote>{t.texte}</blockquote>
                  <figcaption>
                    <strong class="hp-temo__name">{t.nom}</strong>
                    <span class="hp-temo__cat">{t.prestation}</span>
                    <span class="hp-temo__stars">{'★'.repeat(t.note ?? 5)}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
            <div class="hp-temo__dots" id="temoDots">
              {temoignages.map((_: any, i: number) => (
                <button
                  class={`hp-temo__dot${i === 0 ? ' hp-temo__dot--active' : ''}`}
                  aria-label={`Témoignage ${i + 1}`}
                ></button>
              ))}
            </div>
          </div>
          <div class="hp-temo__right">
            <div class="hp-temo__score">
              <div class="hp-temo__score-num">{temoAvgNote}</div>
              <div class="hp-temo__score-stars">★★★★★</div>
              <div class="hp-temo__score-label">{temoLabel}</div>
            </div>
            <div class="hp-temo__divider"></div>
            <p class="hp-temo__pitch">{temoPitch}</p>
            <a href={temoCtaLien} class="hp-temo__cta">{temoCtaTxt}</a>
          </div>
        </div>
      </section>
    )

    // Inject FR badges on sectionHero if not already set in Sanity
    if (s._type === 'sectionHero') {
      const withBadges = s.badges?.length ? s : { ...s, badges: [
        { _key: 'b1', texte: '21 ans de guidage' },
        { _key: 'b2', texte: '🪶 Exclusivement Mouche', style: 'mouche' },
      ]}
      return <PageBuilderSections sections={[withBadges]} pageTitle={pageTitle} />
    }
    return <PageBuilderSections sections={[s]} pageTitle={pageTitle} />
  })}

  <!-- ── Section newsletter (toujours en dernier) ── -->
  <NewsletterSection
    titre={nlSectionTitre}
    sousTitre={nlSectionSous}
    avantages={nlAvantages}
    boutonTexte={nlBoutonTexte}
    placeholder={nlPlaceholder}
    formAction={nlFormAction}
  />

  <!-- ── Popup newsletter (apparaît après délai) ── -->
  <NewsletterPopup
    actif={nlPopupActif}
    delai={nlPopupDelai}
    scrollPct={nlPopupScroll}
    cooldown1={nlPopupCd1}
    cooldown2={nlPopupCd2}
    titre={nlPopupTitre}
    texte={nlPopupTexte}
    imageUrl={nlPopupImageUrl}
    boutonTexte={nlPopupBtn}
    ignorerTexte={nlPopupIgnorer}
    formAction={nlFormAction}
  />

</BaseLayout>

<style>
  /* ══════════════════════════════════════
     HERO FALLBACK (si pagebuilder vide)
  ══════════════════════════════════════ */
  .hp-hero-fallback {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 6rem;
    overflow: hidden;
  }
  .hp-hero-fallback__bg {
    position: absolute; inset: 0;
    background: url('/images/hero.jpg') center / cover no-repeat;
  }
  .hp-hero-fallback__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(7,24,31,0.92) 0%, rgba(13,43,62,0.55) 55%, rgba(13,43,62,0.3) 100%);
  }
  .hp-hero-fallback__content {
    position: relative; z-index: 1;
    max-width: 780px;
  }
  .hp-hero-fallback__badges {
    display: flex; gap: 0.75rem; flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .hp-hero-fallback__badge {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 2px;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    background: rgba(255,255,255,0.12);
