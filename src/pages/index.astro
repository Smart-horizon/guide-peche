              <blockquote>{t.texte}</blockquote>
              <figcaption>
                <strong class="hp-temo__name">{t.nom}</strong>
                <span class="hp-temo__cat">{t.prestation}</span>
                <span class="hp-temo__stars">{'★'.repeat(t.note ?? 5)}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <!-- Dots dynamiques -->
        <div class="hp-temo__dots" id="temoDots">
          {temoignages.map((_: any, i: number) => (
            <button
              class={`hp-temo__dot${i === 0 ? ' hp-temo__dot--active' : ''}`}
              aria-label={`Témoignage ${i + 1}`}
            ></button>
          ))}
        </div>
      </div>

      <!-- Colonne droite : score + CTA -->
      <div class="hp-temo__right">
        <div class="hp-temo__score">
          <div class="hp-temo__score-num">{temoSection.score}</div>
          <div class="hp-temo__score-stars">★★★★★</div>
          <div class="hp-temo__score-label">{temoSection.nombre}</div>
        </div>
        <div class="hp-temo__divider"></div>
        <p class="hp-temo__pitch">{temoSection.pitch}</p>
        <a href={temoSection.ctaLien} class="hp-temo__cta">{temoSection.ctaTexte}</a>
      </div>

    </div>
  </section>

  </div><!-- /sections-dynamic -->

  <!-- ═══ CTA FINALE ═══ -->
  <section class="section cta-section">
    <div class="container cta-inner">
      <h2>{cta.titre}</h2>
      <p>{cta.texte}</p>
      <div class="cta-btns">
        <a href={cta.btn1Lien} class="btn btn--ocean">{cta.btn1Texte}</a>
        <a href={cta.btn2Lien} class="btn btn--outline">{cta.btn2Texte}</a>
