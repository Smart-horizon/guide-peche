      <p class="cta-tel">Ou par téléphone : <a href={`tel:+33${cta.telephone.replace(/\s/g,'').replace(/^0/,'')}`}>{cta.telephone}</a> · <a href={`mailto:${cta.email}`}>{cta.email}</a></p>
    </div>
  </section>

</BaseLayout>

