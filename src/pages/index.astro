<script>
  (() => {
    const rotator = document.getElementById('temoRotator');
    const dotsContainer = document.getElementById('temoDots');
    if (!rotator) return;

    const quotes = rotator.querySelectorAll('.hp-temo__quote');
    const dots   = dotsContainer ? dotsContainer.querySelectorAll('.hp-temo__dot') : [];
    let current  = 0;
    let timer;

    function show(n) {
      quotes[current].classList.remove('hp-temo__quote--active');
      dots[current]?.classList.remove('hp-temo__dot--active');
      current = (n + quotes.length) % quotes.length;
      quotes[current].classList.add('hp-temo__quote--active');
      dots[current]?.classList.add('hp-temo__dot--active');
    }

    function start() {
      timer = setInterval(() => show(current + 1), 6000);
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        clearInterval(timer);
        show(i);
        start();
      });
    });

    start();
  })();
</script>
