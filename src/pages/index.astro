---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageBuilderSections from '../components/PageBuilderSections.astro'
import { client, stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

const builder = imageUrlBuilder(stegaClient)
const urlFor = (source: any) => builder.image(source)

// ── Page d'accueil depuis Sanity (document "page" avec slug "/") ──────────────
const hp = await stegaClient.fetch(`
  *[_type == "page" && slug.current == "/"][0]{
    _id, title, seoTitle, seoDescription,
    pagebuilder[]{
      ...,
      image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      photo{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } },
      btnFichier{ asset->{ _id, url } },
      photos[]{ asset->{ _id, url } },
      images[]{ asset->{ _id, url } },
      cards[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      etapes[]{ ..., image{ _type, hotspot, crop, asset->{ _id, url, metadata{ dimensions } } } },
      items[]{..., photos[]{asset->{_id, url}, alt, caption}},
    }
  }
`)

// ── SEO ───────────────────────────────────────────────────────────────────────
const heroSection = hp?.pagebuilder?.find((s: any) => s._type === 'sectionHero')
const pageTitle   = hp?.seoTitle || heroSection?.titre || hp?.title || 'Jean-Baptiste Vidal — Guide de pêche à la mouche en Bretagne'
const pageDesc    = hp?.seoDescription || 'Moniteur-Guide diplômé, 21 ans de guidage. Stages de pêche à la mouche, guidage bar, truite, alose et brochet en Bretagne-Sud.'
const ogImg       = heroSection?.image
  ? urlFor(heroSection.image).width(1200).height(630).url()
  : undefined

// ── Prestations (pour la grille Wild Fly) ────────────────────────────────────
const prestations = await client.fetch(`
  *[_type == "prestation"] | order(_createdAt asc) {
    title, slug, categorie, tarif, duree, image,
    "description": description[0].children[0].text
  }
`)

// ── Données grille prestations HP ─────────────────────────────────────────────
// Récupère la sectionPrestationsHP du pagebuilder si elle existe, sinon fallback
const prestationsHPSection = hp?.pagebuilder?.find((s: any) => s._type === 'sectionPrestationsHP')
const prestationsEyebrow = stegaClean(prestationsHPSection?.eyebrow) || 'Ce que je propose'
const prestationsTitre   = stegaClean(prestationsHPSection?.titre)   || 'Stages & guidages'

const imgFallback: Record<string, string> = {
  'eau-douce':   '/images/prestation-eaudouce.jpg',
  'bar':         '/images/prestation-bar.jpg',
  'masterclass': '/images/prestation-masterclass.jpg',
  'spey-cast':   '/images/prestation-speycast.jpg',
  'bon-cadeau':  '/images/prestation-cadeau.jpg',
}

const rawCards = [
  { label: 'Eau douce',          sub: 'Truite · Alose · Brochet',         href: '/peche-a-la-mouche-en-bretagne',      categorie: 'eau-douce'   },
  { label: 'Pêche du bar',       sub: 'Pêche à vue · Bateau',             href: '/peche-du-bar-a-la-mouche',           categorie: 'bar'         },
  { label: 'Masterclass',        sub: 'Réservoir · Nymphe au fil',        href: '/masterclass',                        categorie: 'masterclass'  },
  { label: 'Spey Cast & Lancer', sub: 'Canne une main · Switch · Spey',   href: '/stage-spey-cast-et-cours-de-lancer', categorie: 'spey-cast'   },
  { label: 'Bon cadeau',         sub: 'Offrir une sortie',                href: '/bon-cadeau-peche-mouche',            categorie: 'bon-cadeau'  },
]

const prestationsCards = rawCards.map((card, i) => {
  const slug    = card.categorie
  const sanityImg = prestations.find((p: any) => p.categorie === slug)?.image
  const img = sanityImg
    ? urlFor(sanityImg).width(i === 0 ? 900 : 600).height(i === 0 ? 600 : 400).url()
    : (imgFallback[slug] ?? '/images/hero.jpg')
  return { ...card, img, isLarge: i === 0 }
})

// ── Stats témoignages ─────────────────────────────────────────────────────────
const allTemoStats = await client.fetch(`*[_type == "temoignage"] { note }`)
const temoCount    = allTemoStats.length
const temoAvgRaw   = temoCount > 0
  ? allTemoStats.reduce((sum: number, t: any) => sum + (t.note ?? 5), 0) / temoCount
  : 5
const temoAvgNote  = temoAvgRaw.toFixed(1)
const temoLabel    = temoCount > 0
  ? `${temoCount} témoignage${temoCount > 1 ? 's' : ''}`
  : '26 témoignages'

// ── Témoignages section HP ────────────────────────────────────────────────────
const temoHPSection = hp?.pagebuilder?.find((s: any) => s._type === 'sectionTemoignagesHP')
const temoEyebrow = stegaClean(temoHPSection?.eyebrow) || "Ce qu'ils disent"
const temoPitch   = stegaClean(temoHPSection?.pitch)   || 'Des pêcheurs de toute la France font confiance à Jean-Baptiste depuis 2004.'
const temoCtaTxt  = stegaClean(temoHPSection?.ctaTexte) || 'Lire tous les témoignages'
const temoCtaLien = stegaClean(temoHPSection?.ctaLien)  || '/temoignages'

// ── Témoignages (avec fallback) ───────────────────────────────────────────────
const sanityTemoignages = await stegaClient.fetch(`
  *[_type == "temoignage" && afficherAccueil == true] | order(orderRank asc) [0...6] {
    _id, nom, note, texte, prestation
  }
`)
const temoignagesFallbackQuery = await stegaClient.fetch(`
  *[_type == "temoignage"] | order(orderRank asc) [0...6] {
    _id, nom, note, texte, prestation
  }
`)
const fallbackTemoignages = [
  { _id: 'f1', nom: 'Diego', prestation: 'Stage saumon & Spey Cast', note: 5, texte: "Il m'a fallu désapprendre pour réapprendre. 5 jours de stage intensif au saumon à la mouche en Bretagne : le site est proprement magnifique et les rivières sont brunes et mystérieuses." },
  { _id: 'f2', nom: 'Marc', prestation: 'Découverte bar à vue & bateau', note: 5, texte: 'Jean-Baptiste connaît le poisson par cœur, ses habitudes, les sites qui vont bien. Super matos, super conseils. Très agréable et efficace. Grande expérience du guidage.' },
  { _id: 'f3', nom: 'Fiona et Romain', prestation: 'Découverte de la pêche à la mouche', note: 5, texte: "Ce fut un vrai plaisir d'apprendre avec toi. Pas de stress, de la rigolade et surtout un excellent prof qui ne se contente pas de l'apprentissage brut du lancer mais fait découvrir l'art qu'est véritablement la pêche à la mouche." },
  { _id: 'f4', nom: 'Vincent', prestation: 'Bar à vue & bateau, Bretagne-Sud', note: 5, texte: "Je conseille à tout le monde d'essayer de prendre ces gros bars que Jean-Baptiste connaît par cœur — ressentir ces montées d'adrénaline à la vue de bars énormes postés devant vous." },
]
const temoignages = sanityTemoignages.length > 0
  ? sanityTemoignages
  : (temoignagesFallbackQuery.length > 0 ? temoignagesFallbackQuery : fallbackTemoignages)

// ── Bon cadeau HP ─────────────────────────────────────────────────────────────
const bonCadeauHP = hp?.pagebuilder?.find((s: any) => s._type === 'sectionBonCadeauHP')
const cadeauTitre  = stegaClean(bonCadeauHP?.titre)     || 'Offrez une expérience inoubliable'
const cadeauTexte  = stegaClean(bonCadeauHP?.texte)     || "Offrez à un proche une journée de pêche à la mouche en Bretagne. Initiation, perfectionnement ou sortie guidée — le bon cadeau est valable sur toutes les prestations, eau douce ou bar en mer."
const cadeauBtn1T  = stegaClean(bonCadeauHP?.btn1Texte) || 'Découvrir le bon cadeau'
const cadeauBtn1L  = stegaClean(bonCadeauHP?.btn1Lien)  || '/bon-cadeau-peche-mouche'
const cadeauBtn2T  = stegaClean(bonCadeauHP?.btn2Texte) || 'Demander un renseignement'
const cadeauBtn2L  = stegaClean(bonCadeauHP?.btn2Lien)  || '/contact'

// ── Guide HP ──────────────────────────────────────────────────────────────────
const guideHP    = hp?.pagebuilder?.find((s: any) => s._type === 'sectionGuideHP')
const guidePhotoUrl  = guideHP?.photo?.asset
  ? urlFor(guideHP.photo).width(600).height(800).fit('crop').crop('focalpoint').url()
  : null
const guideEyebrow   = stegaClean(guideHP?.eyebrow)     || 'Votre guide'
const guideNom       = stegaClean(guideHP?.nom)         || 'Jean-Baptiste Vidal'
const guideAccroche  = stegaClean(guideHP?.accroche)    || "33 ans de pêche à la mouche et d'expérience à votre service, dont 21 années de guidage en France et à l'étranger."
const guideBio       = stegaClean(guideHP?.bio)         || "Après des études dans l'environnement et 5 ans à la Fédération de Pêche du Finistère, Jean-Baptiste a guidé 6 saisons sur le Rio Grande (Argentine) pour Nervous Waters, puis en Irlande, Russie et Bolivie. Depuis 2014, il propose ses services de Moniteur-Guide en Bretagne-Sud, tout au long de l'année."
const guideBtnTxt    = stegaClean(guideHP?.boutonTexte) || 'Votre guide'
const guideBtnLien   = stegaClean(guideHP?.boutonLien)  || '/jean-baptiste-vidal-moniteur-guide-de-peche'

// ── Sections pagebuilder (hors sections HP fixes) ─────────────────────────────
// On filtre les 4 types HP fixes car ils sont rendus en dur ci-dessous
const HP_FIXED = ['sectionPrestationsHP', 'sectionGuideHP', 'sectionTemoignagesHP', 'sectionBonCadeauHP']
const pbSections = (hp?.pagebuilder ?? []).filter((s: any) => !HP_FIXED.includes(s._type))
---

<BaseLayout
  title={`${pageTitle} — Jean-Baptiste Vidal`}
  description={pageDesc}
  image={ogImg}
>

  {/* ── Sections pagebuilder (hero + autres blocs libres) ── */}
  <PageBuilderSections sections={pbSections} pageTitle={pageTitle} />

  {/* ── PRESTATIONS — grille Wild Fly fixe ── */}
  <section class="prestations-section">
    <div class="prestations-header container">
      <p class="eyebrow">{prestationsEyebrow}</p>
      <h2>{prestationsTitre}</h2>
    </div>
    <div class="wildfly-grid">
      {prestationsCards.map((card: any) => (
        <a href={card.href} class={`wf-card ${card.isLarge ? 'wf-card--large' : ''}`}>
          <div class="wf-card-bg" style={`background-image: url(${card.img})`}></div>
          <div class="wf-overlay"></div>
          <div class="wf-body">
            <span class="wf-sub">{card.sub}</span>
            <strong class="wf-label">{card.label}</strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* ── LE GUIDE — section fixe ── */}
  <section class="section section--sand guide-section">
    <div class="container guide-inner">
      <div class="guide-photo" style={guidePhotoUrl ? `background-image: url('${guidePhotoUrl}')` : undefined}></div>
      <div class="guide-text">
        <p class="eyebrow">{guideEyebrow}</p>
        <h2>{guideNom}</h2>
        <p class="guide-accroche">{guideAccroche}</p>
        <p>{guideBio}</p>
        <ul class="guide-stats">
          <li><strong>33 ans</strong> de pêche à la mouche</li>
          <li><strong>21 ans</strong> de guidage</li>
          <li><strong>8 ans</strong> de guidage à l'étranger</li>
          <li><strong>Voyages</strong> Organisation de voyages</li>
        </ul>
        <a href={guideBtnLien} class="btn btn--ocean">{guideBtnTxt}</a>
      </div>
    </div>
  </section>

  {/* ── BON CADEAU — section fixe ── */}
  <section class="hp-cadeau">
    <div class="hp-cadeau__bg"></div>
    <div class="hp-cadeau__overlay"></div>
    <div class="container hp-cadeau__inner">
      <div class="hp-cadeau__content">
        <p class="hp-cadeau__eyebrow">🎁 Idée cadeau</p>
        <h2 class="hp-cadeau__titre">{cadeauTitre}</h2>
        <p class="hp-cadeau__texte">{cadeauTexte}</p>
        <div class="hp-cadeau__actions">
          <a href={cadeauBtn1L} class="hp-cadeau__btn hp-cadeau__btn--prim">{cadeauBtn1T}</a>
          <a href={cadeauBtn2L} class="hp-cadeau__btn hp-cadeau__btn--ghost">{cadeauBtn2T}</a>
        </div>
      </div>
      <div class="hp-cadeau__aside">
        <div class="hp-cadeau__card">
          <p class="hp-cadeau__card-label">Format</p>
          <p class="hp-cadeau__card-val">Journée · Demi-journée</p>
          <p class="hp-cadeau__card-label">Valable sur</p>
          <p class="hp-cadeau__card-val">Toutes les prestations · Eau douce &amp; Bar</p>
          <p class="hp-cadeau__card-label">Validité</p>
          <p class="hp-cadeau__card-val">1 an à compter de la date d'achat</p>
          <p class="hp-cadeau__card-label">Envoi</p>
          <p class="hp-cadeau__card-val">Par e-mail ou courrier · Personnalisable</p>
          <a href={cadeauBtn1L} class="hp-cadeau__card-cta">Commander →</a>
        </div>
      </div>
    </div>
  </section>

  {/* ── TÉMOIGNAGES — rotator fixe ── */}
  <section class="hp-temo">
    <div class="container hp-temo__inner">

      <div class="hp-temo__left">
        <p class="hp-temo__eyebrow">{temoEyebrow}</p>
        <div class="hp-temo__mark">&ldquo;</div>
        <div class="hp-temo__rotator" id="temoRotator">
          {temoignages.map((t: any, i: number) => (
            <figure class={`hp-temo__quote${i === 0 ? ' hp-temo__quote--active' : ''}`}>
              <blockquote>{t.texte}</blockquote>
              <figcaption>
                <strong class="hp-temo__name">{t.nom}</strong>
                <span class="hp-temo__cat">{t.prestation}</span>
                <span class="hp-temo__stars">{'★'.repeat(t.note ?? 5)}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="hp-temo__dots" id="temoDots">
          {temoignages.map((_: any, i: number) => (
            <button
              class={`hp-temo__dot${i === 0 ? ' hp-temo__dot--active' : ''}`}
              aria-label={`Témoignage ${i + 1}`}
            ></button>
          ))}
        </div>
      </div>

      <div class="hp-temo__right">
        <div class="hp-temo__score">
          <div class="hp-temo__score-num">{temoAvgNote}</div>
          <div class="hp-temo__score-stars">★★★★★</div>
          <div class="hp-temo__score-label">{temoLabel}</div>
        </div>
        <div class="hp-temo__divider"></div>
        <p class="hp-temo__pitch">{temoPitch}</p>
        <a href={temoCtaLien} class="hp-temo__cta">{temoCtaTxt}</a>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  /* ══════════════════════════════════════
     PRESTATIONS — WILD FLY STYLE
  ══════════════════════════════════════ */
  .prestations-section { background: #fff; }

  .prestations-header {
    text-align: center;
    padding: 4rem 2rem 2.5rem;
  }

  .wildfly-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 420px 300px;
    gap: 4px;
  }

  /* Carte large : col 1-2, row 1 */
  .wf-card--large {
    grid-column: 1 / 3;
    grid-row: 1 / 2;
  }

  /* Bar : col 3, row 1 */
  .wf-card:nth-child(2) {
    grid-column: 3 / 4;
    grid-row: 1 / 2;
  }

  /* 3 petites : row 2 */
  .wf-card:nth-child(3) { grid-column: 1; grid-row: 2; }
  .wf-card:nth-child(4) { grid-column: 2; grid-row: 2; }
  .wf-card:nth-child(5) { grid-column: 3; grid-row: 2; }

  .wf-card {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: white;
    background: var(--color-ocean);
  }

  .wf-card-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: transform 0.6s ease;
  }

  .wf-card:hover .wf-card-bg {
    transform: scale(1.06);
  }

  .wf-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(7, 24, 31, 0.25);
    transition: background 0.35s ease;
  }

  .wf-card:hover::after {
    background: rgba(7, 24, 31, 0.1);
  }

  .wf-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7,24,31,0.75) 0%, transparent 55%);
    z-index: 1;
    transition: opacity 0.35s ease;
  }

  .wf-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem 1.75rem 1.75rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .wf-sub {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    font-weight: 500;
  }

  .wf-label {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.2;
    color: white;
  }

  .wf-card--large .wf-label {
    font-size: 2rem;
  }

  @media (max-width: 900px) {
    .wildfly-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 280px 280px 240px;
    }
    .wf-card--large { grid-column: 1 / 3; grid-row: 1; }
    .wf-card:nth-child(2) { grid-column: 1; grid-row: 2; }
    .wf-card:nth-child(3) { grid-column: 2; grid-row: 2; }
    .wf-card:nth-child(4) { grid-column: 1; grid-row: 3; }
    .wf-card:nth-child(5) { grid-column: 2; grid-row: 3; }
  }

  @media (max-width: 560px) {
    .wildfly-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(5, 260px);
    }
    .wf-card--large, .wf-card:nth-child(2),
    .wf-card:nth-child(3), .wf-card:nth-child(4),
    .wf-card:nth-child(5) {
      grid-column: 1; grid-row: auto;
    }
  }

  /* ══════════════════════════════════════
     LE GUIDE
  ══════════════════════════════════════ */
  .section--sand { background: var(--color-sand); }

  .guide-inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 5rem;
    align-items: center;
  }

  .guide-photo {
    aspect-ratio: 3/4;
    background-color: var(--color-ocean-main);
    background-image: url('/images/votre-guide.avif');
    background-size: cover;
    background-position: center;
    border-radius: 3px;
    position: relative;
  }

  .guide-accroche {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-ocean-main);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .guide-text p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .guide-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    list-style: none;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: white;
    border-radius: 3px;
    border-left: 3px solid var(--color-ocean-main);
  }

  .guide-stats li {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .guide-stats strong {
    display: block;
    font-size: 1.5rem;
    font-family: var(--font-serif);
    color: var(--color-ocean);
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  @media (max-width: 1024px) {
    .guide-inner { grid-template-columns: 1fr; gap: 2rem; }
    .guide-photo { aspect-ratio: 16/9; max-height: 320px; }
  }

  /* ══════════════════════════════════════
     BON CADEAU
  ══════════════════════════════════════ */
  .hp-cadeau {
    position: relative;
    overflow: hidden;
    min-height: 520px;
    display: flex;
    align-items: center;
  }
  .hp-cadeau__bg {
    position: absolute; inset: 0;
    background: url('/images/prestation-cadeau.jpg') center / cover no-repeat;
  }
  .hp-cadeau__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(105deg, rgba(7,24,31,0.93) 0%, rgba(13,43,62,0.82) 50%, rgba(13,43,62,0.55) 100%);
  }
  .hp-cadeau__inner {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 5rem;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
  .hp-cadeau__eyebrow {
    font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-ocean-light); font-weight: 600; margin-bottom: 1rem;
  }
  .hp-cadeau__titre {
    font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400; color: white; line-height: 1.1; margin-bottom: 1.5rem;
  }
  .hp-cadeau__texte {
    font-size: 1rem; line-height: 1.75; color: rgba(255,255,255,0.72);
    max-width: 520px; margin-bottom: 2.5rem;
  }
  .hp-cadeau__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hp-cadeau__btn {
    display: inline-block; padding: 0.8rem 2rem; border-radius: 4px;
    font-weight: 500; font-size: 0.95rem; text-decoration: none; transition: all 0.2s;
  }
  .hp-cadeau__btn--prim {
    background: var(--color-ocean-light); color: #07181f;
  }
  .hp-cadeau__btn--prim:hover { background: white; }
  .hp-cadeau__btn--ghost {
    border: 1.5px solid rgba(255,255,255,0.35); color: white;
  }
  .hp-cadeau__btn--ghost:hover { border-color: white; background: rgba(255,255,255,0.08); }

  .hp-cadeau__card {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px; padding: 2rem;
    backdrop-filter: blur(8px);
  }
  .hp-cadeau__card-label {
    font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--color-ocean-light); font-weight: 700; margin-top: 1.2rem;
  }
  .hp-cadeau__card-label:first-child { margin-top: 0; }
  .hp-cadeau__card-val {
    font-size: 0.88rem; color: rgba(255,255,255,0.8); line-height: 1.5;
  }
  .hp-cadeau__card-cta {
    display: block; margin-top: 1.6rem; text-align: center;
