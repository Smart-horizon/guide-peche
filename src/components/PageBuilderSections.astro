}
.pb-prog__text p {
  line-height: 1.75; color: var(--color-text-muted);
  font-size: 0.92rem; margin-bottom: 0.8rem;
}
.pb-prog__text p:last-child { margin-bottom: 0; }
@media (max-width: 900px) {
  .pb-prog__row { grid-template-columns: 1fr; }
  .pb-prog__row--rev .pb-prog__img,
  .pb-prog__row--rev .pb-prog__body { order: unset; }
  .pb-prog__img { min-height: 240px; }
  .pb-prog__body { padding: 2rem; }
}
@media (max-width: 560px) {
  .pb-prog__body { padding: 1.75rem 1.5rem; }
}

/* ── SÉLECTION ── */
.pb-sel__list { display: flex; flex-direction: column; gap: 3rem; margin-top: 2rem; }
.pb-sel__block {
  display: grid; grid-template-columns: 1fr 1fr;
  border-radius: 8px; overflow: hidden;
  box-shadow: 0 2px 20px rgba(0,0,0,0.08);
}
.pb-sel__block--rev .pb-sel__img  { order: 2; }
.pb-sel__block--rev .pb-sel__body { order: 1; }
.pb-sel__img { overflow: hidden; min-height: 400px; }
.pb-sel__img img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.pb-sel__block:hover .pb-sel__img img { transform: scale(1.04); }
.pb-sel__body {
  padding: 2.5rem 3rem; background: white;
  display: flex; flex-direction: column;
}
.pb-sel__body--sand { background: white; }
.pb-sel__tag {
  font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--color-ocean-main); font-weight: 600; margin-bottom: 0.4rem;
}
.pb-sel__h3 {
  font-size: 1.35rem; margin-bottom: 1rem; color: var(--color-ocean); line-height: 1.25;
}
.pb-sel__text p {
  font-size: 0.88rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: 0.8rem;
}
.pb-sel__text p:last-child { margin-bottom: 0; }
.pb-sel__pills {
  display: flex; gap: 0.5rem; flex-wrap: wrap;
  list-style: none; padding: 0; margin-top: 1.25rem;
}
.pb-sel__pills li {
  font-size: 0.72rem; background: rgba(27,94,138,0.08); color: var(--color-ocean);
  padding: 0.3rem 0.75rem; border-radius: 2px; font-weight: 500; letter-spacing: 0.05em;
}
.pb-sel__infos {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem;
  margin-top: 1.5rem; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 1.5rem;
}
.pb-sel__info-item { display: flex; flex-direction: column; gap: 0.15rem; }
.pb-sel__info-lbl {
  font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--color-ocean-main); font-weight: 700;
}
.pb-sel__info-val { font-size: 0.84rem; color: var(--color-text); font-weight: 500; line-height: 1.4; }
.section--dark .pb-sel__block {
  box-shadow: 0 2px 24px rgba(0,0,0,0.4);
}
.section--dark .pb-sel__body,
.section--dark .pb-sel__body--sand {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
}
.section--dark .pb-sel__tag   { color: var(--color-ocean-light); }
.section--dark .pb-sel__h3    { color: white; }
.section--dark .pb-sel__text p { color: rgba(255,255,255,0.72); }
.section--dark .pb-sel__pills li {
  background: rgba(255,255,255,0.1);
  color: white;
}
.section--dark .pb-sel__infos {
  border-top-color: rgba(255,255,255,0.1);
}
.section--dark .pb-sel__info-lbl { color: var(--color-ocean-light); }
.section--dark .pb-sel__info-val { color: rgba(255,255,255,0.85); }

@media (max-width: 900px) {
  .pb-sel__block { grid-template-columns: 1fr; }
  .pb-sel__block--rev .pb-sel__img,
  .pb-sel__block--rev .pb-sel__body { order: unset; }
  .pb-sel__img { min-height: 260px; }
  .pb-sel__body { padding: 2rem; }
}
@media (max-width: 560px) {
  .pb-sel__infos { grid-template-columns: 1fr; }
  .pb-sel__body { padding: 1.5rem; }
}

/* ── PROGRAMME CARTES style 2 ── */
.pb-prog-cart__grid {
  display: grid;
  gap: 2rem;
}
.pb-prog-cart__card {
  background: white;
  border-radius: 6px;
  padding: 1.8rem;
  border-top: 3px solid var(--color-ocean-main);
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.pb-prog-cart__num {
  display: block;
  font-size: 2rem;
  font-family: var(--font-serif);
  color: var(--color-ocean-light);
  opacity: 0.5;
  margin-bottom: 0.5rem;
  line-height: 1;
}
.pb-prog-cart__h3 {
  font-size: 1rem;
  color: var(--color-ocean);
  margin-bottom: 0.7rem;
}
.pb-prog-cart__desc {
  font-size: 0.9rem;
  line-height: 1.7;
  color: var(--color-text-muted);
  margin: 0;
  white-space: pre-line;
}
@media (max-width: 768px) {
  .pb-prog-cart__grid { grid-template-columns: repeat(2,1fr) !important; gap: 1.2rem; }
}
@media (max-width: 480px) {
  .pb-prog-cart__grid { grid-template-columns: 1fr !important; }
}

/* ── PROGRAMME SANS IMAGE ── */
.pb-prog-txt__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.pb-prog-txt__card {
  background: white;
  border-radius: 6px;
  padding: 1.5rem;
  box-shadow: 0 2px 12px rgba(27,94,138,0.07);
}
.pb-prog-txt__label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-bottom: 1rem;
}
.pb-prog-txt__list {
  list-style: none;
  padding: 0; margin: 0;
}
.pb-prog-txt__list li {
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--color-text);
  padding: 0.35rem 0 0.35rem 1.3rem;
  border-bottom: 1px solid #f0eff0;
  position: relative;
  white-space: pre-line;
}
.pb-prog-txt__list li::before {
  content: '—';
  position: absolute; left: 0;
  color: var(--color-ocean-light);
  font-size: 0.75rem;
}
.pb-prog-txt__list li:last-child { border-bottom: none; }
.pb-prog-txt__list--check li.ok::before { content: '✓'; color: #22c55e; }
.pb-prog-txt__list--check li.no::before { content: '✗'; color: #ef4444; }
.section--dark .pb-prog-txt__card,
.section--ocean .pb-prog-txt__card {
  background: rgba(255,255,255,0.1);
  box-shadow: none;
}
.section--dark .pb-prog-txt__label,
.section--ocean .pb-prog-txt__label { color: var(--color-ocean-light); }
.section--dark .pb-prog-txt__list li,
.section--ocean .pb-prog-txt__list li { color: rgba(255,255,255,0.82); }
@media (max-width: 768px) {
  .pb-prog-txt__grid { grid-template-columns: 1fr; }
}

/* ── CTA ── */
.section--dark.pb-cta { background: var(--color-ocean); }
.pb-cta__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem; flex-wrap: wrap;
}
.pb-cta__h2 { margin-bottom: 0.4rem; }
.pb-cta__sub { color: rgba(255,255,255,0.7); margin-top: 0.3rem; }
.section--sand .pb-cta__sub,
.section--mist .pb-cta__sub,
.section--white .pb-cta__sub { color: var(--color-text-muted); }
.pb-cta__btns { display: flex; gap: 1rem; flex-wrap: wrap; }

/* ── BANNIÈRE + INFOCARD ── */
.bc-section {
  position: relative;
  overflow: hidden;
  min-height: 520px;
  display: flex;
  align-items: center;
}
.bc-bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  transition: transform 0.6s ease;
}
.bc-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(105deg, rgba(7,24,31,0.93) 0%, rgba(13,43,62,0.82) 50%, rgba(13,43,62,0.55) 100%);
}
.bc-inner {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 5rem;
  align-items: center;
  padding-top: 5rem;
  padding-bottom: 5rem;
}
.bc-inner[data-card="false"] {
  grid-template-columns: 1fr;
  max-width: 760px;
}
.bc-eyebrow {
  font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--color-ocean-light); font-weight: 600; margin-bottom: 1rem;
}
.bc-titre {
  font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 400; color: white; line-height: 1.1; margin-bottom: 1.5rem;
}
.bc-texte {
  font-size: 1rem; line-height: 1.75; color: rgba(255,255,255,0.72);
  max-width: 520px; margin-bottom: 2.5rem;
}
.bc-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
.bc-btn {
  display: inline-block; padding: 0.8rem 2rem; border-radius: 4px;
  font-weight: 500; font-size: 0.95rem; text-decoration: none; transition: all 0.2s;
}
.bc-btn--prim  { background: var(--color-ocean-light); color: #07181f; }
.bc-btn--prim:hover  { background: white; }
.bc-btn--ghost { border: 1.5px solid rgba(255,255,255,0.35); color: white; }
.bc-btn--ghost:hover { border-color: white; background: rgba(255,255,255,0.08); }
.bc-card {
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 8px; padding: 2rem;
  backdrop-filter: blur(8px);
}
.bc-card__label {
  font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.12em;
  color: var(--color-ocean-light); font-weight: 700; margin-top: 1.2rem;
}
.bc-card__label:first-child { margin-top: 0; }
.bc-card__val {
  font-size: 0.88rem; color: rgba(255,255,255,0.8); line-height: 1.5;
}
.bc-card__cta {
  display: block; margin-top: 1.6rem; text-align: center;
  background: var(--color-ocean-light); color: #07181f;
  padding: 0.7rem 1rem; border-radius: 4px; font-weight: 600;
  font-size: 0.9rem; text-decoration: none; transition: background 0.2s;
}
.bc-card__cta:hover { background: white; }
@media (max-width: 860px) {
  .bc-inner { grid-template-columns: 1fr !important; gap: 2.5rem; }
  .bc-aside  { display: none; }
}
@media (max-width: 560px) {
  .bc-actions { flex-direction: column; }
}

/* ── BANNIÈRE ── */
.pb-banniere { padding: 0.9rem 0; }
.pb-banniere--ocean  { background: var(--color-ocean-main); color: white; }
.pb-banniere--sand   { background: var(--color-sand); color: var(--color-text); }
.pb-banniere--accent { background: var(--color-ocean-light); color: var(--color-ocean); }
.pb-banniere__inner {
  display: block;
  font-size: 0.9rem;
  font-weight: 500;
  text-align: center;
}
a.pb-banniere__inner:hover { text-decoration: underline; }

/* ── CARROUSEL 3 IMAGES ── */
.pb-carr-outer { overflow: hidden; }
.carr3-wrap {
  position: relative;
  overflow: hidden;
  cursor: grab;
}
.carr3-wrap:active { cursor: grabbing; }
.carr3-track {
  display: flex;
  align-items: stretch;
  gap: 3px;
  transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
}
.carr3-slide {
  flex: 0 0 calc((100% - 6px) / 3);
  width: calc((100% - 6px) / 3);
  overflow: hidden;
  position: relative;
}
.carr3-slide img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  display: block;
  user-select: none; -webkit-user-drag: none;
}

/* ── LIEN BLOG ── */
.pb-blog-section { max-width: 800px; }
.pb-blog-card {
  display: flex; gap: 2rem; align-items: flex-start;
  background: var(--color-sand); border-radius: 8px; padding: 2rem 2.5rem;
  border-left: 4px solid var(--color-ocean-main);
}
.pb-blog-card__icon {
  flex-shrink: 0; width: 52px; height: 52px;
  background: var(--color-ocean-main); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; color: white;
}
.pb-blog-card__body h3 { font-size: 1.15rem; margin-bottom: 0.6rem; }
.pb-blog-card__body p  { line-height: 1.75; color: var(--color-text-muted,#555); font-size: 0.92rem; margin-bottom: 1.2rem; }
.pb-blog-card__btn {
  display: inline-block; background: var(--color-ocean-main); color: white;
  padding: 0.65rem 1.4rem; border-radius: 4px; font-weight: 500;
  font-size: 0.9rem; text-decoration: none; transition: background 0.2s;
}
.pb-blog-card__btn:hover { background: #144b72; }
.section--sand .pb-blog-card { background: #fff; }
.section--dark .pb-blog-card {
  background: rgba(255,255,255,0.06); border-color: var(--color-ocean-light);
}
.section--dark .pb-blog-card__body h3 { color: white; }
.section--dark .pb-blog-card__body p  { color: rgba(255,255,255,0.7); }
.section--dark .pb-blog-card__icon { background: var(--color-ocean-light); color: var(--color-ocean); }
.section--dark .pb-blog-card__btn  { background: var(--color-ocean-light); color: var(--color-ocean); }
.section--dark .pb-blog-card__btn:hover { background: #a8d8ee; }
@media (max-width: 640px) {
  .pb-blog-card { flex-direction: column; gap: 1rem; padding: 1.5rem; }
}

.carr3-caption {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 1.5rem 1rem 0.7rem;
  background: linear-gradient(to top, rgba(7,24,31,.75) 0%, transparent 100%);
  color: rgba(255,255,255,.85);
  font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
  pointer-events: none;
}
.carr3-btn {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 46px; height: 46px; border-radius: 50%;
  background: rgba(0,0,0,.45); border: 1.5px solid rgba(255,255,255,.2);
  color: white; cursor: pointer; padding: 0;
  display: flex; align-items: center; justify-content: center;
  z-index: 10; transition: background 0.2s, border-color 0.2s;
}
.carr3-btn:hover { background: rgba(0,0,0,.7); border-color: rgba(255,255,255,.5); }
.carr3-btn--prev { left: 1rem; }
.carr3-btn--next { right: 1rem; }
.carr3-counter {
  position: absolute; bottom: 0.85rem; right: 1rem;
  font-size: 0.7rem; letter-spacing: 0.12em;
  color: rgba(255,255,255,.6); background: rgba(0,0,0,.35);
  padding: 0.2rem 0.55rem; border-radius: 2px; z-index: 10;
}

/* ── GRILLE DE CARTES — nouveaux champs ── */
.pb-prog-cart__header {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 4rem;
  align-items: start;
  margin-bottom: 2.5rem;
}
.pb-prog-cart__header[data-pos="right"] .pb-prog-cart__header-img { order: 2; }
.pb-prog-cart__header[data-pos="right"] .pb-prog-cart__header-text { order: 1; }
.pb-prog-cart__header-img {
  border-radius: 8px; overflow: hidden; height: 380px; margin: 0;
}
.pb-prog-cart__header-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pb-prog-cart__sub {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin: 0.15rem 0 0.6rem;
}
.section--dark .pb-prog-cart__sub { color: var(--color-ocean-light); }
.pb-prog-cart__note {
  font-size: 0.88rem;
  font-style: italic;
  color: var(--color-text-muted);
  margin-top: 2rem;
  max-width: 720px;
  line-height: 1.7;
}
.section--dark .pb-prog-cart__note { color: rgba(255,255,255,0.55); }
.pb-prog-cart__btn-wrap { margin-top: 2rem; }
.btn-download {
  display: inline-flex; align-items: center; gap: 0.6rem;
  background: var(--color-ocean-main); color: white;
  padding: 0.85rem 1.75rem; border-radius: 4px; font-weight: 500; font-size: 0.9rem;
  text-decoration: none; transition: background 0.2s;
}
.btn-download:hover { background: #144b72; }
@media (max-width: 900px) {
  .pb-prog-cart__header { grid-template-columns: 1fr; gap: 2rem; }
  .pb-prog-cart__header-img { height: 260px; }
  .pb-prog-cart__header[data-pos="right"] .pb-prog-cart__header-img,
  .pb-prog-cart__header[data-pos="right"] .pb-prog-cart__header-text { order: unset; }
}
.section--white .pb-prog-cart__card,
.section--sand  .pb-prog-cart__card {
  background: #fff;
  border: 1px solid #b8cdd8;
  border-top: 3px solid var(--color-ocean-main);
  box-shadow: 0 2px 12px rgba(0,0,0,.07);
}
.section--white .pb-prog-cart__h3,
.section--sand  .pb-prog-cart__h3  { color: var(--color-ocean); }
.section--white .pb-prog-cart__desc,
.section--sand  .pb-prog-cart__desc { color: var(--color-text-muted); }
.section--dark .pb-prog-cart__card,
.section--ocean .pb-prog-cart__card {
  background: rgba(255,255,255,0.1);
  border-top-color: var(--color-ocean-light);
  box-shadow: none;
}
.section--dark .pb-prog-cart__num,
.section--ocean .pb-prog-cart__num { color: var(--color-ocean-light); opacity: 0.6; }
.section--dark .pb-prog-cart__h3,
.section--ocean .pb-prog-cart__h3  { color: white; }
.section--dark .pb-prog-cart__desc,
.section--ocean .pb-prog-cart__desc { color: rgba(255,255,255,0.65); }
.section--dark .pb-prog-cart__sub,
.section--ocean .pb-prog-cart__sub { color: var(--color-ocean-light); }
.section--dark .pb-prog-cart__note,
.section--ocean .pb-prog-cart__note { color: rgba(255,255,255,0.55); }

/* ── BILAN DE SÉJOUR ── */
.pb-bilan__inner {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 4rem;
  align-items: start;
}
.pb-bilan__contexte {
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-bottom: 1.25rem;
  padding: 0.5rem 0.9rem;
  background: rgba(27,94,138,0.08);
  border-radius: 3px;
  display: inline-block;
}
.pb-bilan__resultats {
  display: flex; flex-wrap: wrap; gap: 1.5rem;
  margin-top: 2rem; padding-top: 1.5rem;
  border-top: 1px solid rgba(0,0,0,0.1);
}
.pb-bilan__resultat { display: flex; flex-direction: column; gap: 0.15rem; }
.pb-bilan__res-val {
  font-family: var(--font-serif); font-size: 1.8rem;
  color: var(--color-ocean-main); line-height: 1;
}
.pb-bilan__res-lbl {
  font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--color-text-muted);
}
.pb-bilan__img {
  margin: 0; border-radius: 8px; overflow: hidden;
  position: sticky; top: calc(var(--header-height) + 2rem);
}
.pb-bilan__img img { width: 100%; height: 420px; object-fit: cover; display: block; }
@media (max-width: 900px) {
  .pb-bilan__inner { grid-template-columns: 1fr; }
  .pb-bilan__img { position: static; }
  .pb-bilan__img img { height: 280px; }
}

/* ── DATES DES SÉJOURS ── */
.pb-dates__intro {
  color: rgba(255,255,255,0.7); font-size: 1rem; line-height: 1.7;
  max-width: 640px; margin-bottom: 2.5rem;
}
.pb-dates__grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem; margin-bottom: 2.5rem;
}
.pb-dates__card {
  background: rgba(255,255,255,0.07);
  border-radius: 8px; padding: 1.75rem;
  border-left: 3px solid var(--color-ocean-light);
  display: flex; flex-direction: column; gap: 0.6rem;
}
.pb-dates__card-header {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
}
.pb-dates__statut { font-size: 0.78rem; font-weight: 600; color: rgba(255,255,255,0.85); }
.pb-dates__places {
  font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--color-ocean-light); font-weight: 500;
}
.pb-dates__h3 {
  font-family: var(--font-serif); font-size: 1.35rem;
  color: white; margin: 0; line-height: 1.2;
}
.pb-dates__dest { font-size: 0.8rem; color: var(--color-ocean-light); margin: 0; }
.pb-dates__desc { font-size: 0.88rem; color: rgba(255,255,255,0.65); line-height: 1.6; margin: 0; }
.pb-dates__prix {
  font-size: 0.9rem; font-weight: 600; color: var(--color-ocean-light); margin: 0.25rem 0 0;
}
.pb-dates__cta { display: flex; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .pb-intro__grid { grid-template-columns: 1fr; }
  .info-card { position: static; order: -1; }
  .pb-ti__grid  { grid-template-columns: 1fr; }
  .pb-ti__grid[data-pos="left"] .pb-ti__fig { order: 0; }
  .galerie-grid { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 900px) {
