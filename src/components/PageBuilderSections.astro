---
import { stegaClient, client } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'
import MatierielBtn from './MatierielBtn.astro'

const builder = imageUrlBuilder(stegaClient)
const urlFor  = (source: any) => {
  const b = builder.image(source)
  const hs = source?.hotspot
  return (hs?.x != null && hs?.y != null) ? b.focalPoint(hs.x, hs.y) : b
}

// ── Rendu Portable Text ───────────────────────────────────────────────────────
function spanHtml(b: any): string {
  return (b.children || []).map((span: any) => {
    let t = (span.text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    if (span.marks?.includes('strong')) t = `<strong>${t}</strong>`
    if (span.marks?.includes('em'))     t = `<em>${t}</em>`
    const linkKey = (span.marks || []).find((m: any) => m?.length > 5)
    if (linkKey) {
      const href = b.markDefs?.find((d: any) => d._key === linkKey)?.href
      if (href) t = `<a href="${href}">${t}</a>`
    }
    return t
  }).join('')
}

function blocks(content: any[]): string {
  if (!content?.length) return ''
  let out = '', i = 0
  while (i < content.length) {
    const b = content[i]
    if (b._type !== 'block') {
      if (b._type === 'image' && b.asset) {
        const u = urlFor(b).width(900).url()
        out += `<figure><img src="${u}" alt="${b.alt || ''}" loading="lazy"/></figure>`
      }
      i++; continue
    }
    if (b.listItem) {
      const tag = b.listItem === 'number' ? 'ol' : 'ul'
      out += `<${tag} class="pb-list pb-list--${b.listItem}">`
      while (i < content.length && content[i]._type === 'block' && content[i].listItem === b.listItem) {
        out += `<li>${spanHtml(content[i])}</li>`
        i++
      }
      out += `</${tag}>`
      continue
    }
    const tag: Record<string,string> = { h2:'h2', h3:'h3', blockquote:'blockquote', normal:'p' }
    const el = tag[b.style] || 'p'
    out += `<${el} class="pb-${el}">${spanHtml(b)}</${el}>`
    i++
  }
  return out
}

// ── Fond de section ───────────────────────────────────────────────────────────
const bgClass: Record<string,string> = {
  white: 'section--white',
  sand:  'section--sand',
  mist:  'section--mist',
  dark:  'section--dark',
  ocean: 'section--ocean',
}
const bg = (fond: string) => bgClass[stegaClean(fond) ?? ''] ?? ''

// ── YouTube ID ────────────────────────────────────────────────────────────────
const ytId = (url: string) =>
  url?.match(/(?:v=|youtu\.be\/|embed\/)([a-zA-Z0-9_-]{11})/)?.[1]
  ?? (url?.match(/^[a-zA-Z0-9_-]{11}$/) ? url : null)

// ── Helpers hero ──────────────────────────────────────────────────────────────
const heroHeight = (h: string) => {
  const v = stegaClean(h)
  return v === 'medium' ? '52vh' : v === 'compact' ? '36vh' : '72vh'
}

// Curseur "Épaisseur du voile bleu" (sectionHero.voile, 0–100) → multiplicateur
// appliqué aux alphas du dégradé. 50 = réglage d'origine (×1), d'où le /50 :
// un hero sans le champ (undefined) rend donc exactement comme avant.
const voileMult = (v: any) => {
  const n = typeof v === 'number' && Number.isFinite(v) ? v : 50
  return Math.min(100, Math.max(0, n)) / 50
}
// Alpha borné à 1 : au-delà de 50 le voile densifie jusqu'à l'aplat opaque.
const voileAlpha = (base: number, k: number) => +Math.min(1, base * k).toFixed(3)

const heroBg = (image: any, voile?: any) => {
  if (!image?.asset) return 'background:var(--color-ocean)'
  // On sert l'image à pleine largeur sans crop CDN,
  // et on laisse background-position CSS gérer le hotspot (plus fiable que crop=focalpoint)
  const url = urlFor(image).width(1600).auto('format').url()
  const hs = image?.hotspot
  const bgPos = (hs?.x != null && hs?.y != null)
    ? `${Math.round(hs.x * 100)}% ${Math.round(hs.y * 100)}%`
    : 'center'
  const k = voileMult(voile)
  return `background:linear-gradient(to top,rgba(7,24,31,${voileAlpha(.88, k)}) 0%,rgba(13,43,62,${voileAlpha(.45, k)}) 60%,rgba(13,43,62,${voileAlpha(.3, k)}) 100%),url(${url}) ${bgPos}/cover no-repeat`
}

interface Props {
  sections?: any[]
  pageTitle?: string
  lang?: 'fr' | 'en'
  /** Articles du maillage intelligent — utilisés par sectionBlog en mode "liés à cette page" */
  articlesLies?: any[]
}

const { sections, pageTitle = '', lang = 'fr', articlesLies = [] } = Astro.props

// Prefix internal links with /en when rendering the EN version
const pfx = (href: string | undefined): string | undefined =>
  lang === 'en' && href?.startsWith('/') && !href.startsWith('/en')
    ? '/en' + href : href

const hasPartenaires = (sections ?? []).some((s: any) => s._type === 'sectionPartenaires')
const partenaires: any[] = hasPartenaires
  ? await client.fetch(`*[_type == "partenaire"] | order(orderRank asc) { _id, nom, nomComplet, tag, tagEn, description, descriptionEn, url, labelLien, logo { asset->{ url } } }`)
  : []

const hasRevuePresse = (sections ?? []).some((s: any) => s._type === 'sectionRevuePresse')
const revuePresse: any[] = hasRevuePresse
  ? await client.fetch(`*[_type == "revuePresse"] | order(orderRank asc) { _id, magazine, numero, date, annee, titre, description, type, cover { asset->{ url } }, photos[] { asset->{ url }, alt }, fichierPdf { asset->{ url, originalFilename } }, lien, labelLien }`)
  : []

// Coordonnées (⚙️ Paramètres, éditable par JBV) — encarts d'infos et CTA
const hasContactUse = (sections ?? []).some((s: any) => s._type === 'sectionIntro' || s._type === 'sectionCta')
const contactParams = hasContactUse
  ? await client.fetch(`*[_type == "parametres"][0]{ telephone, email }`)
  : null
const contactTel   = contactParams?.telephone || '06 87 30 34 56'
const contactEmail = contactParams?.email     || 'enjoy.fishing@hotmail.fr'

// FAQ : si plusieurs sections FAQ sur une même page, un SEUL bloc JSON-LD
// FAQPage est émis (sur la première), regroupant toutes les questions.
const faqSectionsAll = (sections ?? []).filter((s: any) => s._type === 'sectionFaq')
const firstFaqKey = faqSectionsAll[0]?._key

// Produits boutique — utilisés par sectionProduits (mise en avant)
const hasProduitsSection = (sections ?? []).some((s: any) => s._type === 'sectionProduits')
const produitsBruts: any[] = hasProduitsSection
  ? await client.fetch(`
    *[_type == "produit" && disponible == true] | order(coalesce(dateAjout, _createdAt) desc) {
      _id, title, titleEn, "slug": slug.current, prix, categorie, espece, badges, stock,
      "dateAjout": coalesce(dateAjout, _createdAt),
      "image": images[0]{ _type, hotspot, crop, asset->{ _id, url } },
      "variantes": variantes[]{ prix, stock }
    }
  `)
  : []
// En mode aperçu, stega encode des caractères invisibles dans les chaînes :
// on nettoie celles qui servent à filtrer/router (les titres restent encodés
// pour garder les overlays cliquables dans Sanity).
const produitsBoutique: any[] = produitsBruts.map((p: any) => ({
  ...p,
  slug:      stegaClean(p.slug),
  categorie: stegaClean(p.categorie),
  espece:    stegaClean(p.espece),
  badges:    (p.badges ?? []).map((b: any) => stegaClean(b)),
}))

const hasBlogSection = (sections ?? []).some((s: any) => s._type === 'sectionBlog')
const blogArticles: any[] = hasBlogSection
  ? await client.fetch(`
    *[_type == "article"] | order(date desc) {
      _id, title, titleEn, "slug": slug.current, date, espece,
      image { _type, hotspot, crop, asset->{ _id, url } }
    }
  `)
  : []

const hasVoyagesGrid = (sections ?? []).some((s: any) => s._type === 'sectionVoyagesGrid')
const voyagesForGrid: any[] = hasVoyagesGrid
  ? await client.fetch(`
    *[_type == "voyage"] {
      _id, title, slug, pays, periode, especes,
      "displayTitle":   coalesce(pagebuilder[_type == "sectionHero"][0].titre, title),
      "tagline":        coalesce(pagebuilder[_type == "sectionHero"][0].sousTitre, especes),
      "region":         pagebuilder[_type == "sectionHero"][0].eyebrow,
      "heroImage":      pagebuilder[_type == "sectionHero"][0].image { _type, hotspot, crop, asset->{ _id, url } },
      "displayTitleEn": coalesce(pagebuilderEn[_type == "sectionHero"][0].titre, title),
      "taglineEn":      coalesce(pagebuilderEn[_type == "sectionHero"][0].sousTitre, especes),
      "regionEn":       pagebuilderEn[_type == "sectionHero"][0].eyebrow,
    }
  `)
  : []
---

{sections?.map((s: any) => (
  <>
  {/* ════════════ HERO ════════════ */}
  {s._type === 'sectionHero' && (
    <section class="pb-hero" style={`min-height:${heroHeight(s.hauteur)}`}>
      {ytId(stegaClean(s.videoYoutubeUrl) || '') ? (() => {
              const vid   = ytId(stegaClean(s.videoYoutubeUrl) || '')!
              const debut = s.videoYoutubeDebut ?? 0
              const fin   = s.videoYoutubeFin
              const params = new URLSearchParams({
                autoplay: '1', mute: '1',
                controls: '0', rel: '0', iv_load_policy: '3',
                modestbranding: '1', playsinline: '1', disablekb: '1',
                enablejsapi: '1',
                start: String(debut),
                ...(fin != null ? { end: String(fin) } : {}),
              })
              // Le poster porte SON PROPRE voile (curseur photo) : il est peint
              // au-dessus de .pb-hero__overlay (z-index 1 vs auto), donc le voile
              // vidéo ne l'atteint jamais. Sans ce dégradé cuit dedans, la photo
              // resterait nue tant que la vidéo n'a pas démarré.
              const posterStyle = s.image?.asset ? heroBg(s.image, s.voile) : null
              const loopScript = `(function(){
                function init(){
                  if(typeof YT==='undefined'||!YT.Player){setTimeout(init,150);return;}
                  new YT.Player('yt-hero-player',{events:{
                    onReady:function(e){e.target.setPlaybackQuality('highres');},
                    onStateChange:function(e){
                      if(e.data===1){
                        e.target.setPlaybackQuality('highres');
                        setTimeout(function(){
                          var p=document.getElementById('yt-hero-poster');
                          if(p){p.style.opacity='0';setTimeout(function(){p.style.display='none';},900);}
                        },2500);
                      }
                      if(e.data===0){e.target.seekTo(${debut},true);e.target.playVideo();}
                    }
                  }});
                }
                if(!document.getElementById('yt-api')){
                  var s=document.createElement('script');
                  s.id='yt-api';s.src='https://www.youtube.com/iframe_api';
                  document.head.appendChild(s);
                }
                var prev=window.onYouTubeIframeAPIReady;
                window.onYouTubeIframeAPIReady=function(){if(prev)prev();init();};
                if(typeof YT!=='undefined'&&YT.Player)init();
              })();`
              return (
                <>
                  <div class="pb-hero__yt-wrapper">
                    <iframe
                      id="yt-hero-player"
                      class="pb-hero__yt-iframe"
                      src={`https://www.youtube-nocookie.com/embed/${vid}?${params}`}
                      allow="autoplay; encrypted-media"
                      title="hero video"
                    />
                    <script is:inline set:html={loopScript} />
                  </div>
                  <div
                    id="yt-hero-poster"
                    class="pb-hero__yt-poster"
                    style={posterStyle ?? ''}
                  />
                  <div class="pb-hero__overlay" style={`--voile-k:${voileMult(s.voileVideo)}`}></div>
                </>
              )
            })() : stegaClean(s.videoUrl) ? (
        <>
          <video
            class="pb-hero__video"
            autoplay loop muted playsinline
            poster={s.image?.asset ? urlFor(s.image).width(1600).height(900).fit('crop').crop('focalpoint').url() : undefined}
          >
            {stegaClean(s.videoWebmUrl) && <source src={stegaClean(s.videoWebmUrl)} type="video/webm" />}
            <source src={stegaClean(s.videoUrl)} type="video/mp4" />
          </video>
          {/* Vidéo MP4 : le poster est natif (attribut poster), rendu par
              l'élément <video> lui-même — impossible de le voiler à part.
              L'overlay porte donc le voile vidéo pour les deux. */}
          <div class="pb-hero__overlay" style={`--voile-k:${voileMult(s.voileVideo)}`}></div>
        </>
      ) : (
        <div class="pb-hero__bg" style={heroBg(s.image, s.voile)}></div>
      )}
      <div class="pb-hero__content container">
        {s.badges?.length > 0 && (
          <div class="pb-hero__badges">
            {s.badges.map((b: any) => (
              <span class={`pb-hero__badge${b.style === 'mouche' ? ' pb-hero__badge--mouche' : ''}`}>{b.texte}</span>
            ))}
          </div>
        )}
        {s.eyebrow && <p class="pb-eyebrow">{s.eyebrow}</p>}
        <h1 class="pb-hero__h1">{s.titre}</h1>
        {s.sousTitre && <p class="pb-hero__sub">{s.sousTitre}</p>}
        <div class="pb-hero__cta">
          {stegaClean(s.btnReserverTexte) && (
            <a href={pfx(s.btnReserverLien || '/contact')} class="btn-prim">{s.btnReserverTexte}</a>
          )}
          {stegaClean(s.btnTelTexte) && (
            <a href={`tel:${stegaClean(s.btnTelTexte).replace(/\s/g,'')}`} class="btn-ghost">{s.btnTelTexte}</a>
          )}
          {s.btnMaterielLien && (
            <MatierielBtn href={pfx(s.btnMaterielLien)} label={s.btnMaterielLabel || 'Matériel'} />
          )}
          {stegaClean(s.btnYoutubeLien) && (
            <a href={stegaClean(s.btnYoutubeLien)} class="btn-youtube" target="_blank" rel="noopener noreferrer">
              <svg class="btn-youtube__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="currentColor"/>
              </svg>
              {s.btnYoutubeTexte || "S'abonner à ma chaîne"}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ INTRO + INFO CARD ════════════ */}
  {s._type === 'sectionIntro' && (
    <section class={`section pb-intro ${bg(s.fond)||''}`}>
      <div class="container pb-intro__grid">
        <div class="pb-intro__left">
          <div class="pb-intro__body">
            {stegaClean(s.eyebrow) && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
            {stegaClean(s.titre)   && <h2 class="pb-intro__h2">{s.titre}</h2>}
            <div class="prose" set:html={blocks(s.texte)} />
          </div>
          {s.intervenant?.nom && (
            <div class="expert-card">
              {s.intervenant.avatar && (
                <div class="expert-card__avatar">{s.intervenant.avatar}</div>
              )}
              <div>
                <strong class="expert-card__name">{s.intervenant.nom}</strong>
                {s.intervenant.titre && (
                  <span class="expert-card__title">{s.intervenant.titre}</span>
                )}
                {s.intervenant.bio && (
                  <p class="expert-card__bio">{s.intervenant.bio}</p>
                )}
              </div>
            </div>
          )}
        </div>
        {s.showInfoCard !== false && (
          <aside>
            <div class="info-card">
              {s.niveau && <><p class="info-lbl">{lang === 'en' ? 'Level'    : 'Niveau'}</p><p class="info-val">{s.niveau}</p></>}
              {s.format && <><p class="info-lbl">Format</p>                                     <p class="info-val">{s.format}</p></>}
              {s.saison && <><p class="info-lbl">{lang === 'en' ? 'Season'   : 'Saison'}</p><p class="info-val">{s.saison}</p></>}
              {s.tarif  && <><p class="info-lbl">{lang === 'en' ? 'Rate'     : 'Tarif'}</p> <p class="info-val">{s.tarif}</p></>}
              {s.duree  && <><p class="info-lbl">{lang === 'en' ? 'Duration' : 'Durée'}</p> <p class="info-val">{s.duree}</p></>}
              {s.lignesSupp?.map((l: any) => l.label && (
                <>
                  <p class="info-lbl">{l.label}</p>
                  <p class="info-val">{l.valeur}</p>
                  {stegaClean(l.note) && <p class="info-note">{l.note}</p>}
                </>
              ))}
              {s.afficherContact !== false && (
                <>
                  <p class="info-lbl">Contact</p>
                  <p class="info-val">{contactTel}<br/>{contactEmail}</p>
                </>
              )}
              {s.boutons?.map((btn: any) => (
                <a href={pfx(btn.lien)} class="info-card-btn">{btn.texte}</a>
              ))}
            </div>
          </aside>
        )}
      </div>
    </section>
  )}

  {/* ════════════ CARDS ════════════ */}
  {s._type === 'sectionCards' && (
    <section class="pb-cards">
      {s.titre && <div class="container" style="padding-top:3rem"><h2 class="pb-section-titre">{s.titre}</h2></div>}
      <div class="sous-grid" data-count={s.cards?.length}>
        {s.cards?.map((c: any, i: number) => {
          const isLast   = i === s.cards.length - 1
          const isOdd    = s.cards.length % 2 === 1
          const cardImgUrl = c.image?.asset ? urlFor(c.image).width(1400).quality(85).url() : null
          const hs = c.image?.hotspot
          const cardImgPos = (hs?.x != null && hs?.y != null)
            ? `${(hs.x * 100).toFixed(1)}% ${(hs.y * 100).toFixed(1)}%`
            : (stegaClean(c.positionPhoto) || 'center center')
          return (
            <a href={pfx(c.lien)||'#'} class:list={['wf-card', isOdd&&isLast&&'wf-card--wide']}>
              <div class="wf-card-bg" style={cardImgUrl ? `background-image:url(${cardImgUrl});background-position:${cardImgPos}` : ''}></div>
              <div class="wf-overlay"></div>
              <div class="wf-body">
                {c.sousTitre && <span class="wf-sub">{c.sousTitre}</span>}
                <strong class="wf-label">{c.titre}</strong>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  )}

  {/* ════════════ CARDS STYLE 2 ════════════ */}
  {s._type === 'sectionCards2' && (
    <section class={`pb-cards2 ${bg(s.fond)||''}`}>
      {(s.eyebrow || s.titre) && (
        <div class="container pb-cards2__header">
          {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
          {s.titre   && <h2 class="pb-section-titre">{s.titre}</h2>}
        </div>
      )}
      <div class="pb-cards2__grid" style={`grid-template-columns:repeat(${stegaClean(s.colonnes)||4},1fr)`}>
        {s.cards?.map((c: any) => {
          const cardImgUrl = c.image?.asset ? urlFor(c.image).width(1400).quality(85).url() : null
          const hs2 = c.image?.hotspot
          const cardImgPos2 = (hs2?.x != null && hs2?.y != null)
            ? `${(hs2.x * 100).toFixed(1)}% ${(hs2.y * 100).toFixed(1)}%`
            : (stegaClean(c.positionPhoto) || 'center center')
          return (
            <a href={pfx(c.lien)||'#'} class="wf-card">
              <div class="wf-card-bg" style={cardImgUrl ? `background-image:url(${cardImgUrl});background-position:${cardImgPos2}` : ''}></div>
              <div class="wf-overlay"></div>
              <div class="wf-body">
                {c.sousTitre && <span class="wf-sub">{c.sousTitre}</span>}
                <strong class="wf-label">{c.titre}</strong>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  )}

  {/* ════════════ GRILLE WILD FLY — style 3 ════════════ */}
  {s._type === 'sectionCards3' && (() => {
    // stegaClean = test de vide uniquement ; on rend l'original (overlays aperçu)
    const eyebrow = stegaClean(s.eyebrow) ? s.eyebrow : ''
    const titre   = stegaClean(s.titre)   ? s.titre   : ''
    const rawCartes: any[] = s.cartes ?? []
    // Carte isLarge en premier pour le positionnement CSS
    const li = rawCartes.findIndex((c: any) => c.isLarge)
    const cartes = [...rawCartes]
    if (li > 0) { const [lg] = cartes.splice(li, 1); cartes.unshift(lg) }
    return (
      <section class="wf3-section">
        {(eyebrow || titre) && (
          <div class="wf3-header container">
            {eyebrow && <p class="pb-eyebrow">{eyebrow}</p>}
            {titre   && <h2 class="wf3-titre">{titre}</h2>}
          </div>
        )}
        <div class="wf3-grid">
          {cartes.map((c: any, i: number) => {
            const img = c.image?.asset ? urlFor(c.image).width(1400).quality(85).url() : null
            const hsWf3 = c.image?.hotspot
            const posWf3 = (hsWf3?.x != null && hsWf3?.y != null)
              ? `${(hsWf3.x * 100).toFixed(1)}% ${(hsWf3.y * 100).toFixed(1)}%`
              : 'center center'
            return (
              <a href={pfx(stegaClean(c.lien)) || '#'} class={`wf3-card${i === 0 ? ' wf3-card--large' : ''}`}>
                {img && <div class="wf3-card__bg" style={`background-image:url(${img});background-position:${posWf3}`}></div>}
                <div class="wf3-overlay"></div>
                <div class="wf3-body">
                  {c.sousTitre && <span class="wf3-sub">{c.sousTitre}</span>}
                  {c.label     && <strong class="wf3-label">{c.label}</strong>}
                </div>
              </a>
            )
          })}
        </div>
      </section>
    )
  })()}

  {/* ════════════ TEXTE ════════════ */}
  {s._type === 'sectionTexte' && (
    <section class={`section pb-texte ${bg(s.fond)||''}`}>
      <div class="container" style={`max-width:${s.largeur==='wide'?'960px':s.largeur==='full'?'var(--max-width)':'760px'}`}>
        <div class="prose" set:html={blocks(s.texte)} />
      </div>
    </section>
  )}

  {/* ════════════ TEXTE + IMAGE ════════════ */}
  {s._type === 'sectionTexteImage' && (
    <section class={`section pb-ti ${bg(s.fond)||''}`}>
      <div class="container pb-ti__grid" data-pos={stegaClean(s.imagePosition)||'right'}>
        <div class="pb-ti__text">
          {stegaClean(s.eyebrow) && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
          {stegaClean(s.titre) && <h2 class="pb-ti__h2">{s.titre}</h2>}
          <div class="prose" set:html={blocks(s.texte)} />
          {s.distances?.length > 0 && (
            <div class="pb-ti__chips">
              {s.distances.map((d: string) => (
                <span class="pb-ti__chip">{d}</span>
              ))}
            </div>
          )}
        </div>
        {(s.image?.asset || s.texteImageUrl) && (
          <figure class="pb-ti__fig">
            {s.image?.asset
              ? <img src={urlFor(s.image).width(680).height(520).fit('crop').crop('focalpoint').url()} alt={s.image?.alt || ''} loading="lazy" />
              : <img src={`${s.texteImageUrl}?w=680&fit=crop`} alt={s.image?.alt || ''} loading="lazy" />
            }
          </figure>
        )}
      </div>
    </section>
  )}

  {/* ════════════ GALERIE ════════════ */}
  {s._type === 'sectionGalerie' && (
    <section class={`section pb-galerie ${bg(s.fond)||'section--mist'}`}>
      <div class="container">
        {s.titre && <h2 class="pb-section-titre">{s.titre}</h2>}
        <div class="galerie-grid" style={`grid-template-columns:repeat(${stegaClean(s.colonnes)||3},1fr)`}>
          {s.photos?.map((p: any) => (
            <img src={urlFor(p).width(600).height(450).fit('crop').crop('focalpoint').url()} alt={p.alt||''} loading="lazy" class="galerie-img"/>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ VIDÉO ════════════ */}
  {s._type === 'sectionVideo' && ytId(s.url) && (
    <section class={`section pb-video2 ${bg(s.fond)||''}`}>
      <div class={`container pb-video2__grid${stegaClean(s.videoPosition)==='right' ? ' pb-video2__grid--rev' : ''}`}>
        <div class="pb-video2__player">
          <div class="video-wrap">
            <iframe
              src={`https://www.youtube.com/embed/${ytId(s.url)}`}
              title={s.titre || pageTitle}
              allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
        <div class="pb-video2__text">
          {s.eyebrow && <p class="pb-video2__eyebrow">{s.eyebrow}</p>}
          {s.titre   && <h2 class="pb-video2__titre">{s.titre}</h2>}
          {s.description && <p class="pb-video2__desc">{s.description}</p>}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ INFOS CLÉS BANDEAU ════════════ */}
  {s._type === 'sectionStats' && (
    <div class={`pb-bandeau ${bg(s.fond)||'section--dark'}`}>
      <div class="pb-bandeau__grid">
        {s.stats?.map((st: any) => (
          <div class="pb-bandeau__item">
            <strong class="pb-bandeau__titre">{st.nombre}</strong>
            <span   class="pb-bandeau__sub">{st.label}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  {/* ════════════ PROGRAMME / ÉTAPES ════════════ */}
  {s._type === 'sectionProgramme' && (
    <section class={`section pb-prog ${bg(s.fond)||'section--sand'}`}>
      <div class="container">
        {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
        {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
        {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
        <div class="pb-prog__rows">
          {s.etapes?.map((etape: any, i: number) => {
            const imgUrl = etape.image?.asset
              ? urlFor(etape.image).width(1200).url()
              : null
            const hp = etape.image?.hotspot
            const objPos = hp
              ? `${Math.round(stegaClean(hp.x) * 100)}% ${Math.round(stegaClean(hp.y) * 100)}%`
              : 'center center'
            return (
              <div class:list={['pb-prog__row', i % 2 === 1 && 'pb-prog__row--rev']}>
                <div class="pb-prog__img">
                  {imgUrl && <img src={imgUrl} alt={etape.image?.alt || etape.titre || ''} loading="lazy" style={`object-position:${objPos}`} />}
                </div>
                <div class="pb-prog__body">
                  <div class="pb-prog__num">{String(i + 1).padStart(2, '0')}</div>
                  <h3>{etape.titre}</h3>
                  {etape.tag && <span class="pb-prog__tag">{etape.tag}</span>}
                  <div class="pb-prog__text prose" set:html={blocks(etape.texte)} />
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ PROGRAMME SANS IMAGE ════════════ */}
  {s._type === 'sectionProgrammeTexte' && (
    <section class={`section pb-prog-txt ${bg(s.fond)||'section--sand'}`}>
      <div class="container">
        {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
        {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
        {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
        <div class="pb-prog-txt__grid">
          {s.colonnes?.map((col: any) => {
            const isCheck = stegaClean(col.style) === 'check'
            return (
              <div class="pb-prog-txt__card">
                {col.label && <div class="pb-prog-txt__label">{col.label}</div>}
                <ul class:list={['pb-prog-txt__list', isCheck && 'pb-prog-txt__list--check']}>
                  {col.items?.map((item: any) => (
                    <li class:list={[isCheck && (item.inclus !== false ? 'ok' : 'no')]}>
                      {item.texte}
                    </li>
                  ))}
                </ul>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ MISE EN PAGE D'INFO ════════════ */}
  {s._type === 'sectionProgrammeCartes' && (() => {
    const imgUrl = s.image?.asset ? urlFor(s.image).width(560).height(460).fit('crop').crop('focalpoint').url() : null
    return (
      <section class={`section pb-prog-cart ${bg(s.fond)||'section--sand'}`}>
        <div class="container">
          {imgUrl ? (
            <div class="pb-prog-cart__header" data-pos={stegaClean(s.imagePosition)||'left'}>
              <figure class="pb-prog-cart__header-img">
                <img src={imgUrl} alt={s.image?.alt || s.titre || ''} loading="lazy" />
              </figure>
              <div class="pb-prog-cart__header-text">
                {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
                {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
                {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
              </div>
            </div>
          ) : (
            <>
              {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
              {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
              {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
            </>
          )}
          <div class="pb-prog-cart__grid" style={`grid-template-columns:repeat(${stegaClean(s.colonnes)||3},1fr)`}>
            {s.items?.map((item: any, i: number) => (
              <div class="pb-prog-cart__card">
                <span class="pb-prog-cart__num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="pb-prog-cart__h3">{item.titre}</h3>
                {item.sousTitre && <p class="pb-prog-cart__sub">{item.sousTitre}</p>}
                {item.description && <p class="pb-prog-cart__desc">{item.description}</p>}
              </div>
            ))}
          </div>
          {s.note && <p class="pb-prog-cart__note">{s.note}</p>}
          {s.btnTexte && (s.btnFichier?.asset?.url || s.btnLien) && (
            <div class="pb-prog-cart__btn-wrap">
              <a href={s.btnFichier?.asset?.url || s.btnLien} class="btn-download" download={!!s.btnFichier?.asset?.url}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                {s.btnTexte}
              </a>
            </div>
          )}
        </div>
      </section>
    )
  })()}

  {/* ════════════ SÉLECTION ════════════ */}
  {s._type === 'sectionSelection' && (
    <section class={`section pb-sel ${bg(s.fond)||'section--white'}`}>
      <div class="container">
        {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
        {s.titre   && <h2 class="pb-prog__h2">{s.titre}</h2>}
        {s.intro   && <p class="pb-prog__intro">{s.intro}</p>}
        <div class="pb-sel__list">
          {s.items?.map((item: any, i: number) => {
            const imgUrl = item.image?.asset
              ? urlFor(item.image).width(900).height(700).fit('crop').crop('focalpoint').url()
              : null
            const isReverse = i % 2 === 1
            const bodySand  = stegaClean(s.styleCorps) !== 'white'
            return (
              <div class:list={['pb-sel__block', isReverse && 'pb-sel__block--rev']}>
                <div class="pb-sel__img">
                  {imgUrl && <img src={imgUrl} alt={item.image?.alt || item.titre || ''} loading="lazy" />}
                </div>
                <div class:list={['pb-sel__body', bodySand && 'pb-sel__body--sand']}>
                  {item.tag && <p class="pb-sel__tag">{item.tag}</p>}
                  <h3 class="pb-sel__h3">{item.titre}</h3>
                  <div class="pb-sel__text prose" set:html={blocks(item.texte)} />
                  {item.pills?.length > 0 && (
                    <ul class="pb-sel__pills">
                      {item.pills.map((p: string) => <li>{p}</li>)}
                    </ul>
                  )}
                  {item.infos?.length > 0 && (
                    <div class="pb-sel__infos">
                      {item.infos.map((inf: any) => (
                        <div class="pb-sel__info-item">
                          <span class="pb-sel__info-lbl">{inf.label}</span>
                          <span class="pb-sel__info-val">{inf.valeur}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ BILAN DE SÉJOUR ════════════ */}
  {s._type === 'sectionBilan' && (() => {
    const imgUrl = s.image?.asset ? urlFor(s.image).width(680).height(520).fit('crop').crop('focalpoint').url() : null
    return (
      <section class={`section pb-bilan ${bg(s.fond)||'section--sand'}`}>
        <div class="container pb-bilan__inner">
          <div class="pb-bilan__text">
            {s.eyebrow  && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
            {s.titre    && <h2 class="pb-prog__h2">{s.titre}</h2>}
            {s.contexte && <p class="pb-bilan__contexte">{s.contexte}</p>}
            <div class="prose" set:html={blocks(s.texte)} />
            {s.resultats?.length > 0 && (
              <div class="pb-bilan__resultats">
                {s.resultats.map((r: any) => (
                  <div class="pb-bilan__resultat">
                    <span class="pb-bilan__res-val">{r.valeur}</span>
                    <span class="pb-bilan__res-lbl">{r.label}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
          {imgUrl && (
            <figure class="pb-bilan__img">
              <img src={imgUrl} alt={s.image?.alt || s.titre || ''} loading="lazy" />
            </figure>
          )}
        </div>
      </section>
    )
  })()}

  {/* ════════════ DATES DES SÉJOURS ════════════ */}
  {s._type === 'sectionDates' && (
    <section class={`section pb-dates ${bg(s.fond)||'section--dark'}`}>
      <div class="container">
        {s.eyebrow && <p class="pb-eyebrow-sm">{s.eyebrow}</p>}
        {s.titre   && <h2 class="pb-dates__h2">{s.titre}</h2>}
        {s.intro   && <p class="pb-dates__intro">{s.intro}</p>}
        <div class="pb-dates__grid">
          {s.sejours?.map((sej: any) => {
            const statut = stegaClean(sej.statut) || 'disponible'
            const icons = { disponible: '🟢', 'peu-de-places': '🟡', complet: '🔴', 'liste-attente': '⏳' } as const
            const labels = lang === 'en'
              ? { disponible: 'Available', 'peu-de-places': 'Limited places', complet: 'Fully booked', 'liste-attente': 'Waitlist' } as const
              : { disponible: 'Disponible', 'peu-de-places': 'Quelques places', complet: 'Complet', 'liste-attente': "Liste d'attente" } as const
            return (
              <div class="pb-dates__card">
                <div class="pb-dates__card-header">
                  <span class="pb-dates__statut">{icons[statut]} {labels[statut]}</span>
                  {sej.placesDispo != null && statut !== 'complet' && (
                    <span class="pb-dates__places">{sej.placesDispo} place(s)</span>
                  )}
                </div>
                <h3 class="pb-dates__h3">{sej.dates}</h3>
                {sej.destination  && <p class="pb-dates__dest">{sej.destination}</p>}
                {sej.description  && <p class="pb-dates__desc">{sej.description}</p>}
                {sej.prix         && <p class="pb-dates__prix">{sej.prix}</p>}
              </div>
            )
          })}
        </div>
        {s.btnTexte && s.btnLien && (
          <div class="pb-dates__cta">
            <a href={pfx(s.btnLien)} class="btn-prim">{s.btnTexte}</a>
          </div>
        )}
      </div>
    </section>
  )}

  {/* ════════════ CTA FINAL ════════════ */}
  {s._type === 'sectionCta' && (
    <section class={`section pb-cta ${bg(s.style)||'section--dark'}`}>
      <div class="container pb-cta__inner">
        <div>
          <h2 class="pb-cta__h2" style={stegaClean(s.style)==='dark'||!s.style?'color:white':''}>{s.titre}</h2>
          {s.texte && <p class="pb-cta__sub">{s.texte}</p>}
        </div>
        <div class="pb-cta__btns">
          <a href={pfx(s.btn1Lien)||pfx('/contact')} class="btn-prim">{s.btn1Texte||'Me contacter'}</a>
          {s.btn2Texte && <a href={pfx(s.btn2Lien) || `tel:${contactTel.replace(/\s/g, '')}`} class="btn-ghost-light">{s.btn2Texte}</a>}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ TITRE DE SECTION ════════════ */}
  {s._type === 'sectionTitre' && (
    <section class={`pb-st ${bg(s.fond)||''}`}>
      <div class={`container pb-st__inner${stegaClean(s.alignement)==='left' ? ' pb-st__inner--left' : ''}`}>
        {s.eyebrow && <p class="pb-st__eyebrow">{s.eyebrow}</p>}
        <h2 class="pb-st__h2">{s.titre}</h2>
        {s.sousTitre && <p class="pb-st__sub">{s.sousTitre}</p>}
      </div>
    </section>
  )}

  {/* ════════════ BANNIÈRE + INFOCARD ════════════ */}
  {s._type === 'sectionBanniereCard' && (() => {
    const bgUrl = s.image?.asset
      ? urlFor(s.image).width(1600).height(700).fit('crop').url()
      : null
    const showCard = s.infocard?.afficher !== false && (s.infocard?.lignes?.length > 0 || s.infocard?.ctaTexte)
    return (
      <section class="bc-section">
        {bgUrl && <div class="bc-bg" style={`background-image:url(${bgUrl})`}></div>}
        <div class="bc-overlay"></div>
        <div class="container bc-inner" data-card={showCard ? 'true' : 'false'}>
          <div class="bc-content">
            {s.eyebrow && <p class="bc-eyebrow">{s.eyebrow}</p>}
            {s.titre   && <h2 class="bc-titre">{s.titre}</h2>}
            {s.texte   && <p class="bc-texte">{s.texte}</p>}
            {s.boutons?.length > 0 && (
              <div class="bc-actions">
                {s.boutons.map((b: any) => (
                  <a
                    href={pfx(stegaClean(b.lien)) || '#'}
                    class={`bc-btn bc-btn--${stegaClean(b.style) === 'ghost' ? 'ghost' : 'prim'}`}
                  >
                    {stegaClean(b.texte)}
                  </a>
                ))}
              </div>
            )}
          </div>
          {showCard && (
            <aside class="bc-aside">
              <div class="bc-card">
                {s.infocard.lignes?.map((l: any) => (
                  <>
                    {l.label  && <p class="bc-card__label">{l.label}</p>}
                    {l.valeur && <p class="bc-card__val">{l.valeur}</p>}
                  </>
                ))}
                {s.infocard.ctaTexte && (
                  <a href={pfx(stegaClean(s.infocard.ctaLien)) || '#'} class="bc-card__cta">
                    {stegaClean(s.infocard.ctaTexte)}
                  </a>
                )}
              </div>
            </aside>
          )}
        </div>
      </section>
    )
  })()}

  {/* ════════════ BANNIÈRE ════════════ */}
  {s._type === 'sectionBanniere' && (
    <div class={`pb-banniere pb-banniere--${stegaClean(s.style)||'ocean'}`}>
      {s.lien
        ? <a href={pfx(s.lien)} class="pb-banniere__inner container">{s.texte}</a>
        : <p class="pb-banniere__inner container">{s.texte}</p>
      }
    </div>
  )}

  {/* ════════════ CARROUSEL 3 IMAGES ════════════ */}
  {s._type === 'sectionCarrousel3Images' && (
    <section class={`pb-carr-outer ${bg(s.fond)||'section--dark'}`}>
      {s.titre && (
        <div class="container" style="padding-top:2.5rem;padding-bottom:1.5rem">
          <h2 class="pb-section-titre">{s.titre}</h2>
        </div>
      )}
      <div class="carr3-wrap" data-carr>
        <div class="carr3-track">
          {s.images?.map((img: any, i: number) => (
            <div class="carr3-slide" style={`aspect-ratio:${stegaClean(s.ratio)||'3/2'}`}>
              <img
                src={urlFor(img).width(1400).url()}
                alt={img.alt||''}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              {img.legende && <span class="carr3-caption">{img.legende}</span>}
            </div>
          ))}
        </div>
        <button class="carr3-btn carr3-btn--prev" aria-label="Précédent">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="carr3-btn carr3-btn--next" aria-label="Suivant">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
        </button>
        <div class="carr3-counter">1 / {s.images?.length || 0}</div>
      </div>
    </section>
  )}

  {/* ════════════ LIEN BLOG ════════════ */}
  {s._type === 'sectionLienBlog' && stegaClean(s.urlArticle) && (
    <section class={`section ${bg(s.fond)||'section--white'}`}>
      <div class="container pb-blog-section">
        <div class="pb-blog-card">
          <div class="pb-blog-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><path d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/></svg>
          </div>
          <div class="pb-blog-card__body">
            {stegaClean(s.eyebrow) && (
              <p class={`eyebrow${stegaClean(s.fond)==='dark' ? ' eyebrow--light' : ''}`}>{s.eyebrow}</p>
            )}
            <h3>{s.titre}</h3>
            {stegaClean(s.description) && <p>{s.description}</p>}
            <a href={stegaClean(s.urlArticle)} class="pb-blog-card__btn" target="_blank" rel="noopener noreferrer">
              {stegaClean(s.labelBouton) || "Lire l'article →"}
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* ════════════ BLOG — DERNIERS RÉCITS ════════════ */}
  {s._type === 'sectionBlog' && (() => {
    const mode = stegaClean(s.mode) || 'lies'
    const n = parseInt(stegaClean(s.nombre) || '3', 10) || 3
    let arts: any[] = []
    if (mode === 'manuel') {
      arts = (s.articlesChoisis ?? [])
        .map((r: any) => blogArticles.find((a: any) => a._id === (r._ref || r._id)))
        .filter(Boolean)
    } else if (mode === 'espece' && stegaClean(s.espece)) {
      arts = blogArticles.filter((a: any) => a.espece === stegaClean(s.espece))
    } else if (mode === 'lies' && articlesLies?.length) {
      arts = articlesLies
    } else {
      arts = blogArticles
    }
    arts = arts.slice(0, n)
    if (!arts.length) return null
    const base   = lang === 'en' ? '/en/blog' : '/blog'
    const locale = lang === 'en' ? 'en-GB' : 'fr-FR'
    const isDark = stegaClean(s.fond) === 'dark'
    return (
      <section class={`section pb-blogsec ${bg(s.fond)||'section--sand'}`}>
        <div class="container">
          <div class="pb-blogsec__head">
            <div>
              {stegaClean(s.eyebrow) && <p class={`pb-eyebrow-sm${isDark ? ' pb-blogsec__eyebrow--dark' : ''}`}>{s.eyebrow}</p>}
              <h2 class="pb-blogsec__titre">{s.titre || (lang === 'en' ? 'Latest fishing stories' : 'Derniers récits de pêche')}</h2>
            </div>
            {s.afficherLienBlog !== false && (
              <a href={base} class="pb-blogsec__all">{lang === 'en' ? 'All articles →' : 'Tous les articles →'}</a>
            )}
          </div>
          <div class="pb-blogsec__grid">
            {arts.map((a: any) => (
              <a href={`${base}/${a.slug?.current || a.slug}`} class="pb-blogsec__card">
                <div
                  class="pb-blogsec__img"
                  style={a.image
                    ? `background-image:url(${urlFor(a.image).width(500).height(320).fit('crop').crop('focalpoint').url()})`
                    : ''}
                ></div>
                <div class="pb-blogsec__body">
                  {a.date && (
                    <time class="pb-blogsec__date" datetime={a.date}>
                      {new Date(a.date).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' })}
                    </time>
                  )}
                  <h3 class="pb-blogsec__h3">{lang === 'en' ? (a.titleEn || a.title) : a.title}</h3>
                  <span class="pb-blogsec__lire">{lang === 'en' ? 'Read →' : 'Lire →'}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  })()}

  {/* ════════════ PRODUITS — MISE EN AVANT BOUTIQUE ════════════ */}
  {s._type === 'sectionProduits' && (() => {
    const mode = stegaClean(s.mode) || 'manuel'
    const n = parseInt(stegaClean(s.nombre) || '4', 10) || 4
    let prods: any[] = []
    if (mode === 'manuel') {
      prods = (s.produits ?? [])
        .map((r: any) => produitsBoutique.find((p: any) => p._id === (r._ref || r._id)))
        .filter(Boolean)
    } else if (mode === 'categorie') {
      prods = produitsBoutique.filter((p: any) => p.categorie === stegaClean(s.categorie)).slice(0, n)
    } else if (mode === 'espece') {
      prods = produitsBoutique.filter((p: any) => p.espece === stegaClean(s.espece)).slice(0, n)
    } else if (mode === 'tous') {
      prods = produitsBoutique.slice(0, n)
    } else {
      // vente · nouveaute · coup-coeur → pastilles cochées sur la fiche produit
      prods = produitsBoutique.filter((p: any) => (p.badges ?? []).includes(mode)).slice(0, n)
    }
    if (!prods.length) return null
    const isDark = stegaClean(s.fond) === 'dark'
    const fmtPrix = (v: number) => v.toFixed(2).replace('.', ',') + ' €'
    const BADGES = lang === 'en'
      ? { nouveaute: 'New', vente: 'Bestseller', 'coup-coeur': 'Favourite' }
      : { nouveaute: 'Nouveauté', vente: 'Meilleure vente', 'coup-coeur': 'Coup de cœur' }
    return (
      <section class={`section pb-prodsec ${bg(s.fond)||'section--sand'}`}>
        <div class="container">
          <div class="pb-prodsec__head">
            <div>
              {stegaClean(s.eyebrow) && <p class={`pb-eyebrow-sm${isDark ? ' pb-prodsec__eyebrow--dark' : ''}`}>{s.eyebrow}</p>}
              <h2 class="pb-prodsec__titre">{s.titre || (lang === 'en' ? 'From the shop' : 'Dans la boutique')}</h2>
            </div>
            {s.afficherLienBoutique !== false && (
              <a href={pfx('/boutique')} class="pb-prodsec__all">{lang === 'en' ? 'Visit the shop →' : 'Toute la boutique →'}</a>
            )}
          </div>
          <div class="pb-prodsec__grid">
            {prods.map((p: any) => {
              const prixVar = (p.variantes ?? []).map((v: any) => v.prix).filter((x: any) => x != null)
              const prixMin = prixVar.length ? Math.min(...prixVar, ...(p.variantes.length > prixVar.length ? [p.prix] : [])) : p.prix
              const aPartir = prixVar.length > 0 && new Set([...prixVar, p.prix]).size > 1
              const epuise = (p.variantes ?? []).length
                ? p.variantes.every((v: any) => v.stock === 0)
                : p.stock === 0
              const badge = (p.badges ?? [])[0]
              return (
                <a href={`/boutique/${p.slug}`} class="pb-prodsec__card">
                  <div
                    class="pb-prodsec__img"
                    style={p.image?.asset
                      ? `background-image:url(${urlFor(p.image).width(500).height(500).fit('crop').crop('focalpoint').url()})`
                      : ''}
                  >
                    {badge && BADGES[badge] && <span class="pb-prodsec__badge">{BADGES[badge]}</span>}
                    {epuise && <span class="pb-prodsec__epuise">{lang === 'en' ? 'Sold out' : 'Épuisé'}</span>}
                  </div>
                  <div class="pb-prodsec__body">
                    <h3 class="pb-prodsec__h3">{lang === 'en' ? (p.titleEn || p.title) : p.title}</h3>
                    <p class="pb-prodsec__prix">
                      {aPartir && <span class="pb-prodsec__apartir">{lang === 'en' ? 'From ' : 'À partir de '}</span>}
                      {prixMin != null && fmtPrix(prixMin)}
                    </p>
                    <span class="pb-prodsec__voir">{lang === 'en' ? 'View →' : 'Voir le produit →'}</span>
                  </div>
                </a>
              )
            })}
          </div>
        </div>
      </section>
    )
  })()}

  {/* ════════════ BOUTIQUE — BANNIÈRE D'APPEL ════════════ */}
  {s._type === 'sectionBoutiqueCta' && (
    <section class="pb-shopcta" style={heroBg(s.image)}>
      <div class="container pb-shopcta__inner">
        {stegaClean(s.eyebrow) && <p class="pb-shopcta__eyebrow">{s.eyebrow}</p>}
        <h2 class="pb-shopcta__titre">{s.titre}</h2>
        {stegaClean(s.texte) && <p class="pb-shopcta__texte">{s.texte}</p>}
        <a href={pfx(stegaClean(s.boutonLien)) || pfx('/boutique')} class="pb-shopcta__btn">
          {s.boutonTexte || (lang === 'en' ? 'Visit the shop' : 'Découvrir la boutique')}
        </a>
      </div>
    </section>
  )}

  {/* ════════════ FRISE CHRONOLOGIQUE ════════════ */}
  {s._type === 'sectionFriseChronologique' && s.items?.length > 0 && (
    <section class={`section ${bg(s.fond)||'section--sand'}`}>
      <div class="container">
        {(stegaClean(s.eyebrow) || stegaClean(s.titre)) && (
          <div class="frise-header">
            {stegaClean(s.eyebrow) && <p class="pb-eyebrow frise-eyebrow">{s.eyebrow}</p>}
            {stegaClean(s.titre) && <h2 class="frise-h2">{s.titre}</h2>}
            {stegaClean(s.sousTitre) && <p class="frise-sub">{s.sousTitre}</p>}
          </div>
        )}
        {(s.statsBar?.length > 0 || stegaClean(s.citation)) && (
          <div class="tl-stats-bar">
            {s.statsBar?.map((stat: any, si: number) => (
              <>
                {si > 0 && <div class="tl-stat-sep" />}
                <div class="tl-stat-item">
                  <span class="tl-stat-num">{stat.nombre}</span>
                  <span class="tl-stat-lbl">{stat.label}</span>
                </div>
              </>
            ))}
            {s.statsBar?.length > 0 && stegaClean(s.citation) && (
              <div class="tl-stat-sep tl-stat-sep--hide-sm" />
            )}
            {stegaClean(s.citation) && (
              <blockquote class="tl-stat-quote">{s.citation}</blockquote>
            )}
          </div>
        )}
        <div class="timeline" id="timeline-list">
          {s.items?.map((item: any, i: number) => {
            const hasPhotos = (item.photos?.length ?? 0) > 0
            return (
              <div class={`timeline-item${hasPhotos ? ' has-photo' : ''}`} data-idx={String(i)}>
                <div class="timeline-periode">{item.periode}</div>
                <div class="timeline-dot">
                  {hasPhotos && (
                    <svg class="dot-camera" viewBox="0 0 24 24" fill="currentColor" width="8" height="8" aria-hidden="true">
                      <path d="M20 5h-3.17L15 3H9L7.17 5H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-8 13c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                    </svg>
                  )}
                </div>
                <div class="timeline-content">
                  <h3>{item.lieu}</h3>
                  {stegaClean(item.detail) && <p>{item.detail}</p>}
                </div>
                {hasPhotos && (
                  <div class="tl-expand">
                    <div class="tl-expand-inner">
                      <div class="tl-expand-body">
                        <div class="tl-carousel" data-total={String(item.photos.length)}>
                          <div class="tl-car-track">
                            {item.photos.map((ph: any) => (
                              <div class="tl-car-slide">
                                <div class="tl-expand-photo">
                                  <img
                                    src={ph.asset?.url}
                                    alt={stegaClean(ph.alt) || stegaClean(item.lieu) || ''}
                                    loading="lazy"
                                    width="560"
                                    height="373"
                                  />
                                  {stegaClean(ph.caption) && (
                                    <span class="tl-expand-caption">{ph.caption}</span>
                                  )}
                                </div>
                              </div>
                            ))}
                          </div>
                          {item.photos.length > 1 && (
                            <>
                              <button class="tl-car-btn tl-car-prev" aria-label="Photo précédente" type="button">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                              </button>
                              <button class="tl-car-btn tl-car-next" aria-label="Photo suivante" type="button">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                              </button>
                              <div class="tl-car-counter">1 / {item.photos.length}</div>
                            </>
                          )}
                        </div>
                        {stegaClean(item.lien) && (
                          <a href={pfx(stegaClean(item.lien))} class="tl-expand-link">
                            {stegaClean(item.lienLabel) || 'Voir →'}
                          </a>
                        )}
                        {stegaClean(item.lien2) && (
                          <a href={pfx(stegaClean(item.lien2))} class="tl-expand-link tl-expand-link--temo">
                            {stegaClean(item.lienLabel2) || 'Témoignage →'}
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                )}
              </div>
            )
          })}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ GRILLE REVUE DE PRESSE ════════════ */}
  {s._type === 'sectionRevuePresse' && (
    <section class={`section pb-press-section ${bg(s.fond) || 'section--white'}`}>
      <div class="container">
        {(stegaClean(s.eyebrow) || stegaClean(s.titre)) && (
          <div class="pb-press-header">
            {stegaClean(s.eyebrow) && <p class="pb-eyebrow">{s.eyebrow}</p>}
            {stegaClean(s.titre) && <h2 class="pb-press-h2">{s.titre}</h2>}
          </div>
        )}
        <div class="pb-press-grid">
          {revuePresse.map((item: any) => {
            // Cover en premier, puis les photos du carrousel (combinés pour l'effet livre)
            const coverPhoto: {url:string,alt:string}[] = item.cover?.asset?.url
              ? [{ url: item.cover.asset.url, alt: item.titre || '' }]
              : []
            const extraPhotos: {url:string,alt:string}[] = item.photos?.length
              ? item.photos.filter((p: any) => p.asset?.url).map((p: any) => ({ url: p.asset.url, alt: p.alt || item.titre || '' }))
              : []
            const allPhotos: {url:string,alt:string}[] = [...coverPhoto, ...extraPhotos]
            return (
              <article class="pb-press-card2">
                <div class="pb-press-card2__media">
                  <div class="pb-press-flip" data-press-flip>
                    {allPhotos.length > 0
                      ? allPhotos.map((ph, idx) => (
                          <img
                            src={ph.url}
                            alt={ph.alt}
                            class:list={['pb-press-flip__img', idx === 0 && 'is-active']}
                            loading="lazy"
                          />
                        ))
                      : <span class="pb-press-flip__placeholder">{item.magazine}</span>
                    }
                  </div>
                  {allPhotos.length > 1 && (
                    <div class="pb-press-flip__dots">
                      {allPhotos.map((_: any, idx: number) => (
                        <span class:list={['pb-press-flip__dot', idx === 0 && 'is-active']} />
                      ))}
                    </div>
                  )}
                  {item.type && <span class="pb-press-card2__badge">{item.type}</span>}
                </div>
                <div class="pb-press-card2__body">
                  <div class="pb-press-card2__meta">
                    <span class="pb-press-card2__magazine">{item.magazine}</span>
                    {item.numero && <span class="pb-press-card2__numero">&middot; {item.numero}</span>}
                    <span class="pb-press-card2__date">{item.date}</span>
                  </div>
                  <h3 class="pb-press-card2__titre">{item.titre}</h3>
                  {item.description && <p class="pb-press-card2__desc">{item.description}</p>}
                  {item.fichierPdf?.asset?.url ? (
                    <a href={`${item.fichierPdf.asset.url}?dl=${encodeURIComponent(item.fichierPdf.asset.originalFilename || 'article.pdf')}`} class="pb-press-card2__link pb-press-card2__link--dl">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                      {item.labelLien || 'Télécharger l\'article (PDF)'}
                    </a>
                  ) : item.lien ? (
                    <a href={item.lien} target="_blank" rel="noopener noreferrer" class="pb-press-card2__link">
                      {item.labelLien || 'Lire l\'article'}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </a>
                  ) : null}
                </div>
              </article>
            )
          })}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ GRILLE PARTENAIRES ════════════ */}
  {s._type === 'sectionPartenaires' && (
    <section class={`section pb-part-section ${bg(s.fond) || 'section--white'}`}>
      <div class="container">
        {(stegaClean(s.eyebrow) || stegaClean(s.titre)) && (
          <div class="pb-part-header">
            {stegaClean(s.eyebrow) && <p class="pb-eyebrow">{s.eyebrow}</p>}
            {stegaClean(s.titre) && <h2 class="pb-part-h2">{s.titre}</h2>}
          </div>
        )}
        <div class="pb-part-grid">
          {partenaires.map((p: any) => (
            <article class="pb-part-card">
              <div class="pb-part-card__logo-wrap">
                {p.logo?.asset?.url
                  ? <img src={p.logo.asset.url} alt={`Logo ${p.nom}`} class="pb-part-card__logo" loading="lazy" />
                  : <span class="pb-part-card__logo-placeholder">{p.nom}</span>
                }
              </div>
              <div class="pb-part-card__body">
                {(lang === 'en' ? (stegaClean(p.tagEn) || p.tag) : p.tag) && (
                  <span class="pb-part-card__tag">{lang === 'en' ? (stegaClean(p.tagEn) || p.tag) : p.tag}</span>
                )}
                <h3 class="pb-part-card__name">{p.nom}</h3>
                {(lang === 'en' ? (stegaClean(p.descriptionEn) || p.description) : p.description) && (
                  <p class="pb-part-card__desc">{lang === 'en' ? (stegaClean(p.descriptionEn) || p.description) : p.description}</p>
                )}
              </div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="pb-part-card__link" aria-label={`Visiter le site ${p.nom}`}>
                  {p.labelLien || p.url}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ MATÉRIEL — INTRO + SPECS ════════════ */}
  {s._type === 'sectionMaterielIntro' && (
    <section class={`section pb-mat-intro ${bg(s.fond)||'section--white'}`}>
      <div class="container pb-mat-intro__grid">
        <div class="pb-mat-intro__body">
          {stegaClean(s.titre) && <h2 class="pb-mat-intro__h2">{s.titre}</h2>}
          <div class="prose" set:html={blocks(s.texte)} />
        </div>
        {s.specs?.length > 0 && (
          <aside class="pb-mat-specs">
            {s.specs.map((sp: any) => (
              <div class="pb-mat-specs__row">
                <span class="pb-mat-specs__label">{sp.label}</span>
                <span class="pb-mat-specs__val">{sp.valeur}</span>
              </div>
            ))}
          </aside>
        )}
      </div>
    </section>
  )}

  {/* ════════════ MATÉRIEL — ÉQUIPEMENT / MOUCHES CARTES ════════════ */}
  {s._type === 'sectionEquipement' && (
    <section class={`section pb-equip ${bg(s.fond)||'section--sand'}`}>
      <div class="container">
        <div class="pb-equip__header">
          {stegaClean(s.titre) && <h2 class="pb-equip__h2">{s.titre}</h2>}
          {s.lienBoutique && (
            <a href={stegaClean(s.lienBoutique)} target="_blank" rel="noopener noreferrer" class="pb-equip__lien-boutique">
              {stegaClean(s.labelBoutique) || 'Voir sur Ardent'}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          )}
        </div>
        <div class="pb-equip__grid">
          {s.items?.map((item: any) => (
            <div class="pb-equip__card">
              <h3 class="pb-equip__card-titre">{item.titre}</h3>
              {item.description && <p class="pb-equip__card-desc">{item.description}</p>}
              {item.lien && (
                <a href={stegaClean(item.lien)} target="_blank" rel="noopener noreferrer" class="pb-equip__card-lien">
                  {stegaClean(item.labelLien) || 'Acheter sur Ardent'}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ MATÉRIEL — NAVIGATION SOUS-PAGES ════════════ */}
  {s._type === 'sectionMaterielNav' && (
    <section class={`section pb-mat-nav ${bg(s.fond)||'section--sand'}`}>
      <div class="container pb-mat-nav__inner">
        {s.liens?.map((lien: any) => (
          <a href={pfx(stegaClean(lien.url))} class="pb-mat-nav__btn">{lien.label}</a>
        ))}
      </div>
    </section>
  )}

  {/* ════════════ VIDÉOS YOUTUBE ALTERNÉES ════════════ */}
  {s._type === 'sectionVideos' && (
    <section class={`section pb-videos ${bg(s.fond)||'section--white'}`}>
      <div class="container">
        <div class="pb-videos__header">
          {stegaClean(s.titre) && <h2 class="pb-videos__h2">{s.titre}</h2>}
          {s.lienChaine && (
            <a href={stegaClean(s.lienChaine)} target="_blank" rel="noopener noreferrer" class="pb-videos__lien-chaine">
              {stegaClean(s.labelChaine) || 'Voir la chaîne YouTube'}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          )}
        </div>
        {s.items?.filter((item: any) => ytId(stegaClean(item.youtubeId) || stegaClean(item.youtubeUrl) || '')).map((item: any, idx: number) => (
          <div class:list={['pb-video-row', idx % 2 === 1 && 'pb-video-row--rev']}>
            <div class="pb-video-row__player">
              <div class="video-wrap">
                <iframe
                  src={`https://www.youtube.com/embed/${ytId(stegaClean(item.youtubeId) || stegaClean(item.youtubeUrl) || '')}?rel=0`}
                  title={stegaClean(item.titre) || 'Vidéo YouTube'}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
            <div class="pb-video-row__body">
              {item.espece && <span class="pb-video-row__tag">{item.espece}</span>}
              <h3 class="pb-video-row__titre">{item.titre}</h3>
              {(lang === 'en' ? (stegaClean(item.descriptionEn) || item.description) : item.description) && (
                <p class="pb-video-row__desc">{lang === 'en' ? (stegaClean(item.descriptionEn) || item.description) : item.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* ════════════ GRILLE HUB SOUS-PAGES ════════════ */}
  {s._type === 'sectionGrilleSubPages' && (
    <section class={`section pb-hub ${bg(s.fond)||'section--sand'}`}>
      <div class="container">
        {(stegaClean(s.eyebrow) || stegaClean(s.titre)) && (
          <div class="pb-hub__header">
            {stegaClean(s.eyebrow) && <p class="pb-eyebrow">{s.eyebrow}</p>}
            {stegaClean(s.titre) && <h2 class="pb-hub__h2">{s.titre}</h2>}
          </div>
        )}
        <div class="pb-hub__grid">
          {s.cartes?.map((carte: any) => (
            <a href={pfx(stegaClean(carte.url))} class="pb-hub__card">
              <div class="pb-hub__card-img-wrap">
                {carte.image?.asset?.url
                  ? <img src={carte.image.asset.url} alt={stegaClean(carte.image?.alt) || stegaClean(carte.titre) || ''} class="pb-hub__card-img" loading="lazy" />
                  : <div class="pb-hub__card-img pb-hub__card-img--placeholder" />
                }
              </div>
              <div class="pb-hub__card-body">
                {stegaClean(carte.tag) && <span class="pb-hub__card-tag">{carte.tag}</span>}
                <h3 class="pb-hub__card-titre">{carte.titre}</h3>
                {stegaClean(carte.description) && <p class="pb-hub__card-desc">{carte.description}</p>}
                <span class="pb-hub__card-arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ TARIFS ════════════ */}
  {s._type === 'sectionTarifs' && (() => {
    const panel = stegaClean(s.couleurPanel) || 'bar'
    const body  = stegaClean(s.fond) === 'sand' ? 'sand' : 'white'
    return (
      <div class="pb-tarifs">
        <section class="ts-section">
          {/* Panneau gauche */}
          <div class={`ts-panel ts-panel--${panel}`}>
            {stegaClean(s.eyebrow)    && <p class="ts-eyebrow">{s.eyebrow}</p>}
            {stegaClean(s.titre)      && <h2 class="ts-title">{s.titre}</h2>}
            <div class="ts-divider"></div>
            {stegaClean(s.description) && <p class="ts-desc">{s.description}</p>}
            {stegaClean(s.lienUrl)    && (
              <a href={pfx(stegaClean(s.lienUrl))} class="ts-more">
                {stegaClean(s.lienLabel) || 'Découvrir →'}
              </a>
            )}
          </div>
          {/* Corps droit */}
          <div class={`ts-body ts-body--${body}`}>
            {s.lignes?.map((ligne: any) => {
              const statut    = stegaClean(ligne.statut) || 'normal'
              const isFerme   = statut === 'ferme'
              const isContact = statut === 'contact'
              const isAccent  = statut === 'accentue'
              return (
                <div class={`ts-row${isFerme ? ' ts-row--closed' : ''}`}>
                  <div class="ts-row__info">
                    {stegaClean(ligne.lienUrl)
                      ? <a href={pfx(stegaClean(ligne.lienUrl))} class="ts-row__name">{ligne.nom}</a>
                      : <span class="ts-row__name">{ligne.nom}</span>}
                    {stegaClean(ligne.format) && (
                      <span class="ts-row__format">
                        {isFerme
                          ? <span class="tag-closed">Fermée en 2026</span>
                          : ligne.format}
                      </span>
                    )}
                  </div>
                  <div class={`ts-prices${isContact ? ' ts-prices--contact' : ''}`}>
                    {isContact
                      ? <a href={pfx('/contact')} class="ts-contact-price ts-contact-price--link">Nous contacter</a>
                      : ligne.prix?.map((p: any) => (
                          <div class={`ts-price${isAccent ? ' ts-price--accent' : ''}`}>
                            <span class="ts-price__val">{p.valeur}</span>
                            <span class="ts-price__lbl">{p.label}</span>
                          </div>
                        ))
                    }
                  </div>
                </div>
              )
            })}
            {s.matrices?.map((m: any) => {
              const cols     = m.colonnes || []
              const nbCols   = cols.length
              const colPx    = 95
              const gridCols = `1fr ${cols.map(() => `${colPx}px`).join(' ')}`
              return (
                <div class="ts-matrix">
                  <div class="ts-matrix__title">
                    {stegaClean(m.titreUrl)
                      ? <a href={stegaClean(m.titreUrl)} class="ts-matrix__title-link">{m.titre}</a>
                      : <span>{m.titre}</span>}
                    {stegaClean(m.note) && <span> {m.note}</span>}
                  </div>
                  <div class="ts-matrix__head" style={`grid-template-columns:${gridCols}`}>
                    <span></span>
                    {cols.map((col: string) => <span class="ts-mh__col">{col}</span>)}
                  </div>
                  {m.lignes?.map((lig: any) => (
                    <div class="ts-matrix__row" style={`grid-template-columns:${gridCols}`}>
                      <span class="ts-mrow__label">{lig.label}</span>
                      {lig.valeurs?.map((v: string) => <span class="ts-mrow__val">{v}</span>)}
                    </div>
                  ))}
                </div>
              )
            })}
          </div>
        </section>
      </div>
    )
  })()}

  {/* ════════════ AVANTAGES ════════════ */}
  {s._type === 'sectionAvantages' && (
    <section class={`section pb-avantages ${bg(s.fond) || 'section--sand'}`}>
      <div class="container">
        {stegaClean(s.eyebrow) && <p class="pb-eyebrow">{s.eyebrow}</p>}
        {stegaClean(s.titre) && <h2 class="pb-avantages__titre">{s.titre}</h2>}
        <div class="pb-avantages__grid">
          {s.items?.map((item: any) => (
            <div class="pb-avantages__item">
              {stegaClean(item.icone) && <div class="pb-avantages__icon">{item.icone}</div>}
              {stegaClean(item.titre) && <h3 class="pb-avantages__h3">{item.titre}</h3>}
              {stegaClean(item.texte) && <p class="pb-avantages__p">{item.texte}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ════════════ FAQ (questions/réponses + JSON-LD FAQPage) ════════════ */}
  {s._type === 'sectionFaq' && (() => {
    const items = (s.questions ?? []).filter((q: any) => stegaClean(q.question) && stegaClean(q.reponse))
    if (!items.length) return null
    // JSON-LD émis une seule fois par page (guidelines Google : un seul FAQPage),
    // en agrégeant les questions de TOUTES les sections FAQ de la page
    const emitJsonLd = s._key === firstFaqKey
    const allItems = faqSectionsAll
      .flatMap((f: any) => f.questions ?? [])
      .filter((q: any) => stegaClean(q.question) && stegaClean(q.reponse))
    const faqJsonLd = {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: allItems.map((q: any) => ({
        '@type': 'Question',
        name: stegaClean(q.question),
        acceptedAnswer: { '@type': 'Answer', text: stegaClean(q.reponse) },
      })),
    }
    return (
      <section class={`section pb-faq ${bg(s.fond) || 'section--white'}`}>
        <div class="container pb-faq__inner">
          {stegaClean(s.eyebrow) && <p class="pb-eyebrow">{s.eyebrow}</p>}
          {stegaClean(s.titre) && <h2 class="pb-faq__titre">{s.titre}</h2>}
          <div class="pb-faq__list">
            {items.map((q: any) => (
              <details class="pb-faq__item">
                <summary class="pb-faq__q">
                  {q.question}
                  <span class="pb-faq__chevron" aria-hidden="true">+</span>
                </summary>
                <p class="pb-faq__a">{q.reponse}</p>
              </details>
            ))}
          </div>
        </div>
        {emitJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
      </section>
    )
  })()}

  {/* ════════════ VOYAGES GRID ════════════ */}
  {s._type === 'sectionVoyagesGrid' && (() => {
    // stegaClean = test de vide uniquement ; on rend l'original (overlays aperçu)
    const eyebrow = stegaClean(s.eyebrow) ? s.eyebrow : 'Destinations'
    const titre   = stegaClean(s.titre)   ? s.titre   : 'Choisissez votre aventure'
    const featuredSlug = stegaClean(s.voyageFeaturedSlug) || 'los-roques-venezuela'

    const featured = voyagesForGrid.find((v: any) => stegaClean(v.slug?.current) === featuredSlug)
    const ORDRE = [
      'voyage-peche-argentine-rio-grande-truite-de-mer',
      'peche-mouche-cuba-cayo-cruz',
      'peche-mouche-cuba-cayo-santa-maria',
      'voyage-peche-mouche-mexique',
    ]
    const rest = voyagesForGrid
      .filter((v: any) => stegaClean(v.slug?.current) !== featuredSlug)
      .sort((a: any, b: any) => {
        const ai = ORDRE.indexOf(stegaClean(a.slug?.current) ?? '')
        const bi = ORDRE.indexOf(stegaClean(b.slug?.current) ?? '')
        return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi)
      })

    const vRegion = (v: any): string => {
      const raw = lang === 'en'
        ? (stegaClean(v.regionEn) || stegaClean(v.region) || stegaClean(v.pays) || '')
        : (stegaClean(v.region)   || stegaClean(v.pays) || '')
      return raw
        .replace(/^Voyage\s*[·•]\s*/i, '')
        .replace(/^Fly\s+Fishing\s+Trip\s*[·•]\s*/i, '')
    }
    const vTitle  = (v: any): string => lang === 'en'
      ? (stegaClean(v.displayTitleEn) || stegaClean(v.displayTitle) || v.title)
      : (stegaClean(v.displayTitle)   || v.title)
    const vTag    = (v: any): string => lang === 'en'
      ? (stegaClean(v.taglineEn) || stegaClean(v.tagline) || v.especes || '')
      : (stegaClean(v.tagline)   || v.especes || '')
    const vImg = (v: any, w: number, h: number): string | null =>
      v.heroImage?.asset ? urlFor(v.heroImage).width(w).height(h).fit('crop').crop('focalpoint').url() : null

    return (
      <section class="vg-section">
        {(eyebrow || titre) && (
          <div class="container vg-header">
            {eyebrow && <p class="pb-eyebrow">{eyebrow}</p>}
            {titre   && <h2 class="vg-titre">{titre}</h2>}
          </div>
        )}
        <div class="vg-grid">
          {featured && (
            <a href={pfx(`/${stegaClean(featured.slug?.current)}`)} class="vg-card vg-card--large">
              {vImg(featured, 1400, 900) && <div class="vg-card__bg" style={`background-image:url(${vImg(featured, 1400, 900)})`}></div>}
              <div class="vg-overlay"></div>
              <div class="vg-body">
                {vRegion(featured) && <span class="vg-sub">{vRegion(featured)}</span>}
                <strong class="vg-label">{vTitle(featured)}</strong>
                {vTag(featured) && <span class="vg-tagline">{vTag(featured)}</span>}
                {stegaClean(featured.periode) && <span class="vg-saison">{featured.periode}</span>}
              </div>
            </a>
          )}
          {rest.map((v: any) => {
            const img = vImg(v, 900, 640)
            return (
              <a href={pfx(`/${stegaClean(v.slug?.current)}`)} class="vg-card">
                {img && <div class="vg-card__bg" style={`background-image:url(${img})`}></div>}
                <div class="vg-overlay"></div>
                <div class="vg-body">
                  {vRegion(v) && <span class="vg-sub">{vRegion(v)}</span>}
                  <strong class="vg-label">{vTitle(v)}</strong>
                  {vTag(v) && <span class="vg-tagline">{vTag(v)}</span>}
                  {stegaClean(v.periode) && <span class="vg-saison">{v.periode}</span>}
                </div>
              </a>
            )
          })}
        </div>
      </section>
    )
  })()}

  </>
))}

