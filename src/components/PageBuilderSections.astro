/* ═══════════════════════════════════════════════════════════════════════ */

/* ── HERO ── */
.pb-hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  padding-bottom: 4rem;
  color: white;
}
.pb-hero__bg {
  position: absolute;
  inset: 0;
  background-color: var(--color-ocean);
}
.pb-hero__yt-wrapper {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}
.pb-hero__yt-iframe {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100vw;
  height: 56.25vw;
  min-width: 177.78vh;
  min-height: 100vh;
  transform: translate(-50%, -50%);
  border: none;
}
/* Photo affichée le temps que la vidéo démarre. Son voile (curseur photo) est
   cuit dans son background par heroBg() côté template — un overlay séparé ne
   marcherait pas, ce calque étant au-dessus de .pb-hero__overlay.
   Le background ci-dessous n'est que le fond de repli (aucune photo). */
.pb-hero__yt-poster {
  position: absolute;
  inset: 0;
  background: #07181f;
  background-size: cover;
  background-position: center;
  pointer-events: none;
  z-index: 1;
  will-change: opacity;
  transition: opacity 0.8s ease;
}
.pb-hero__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
/* Voile de la VIDÉO uniquement.
   ⚠️ Empilement du hero vidéo (ne pas y toucher sans relire ceci) :
      .pb-hero__yt-wrapper (auto) < .pb-hero__overlay (auto) < .pb-hero__yt-poster
      (z-index 1) < .pb-hero__content (z-index 1, plus loin dans le DOM).
   Cet overlay est donc SOUS le poster : il ne voile que la vidéo. La photo de
   poster porte son propre voile, cuit dans son background par heroBg(). C'est
   voulu — deux curseurs distincts (voile photo / voile vidéo). */
.pb-hero__overlay {
  position: absolute;
  inset: 0;
  /* --voile-k : multiplicateur posé par le curseur "voile vidéo"
     (1 = réglage d'origine). Les alphas > 1 sont clampés par le navigateur. */
  background: linear-gradient(to top,
    rgba(7,24,31, calc(.88 * var(--voile-k, 1))) 0%,
    rgba(13,43,62, calc(.5 * var(--voile-k, 1))) 55%,
    rgba(13,43,62, calc(.25 * var(--voile-k, 1))) 100%);
}
.pb-hero__content {
  position: relative;
  z-index: 1;
  padding-top: var(--header-height);
}
.pb-hero__badges {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}
.pb-hero__badge {
  display: inline-block;
  padding: 0.35rem 0.9rem;
  border-radius: 2px;
  font-size: 0.65rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 600;
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.85);
  border: 1px solid rgba(255,255,255,0.2);
}
.pb-hero__badge--mouche {
  background: rgba(126,200,227,0.15);
  border-color: rgba(126,200,227,0.35);
  color: var(--color-ocean-light);
}
.pb-eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-ocean-light);
  margin-bottom: 0.8rem;
  font-weight: 500;
}
.pb-hero__h1 {
  color: white;
  margin-bottom: 1rem;
  max-width: 720px;
}
.pb-hero__sub {
  color: rgba(255,255,255,0.75);
  max-width: 580px;
  line-height: 1.65;
  margin-bottom: 2rem;
  font-size: 1.05rem;
}
.pb-hero__cta { display: flex; gap: 1rem; flex-wrap: wrap; }

/* ── Boutons ── */
.btn-prim {
  background: var(--color-ocean-main);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: background 0.2s;
}
.btn-prim:hover { background: #144b72; }
.btn-ghost {
  border: 1.5px solid rgba(255,255,255,0.4);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: border-color 0.2s;
}
.btn-ghost:hover { border-color: white; }
.btn-youtube {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  border: 1.5px solid rgba(255,255,255,0.4);
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: border-color 0.2s, background 0.2s;
}
.btn-youtube:hover {
  border-color: #FF0000;
  background: rgba(255,0,0,0.12);
}
.btn-youtube__icon {
  width: 20px;
  height: 20px;
  color: #FF0000;
  flex-shrink: 0;
}
.btn-ghost-light {
  border: 1.5px solid rgba(255,255,255,0.35);
  color: white;
  padding: 0.75rem 1.8rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: border-color 0.2s;
}
.btn-ghost-light:hover { border-color: white; }
.btn-mat {
  display: flex; align-items: center; gap: 0.4rem;
  border: 1.5px solid rgba(126,200,227,0.5);
  color: var(--color-ocean-light);
  padding: 0.75rem 1.4rem;
  border-radius: 4px;
  font-size: 0.88rem;
  font-weight: 500;
  transition: border-color 0.2s, color 0.2s;
}
.btn-mat:hover { border-color: var(--color-ocean-light); color: white; }

/* ── TITRE DE SECTION ── */
.pb-st {
  padding: 3.5rem 0 1.5rem;
}
.pb-st__inner {
  text-align: center;
  max-width: 760px;
  margin: 0 auto;
}
.pb-st__inner--left {
  text-align: left;
  max-width: var(--max-width);
}
.pb-st__eyebrow {
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-ocean-main);
  font-weight: 500;
  margin-bottom: 0.6rem;
}
.section--dark .pb-st__eyebrow { color: var(--color-ocean-light); }
.pb-st__h2 {
  color: var(--color-text);
  margin-bottom: 0;
}
.section--dark .pb-st__h2 { color: white; }
.pb-st__sub {
  color: var(--color-text-muted);
  max-width: 600px;
  margin: 0.9rem auto 0;
  line-height: 1.7;
  font-size: 1rem;
}
.pb-st__inner--left .pb-st__sub { margin-left: 0; }
.section--dark .pb-st__sub { color: rgba(255,255,255,0.7); }

/* ── INTRO + INFO CARD ── */
.pb-intro__grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 4rem;
  align-items: start;
}
.pb-intro__h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  color: var(--color-text);
  margin: 0.3rem 0 1.4rem;
  line-height: 1.2;
}
.section--dark .pb-intro__h2,
.section--ocean .pb-intro__h2 { color: white; }
.info-card {
  background: var(--color-sand);
  border-radius: 6px;
  padding: 1.6rem;
  border-left: 3px solid var(--color-ocean-main);
  position: sticky;
  top: calc(var(--header-height) + 2rem);
}
.info-lbl {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-top: 1.2rem;
}
.info-lbl:first-child { margin-top: 0; }
.info-val {
  font-size: 0.92rem;
  color: var(--color-text);
  line-height: 1.55;
}
.info-note {
  font-size: 0.78rem;
  font-style: italic;
  color: var(--color-text-muted, #6b7280);
  line-height: 1.5;
  margin-top: 0.15rem;
}
.info-card-btn {
  display: block;
  margin-top: 1.2rem;
  text-align: center;
  background: var(--color-ocean-main);
  color: white;
  padding: 0.7rem 1rem;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.88rem;
  text-decoration: none;
  transition: background 0.2s;
}
.info-card-btn:hover { background: #144b72; }

/* ── PROSE (Portable Text) ── */
.prose .pb-p {
  color: var(--color-text);
  line-height: 1.8;
  margin-bottom: 1.2rem;
  font-size: 1rem;
}
.prose .pb-h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  color: var(--color-text);
  margin: 2rem 0 0.75rem;
}
.prose .pb-h3 {
  font-family: var(--font-serif);
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  color: var(--color-text);
  margin: 1.5rem 0 0.5rem;
}
.prose .pb-blockquote {
  border-left: 3px solid var(--color-ocean-light);
  padding-left: 1.2rem;
  margin: 1.5rem 0;
  font-style: italic;
  color: var(--color-text-muted);
}
.prose a { color: var(--color-ocean-main); text-decoration: underline; text-underline-offset: 2px; }
.prose figure { margin: 1.5rem 0; }
.prose figure img { border-radius: 6px; width: 100%; }
.prose .pb-list {
  padding-left: 1.4rem; margin-bottom: 1rem;
}
.prose .pb-list li {
  line-height: 1.75; margin-bottom: 0.35rem;
  color: var(--color-text);
}
.prose .pb-list--bullet { list-style-type: disc; }
.prose .pb-list--number { list-style-type: decimal; }
.section--dark .prose .pb-list li  { color: rgba(255,255,255,0.82); }
.section--dark .prose .pb-p        { color: rgba(255,255,255,0.85); }
.section--dark .prose .pb-h2       { color: white; }
.section--dark .prose .pb-h3       { color: white; }
.section--dark .prose .pb-blockquote { color: rgba(255,255,255,0.7); border-left-color: var(--color-ocean-light); }
.section--dark .prose a             { color: var(--color-ocean-light); }
.section--dark .prose strong        { color: white; }

/* ── EXPERT CARD (intervenant) ── */
.expert-card {
  display: flex; gap: 1rem; align-items: flex-start;
  background: var(--color-sand); border-radius: 4px;
  padding: 1.2rem; margin-top: 1.5rem;
}
.expert-card__avatar {
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--color-ocean); color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; font-weight: 700; flex-shrink: 0;
}
.expert-card__name { font-size: 1rem; font-weight: 600; color: var(--color-text); display: block; }
.expert-card__title { font-size: 0.75rem; color: var(--color-ocean-main); display: block; margin: 0.2rem 0 0.5rem; line-height: 1.5; }
.expert-card__bio { font-size: 0.85rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }

/* ── CARDS STYLE 2 ── */
.pb-cards2 { overflow: hidden; }
.pb-cards2__header { padding-top: 3rem; padding-bottom: 1.5rem; }
.section--dark .pb-cards2__header .pb-eyebrow-sm,
.section--ocean .pb-cards2__header .pb-eyebrow-sm { color: var(--color-ocean-light); }
.section--dark .pb-cards2__header .pb-section-titre,
.section--ocean .pb-cards2__header .pb-section-titre { color: white; }
.pb-cards2__grid {
  display: grid;
  grid-template-rows: 320px;
  gap: 4px;
}
.pb-cards2__grid .wf-card { height: 320px; }
@media (max-width: 900px) {
  .pb-cards2__grid { grid-template-columns: 1fr 1fr !important; grid-template-rows: 240px 240px; }
}
@media (max-width: 480px) {
  .pb-cards2__grid { grid-template-columns: 1fr !important; grid-template-rows: none; }
  .pb-cards2__grid .wf-card { height: 220px; }
}

/* ── GRILLE WILD FLY style 3 (sectionCards3) ── */
.wf3-section { background: #fff; }
.wf3-header  { text-align: center; padding: 4rem 2rem 2.5rem; }
.wf3-titre   { font-family: var(--font-serif); font-size: clamp(1.8rem,3vw,2.5rem); font-weight: 400; color: var(--color-text); }
.wf3-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: 420px 300px;
  gap: 4px;
}
.wf3-card {
  position: relative; display: block; overflow: hidden;
  text-decoration: none; color: white; background: var(--color-ocean);
}
.wf3-card--large { grid-column: 1 / 3; grid-row: 1 / 2; }
.wf3-card:nth-child(2) { grid-column: 3 / 4; grid-row: 1 / 2; }
.wf3-card:nth-child(3) { grid-column: 1; grid-row: 2; }
.wf3-card:nth-child(4) { grid-column: 2; grid-row: 2; }
.wf3-card:nth-child(5) { grid-column: 3; grid-row: 2; }
.wf3-card__bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  transition: transform 0.6s ease;
}
.wf3-card:hover .wf3-card__bg { transform: scale(1.06); }
.wf3-card::after {
  content: ''; position: absolute; inset: 0;
  background: rgba(7,24,31,0.22); transition: background 0.35s ease;
}
.wf3-card:hover::after { background: rgba(7,24,31,0.08); }
.wf3-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(7,24,31,0.78) 0%, transparent 55%);
  z-index: 1;
}
.wf3-body {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 1.5rem 1.75rem 1.75rem; z-index: 2;
  display: flex; flex-direction: column; gap: 0.2rem;
}
.wf3-sub   { font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-ocean-light); font-weight: 500; }
.wf3-label { font-family: var(--font-serif); font-size: 1.45rem; font-weight: 500; line-height: 1.2; color: white; }
.wf3-card--large .wf3-label { font-size: 2rem; }
@media (max-width: 900px) {
  .wf3-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 280px 280px 240px; }
  .wf3-card--large          { grid-column: 1 / 3; grid-row: 1; }
  .wf3-card:nth-child(2)    { grid-column: 1;     grid-row: 2; }
  .wf3-card:nth-child(3)    { grid-column: 2;     grid-row: 2; }
  .wf3-card:nth-child(4)    { grid-column: 1;     grid-row: 3; }
  .wf3-card:nth-child(5)    { grid-column: 2;     grid-row: 3; }
}
@media (max-width: 560px) {
  .wf3-grid { grid-template-columns: 1fr; grid-template-rows: repeat(5, 260px); }
  .wf3-card--large, .wf3-card:nth-child(2), .wf3-card:nth-child(3),
  .wf3-card:nth-child(4),   .wf3-card:nth-child(5) { grid-column: 1; grid-row: auto; }
}

/* ── CARDS (sous-prestations) ── */
.pb-cards { overflow: hidden; }
.pb-section-titre {
  margin-bottom: 2rem;
  color: var(--color-text);
}
.section--dark .pb-section-titre,
.section--ocean .pb-section-titre { color: white; }
.sous-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px;
}
.wf-card {
  position: relative;
  display: block;
  height: 380px;
  overflow: hidden;
  text-decoration: none;
  color: white;
  background: var(--color-ocean);
}
.wf-card--wide {
  grid-column: 1 / -1;
  height: 500px;
}
.wf-card-bg {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  transition: transform 0.6s ease;
}
.wf-card:hover .wf-card-bg { transform: scale(1.06); }
.wf-card::after {
  content: '';
  position: absolute; inset: 0;
  background: rgba(7,24,31,0.25);
  transition: background 0.35s ease;
}
.wf-card:hover::after { background: rgba(7,24,31,0.1); }
.wf-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(7,24,31,.75) 0%, transparent 55%);
  z-index: 1;
}
.wf-body {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 1.5rem 1.75rem 1.75rem;
  z-index: 2;
  display: flex; flex-direction: column; gap: 0.2rem;
}
.wf-sub {
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-ocean-light);
  font-weight: 500;
}
.wf-label {
  font-family: var(--font-serif);
  font-size: 1.45rem;
  font-weight: 500;
  line-height: 1.2;
  color: white;
}

/* ── TEXTE + IMAGE ── */
.pb-ti__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}
.pb-ti__grid[data-pos="left"] .pb-ti__fig { order: -1; }
.pb-ti__fig img { border-radius: 6px; width: 100%; }
.pb-ti__h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  color: var(--color-text);
  margin: 0.3rem 0 1.2rem;
  line-height: 1.2;
}
.section--dark .pb-ti__h2,
.section--ocean .pb-ti__h2 { color: white; }
.pb-ti__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1.6rem;
}
.pb-ti__chip {
  display: inline-block;
  padding: 0.3rem 0.85rem;
  border: 1px solid #d0d5dc;
  border-radius: 999px;
  font-size: 0.82rem;
  color: var(--color-text-muted);
  background: transparent;
  white-space: nowrap;
}
.section--dark .pb-ti__chip,
.section--ocean .pb-ti__chip {
  border-color: rgba(255,255,255,0.3);
  color: rgba(255,255,255,0.75);
}

/* ── GALERIE ── */
.galerie-grid {
  display: grid;
  gap: 1rem;
}
.galerie-img {
  width: 100%; aspect-ratio: 4/3;
  object-fit: cover; border-radius: 4px;
}

/* ── VIDÉO (layout texte + vidéo) ── */
.pb-video2__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
.pb-video2__grid--rev .pb-video2__player { order: 2; }
.pb-video2__grid--rev .pb-video2__text   { order: 1; }
.video-wrap {
  position: relative;
  padding-bottom: 56.25%;
  border-radius: 8px; overflow: hidden;
}
.video-wrap iframe {
  position: absolute; inset: 0;
  width: 100%; height: 100%; border: none;
}
.pb-video2__eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-bottom: 0.75rem;
}
.pb-video2__titre {
  color: var(--color-text);
  margin-bottom: 1rem;
  line-height: 1.2;
}
.section--dark .pb-video2__titre { color: white; }
.section--dark .pb-video2__eyebrow { color: var(--color-ocean-light); }
.pb-video2__desc {
  color: var(--color-text-muted);
  line-height: 1.75;
  font-size: 1rem;
}
.section--dark .pb-video2__desc { color: rgba(255,255,255,0.7); }
@media (max-width: 860px) {
  .pb-video2__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .pb-video2__grid--rev .pb-video2__player { order: 1; }
  .pb-video2__grid--rev .pb-video2__text   { order: 2; }
}

/* ── INFOS CLÉS BANDEAU ── */
.pb-bandeau {
  width: 100%;
}
.pb-bandeau__grid {
  display: flex;
  flex-wrap: nowrap;
}
.pb-bandeau__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1.6rem 1.5rem;
  border-right: 1px solid rgba(255,255,255,0.1);
}
.pb-bandeau__item:last-child { border-right: none; }
.section--dark  .pb-bandeau__item,
.section--ocean .pb-bandeau__item { border-color: rgba(255,255,255,0.1); }
.section--white .pb-bandeau__item,
.section--sand  .pb-bandeau__item { border-color: rgba(0,0,0,0.08); }
.pb-bandeau__titre {
  font-family: var(--font-serif);
  font-size: clamp(0.95rem, 2vw, 1.2rem);
  font-weight: 500;
  line-height: 1.2;
  color: white;
}
.section--white .pb-bandeau__titre,
.section--sand  .pb-bandeau__titre { color: var(--color-text); }
.pb-bandeau__sub {
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  margin-top: 0.4rem;
  font-weight: 400;
}
.section--white .pb-bandeau__sub,
.section--sand  .pb-bandeau__sub { color: var(--color-text-muted); }
@media (max-width: 700px) {
  .pb-bandeau__grid { flex-wrap: wrap; }
  .pb-bandeau__item {
    flex: 0 0 50%;
    border-right: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .pb-bandeau__item:nth-child(even) { border-right: none; }
  .section--white .pb-bandeau__item,
  .section--sand  .pb-bandeau__item { border-color: rgba(0,0,0,0.08); }
}

/* ── PROGRAMME / ÉTAPES ── */
.pb-eyebrow-sm {
  font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--color-ocean-main); font-weight: 600; margin-bottom: 0.5rem;
}
.section--dark .pb-eyebrow-sm,
.section--ocean .pb-eyebrow-sm { color: var(--color-ocean-light); }
.pb-prog__h2  { margin-bottom: 0.5rem; }
.section--dark .pb-prog__h2,
.section--ocean .pb-prog__h2 { color: white; }
.pb-prog__intro {
  font-size: 1rem; line-height: 1.7; color: var(--color-text-muted);
  max-width: 640px; margin-bottom: 2.5rem;
}
.section--dark .pb-prog__intro,
.section--ocean .pb-prog__intro { color: rgba(255,255,255,0.72); }
.pb-prog__rows { display: flex; flex-direction: column; gap: 2rem; }
.pb-prog__row {
  display: grid; grid-template-columns: 1fr 1fr;
  border-radius: 6px; overflow: hidden;
  box-shadow: 0 2px 16px rgba(0,0,0,0.07);
}
.pb-prog__row--rev .pb-prog__img  { order: 2; }
.pb-prog__row--rev .pb-prog__body { order: 1; }
.pb-prog__img { overflow: hidden; min-height: 340px; }
.pb-prog__img img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.pb-prog__row:hover .pb-prog__img img { transform: scale(1.04); }
.pb-prog__body {
  padding: 2.5rem 3rem; background: white;
  display: flex; flex-direction: column; justify-content: center;
}
.pb-prog__num {
  font-family: var(--font-serif); font-size: 2.5rem; font-weight: 300;
  color: rgba(27,94,138,0.15); line-height: 1; margin-bottom: 0.4rem;
}
.pb-prog__body h3 { font-size: 1.3rem; margin-bottom: 0.3rem; color: var(--color-text); }
.pb-prog__tag {
  font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--color-ocean-main); font-weight: 500;
  margin-bottom: 1.1rem; display: block;
}
.pb-prog__text p {
  line-height: 1.75; color: var(--color-text-muted);
  font-size: 0.92rem; margin-bottom: 0.8rem;
}
.pb-prog__text p:last-child { margin-bottom: 0; }
@media (max-width: 900px) {
  .pb-prog__row { grid-template-columns: 1fr; }
  .pb-prog__row--rev .pb-prog__img,
  .pb-prog__row--rev .pb-prog__body { order: unset; }
  .pb-prog__img { min-height: 240px; }
  .pb-prog__body { padding: 2rem; }
}
@media (max-width: 560px) {
  .pb-prog__body { padding: 1.75rem 1.5rem; }
}

/* ── SÉLECTION ── */
.pb-sel__list { display: flex; flex-direction: column; gap: 3rem; margin-top: 2rem; }
.pb-sel__block {
  display: grid; grid-template-columns: 1fr 1fr;
  border-radius: 8px; overflow: hidden;
  box-shadow: 0 2px 20px rgba(0,0,0,0.08);
}
.pb-sel__block--rev .pb-sel__img  { order: 2; }
.pb-sel__block--rev .pb-sel__body { order: 1; }
.pb-sel__img { overflow: hidden; min-height: 400px; }
.pb-sel__img img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.pb-sel__block:hover .pb-sel__img img { transform: scale(1.04); }
.pb-sel__body {
  padding: 2.5rem 3rem; background: white;
  display: flex; flex-direction: column;
}
.pb-sel__body--sand { background: white; }
.pb-sel__tag {
  font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--color-ocean-main); font-weight: 600; margin-bottom: 0.4rem;
}
.pb-sel__h3 {
  font-size: 1.35rem; margin-bottom: 1rem; color: var(--color-ocean); line-height: 1.25;
}
.pb-sel__text p {
  font-size: 0.88rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: 0.8rem;
}
.pb-sel__text p:last-child { margin-bottom: 0; }
.pb-sel__pills {
  display: flex; gap: 0.5rem; flex-wrap: wrap;
  list-style: none; padding: 0; margin-top: 1.25rem;
}
.pb-sel__pills li {
  font-size: 0.72rem; background: rgba(27,94,138,0.08); color: var(--color-ocean);
  padding: 0.3rem 0.75rem; border-radius: 2px; font-weight: 500; letter-spacing: 0.05em;
}
.pb-sel__infos {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem;
  margin-top: 1.5rem; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 1.5rem;
}
.pb-sel__info-item { display: flex; flex-direction: column; gap: 0.15rem; }
.pb-sel__info-lbl {
  font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--color-ocean-main); font-weight: 700;
}
.pb-sel__info-val { font-size: 0.84rem; color: var(--color-text); font-weight: 500; line-height: 1.4; }
.section--dark .pb-sel__block {
  box-shadow: 0 2px 24px rgba(0,0,0,0.4);
}
.section--dark .pb-sel__body,
.section--dark .pb-sel__body--sand {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
}
.section--dark .pb-sel__tag   { color: var(--color-ocean-light); }
.section--dark .pb-sel__h3    { color: white; }
.section--dark .pb-sel__text p { color: rgba(255,255,255,0.72); }
.section--dark .pb-sel__pills li {
  background: rgba(255,255,255,0.1);
  color: white;
}
.section--dark .pb-sel__infos {
  border-top-color: rgba(255,255,255,0.1);
}
.section--dark .pb-sel__info-lbl { color: var(--color-ocean-light); }
.section--dark .pb-sel__info-val { color: rgba(255,255,255,0.85); }

@media (max-width: 900px) {
  .pb-sel__block { grid-template-columns: 1fr; }
  .pb-sel__block--rev .pb-sel__img,
  .pb-sel__block--rev .pb-sel__body { order: unset; }
  .pb-sel__img { min-height: 260px; }
  .pb-sel__body { padding: 2rem; }
}
@media (max-width: 560px) {
  .pb-sel__infos { grid-template-columns: 1fr; }
  .pb-sel__body { padding: 1.5rem; }
}

/* ── PROGRAMME CARTES style 2 ── */
.pb-prog-cart__grid {
  display: grid;
  gap: 2rem;
}
.pb-prog-cart__card {
  background: white;
  border-radius: 6px;
  padding: 1.8rem;
  border-top: 3px solid var(--color-ocean-main);
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.pb-prog-cart__num {
  display: block;
  font-size: 2rem;
  font-family: var(--font-serif);
  color: var(--color-ocean-light);
  opacity: 0.5;
  margin-bottom: 0.5rem;
  line-height: 1;
}
.pb-prog-cart__h3 {
  font-size: 1rem;
  color: var(--color-ocean);
  margin-bottom: 0.7rem;
}
.pb-prog-cart__desc {
  font-size: 0.9rem;
  line-height: 1.7;
  color: var(--color-text-muted);
  margin: 0;
  white-space: pre-line;
}
@media (max-width: 768px) {
  .pb-prog-cart__grid { grid-template-columns: repeat(2,1fr) !important; gap: 1.2rem; }
}
@media (max-width: 480px) {
  .pb-prog-cart__grid { grid-template-columns: 1fr !important; }
}

/* ── PROGRAMME SANS IMAGE ── */
.pb-prog-txt__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.pb-prog-txt__card {
  background: white;
  border-radius: 6px;
  padding: 1.5rem;
  box-shadow: 0 2px 12px rgba(27,94,138,0.07);
}
.pb-prog-txt__label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-bottom: 1rem;
}
.pb-prog-txt__list {
  list-style: none;
  padding: 0; margin: 0;
}
.pb-prog-txt__list li {
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--color-text);
  padding: 0.35rem 0 0.35rem 1.3rem;
  border-bottom: 1px solid #f0eff0;
  position: relative;
  white-space: pre-line;
}
.pb-prog-txt__list li::before {
  content: '—';
  position: absolute; left: 0;
  color: var(--color-ocean-light);
  font-size: 0.75rem;
}
.pb-prog-txt__list li:last-child { border-bottom: none; }
.pb-prog-txt__list--check li.ok::before { content: '✓'; color: #22c55e; }
.pb-prog-txt__list--check li.no::before { content: '✗'; color: #ef4444; }
.section--dark .pb-prog-txt__card,
.section--ocean .pb-prog-txt__card {
  background: rgba(255,255,255,0.1);
  box-shadow: none;
}
.section--dark .pb-prog-txt__label,
.section--ocean .pb-prog-txt__label { color: var(--color-ocean-light); }
.section--dark .pb-prog-txt__list li,
.section--ocean .pb-prog-txt__list li { color: rgba(255,255,255,0.82); }
@media (max-width: 768px) {
  .pb-prog-txt__grid { grid-template-columns: 1fr; }
}

/* ── CTA ── */
.section--dark.pb-cta { background: var(--color-ocean); }
.pb-cta__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem; flex-wrap: wrap;
}
.pb-cta__h2 { margin-bottom: 0.4rem; }
.pb-cta__sub { color: rgba(255,255,255,0.7); margin-top: 0.3rem; }
.section--sand .pb-cta__sub,
.section--mist .pb-cta__sub,
.section--white .pb-cta__sub { color: var(--color-text-muted); }
.pb-cta__btns { display: flex; gap: 1rem; flex-wrap: wrap; }

/* ── BANNIÈRE + INFOCARD ── */
.bc-section {
  position: relative;
  overflow: hidden;
  min-height: 520px;
  display: flex;
  align-items: center;
}
.bc-bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  transition: transform 0.6s ease;
}
.bc-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(105deg, rgba(7,24,31,0.93) 0%, rgba(13,43,62,0.82) 50%, rgba(13,43,62,0.55) 100%);
}
.bc-inner {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 5rem;
  align-items: center;
  padding-top: 5rem;
  padding-bottom: 5rem;
}
.bc-inner[data-card="false"] {
  grid-template-columns: 1fr;
  max-width: 760px;
}
.bc-eyebrow {
  font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--color-ocean-light); font-weight: 600; margin-bottom: 1rem;
}
.bc-titre {
  font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 400; color: white; line-height: 1.1; margin-bottom: 1.5rem;
}
.bc-texte {
  font-size: 1rem; line-height: 1.75; color: rgba(255,255,255,0.72);
  max-width: 520px; margin-bottom: 2.5rem;
}
.bc-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
.bc-btn {
  display: inline-block; padding: 0.8rem 2rem; border-radius: 4px;
  font-weight: 500; font-size: 0.95rem; text-decoration: none; transition: all 0.2s;
}
.bc-btn--prim  { background: var(--color-ocean-light); color: #07181f; }
.bc-btn--prim:hover  { background: white; }
.bc-btn--ghost { border: 1.5px solid rgba(255,255,255,0.35); color: white; }
.bc-btn--ghost:hover { border-color: white; background: rgba(255,255,255,0.08); }
.bc-card {
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 8px; padding: 2rem;
  backdrop-filter: blur(8px);
}
.bc-card__label {
  font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.12em;
  color: var(--color-ocean-light); font-weight: 700; margin-top: 1.2rem;
}
.bc-card__label:first-child { margin-top: 0; }
.bc-card__val {
  font-size: 0.88rem; color: rgba(255,255,255,0.8); line-height: 1.5;
}
.bc-card__cta {
  display: block; margin-top: 1.6rem; text-align: center;
  background: var(--color-ocean-light); color: #07181f;
  padding: 0.7rem 1rem; border-radius: 4px; font-weight: 600;
  font-size: 0.9rem; text-decoration: none; transition: background 0.2s;
}
.bc-card__cta:hover { background: white; }
@media (max-width: 860px) {
  .bc-inner { grid-template-columns: 1fr !important; gap: 2.5rem; }
  .bc-aside  { display: none; }
}
@media (max-width: 560px) {
  .bc-actions { flex-direction: column; }
}

/* ── BANNIÈRE ── */
.pb-banniere { padding: 0.9rem 0; }
.pb-banniere--ocean  { background: var(--color-ocean-main); color: white; }
.pb-banniere--sand   { background: var(--color-sand); color: var(--color-text); }
.pb-banniere--accent { background: var(--color-ocean-light); color: var(--color-ocean); }
.pb-banniere__inner {
  display: block;
  font-size: 0.9rem;
  font-weight: 500;
  text-align: center;
}
a.pb-banniere__inner:hover { text-decoration: underline; }

/* ── CARROUSEL 3 IMAGES ── */
.pb-carr-outer { overflow: hidden; }
.carr3-wrap {
  position: relative;
  overflow: hidden;
  cursor: grab;
}
.carr3-wrap:active { cursor: grabbing; }
.carr3-track {
  display: flex;
  align-items: stretch;
  gap: 3px;
  transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
}
.carr3-slide {
  flex: 0 0 calc((100% - 6px) / 3);
  width: calc((100% - 6px) / 3);
  overflow: hidden;
  position: relative;
}
.carr3-slide img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  display: block;
  user-select: none; -webkit-user-drag: none;
}

/* ── LIEN BLOG ── */
.pb-blog-section { max-width: 800px; }
.pb-blog-card {
  display: flex; gap: 2rem; align-items: flex-start;
  background: var(--color-sand); border-radius: 8px; padding: 2rem 2.5rem;
  border-left: 4px solid var(--color-ocean-main);
}
.pb-blog-card__icon {
  flex-shrink: 0; width: 52px; height: 52px;
  background: var(--color-ocean-main); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; color: white;
}
.pb-blog-card__body h3 { font-size: 1.15rem; margin-bottom: 0.6rem; }
.pb-blog-card__body p  { line-height: 1.75; color: var(--color-text-muted,#555); font-size: 0.92rem; margin-bottom: 1.2rem; }
.pb-blog-card__btn {
  display: inline-block; background: var(--color-ocean-main); color: white;
  padding: 0.65rem 1.4rem; border-radius: 4px; font-weight: 500;
  font-size: 0.9rem; text-decoration: none; transition: background 0.2s;
}
.pb-blog-card__btn:hover { background: #144b72; }
.section--sand .pb-blog-card { background: #fff; }
.section--dark .pb-blog-card {
  background: rgba(255,255,255,0.06); border-color: var(--color-ocean-light);
}
.section--dark .pb-blog-card__body h3 { color: white; }
.section--dark .pb-blog-card__body p  { color: rgba(255,255,255,0.7); }
.section--dark .pb-blog-card__icon { background: var(--color-ocean-light); color: var(--color-ocean); }
.section--dark .pb-blog-card__btn  { background: var(--color-ocean-light); color: var(--color-ocean); }
.section--dark .pb-blog-card__btn:hover { background: #a8d8ee; }
@media (max-width: 640px) {
  .pb-blog-card { flex-direction: column; gap: 1rem; padding: 1.5rem; }
}

.carr3-caption {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 1.5rem 1rem 0.7rem;
  background: linear-gradient(to top, rgba(7,24,31,.75) 0%, transparent 100%);
  color: rgba(255,255,255,.85);
  font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
  pointer-events: none;
}
.carr3-btn {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 46px; height: 46px; border-radius: 50%;
  background: rgba(0,0,0,.45); border: 1.5px solid rgba(255,255,255,.2);
  color: white; cursor: pointer; padding: 0;
  display: flex; align-items: center; justify-content: center;
  z-index: 10; transition: background 0.2s, border-color 0.2s;
}
.carr3-btn:hover { background: rgba(0,0,0,.7); border-color: rgba(255,255,255,.5); }
.carr3-btn--prev { left: 1rem; }
.carr3-btn--next { right: 1rem; }
.carr3-counter {
  position: absolute; bottom: 0.85rem; right: 1rem;
  font-size: 0.7rem; letter-spacing: 0.12em;
  color: rgba(255,255,255,.6); background: rgba(0,0,0,.35);
  padding: 0.2rem 0.55rem; border-radius: 2px; z-index: 10;
}

/* ── GRILLE DE CARTES — nouveaux champs ── */
.pb-prog-cart__header {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 4rem;
  align-items: start;
  margin-bottom: 2.5rem;
}
.pb-prog-cart__header[data-pos="right"] .pb-prog-cart__header-img { order: 2; }
.pb-prog-cart__header[data-pos="right"] .pb-prog-cart__header-text { order: 1; }
.pb-prog-cart__header-img {
  border-radius: 8px; overflow: hidden; height: 380px; margin: 0;
}
.pb-prog-cart__header-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pb-prog-cart__sub {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin: 0.15rem 0 0.6rem;
}
.section--dark .pb-prog-cart__sub { color: var(--color-ocean-light); }
.pb-prog-cart__note {
  font-size: 0.88rem;
  font-style: italic;
  color: var(--color-text-muted);
  margin-top: 2rem;
  max-width: 720px;
  line-height: 1.7;
}
.section--dark .pb-prog-cart__note { color: rgba(255,255,255,0.55); }
.pb-prog-cart__btn-wrap { margin-top: 2rem; }
.btn-download {
  display: inline-flex; align-items: center; gap: 0.6rem;
  background: var(--color-ocean-main); color: white;
  padding: 0.85rem 1.75rem; border-radius: 4px; font-weight: 500; font-size: 0.9rem;
  text-decoration: none; transition: background 0.2s;
}
.btn-download:hover { background: #144b72; }
@media (max-width: 900px) {
  .pb-prog-cart__header { grid-template-columns: 1fr; gap: 2rem; }
  .pb-prog-cart__header-img { height: 260px; }
  .pb-prog-cart__header[data-pos="right"] .pb-prog-cart__header-img,
  .pb-prog-cart__header[data-pos="right"] .pb-prog-cart__header-text { order: unset; }
}
.section--white .pb-prog-cart__card,
.section--sand  .pb-prog-cart__card {
  background: #fff;
  border: 1px solid #b8cdd8;
  border-top: 3px solid var(--color-ocean-main);
  box-shadow: 0 2px 12px rgba(0,0,0,.07);
}
.section--white .pb-prog-cart__h3,
.section--sand  .pb-prog-cart__h3  { color: var(--color-ocean); }
.section--white .pb-prog-cart__desc,
.section--sand  .pb-prog-cart__desc { color: var(--color-text-muted); }
.section--dark .pb-prog-cart__card,
.section--ocean .pb-prog-cart__card {
  background: rgba(255,255,255,0.1);
  border-top-color: var(--color-ocean-light);
  box-shadow: none;
}
.section--dark .pb-prog-cart__num,
.section--ocean .pb-prog-cart__num { color: var(--color-ocean-light); opacity: 0.6; }
.section--dark .pb-prog-cart__h3,
.section--ocean .pb-prog-cart__h3  { color: white; }
.section--dark .pb-prog-cart__desc,
.section--ocean .pb-prog-cart__desc { color: rgba(255,255,255,0.65); }
.section--dark .pb-prog-cart__sub,
.section--ocean .pb-prog-cart__sub { color: var(--color-ocean-light); }
.section--dark .pb-prog-cart__note,
.section--ocean .pb-prog-cart__note { color: rgba(255,255,255,0.55); }

/* ── BILAN DE SÉJOUR ── */
.pb-bilan__inner {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 4rem;
  align-items: start;
}
.pb-bilan__contexte {
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-ocean-main);
  font-weight: 600;
  margin-bottom: 1.25rem;
  padding: 0.5rem 0.9rem;
  background: rgba(27,94,138,0.08);
  border-radius: 3px;
  display: inline-block;
}
.pb-bilan__resultats {
  display: flex; flex-wrap: wrap; gap: 1.5rem;
  margin-top: 2rem; padding-top: 1.5rem;
  border-top: 1px solid rgba(0,0,0,0.1);
}
.pb-bilan__resultat { display: flex; flex-direction: column; gap: 0.15rem; }
.pb-bilan__res-val {
  font-family: var(--font-serif); font-size: 1.8rem;
  color: var(--color-ocean-main); line-height: 1;
}
.pb-bilan__res-lbl {
  font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--color-text-muted);
}
.pb-bilan__img {
  margin: 0; border-radius: 8px; overflow: hidden;
  position: sticky; top: calc(var(--header-height) + 2rem);
}
.pb-bilan__img img { width: 100%; height: 420px; object-fit: cover; display: block; }
@media (max-width: 900px) {
  .pb-bilan__inner { grid-template-columns: 1fr; }
  .pb-bilan__img { position: static; }
  .pb-bilan__img img { height: 280px; }
}

/* ── DATES DES SÉJOURS ── */
/* Titre de section — blanc sur fond sombre, ocean sur fond clair */
.pb-dates__h2 {
  font-family: var(--font-serif); font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  font-weight: 500; line-height: 1.2; color: white; margin-bottom: 0.5rem;
}
.section--white .pb-dates__h2,
.section--sand  .pb-dates__h2,
.section--mist  .pb-dates__h2 { color: var(--color-ocean); }

.pb-dates__intro {
  color: rgba(255,255,255,0.7); font-size: 1rem; line-height: 1.7;
  max-width: 640px; margin-bottom: 2.5rem;
}
.section--white .pb-dates__intro,
.section--sand  .pb-dates__intro,
.section--mist  .pb-dates__intro { color: var(--color-text-muted); }

.pb-dates__grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem; margin-bottom: 2.5rem;
}

/* Cartes — overlay discret sur fond sombre, carte ocean pleine sur fond clair */
.pb-dates__card {
  background: rgba(255,255,255,0.07);
  border-radius: 8px; padding: 1.75rem;
  border-left: 3px solid var(--color-ocean-light);
  display: flex; flex-direction: column; gap: 0.6rem;
}
.section--white .pb-dates__card,
.section--sand  .pb-dates__card,
.section--mist  .pb-dates__card {
  background: var(--color-ocean);
  box-shadow: 0 4px 20px rgba(13,43,62,0.15);
}

.pb-dates__card-header {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
}
.pb-dates__statut { font-size: 0.78rem; font-weight: 600; color: rgba(255,255,255,0.85); }
.pb-dates__places {
  font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--color-ocean-light); font-weight: 500;
}
.pb-dates__h3 {
  font-family: var(--font-serif); font-size: 1.35rem;
  color: white; margin: 0; line-height: 1.2;
}
.pb-dates__dest { font-size: 0.8rem; color: var(--color-ocean-light); margin: 0; }
.pb-dates__desc { font-size: 0.88rem; color: rgba(255,255,255,0.65); line-height: 1.6; margin: 0; }
.pb-dates__prix {
  font-size: 0.9rem; font-weight: 600; color: var(--color-ocean-light); margin: 0.25rem 0 0;
}
.pb-dates__cta { display: flex; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .pb-intro__grid { grid-template-columns: 1fr; }
  .info-card { position: static; order: -1; }
  .pb-ti__grid  { grid-template-columns: 1fr; }
  .pb-ti__grid[data-pos="left"] .pb-ti__fig { order: 0; }
  .galerie-grid { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 900px) {
  .carr3-slide { flex: 0 0 calc((100% - 3px) / 2); width: calc((100% - 3px) / 2); }
}
@media (max-width: 640px) {
  .pb-hero { min-height: 60vh; }
  .sous-grid { grid-template-columns: 1fr; }
  .wf-card--wide { grid-column: auto; }
  .carr3-slide { flex: 0 0 100%; width: 100%; }
  .pb-cta__inner { flex-direction: column; text-align: center; }
  .pb-cta__btns  { justify-content: center; }
}

/* ── FRISE CHRONOLOGIQUE ── */
.frise-header {
  text-align: center;
  max-width: 640px;
  margin: 0 auto 3rem;
}
.frise-eyebrow { margin-bottom: 0.6rem; }
.frise-h2 { color: var(--color-text); margin-bottom: 0; }
.frise-sub {
  color: var(--color-text-muted);
  font-size: 1rem;
  line-height: 1.7;
  margin-top: 0.75rem;
}
.tl-stats-bar {
  display: flex;
  align-items: center;
  gap: 2rem;
  flex-wrap: wrap;
  padding: 1.25rem 2rem;
  background: white;
  border-radius: 3px;
  border-left: 3px solid var(--color-ocean-main);
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  margin: 0 auto 2.75rem;
  max-width: 820px;
}
.tl-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tl-stat-num {
  font-family: var(--font-serif);
  font-size: 1.55rem;
  font-weight: 600;
  color: var(--color-ocean);
  line-height: 1;
}
.tl-stat-lbl {
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin-top: 0.25rem;
}
.tl-stat-sep {
  width: 1px;
  height: 32px;
  background: rgba(0,0,0,0.1);
  flex-shrink: 0;
}
.tl-stat-quote {
  font-family: var(--font-serif);
  font-size: 0.85rem;
  font-style: italic;
  color: var(--color-text-muted);
  line-height: 1.6;
  border-left: 2px solid var(--color-ocean-light);
  padding-left: 1rem;
  margin: 0;
  flex: 1;
  min-width: 180px;
}
.timeline {
  position: relative;
  max-width: 820px;
  margin: 0 auto;
}
.timeline::before {
  content: '';
  position: absolute;
  left: 110px;
  top: 0; bottom: 0;
  width: 1px;
  background: var(--color-ocean-main);
  opacity: 0.22;
}
.timeline-item {
  display: grid;
  grid-template-columns: 100px 22px minmax(0, 1fr);
  gap: 0 0.85rem;
  align-items: start;
  margin-bottom: 1.5rem;
  cursor: default;
}
.timeline-item.has-photo { cursor: pointer; }
.timeline-periode {
  text-align: right;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--color-ocean-main);
  text-transform: uppercase;
  padding-top: 0.28rem;
  transition: color 0.2s;
}
.timeline-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(91,163,201,0.35);
  border: 1.5px solid var(--color-ocean-main);
  margin-top: 0.22rem;
  justify-self: center;
  transition: background 0.25s, box-shadow 0.25s, transform 0.25s;
  position: relative;
  color: white;
}
.dot-camera {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  display: block;
  width: 8px; height: 8px;
  opacity: 0;
  transition: opacity 0.2s;
}
.timeline-item.has-photo .timeline-dot {
  background: var(--color-ocean-main);
  border-color: var(--color-ocean-main);
}
.timeline-item.has-photo .dot-camera { opacity: 0.85; }
.timeline-content h3 {
  font-family: var(--font-serif);
  font-size: 0.95rem;
  color: var(--color-ocean);
  margin: 0 0 0.25rem;
  transition: color 0.2s;
}
.timeline-content p {
  font-size: 0.83rem;
  color: var(--color-text-muted);
  line-height: 1.6;
  margin: 0;
}
.timeline-item.has-photo:hover .timeline-periode,
.timeline-item.is-active .timeline-periode { color: var(--color-ocean); }
.timeline-item.has-photo:hover .timeline-dot,
.timeline-item.is-active .timeline-dot {
  background: var(--color-ocean-light);
  border-color: var(--color-ocean-light);
  box-shadow: 0 0 0 5px rgba(126,200,227,0.2);
  transform: scale(1.25);
}
.timeline-item.has-photo:hover .timeline-content h3,
.timeline-item.is-active .timeline-content h3 { color: var(--color-ocean); }
.tl-expand {
  grid-column: 3;
  grid-row: 2;
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.42s cubic-bezier(0.4,0,0.2,1);
}
.tl-expand-inner { overflow: hidden; min-height: 0; }
.tl-expand-body { padding: 0.85rem 0 0.5rem; }
.tl-carousel {
  position: relative;
  width: 100%;
  max-width: 520px;
  overflow: hidden;
  border-radius: 3px;
  box-shadow: 0 6px 28px rgba(0,0,0,0.16);
}
.tl-car-track {
  display: flex;
  width: 100%;
  transition: transform 0.45s cubic-bezier(0.4,0,0.2,1);
}
.tl-car-slide { flex: 0 0 100%; min-width: 0; }
.tl-expand-photo {
  position: relative;
  aspect-ratio: 3/2;
  overflow: hidden;
}
.tl-expand-photo img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
}
.tl-car-btn {
  position: absolute;
  top: 50%; transform: translateY(-50%);
  width: 30px; height: 30px;
  border-radius: 50%;
  background: rgba(0,0,0,0.45);
  border: 1px solid rgba(255,255,255,0.25);
  color: white; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  z-index: 10; padding: 0;
  transition: background 0.2s;
}
.tl-car-btn:hover { background: rgba(0,0,0,0.72); }
.tl-car-prev { left: 0.5rem; }
.tl-car-next { right: 0.5rem; }
.tl-car-counter {
  position: absolute;
  bottom: 0.45rem; right: 0.6rem;
  font-size: 0.6rem; letter-spacing: 0.1em;
  color: rgba(255,255,255,0.78);
  background: rgba(0,0,0,0.4);
  padding: 0.12rem 0.4rem; border-radius: 2px;
  pointer-events: none;
}
.tl-expand-caption {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 1.25rem 1rem 0.75rem;
  background: linear-gradient(to top, rgba(7,24,31,0.82) 0%, transparent 100%);
  color: rgba(255,255,255,0.88);
  font-size: 0.68rem; letter-spacing: 0.08em;
  text-transform: uppercase;
  pointer-events: none;
}
.tl-expand-link {
  display: inline-block;
  margin-top: 0.75rem;
  font-size: 0.72rem;
  color: var(--color-ocean-main);
  font-weight: 600;
  letter-spacing: 0.04em;
  border-bottom: 1px solid rgba(27,94,138,0.35);
  padding-bottom: 0.1rem;
  transition: color 0.2s, border-color 0.2s;
}
.tl-expand-link:hover { color: var(--color-ocean); border-color: var(--color-ocean); }
.tl-expand-link--temo {
  color: #5a8c5c;
  border-bottom-color: rgba(90,140,92,0.35);
  margin-left: 0.75rem;
}
.tl-expand-link--temo:hover { color: #3d6b3f; border-color: #3d6b3f; }
.timeline-item.is-active .tl-expand { grid-template-rows: 1fr; }
@media (max-width: 900px) {
  .tl-stats-bar { gap: 1.25rem; padding: 1rem 1.25rem; }
  .tl-stat-sep--hide-sm { display: none; }
  .tl-stat-quote { min-width: 100%; border-left: none; padding-left: 0; border-top: 1px solid rgba(0,0,0,0.07); padding-top: 0.75rem; margin-top: 0.25rem; }
  .timeline::before { left: 90px; }
  .timeline-item { grid-template-columns: 80px 20px 1fr; }
}
@media (max-width: 640px) {
  .timeline::before { left: 72px; }
  .timeline-item { grid-template-columns: 64px 20px 1fr; }
  .tl-expand-photo { max-width: 100%; }
}

/* ── GRILLE REVUE DE PRESSE ── */
/* Fond géré par la classe section--* (défaut blanc via le markup) */
.pb-press-header { margin-bottom: 2.5rem; }
.pb-press-h2 { font-family: var(--font-serif); font-size: clamp(1.5rem,3vw,2rem); color: var(--color-ocean); margin: 0.5rem 0 0; }
.pb-press-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

/* ── Carte presse v2 ── */
.pb-press-card2 {
  background: white;
  border: 1px solid rgba(0,0,0,0.07);
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
/* Pas d'effet de survol sur la carte : elle n'est pas cliquable —
   seul le lien "Télécharger / Lire l'article" l'est. */

/* ── Zone image / carrousel ── */
.pb-press-card2__media {
  position: relative;
  aspect-ratio: 3/4;
  background: #f0eff0;
  flex-shrink: 0;
}

.pb-press-flip {
  position: absolute;
  inset: 0;
}

.pb-press-flip__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 0.5rem;
  opacity: 0;
  pointer-events: none;
}
.pb-press-flip__img.is-active {
  opacity: 1;
  pointer-events: auto;
}
.pb-press-flip__img.is-leaving {
  opacity: 1;
  animation: pb-flip-out 0.48s ease-in forwards;
  transform-origin: right center;
}
.pb-press-flip__img.is-entering {
  animation: pb-flip-in 0.48s ease-out forwards;
  transform-origin: left center;
}

@keyframes pb-flip-out {
  from { transform: perspective(700px) rotateY(0deg);   opacity: 1; }
  to   { transform: perspective(700px) rotateY(-90deg); opacity: 0; }
}
@keyframes pb-flip-in {
  from { transform: perspective(700px) rotateY(90deg);  opacity: 0; }
  to   { transform: perspective(700px) rotateY(0deg);   opacity: 1; }
}

.pb-press-flip__placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  text-align: center;
  padding: 1.5rem;
}

/* ── Pastilles de navigation ── */
.pb-press-flip__dots {
  position: absolute;
  bottom: 0.55rem;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 0.32rem;
  z-index: 2;
  pointer-events: none;
}
.pb-press-flip__dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(0,0,0,0.16);
  transition: background 0.25s, transform 0.25s;
}
.pb-press-flip__dot.is-active {
  background: var(--color-ocean-main);
  transform: scale(1.3);
}

/* ── Badge type ── */
.pb-press-card2__badge {
  position: absolute;
  top: 0.6rem;
  left: 0.6rem;
  font-size: 0.56rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: white;
  background: rgba(27,94,138,0.82);
  padding: 0.2rem 0.55rem;
  border-radius: 2px;
  backdrop-filter: blur(4px);
  z-index: 2;
}

/* ── Corps de la carte ── */
.pb-press-card2__body {
  display: flex;
  flex-direction: column;
  padding: 1.2rem 1.4rem 1.4rem;
  flex: 1;
  gap: 0.55rem;
}
.pb-press-card2__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.3rem;
  line-height: 1.4;
}
.pb-press-card2__magazine {
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: var(--color-ocean-main);
}
.pb-press-card2__numero {
  font-size: 0.67rem;
  color: var(--color-ocean);
  font-weight: 500;
}
.pb-press-card2__date {
  font-size: 0.65rem;
  color: rgba(0,0,0,0.36);
  margin-left: auto;
}
.pb-press-card2__titre {
  font-family: var(--font-serif);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.35;
  margin: 0;
}
.pb-press-card2__desc {
  font-size: 0.83rem;
  line-height: 1.7;
  color: var(--color-text-muted);
  margin: 0;
  flex: 1;
  /* Description complète — pas de troncature (demande JBV) */
}
.pb-press-card2__link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: auto;
  padding-top: 0.85rem;
  border-top: 1px solid rgba(0,0,0,0.07);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--color-ocean-main);
  text-decoration: none;
  transition: color 0.2s;
  align-self: flex-start;
}
.pb-press-card2__link:hover { color: var(--color-ocean); }

@media (max-width: 900px) {
  .pb-press-grid { gap: 1.5rem; }
}
@media (max-width: 640px) {
  .pb-press-grid { grid-template-columns: 1fr; gap: 1.25rem; }
  .pb-press-card2__media { aspect-ratio: 4/3; }
}

/* ── GRILLE PARTENAIRES ── */
.pb-part-header { margin-bottom: 2.5rem; }
.pb-part-h2 { font-family: var(--font-serif); font-size: clamp(1.5rem,3vw,2rem); color: var(--color-ocean); margin: 0.5rem 0 0; }
.pb-part-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.pb-part-card {
  display: flex; flex-direction: column;
  border: 1px solid rgba(0,0,0,0.07); border-radius: 6px;
  overflow: hidden; background: white;
  transition: box-shadow .25s, transform .25s;
}
.pb-part-card:hover { box-shadow: 0 8px 32px rgba(27,94,138,.10); transform: translateY(-3px); }
.pb-part-card__logo-wrap {
  height: 120px; display: flex; align-items: center; justify-content: center;
  padding: 1.5rem 2rem; background: #fafafa;
  border-bottom: 1px solid rgba(0,0,0,.05);
}
.pb-part-card__logo { max-width: 100%; max-height: 72px; width: auto; height: auto; object-fit: contain; filter: grayscale(20%); transition: filter .2s; }
.pb-part-card:hover .pb-part-card__logo { filter: grayscale(0%); }
.pb-part-card__logo-placeholder { font-size: .8rem; font-weight: 700; color: var(--color-ocean-main); text-align: center; }
.pb-part-card__body { flex: 1; padding: 1.4rem 1.4rem .8rem; }
.pb-part-card__tag { font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; color: var(--color-ocean-main); display: block; margin-bottom: .5rem; }
.pb-part-card__name { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 600; color: var(--color-ocean); margin: 0 0 .75rem; line-height: 1.3; }
.pb-part-card__desc { font-size: .85rem; line-height: 1.7; color: var(--color-text-muted, #555); margin: 0; }
.pb-part-card__link {
  display: inline-flex; align-items: center; gap: .45rem;
  margin: 1rem 1.4rem 1.4rem; font-size: .75rem; font-weight: 600; letter-spacing: .06em;
  color: var(--color-ocean-main); text-decoration: none;
  border-bottom: 1.5px solid rgba(27,94,138,.25); padding-bottom: .15rem;
  transition: color .2s, border-color .2s; align-self: flex-start;
}
.pb-part-card__link:hover { color: var(--color-ocean); border-color: var(--color-ocean); }
@media (max-width: 1024px) { .pb-part-grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 640px) { .pb-part-grid { grid-template-columns: 1fr; gap: 1.25rem; } }

/* ══════════════════════════════════════════════════════════════════════════════
   SECTIONS MATÉRIEL
══════════════════════════════════════════════════════════════════════════════ */

/* ── Intro + Specs ── */
.pb-mat-intro__grid {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 3rem;
  align-items: start;
}
.pb-mat-intro__h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2rem);
  color: var(--color-ocean-main);
  margin: 0 0 1.5rem;
}
.pb-mat-specs {
  background: var(--color-sand);
  border-left: 3px solid var(--color-ocean-main);
  border-radius: 6px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  position: sticky;
  top: calc(var(--header-height, 70px) + 1.5rem);
}
.pb-mat-specs__row {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  padding-bottom: 0.85rem;
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.pb-mat-specs__row:last-child { border-bottom: none; padding-bottom: 0; }
.pb-mat-specs__label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-ocean-main);
}
.pb-mat-specs__val {
  font-size: 0.88rem;
  color: var(--color-text);
  line-height: 1.5;
}
@media (max-width: 900px) {
  .pb-mat-intro__grid { grid-template-columns: 1fr; }
  .pb-mat-specs { position: static; }
}

/* ── Équipement / Mouches cartes ── */
.pb-equip__header {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}
.pb-equip__h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  color: var(--color-ocean-main);
  margin: 0;
}
.pb-equip__lien-boutique {
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-ocean-main);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
}
.pb-equip__lien-boutique:hover { color: var(--color-ocean); }
.pb-equip__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.pb-equip__card {
  background: white;
  border-radius: 8px;
  border-top: 3px solid var(--color-ocean-main);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.pb-equip__card-titre {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  color: var(--color-ocean-main);
  margin: 0;
}
.pb-equip__card-desc {
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--color-text);
  margin: 0;
  flex: 1;
}
.pb-equip__card-lien {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-ocean-main);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: auto;
  padding-top: 0.5rem;
  border-top: 1px solid rgba(0,0,0,0.07);
}
.pb-equip__card-lien:hover { color: var(--color-ocean); }
@media (max-width: 900px) { .pb-equip__grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .pb-equip__grid { grid-template-columns: 1fr; } }

/* ── Navigation sous-pages matériel ── */
.pb-mat-nav { padding: 2rem 0; }
.pb-mat-nav__inner {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  justify-content: center;
}
.pb-mat-nav__btn {
  display: inline-flex;
  align-items: center;
  padding: 0.65rem 1.25rem;
  background: white;
  border: 1px solid rgba(27,94,138,0.25);
  border-radius: 4px;
  color: var(--color-ocean-main);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s, color 0.2s;
}
.pb-mat-nav__btn:hover {
  background: var(--color-ocean-main);
  border-color: var(--color-ocean-main);
  color: white;
}

/* ── Vidéos YouTube alternées ── */
.pb-videos__header {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
}
.pb-videos__h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  color: var(--color-ocean-main);
  margin: 0;
}
