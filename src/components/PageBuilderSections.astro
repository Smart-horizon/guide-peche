<script>
// ── CARROUSEL 3 IMAGES ────────────────────────────────────────────────────────
document.querySelectorAll('[data-carr]').forEach(wrap => {
  const track   = wrap.querySelector('.carr3-track')
  const slides  = wrap.querySelectorAll('.carr3-slide')
  const counter = wrap.querySelector('.carr3-counter')
  if (!track || !slides.length) return

  const total = slides.length
  let current = 0
  const DELAY = 4500
  let timer = null

  function startAutoplay() { if (timer) return; timer = setInterval(() => go(current + 1), DELAY) }
  function stopAutoplay()  { if (timer) { clearInterval(timer); timer = null } }
  function restartAutoplay() { stopAutoplay(); setTimeout(startAutoplay, 6000) }

  function slideW() { return slides[0].offsetWidth }
  function visibleN() { return window.innerWidth <= 640 ? 1 : window.innerWidth <= 900 ? 2 : 3 }

  function calcOffset(idx) {
    const w = slideW(), g = 3, n = visibleN()
    const raw = n < 3 ? idx * (w + g) : (idx - 1) * (w + g)
    return Math.max(0, Math.min(Math.max(0, (total - n) * (w + g)), raw))
  }

  function go(idx) {
    current = (idx + total) % total
    track.style.transform = `translateX(-${calcOffset(current)}px)`
    if (counter) counter.textContent = `${current + 1} / ${total}`
  }

  window.addEventListener('resize', () => {
    track.style.transition = 'none'
    track.style.transform  = `translateX(-${calcOffset(current)}px)`
    requestAnimationFrame(() => { track.style.transition = '' })
  })

  wrap.querySelector('.carr3-btn--prev')?.addEventListener('click', () => { go(current - 1); restartAutoplay() })
  wrap.querySelector('.carr3-btn--next')?.addEventListener('click', () => { go(current + 1); restartAutoplay() })

  let startX = 0
  wrap.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX }, { passive: true })
  wrap.addEventListener('touchend',   (e) => {
    const dx = e.changedTouches[0].clientX - startX
    if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
  }, { passive: true })

  let dragX = 0, dragging = false
  wrap.addEventListener('mousedown',  (e) => { dragX = e.clientX; dragging = true })
  wrap.addEventListener('mouseup',    (e) => {
    if (!dragging) return; dragging = false
    const dx = e.clientX - dragX
    if (Math.abs(dx) > 40) { go(current + (dx < 0 ? 1 : -1)); restartAutoplay() }
  })
  wrap.addEventListener('mouseleave', () => { dragging = false })
  wrap.addEventListener('mouseenter', stopAutoplay)
  wrap.addEventListener('mouseleave', startAutoplay)

  startAutoplay()
})

// ── REVUE DE PRESSE — carrousel "effet page de livre" ────────────────────────
;(function() {
  document.querySelectorAll('[data-press-flip]').forEach(flipEl => {
    const imgs = Array.from(flipEl.querySelectorAll('.pb-press-flip__img'))
    if (imgs.length <= 1) return

    const card    = flipEl.closest('.pb-press-card2')
    const dots    = card ? Array.from(card.querySelectorAll('.pb-press-flip__dot')) : []
    let current   = 0
    let animating = false

    function flipTo(next) {
      if (animating || next === current) return
      animating = true
      const currImg = imgs[current]
      const nextImg = imgs[next]
      currImg.classList.remove('is-active')
      currImg.classList.add('is-leaving')
      nextImg.classList.add('is-entering')
      setTimeout(() => {
        currImg.classList.remove('is-leaving')
        nextImg.classList.remove('is-entering')
        nextImg.classList.add('is-active')
        dots[current]?.classList.remove('is-active')
        dots[next]?.classList.add('is-active')
        current = next
        animating = false
      }, 520)
    }

    // Pause on hover, resume on leave
    let timer = setInterval(() => flipTo((current + 1) % imgs.length), 3500)
    if (card) {
      card.addEventListener('mouseenter', () => { clearInterval(timer); timer = null })
      card.addEventListener('mouseleave', () => { if (!timer) timer = setInterval(() => flipTo((current + 1) % imgs.length), 3500) })
    }
  })
})()

// ── FRISE CHRONOLOGIQUE — mini-carrousels + accordéon ─────────────────────────
;(function() {

  // Mini-carrousels
  document.querySelectorAll('.tl-carousel').forEach(car => {
    const track   = car.querySelector('.tl-car-track')
    const counter = car.querySelector('.tl-car-counter')
    const total   = parseInt(car.dataset.total || '1', 10)
    let idx = 0
    let autoTimer = null

    function carGo(n) {
      idx = (n + total) % total
      if (track) track.style.transform = `translateX(-${idx * 100}%)`
      if (counter) counter.textContent = `${idx + 1} / ${total}`
    }
    function startAuto() {
      if (total <= 1 || autoTimer) return
      autoTimer = setInterval(() => carGo(idx + 1), 2800)
    }
    function stopAuto() {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null }
    }

    car.querySelector('.tl-car-prev')?.addEventListener('click', (e) => {
      e.stopPropagation(); stopAuto(); carGo(idx - 1); setTimeout(startAuto, 5000)
    })
    car.querySelector('.tl-car-next')?.addEventListener('click', (e) => {
      e.stopPropagation(); stopAuto(); carGo(idx + 1); setTimeout(startAuto, 5000)
    })
    startAuto()
  })

  // Accordéon
  const CLOSE_DELAY = 900
  const timelineEl = document.getElementById('timeline-list')
  if (!timelineEl) return
  const items = timelineEl.querySelectorAll('.timeline-item.has-photo')
  const timers = new Map()

  function openItem(item) {
    const t = timers.get(item)
    if (t !== undefined) { clearTimeout(t); timers.delete(item) }
    items.forEach(i => { if (i !== item) i.classList.remove('is-active') })
    item.classList.add('is-active')
    item.querySelectorAll('.tl-expand img[loading="lazy"]').forEach(img => {
      img.loading = 'eager'
    })
  }

  function scheduleClose(item) {
    const t = setTimeout(() => {
      item.classList.remove('is-active')
      timers.delete(item)
    }, CLOSE_DELAY)
    timers.set(item, t)
  }

  if (window.innerWidth > 900) {
    items.forEach(item => {
      item.addEventListener('mouseenter', () => openItem(item))
      item.addEventListener('mouseleave', () => scheduleClose(item))
    })
  } else {
    items.forEach(item => {
      item.addEventListener('click', () => {
        const wasActive = item.classList.contains('is-active')
        items.forEach(i => i.classList.remove('is-active'))
        if (!wasActive) {
          item.classList.add('is-active')
          item.querySelectorAll('.tl-expand img[loading="lazy"]').forEach(img => {
            img.loading = 'eager'
          })
        }
      })
    })
  }

})()
</script>
