---
import { stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'

interface Props {
  lang?: 'fr' | 'en'
  hasLangSwitch?: boolean
}
const { lang = 'fr', hasLangSwitch = false } = Astro.props

// ── Fallback hardcodé — utilisé si le document "navigation" n'existe pas encore dans Sanity
const NAV_FALLBACK = [
  { label: 'Accueil', href: '/' },
  { label: 'Le guide', href: '/jean-baptiste-vidal-moniteur-guide-de-peche' },
  {
    label: 'Eau douce',
    href: '/peche-a-la-mouche-en-bretagne',
    activePrefix: '/peche-a-la-mouche-en-bretagne',
    children: [
      { label: "Stage d'initiation", href: '/initiation-peche-a-la-mouche' },
      { label: 'Perfectionnement truite', href: '/peche-de-la-truite-a-la-mouche-en-bretagne' },
      { label: 'Réservoir', href: '/peche-de-la-truite-en-reservoir' },
      { label: 'Alose', href: '/peche-de-l-alose-a-la-mouche' },
      { label: 'Brochet', href: '/peche-du-brochet-a-la-mouche' },
    ],
  },
  {
    label: 'Mer',
    href: '/peche-du-bar-a-la-mouche',
    activePrefix: '/peche-du-bar',
    children: [
      { label: 'Initiation bar', href: '/initiation-peche-du-bar-a-la-mouche' },
      { label: 'Perfectionnement bar', href: '/peche-du-bar-perfectionnement' },
      { label: 'Bar à vue en estuaire', href: '/peche-du-bar-a-vue-a-la-mouche' },
      { label: 'Bar en bateau', href: '/peche-mouche-bar-bateau-bretagne' },
      { label: 'Coaching bar', href: '/peche-du-bar-a-la-mouche-coaching' },
      { label: 'Le bateau', href: '/bateau-bar-a-la-mouche' },
    ],
  },
  {
    label: 'MasterClass',
    href: '/masterclass',
    activePrefix: '/master-class',
    children: [
      { label: 'Nymphe au fil', href: '/master-class-nymphe-au-fil' },
      { label: 'Réservoir', href: '/master-class-peche-en-reservoir' },
    ],
  },
  {
    label: 'Voyages',
    href: '/voyages-peche-mouche',
    activePrefix: '/voyage',
    children: [
      { label: 'Tous les voyages', href: '/voyages-peche-mouche' },
      { label: 'Argentine — Rio Grande', href: '/voyage-peche-argentine-rio-grande-truite-de-mer' },
      { label: 'Cuba — Cayo Cruz', href: '/peche-mouche-cuba-cayo-cruz' },
      { label: 'Cuba — Santa Maria', href: '/peche-mouche-cuba-cayo-santa-maria' },
      { label: 'Venezuela — Los Roques', href: '/los-roques-venezuela' },
      { label: 'Mexique', href: '/voyage-peche-mouche-mexique' },
    ],
  },
  {
    label: 'Divers',
    href: '/partenaires-jeanbaptistevidal',
    children: [
      { label: 'Partenaires', href: '/partenaires-jeanbaptistevidal' },
      { label: 'Revue de presse', href: '/revue-de-presse-jeanbaptiste-vidal-moniteur-guide-de-peche' },
      { label: 'Vidéos', href: '/videos-jeanbaptiste-vidal-moniteur-guide-de-peche' },
      { label: 'Mon matériel', href: '/materiel-jeanbaptistevidal' },
      { label: 'Mes mouches', href: '/mouches-de-peche-jeanbaptiste-vidal' },
    ],
  },
  { label: 'Blog', href: '/blog' },
  {
    label: 'Contact',
    href: '/contact',
    children: [
      { label: 'Contact', href: '/contact' },
      { label: 'Bon cadeau', href: '/bon-cadeau-peche-mouche' },
      { label: 'Tarifs', href: '/tarifs' },
      { label: 'Calendrier des disponibilités', href: '/disponibilites-guidages' },
    ],
  },
]

// ── Fetch Sanity — si le document n'existe pas encore, on utilise le fallback
let navLinks = NAV_FALLBACK
try {
  const nav = await stegaClient.fetch(
    `*[_type == "navigation" && _id == "navigation"][0]{ items }`
  )
  if (nav?.items?.length) {
    navLinks = nav.items.map((item: any) => ({
      ...item,
      href: stegaClean(item.href),
      activePrefix: item.activePrefix ? stegaClean(item.activePrefix) : undefined,
      children: item.children?.map((child: any) => ({
        ...child,
        href: stegaClean(child.href),
      })),
    }))
  }
} catch (e) {
  // Sanity non disponible au build → fallback silencieux
}

const { pathname } = Astro.url

// Language switch URLs
const isEn  = lang === 'en'
const frPath = isEn ? pathname.replace(/^\/en/, '') || '/' : pathname
const enPath = isEn ? pathname : '/en' + pathname
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Jean-Baptiste Vidal — Accueil">
      <img src="/images/logo.svg" alt="Enjoy Fishing" class="logo-img" />
      <span class="logo-text">
        <span class="logo-name">Jean-Baptiste Vidal</span>
        <span class="logo-tagline">Guide de pêche à la mouche</span>
        <span class="logo-tagline">Bretagne</span>
      </span>
    </a>

    <!-- Titre centré — visible uniquement en mode hamburger (≤1024px) -->
    <a href="/" class="header-title" aria-hidden="true" tabindex="-1">
      <span class="ht-name">Jean-Baptiste Vidal</span>
      <span class="ht-tagline">Guide de pêche à la mouche</span>
      <span class="ht-tagline">Bretagne</span>
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="site-nav">
      <ul>
        {navLinks.map(({ label, href, children, activePrefix }) => (
          <li class:list={[{ 'has-dropdown': children }]}>
            {children ? (
              <>
                <a href={href} class:list={['nav-link', { active: (activePrefix && pathname.startsWith(activePrefix)) || pathname === href }]}>
                  {label}
                  <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </a>
                <ul class="dropdown">
                  {children.map(child => (
                    <li>
                      <a href={child.href} class:list={['dropdown-link', { active: pathname === child.href }]}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={href} class:list={['nav-link', { active: pathname === href }]}>
                {label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    {hasLangSwitch && (
      <div class="lang-switch" role="navigation" aria-label="Language">
        <a href={frPath} class:list={['lang-btn', !isEn && 'lang-btn--active']} aria-label="Version française" hreflang="fr">FR</a>
        <span class="lang-sep" aria-hidden="true"></span>
        <a href={enPath} class:list={['lang-btn', isEn && 'lang-btn--active']} aria-label="English version" hreflang="en">EN</a>
      </div>
    )}
  </div>
</header>

<script>
  const header = document.getElementById('site-header')
  const toggle = document.getElementById('nav-toggle')
  const nav = document.getElementById('site-nav')

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 40)
  })

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open')
    toggle?.setAttribute('aria-expanded', String(open))
  })

  // Mobile: toggle dropdown on click
  nav?.querySelectorAll('.has-dropdown > .nav-link').forEach(link => {
    link.addEventListener('click', (e) => {
      if (window.innerWidth <= 1024) {
        e.preventDefault()
        link.closest('.has-dropdown')?.classList.toggle('dropdown-open')
      }
    })
  })
</script>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    transition: background 0.3s ease, box-shadow 0.3s ease;
    background: transparent;
    overflow: visible;
  }
  .site-header.scrolled {
    background: var(--color-ocean);
    box-shadow: 0 2px 20px rgba(0,0,0,0.25);
  }

  .header-inner {
    position: relative;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 3rem;
    height: 124px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: visible;
  }

  /* Logo */
  .logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: white;
  }
  .logo-img { height: 156px; width: auto; display: block; object-fit: contain; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.2; }
  .logo-name { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap; }
  .logo-tagline { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.7; white-space: nowrap; }

  /* Nav — direct child ul only, so .dropdown sub-ul is not affected */
  .site-nav > ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0; padding: 0;
  }

  .site-nav li { position: relative; }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    transition: color 0.2s;
    position: relative;
    white-space: nowrap;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 0.85rem; right: 0.85rem;
    height: 1px;
    background: var(--color-ocean-light);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }
  .nav-link:hover, .nav-link.active { color: white; }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }

  .chevron {
    transition: transform 0.2s;
    opacity: 0.7;
  }

  /* Dropdown */
  .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    background: var(--color-ocean);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 3px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    flex-direction: column;
    padding: 0.5rem 0;
    z-index: 200;
    list-style: none;
    margin: 0;
  }
  .dropdown::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-bottom-color: rgba(255,255,255,0.1);
    border-top: none;
  }

  /* Desktop uniquement — hover, pas focus-within */
  @media (min-width: 1025px) {
    .has-dropdown:hover .dropdown { display: flex; }
    .has-dropdown:hover .chevron { transform: rotate(180deg); }
  }

  .dropdown-link {
    display: block;
    padding: 0.6rem 1.25rem;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .dropdown-link:first-child {
    font-weight: 600;
    color: var(--color-ocean-light);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    margin-bottom: 0.25rem;
    padding-bottom: 0.75rem;
  }
  .dropdown-link:hover, .dropdown-link.active {
    background: rgba(255,255,255,0.07);
    color: white;
  }

  /* ── Language switch ── */
  .lang-switch {
    display: flex;
    align-items: center;
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 5px;
    overflow: hidden;
    flex-shrink: 0;
    margin-left: 0.75rem;
  }
  .lang-btn {
    display: block;
    padding: 0.28rem 0.6rem;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: background 0.18s, color 0.18s;
    line-height: 1.4;
    font-family: var(--font-sans);
  }
  .lang-btn--active {
    background: rgba(255,255,255,0.18);
    color: #fff;
  }
  .lang-btn:hover:not(.lang-btn--active) {
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.08);
  }
  .lang-sep {
    width: 1px;
    height: 12px;
    background: rgba(255,255,255,0.22);
    display: block;
    flex-shrink: 0;
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }
  .nav-toggle span {
    display: block;
    width: 24px; height: 2px;
    background: white;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* ── Réduction progressive — desktop intermédiaire ── */

  /* 1400px : taglines disparaissent, logo réduit, nav légèrement plus compact */
  @media (max-width: 1400px) {
    .logo-tagline { display: none; }
    .logo-img { height: 120px; }
    .nav-link { padding: 0.5rem 0.65rem; font-size: 0.73rem; }
  }

  /* 1300px : nom du logo disparaît, logo encore réduit */
  @media (max-width: 1300px) {
    .logo-name { display: none; }
    .logo-img { height: 90px; }
  }

  /* 1150px : nav ultra-compact pour tenir dans l'espace restant */
  @media (max-width: 1150px) {
    .nav-link { padding: 0.4rem 0.5rem; font-size: 0.7rem; }
  }

  /* header-title — caché sur desktop, flex item centré sur mobile */
  .header-title {
    display: none;
  }

  /* ── Mobile / tablette : hamburger à 1024px ── */
  @media (max-width: 1024px) {
    .header-inner { padding: 0 1.5rem; }

    .nav-toggle { display: flex; }
    .logo-img { height: 72px; }

    /* Sur mobile, le switch s'intercale entre le titre centré et le hamburger */
    .lang-switch { margin-left: 0; order: 3; }
    .nav-toggle  { order: 4; }

    /* Titre centré : prend tout l'espace libre entre logo et hamburger */
    .header-title {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
      min-width: 0; /* CRUCIAL : permet au flex item de rétrécir sous min-content */
      text-align: center;
      color: white;
      text-decoration: none;
      padding: 0 0.5rem;
      overflow: hidden;
    }
    .ht-name {
      font-family: var(--font-serif);
      font-size: clamp(0.7rem, 2.4vw, 0.9rem); /* ~0.7rem à 375px, 0.9rem dès 480px */
      font-weight: 600;
      letter-spacing: 0.02em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ht-tagline {
      font-size: clamp(0.5rem, 1.5vw, 0.58rem);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.7;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 124px; left: 0; right: 0;
      background: var(--color-ocean);
      padding: 1rem 0 1.5rem;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .site-nav.open { display: block; }

    .site-nav > ul { flex-direction: column; gap: 0; }

    .nav-link {
      padding: 0.85rem 2rem;
      font-size: 0.85rem;
      justify-content: space-between;
    }
    .nav-link::after { display: none; }

    /* Désactive hover/focus-within sur mobile — uniquement JS */
    .has-dropdown:hover .dropdown,
    .has-dropdown:focus-within .dropdown { display: none; }

    /* Mobile dropdown */
    .dropdown {
      position: static;
      transform: none;
      display: none;
      background: rgba(0,0,0,0.2);
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 0;
    }
    .dropdown::before { display: none; }

    .has-dropdown.dropdown-open .dropdown { display: flex !important; }
    .has-dropdown.dropdown-open .chevron { transform: rotate(180deg); }

    .dropdown-link {
      padding: 0.7rem 2rem 0.7rem 3rem;
      font-size: 0.8rem;
    }
    .dropdown-link:first-child {
      border-bottom: none;
      margin-bottom: 0;
    }
  }

</style>
