---
interface Props {
  href: string
  label?: string
}
const { href, label = 'Voir le matériel' } = Astro.props
---

<a href={href} class="reel-btn" title={label}>
  <svg
    class="reel-icon"
    viewBox="0 0 40 40"
    width="19"
    height="19"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    overflow="visible"
    style="overflow:visible"
  >

    <!-- FIXE : patte d'accroche -->
    <line x1="7" y1="3" x2="33" y2="3" stroke-width="3"/>

    <!-- FIXE : canne + anneaux
         Scion jusqu'a x=300 SVG units = ~158 px depuis le bord gauche du bouton,
         soit environ 1 lettre apres le dernier "R" de "Materiel Bar".
         Anneaux : demi-arches upward (sweep=0), espacement decroissant vers le scion.
    -->
    <g opacity="0.72">

      <!-- Segments de canne (taper progressif) -->
      <line x1="33"  y1="3" x2="107" y2="3" stroke-width="1.6"  stroke-linecap="butt"/>
      <line x1="107" y1="3" x2="168" y2="3" stroke-width="1.25" stroke-linecap="butt"/>
      <line x1="168" y1="3" x2="215" y2="3" stroke-width="0.95" stroke-linecap="butt"/>
      <line x1="215" y1="3" x2="256" y2="3" stroke-width="0.65" stroke-linecap="butt"/>
      <line x1="256" y1="3" x2="286" y2="3" stroke-width="0.4"  stroke-linecap="butt"/>
      <line x1="286" y1="3" x2="300" y2="3" stroke-width="0.22" stroke-linecap="round"/>

      <!-- 7 anneaux - positions : 96, 146, 186, 218, 243, 263, 279
           Espacement decroissant : 63, 50, 40, 32, 25, 20, 16 SVG units
           Rayons decroissants   : 2.1, 1.85, 1.65, 1.45, 1.25, 1.05, 0.85
      -->
      <path d="M93.9,3 A2.1,2.1 0 0 0 98.1,3"        stroke-width="0.9"  fill="none"/>
      <path d="M144.15,3 A1.85,1.85 0 0 0 147.85,3"  stroke-width="0.85" fill="none"/>
      <path d="M184.35,3 A1.65,1.65 0 0 0 187.65,3"  stroke-width="0.8"  fill="none"/>
      <path d="M216.55,3 A1.45,1.45 0 0 0 219.45,3"  stroke-width="0.75" fill="none"/>
      <path d="M241.75,3 A1.25,1.25 0 0 0 244.25,3"  stroke-width="0.7"  fill="none"/>
      <path d="M261.95,3 A1.05,1.05 0 0 0 264.05,3"  stroke-width="0.65" fill="none"/>
      <path d="M278.15,3 A0.85,0.85 0 0 0 279.85,3"  stroke-width="0.6"  fill="none"/>

    </g>

    <!-- ANIME : corps du moulinet (JS rotate autour de cx=20 cy=20) -->
    <g class="reel-wheel">
      <circle cx="20" cy="20" r="17" stroke-width="2.5"/>
      <line x1="20" y1="20" x2="20"   y2="7"    stroke-width="1.5"/>
      <line x1="20" y1="20" x2="31.3" y2="26.5" stroke-width="1.5"/>
      <line x1="20" y1="20" x2="8.7"  y2="26.5" stroke-width="1.5"/>
      <circle cx="20"   cy="8"    r="3"   fill="currentColor" stroke="none"/>
      <circle cx="30.6" cy="25.5" r="3"   fill="currentColor" stroke="none"/>
      <circle cx="9.4"  cy="25.5" r="3"   fill="currentColor" stroke="none"/>
      <circle cx="20" cy="20" r="4.5" stroke-width="2"/>
      <circle cx="20" cy="20" r="1.8" fill="currentColor" stroke="none"/>
    </g>

  </svg>
  <span>{label}</span>
</a>

<script>
  // SVG rotate(angle, cx, cy) - centre explicite, zero probleme de CSS scoping
  document.querySelectorAll<HTMLAnchorElement>('.reel-btn').forEach(btn => {
    const wheel = btn.querySelector<SVGGElement>('.reel-wheel')
    if (!wheel) return

    let angle = 0
    let raf: number | null = null

    function spin() {
      angle = (angle + 6) % 360
      wheel!.setAttribute('transform', `rotate(${angle}, 20, 20)`)
      raf = requestAnimationFrame(spin)
    }

    btn.addEventListener('mouseenter', () => { if (!raf) spin() })
    btn.addEventListener('mouseleave', () => {
      if (raf !== null) { cancelAnimationFrame(raf); raf = null }
    })
  })
</script>

<style>
  .reel-btn {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    border: 1.5px solid rgba(255, 255, 255, 0.32);
    color: rgba(255, 255, 255, 0.75);
    padding: 0.65rem 1.35rem 0.65rem 1rem;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    white-space: nowrap;
  }

  .reel-btn:hover {
    border-color: var(--color-ocean-light, #7ec8e3);
    color: var(--color-ocean-light, #7ec8e3);
    background: rgba(126, 200, 227, 0.08);
  }

  .reel-icon {
    flex-shrink: 0;
  }
</style>
