---
// Les données arrivent via props depuis BaseLayout (un seul fetch centralisé)
interface Props {
  telephone?: string
  email?:     string
  adresse?:   string | null
  footerBio?: string | null
  instagram?: string | null
  facebook?:  string | null
  youtube?:   string | null
  vimeo?:     string | null
  lang?:      'fr' | 'en'
}

const {
  telephone = '06 87 30 34 56',
  email     = 'enjoy.fishing@hotmail.fr',
  adresse   = null,
  footerBio: _footerBio = null,
  instagram = null,
  facebook  = null,
  youtube   = null,
  vimeo     = null,
  lang      = 'fr',
} = Astro.props

const isEn = lang === 'en'

const footerBio = _footerBio ?? (isEn
  ? "State-certified fly fishing guide.\nFly fishing on Brittany's rivers and coastline."
  : "Moniteur-Guide diplômé d'État.\nPêche à la mouche en rivières de Bretagne.")

const year      = new Date().getFullYear()
const phone     = telephone
const phoneHref = 'tel:+33' + phone.replace(/\s/g, '').replace(/^0/, '')
const hasSocial = instagram || facebook || youtube || vimeo

const navLinks = isEn ? [
  { label: 'Home',                href: '/en/' },
  { label: 'Services',            href: '/en/stage-peche-mouche' },
  { label: 'Sea bass fly fishing', href: '/en/peche-du-bar-a-la-mouche' },
  { label: 'Freshwater rivers',   href: '/en/peche-a-la-mouche-en-bretagne' },
  { label: 'Masterclass',         href: '/en/masterclass' },
  { label: 'Spey Cast & casting', href: '/en/stage-spey-cast-et-cours-de-lancer' },
  { label: 'Fishing trips',       href: '/en/voyages-peche-mouche' },
  { label: 'Gear',                href: '/en/materiel-jeanbaptistevidal' },
  { label: 'My flies',            href: '/en/mouches-de-peche-jeanbaptiste-vidal' },
  { label: 'Testimonials',        href: '/en/temoignages' },
  { label: 'Blog',                href: '/en/blog' },
  { label: 'About',               href: '/en/jean-baptiste-vidal-moniteur-guide-de-peche' },
  { label: 'Contact',             href: '/en/contact' },
] : [
  { label: 'Accueil',             href: '/' },
  { label: 'Prestations',         href: '/stage-peche-mouche' },
  { label: 'Bar à la mouche',     href: '/peche-du-bar-a-la-mouche' },
  { label: 'Rivières',            href: '/peche-a-la-mouche-en-bretagne' },
  { label: 'Masterclass',         href: '/masterclass' },
  { label: 'Spey Cast & lancer',  href: '/stage-spey-cast-et-cours-de-lancer' },
  { label: 'Voyages',             href: '/voyages-peche-mouche' },
  { label: 'Matériel',            href: '/materiel-jeanbaptistevidal' },
  { label: 'Mes mouches',         href: '/mouches-de-peche-jeanbaptiste-vidal' },
  { label: 'Témoignages',         href: '/temoignages' },
  { label: 'Blog',                href: '/blog' },
  { label: 'À propos',            href: '/jean-baptiste-vidal-moniteur-guide-de-peche' },
  { label: 'Contact',             href: '/contact' },
]
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <a href={isEn ? '/en/' : '/'} class="footer-logo">Jean-Baptiste Vidal</a>
      <p class="footer-bio" set:html={footerBio.replace(/\n/g, '<br />')} />
      <address class="footer-contact">
        <a href={phoneHref}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        {adresse && <span class="footer-adresse">{adresse}</span>}
      </address>
      {hasSocial && (
        <div class="footer-social">
          {instagram && (
            <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          )}
          {facebook && (
            <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          )}
          {youtube && (
            <a href={youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.45A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.97C5.12 20 12 20 12 20s6.88 0 8.59-.45a2.78 2.78 0 0 0 1.95-1.97A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
            </a>
          )}
          {vimeo && (
            <a href={vimeo} target="_blank" rel="noopener noreferrer" aria-label="Vimeo" class="social-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 7.42c-.09 2.01-1.5 4.76-4.21 8.25C15 19.33 12.7 21 10.8 21c-1.15 0-2.13-1.07-2.93-3.2l-1.6-5.87C5.6 9.8 4.9 8.73 4.13 8.73c-.17 0-.77.36-1.77 1.08L1 8.35c1.12-.98 2.22-1.96 3.3-2.93 1.49-1.29 2.61-1.97 3.35-2.04 1.76-.17 2.84 1.03 3.25 3.6.44 2.77.74 4.5.91 5.17.51 2.29 1.06 3.43 1.67 3.43.47 0 1.18-.75 2.13-2.24.95-1.49 1.46-2.63 1.52-3.4.14-1.28-.37-1.93-1.52-1.93-.54 0-1.1.12-1.67.37 1.11-3.63 3.23-5.39 6.35-5.29 2.32.08 3.41 1.57 3.28 4.43z"/></svg>
            </a>
          )}
        </div>
      )}
    </div>

    <nav class="footer-nav" aria-label={isEn ? 'Secondary navigation' : 'Navigation secondaire'}>
      <h3>Navigation</h3>
      <ul>
        {navLinks.map(({ label, href }) => (
          <li><a href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-certif">
      <h3>Certifications</h3>
      <ul>
        <li>BP JEPS « Pêche de Loisir » (2005)</li>
        <li>UCC « Pêche de loisir en milieu maritime »</li>
        <li>Carte pro n° 02913ED0228</li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© {year} Jean-Baptiste Vidal · ENJOY FISHING · Siret 789636313</p>
    <p>{isEn ? 'All rights reserved' : 'Tous droits réservés'}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer);
    color: rgba(255, 255, 255, 0.75);
    padding-top: 4rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 3rem;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 3rem;
  }

  /* Brand column */
  .footer-logo {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: white;
    text-decoration: none;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .footer-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-style: normal;
    font-size: 0.85rem;
  }

  .footer-adresse {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.82rem;
    font-style: normal;
  }

  .footer-contact a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-contact a:hover {
    color: var(--color-ocean-light);
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.6);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .social-link:hover {
    border-color: var(--color-ocean-light);
    color: var(--color-ocean-light);
    background: rgba(126, 200, 227, 0.08);
  }

  /* Nav & certif columns */
  .footer-nav h3,
  .footer-certif h3 {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    margin-bottom: 1.25rem;
    font-weight: 600;
  }

  .footer-nav ul,
  .footer-certif ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: white;
  }

  .footer-certif li {
    font-size: 0.825rem;
    line-height: 1.4;
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.25rem;
      text-align: center;
    }
  }
</style>
