    desc: "Article technique sur la pêche des castillons (saumons d'été) dans les rivières bretonnes, l'une des meilleures destinations en France pour la pêche du saumon.",
    cover: 'press-pm103.jpg',
    page: null,
    link: null,
    linkLabel: null,
    type: 'Article technique',
  },
  {
    id: 'salmo54',
    magazine: 'Revue SALMO',
    issue: 'N° 54',
    date: 'Juin 2014',
    year: 2014,
    title: 'Double page — Mes 3 mouches préférées',
    desc: "Une double page attribuée à un pêcheur qui présente ses trois mouches préférées ou caractéristiques. Merci à Olivier Plasseraud pour cette publication.",
    cover: 'press-salmo54.jpg',
    page: null,
    link: null,
    linkLabel: null,
    type: 'Sélection',
  },
  {
    id: 'fieldstreams',
    magazine: 'Field & Stream (USA)',
    issue: null,
    date: 'Novembre 2013',
    year: 2013,
    title: 'Double page — Guide au lodge de Kau Tapen, Rio Grande',
    desc: "Le photographe Tim Romano de Field & Stream nous a rendu visite en 2012 au lodge de Kau Tapen sur le Rio Grande. En l'honneur de mes services de guide et manager, il m'a mis au devant des projecteurs dans cet article.",
    cover: 'press-fieldstreams.jpg',
    page: null,
    link: null,
    linkLabel: null,
    type: 'Magazine US',
  },
  {
