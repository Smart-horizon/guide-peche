    cover: 'press-vdp2008nov.jpg',
    page: null,
    link: '/pdfs/article-voyages-de-peche-truites-tdf-2008.pdf',
    linkLabel: 'Lire l\'article (PDF)',
    type: 'Article voyage',
  },
  {
    id: 'vdp2008aout',
    magazine: 'Voyages de Pêche',
    issue: null,
    date: 'Août 2008',
    year: 2008,
