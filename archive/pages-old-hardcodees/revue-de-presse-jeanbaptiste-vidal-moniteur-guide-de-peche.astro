    desc: "Hélène Prigent rend hommage au saumon breton à travers mes photos et mes activités de Moniteur-Guide dans ce bel ouvrage. Disponible à la FNAC et dans les espaces culturels.",
    cover: 'press-livre.jpg',
    page: null,
    link: null,
    linkLabel: null,
    type: 'Livre',
  },
