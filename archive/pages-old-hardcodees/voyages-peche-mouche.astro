---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { stegaClient } from '../lib/sanity.js'
import { stegaClean } from '@sanity/client/stega'
import imageUrlBuilder from '@sanity/image-url'

// Fetch all voyage documents — cards are stega-encoded → visual editing overlays
const voyages = (await stegaClient.fetch(`
  *[_type == "voyage"]{
    _id,
    title,
    slug,
    pays,
    periode,
    especes,
    "displayTitle": coalesce(
      pagebuilder[_type == "sectionHero"][0].titre,
      title
    ),
    "tagline": coalesce(
      pagebuilder[_type == "sectionHero"][0].sousTitre,
      especes
    ),
    "region": pagebuilder[_type == "sectionHero"][0].eyebrow,
    "heroImage": pagebuilder[_type == "sectionHero"][0].image.asset->{ _id, url }
  }
`)) as any[]

const builder = imageUrlBuilder(stegaClient)
const urlFor = (source: any) => builder.image(source)

// Ordre d'affichage des cartes secondaires
const ORDRE = [
  'voyage-peche-argentine-rio-grande-truite-de-mer',
  'peche-mouche-cuba-cayo-cruz',
  'peche-mouche-cuba-cayo-santa-maria',
  'voyage-peche-mouche-mexique',
]

// Los Roques = grande carte featured
const featured = voyages.find((v: any) => stegaClean(v.slug?.current) === 'los-roques-venezuela')
const rest = voyages
  .filter((v: any) => stegaClean(v.slug?.current) !== 'los-roques-venezuela')
  .sort((a: any, b: any) => {
    const ai = ORDRE.indexOf(stegaClean(a.slug?.current) ?? '')
    const bi = ORDRE.indexOf(stegaClean(b.slug?.current) ?? '')
    return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi)
  })

function cardImg(v: any, w: number, h: number): string | null {
  return v.heroImage?._id ? urlFor(v.heroImage).width(w).height(h).fit('crop').url() : null
}

// Étiquette région : strip "Voyage · " prefix
function region(v: any): string {
  const raw = stegaClean(v.region) || stegaClean(v.pays) || ''
  return raw.replace(/^Voyage\s*[·•]\s*/i, '')
}
---

<BaseLayout
  title="Voyages de pêche à la mouche — Jean-Baptiste Vidal, Guide accompagnateur"
  description="Voyages de pêche à la mouche accompagnés par Jean-Baptiste Vidal : Argentine, Cuba, Venezuela, Mexique. Truite de mer, permit, bonefish et tarpon dans les plus beaux spots du monde."
>

  <!-- HERO -->
  <section class="voy-overview-hero">
    <div class="voy-overview-hero__bg"></div>
    <div class="voy-overview-hero__content container">
      <p class="eyebrow-light">Voyages accompagnés · Monde entier</p>
      <h1>Voyages de pêche<br /><em>à la mouche</em></h1>
      <p class="hero-sub">Argentine, Cuba, Venezuela, Mexique : des destinations d'exception pour traquer le permit, le bonefish, le tarpon et la truite de mer dans des environnements sauvages préservés.</p>
      <div class="hero-cta">
        <a href="/contact" class="btn btn--primary">Me contacter</a>
        <a href="tel:0687303456" class="btn btn--ghost">06 87 30 34 56</a>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section voy-intro">
    <div class="container voy-intro__inner">
      <div class="voy-intro__text">
        <p class="eyebrow">Voyages accompagnés</p>
        <h2>Pêcher avec un guide qui connaît les spots</h2>
        <p>Depuis 2005, Jean-Baptiste a parcouru les plus grandes destinations de pêche à la mouche au monde : Argentine, Bolivie, Russie, Islande, Cuba, Venezuela, Mexique. Ces voyages accompagnés, c'est l'assurance d'arriver sur des terrains connus, avec un guide qui a déjà pêché là-bas et qui connaît les spots, les guides locaux et les bonnes saisons.</p>
        <p>Petit groupe, rythme adapté, ambiance décontractée. On pêche, on rigole, on rentre avec des souvenirs.</p>
      </div>
      <div class="voy-intro__stats">
        <div class="voy-stat">
          <span class="voy-stat__num">{voyages.length || 5}</span>
          <span class="voy-stat__label">destinations</span>
        </div>
        <div class="voy-stat">
          <span class="voy-stat__num">12+</span>
          <span class="voy-stat__label">pays de pêche</span>
        </div>
        <div class="voy-stat">
          <span class="voy-stat__num">20+</span>
          <span class="voy-stat__label">ans d'expérience exotique</span>
        </div>
      </div>
    </div>
  </section>

  <!-- POURQUOI VOYAGER AVEC JB -->
  <section class="section voy-pourquoi">
    <div class="container">
      <p class="eyebrow" style="text-align:center">Hosted trips</p>
      <h2 style="text-align:center;margin-bottom:3rem">Pourquoi partir avec Jean-Baptiste ?</h2>
      <div class="voy-pourquoi__grid">
        <div class="voy-pourquoi__item">
          <div class="voy-pourquoi__icon">🎯</div>
          <h3>Destinations testées en avant-première</h3>
          <p>Jean-Baptiste effectue systématiquement un voyage de reconnaissance avant de proposer une destination. Vous arrivez sur des terrains connus, avec un guide qui a déjà pêché là-bas.</p>
        </div>
        <div class="voy-pourquoi__item">
          <div class="voy-pourquoi__icon">🤝</div>
          <h3>Réseau international</h3>
          <p>Des partenariats établis de longue date avec Nervous Waters (Argentine), Avalon Fishing (Cuba Cruz), Fly Fish The Run (Cuba Santa Maria) et DHD Laika (Venezuela, Mexique).</p>
        </div>
        <div class="voy-pourquoi__item">
          <div class="voy-pourquoi__icon">🎣</div>
          <h3>Guidage en plus du guide local</h3>
          <p>Jean-Baptiste est présent sur l'eau avec vous, en plus du guide local. Coaching technique, lecture de l'eau, adaptation des mouches — pour maximiser vos chances de capture.</p>
        </div>
        <div class="voy-pourquoi__item">
          <div class="voy-pourquoi__icon">🌎</div>
          <h3>Tout géré pour vous</h3>
          <p>Organisation complète : vols internes, transferts, hébergement, guides, logistique sur place. Vous n'avez qu'à préparer vos cannes et partir l'esprit libre.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GRILLE VOYAGES — données Sanity, overlays visual editing -->
  <section class="voy-grid-section">
    <div class="container voy-grid-header">
      <p class="eyebrow">Destinations</p>
      <h2>Choisissez votre aventure</h2>
    </div>

    <div class="wildfly-grid">

      {/* Grande carte : Los Roques (featured) */}
      {featured && (
        <a href={`/${stegaClean(featured.slug?.current)}`} class="wf-card wf-card--large">
          {cardImg(featured, 1400, 900) ? (
            <div class="wf-card-bg" style={`background-image:url('${cardImg(featured, 1400, 900)}')`}></div>
          ) : (
            <div class="wf-card-bg"></div>
          )}
          <div class="wf-overlay"></div>
          <div class="wf-body">
            <span class="wf-sub">{region(featured)}</span>
            <strong class="wf-label">{featured.displayTitle || featured.title}</strong>
            <span class="wf-tagline">{featured.tagline || featured.especes}</span>
            {stegaClean(featured.periode) && <span class="wf-saison">{featured.periode}</span>}
          </div>
        </a>
      )}

      {/* Cartes secondaires */}
      {rest.map((v: any) => {
        const img = cardImg(v, 900, 640)
        return (
          <a href={`/${stegaClean(v.slug?.current)}`} class="wf-card">
            {img ? (
              <div class="wf-card-bg" style={`background-image:url('${img}')`}></div>
            ) : (
              <div class="wf-card-bg"></div>
            )}
            <div class="wf-overlay"></div>
            <div class="wf-body">
              <span class="wf-sub">{region(v)}</span>
              <strong class="wf-label">{v.displayTitle || v.title}</strong>
              <span class="wf-tagline">{v.tagline || v.especes}</span>
              {stegaClean(v.periode) && <span class="wf-saison">{v.periode}</span>}
            </div>
          </a>
        )
      })}

    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="prest-cta-final section section--dark">
    <div class="container prest-cta-final__inner">
      <div>
        <h2>Un projet de voyage ?</h2>
        <p>Parlez-moi de vos envies, je vous propose les dates et destinations disponibles.</p>
      </div>
      <div class="prest-cta-final__btns">
        <a href="/contact" class="btn-prim">Me contacter</a>
        <a href="tel:0687303456" class="btn-ghost-light">06 87 30 34 56</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO ── */
  .voy-overview-hero {
    position: relative;
    min-height: 75vh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 5rem;
    color: white;
    overflow: hidden;
  }
  .voy-overview-hero__bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(7,24,31,0.88) 0%, rgba(13,43,62,0.45) 60%, rgba(13,43,62,0.3) 100%),
      url('/images/E16.avif') center 30% / cover no-repeat;
    background-color: var(--color-ocean);
  }
  .voy-overview-hero__content {
    position: relative;
    z-index: 1;
  }
  .eyebrow-light {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .voy-overview-hero__content h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    color: white;
    margin-bottom: 1.5rem;
    max-width: 680px;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.1;
  }
  .voy-overview-hero__content h1 em {
    font-style: italic;
    color: rgba(255,255,255,0.85);
  }
  .hero-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.75);
    max-width: 580px;
    margin-bottom: 2.5rem;
  }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn {
    padding: 0.8rem 1.9rem;
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.92rem;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .btn--primary { background: var(--color-ocean-main); color: white; }
  .btn--primary:hover { background: #144b72; }
  .btn--ghost { border: 1.5px solid rgba(255,255,255,0.4); color: white; }
  .btn--ghost:hover { border-color: white; background: rgba(255,255,255,0.08); }

  /* ── INTRO ── */
  .voy-intro { background: var(--color-sand); }
  .voy-intro__inner {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 4rem;
    align-items: center;
  }
  .voy-intro__text .eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ocean-main);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .voy-intro__text h2 { margin-bottom: 1.2rem; }
  .voy-intro__text p { line-height: 1.8; color: var(--color-text); margin-bottom: 1rem; }
  .voy-intro__text p:last-child { margin-bottom: 0; }
  .voy-intro__stats { display: flex; flex-direction: column; gap: 1.5rem; }
  .voy-stat {
    text-align: center;
    padding: 1.25rem 1rem;
    background: white;
    border-radius: 6px;
    border-left: 3px solid var(--color-ocean-main);
  }
  .voy-stat__num {
    display: block;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--color-ocean-main);
    line-height: 1;
    margin-bottom: 0.3rem;
  }
  .voy-stat__label {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0.65;
  }

  /* ── POURQUOI ── */
  .voy-pourquoi { background: #fff; }
  .voy-pourquoi__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .voy-pourquoi__item {
    padding: 1.75rem;
    background: var(--color-sand);
    border-radius: 8px;
    border-top: 3px solid var(--color-ocean-main);
  }
  .voy-pourquoi__icon { font-size: 1.8rem; margin-bottom: 1rem; }
  .voy-pourquoi__item h3 {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-ocean);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .voy-pourquoi__item p {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── GRILLE VOYAGES ── */
  .voy-grid-section { background: #fff; }
  .voy-grid-header { text-align: center; padding: 4rem 2rem 2.5rem; }
  .voy-grid-header .eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ocean-main);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .wildfly-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 480px 320px;
    gap: 4px;
  }
  .wf-card--large { grid-column: 1 / 3; grid-row: 1; }
  .wf-card:nth-child(2) { grid-column: 3; grid-row: 1; }
  .wf-card:nth-child(3) { grid-column: 1; grid-row: 2; }
  .wf-card:nth-child(4) { grid-column: 2; grid-row: 2; }
  .wf-card:nth-child(5) { grid-column: 3; grid-row: 2; }

  .wf-card {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: white;
    background: var(--color-ocean);
  }
  .wf-card-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: transform 0.6s ease;
  }
  .wf-card:hover .wf-card-bg { transform: scale(1.05); }
  .wf-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(7,24,31,0.22);
    transition: background 0.35s ease;
  }
  .wf-card:hover::after { background: rgba(7,24,31,0.08); }
  .wf-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7,24,31,0.82) 0%, rgba(7,24,31,0.1) 55%, transparent 100%);
    z-index: 1;
  }
  .wf-body {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 1.5rem 1.75rem 1.75rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .wf-sub {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    font-weight: 500;
  }
  .wf-label {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.15;
    color: white;
  }
  .wf-card--large .wf-label { font-size: 2.2rem; }
  .wf-tagline {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.4;
    margin-top: 0.1rem;
  }
  .wf-card--large .wf-tagline { font-size: 0.9rem; }
  .wf-saison {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ocean-light);
    border: 1px solid rgba(126,200,227,.35);
    border-radius: 2px;
    padding: 0.15rem 0.55rem;
    align-self: flex-start;
  }

  /* ── CTA FINAL ── */
  .prest-cta-final__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .prest-cta-final__inner h2 { color: white; margin-bottom: 0.5rem; }
  .prest-cta-final__inner > div:first-child p { color: rgba(255,255,255,0.65); }
  .prest-cta-final__btns { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-prim {
    background: var(--color-ocean-main);
    color: white;
    padding: 0.75rem 1.8rem;
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-prim:hover { background: #144b72; }
  .btn-ghost-light {
    border: 1.5px solid rgba(255,255,255,0.4);
    color: white;
    padding: 0.75rem 1.8rem;
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .btn-ghost-light:hover { border-color: white; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .voy-pourquoi__grid { grid-template-columns: repeat(2, 1fr); }
    .wildfly-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 300px 260px 260px;
    }
    .wf-card--large { grid-column: 1 / 3; grid-row: 1; }
    .wf-card:nth-child(2) { grid-column: 1; grid-row: 2; }
    .wf-card:nth-child(3) { grid-column: 2; grid-row: 2; }
    .wf-card:nth-child(4) { grid-column: 1; grid-row: 3; }
    .wf-card:nth-child(5) { grid-column: 2; grid-row: 3; }
    .voy-intro__inner { grid-template-columns: 1fr; gap: 2rem; }
    .voy-intro__stats { flex-direction: row; }
    .voy-stat { flex: 1; }
  }
  @media (max-width: 560px) {
    .voy-pourquoi__grid { grid-template-columns: 1fr; }
    .wildfly-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(5, 260px);
    }
    .wf-card--large,
    .wf-card:nth-child(2),
    .wf-card:nth-child(3),
    .wf-card:nth-child(4),
    .wf-card:nth-child(5) { grid-column: 1; grid-row: auto; }
    .wf-card--large .wf-label { font-size: 1.6rem; }
    .voy-overview-hero { min-height: 85vh; padding-bottom: 3.5rem; }
    .voy-intro__stats { flex-direction: column; }
    .prest-cta-final__inner { flex-direction: column; align-items: flex-start; }
  }
</style>
