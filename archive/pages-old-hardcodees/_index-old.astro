---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Pages hardcodées — comparaison locale</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0d1117; color: #e6edf3; padding: 2rem; }
    h1 { font-size: 1.4rem; margin-bottom: 0.4rem; color: #58a6ff; }
    p.note { font-size: 0.8rem; color: #8b949e; margin-bottom: 2rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    th { text-align: left; padding: 0.5rem 0.75rem; background: #161b22; color: #8b949e; border-bottom: 1px solid #30363d; }
    tr:hover td { background: #161b22; }
    td { padding: 0.55rem 0.75rem; border-bottom: 1px solid #21262d; vertical-align: middle; }
    td:first-child { color: #8b949e; font-size: 0.75rem; width: 1.5rem; text-align: right; }
    .label { color: #e6edf3; }
    .links { display: flex; gap: 0.5rem; }
    a.local  { color: #3fb950; text-decoration: none; font-weight: 500; }
    a.local:hover  { text-decoration: underline; }
    a.prod   { color: #8b949e; text-decoration: none; font-size: 0.78rem; }
    a.prod:hover   { color: #58a6ff; }
    .slug { font-family: monospace; color: #79c0ff; font-size: 0.78rem; }
    .badge { display: inline-block; padding: 0.1rem 0.45rem; border-radius: 12px; font-size: 0.7rem; background: #1f6feb30; color: #58a6ff; border: 1px solid #1f6feb; margin-left: 0.4rem; }
  </style>
</head>
<body>
  <h1>🗂 Pages hardcodées — comparaison locale <span class="badge">DEV ONLY</span></h1>
  <p class="note">Ces pages existent uniquement sur localhost. workers.dev = version Sanity. Cette page disparaît en production.</p>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Page</th>
        <th>Slug</th>
        <th>Liens</th>
      </tr>
    </thead>
    <tbody>
      {pages.map((p, i) => (
        <tr>
          <td>{i + 1}</td>
          <td class="label">{p.label}</td>
          <td class="slug">/{p.slug}</td>
          <td>
            <div class="links">
              <a class="local" href={`/old/${p.slug}`} target="_blank">← localhost /old/</a>
              <a class="prod"  href={`${prod}/${p.slug}`} target="_blank">workers.dev →</a>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</body>
</html>
